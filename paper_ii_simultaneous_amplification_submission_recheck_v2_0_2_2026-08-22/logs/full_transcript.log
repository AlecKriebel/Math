   696	\[
   697	 \underline H_+=r_-(1-2\delta+\ell),\qquad
   698	 \overline H_-=2\delta+m-\ell,
   699	 \qquad \underline U_\ell=\frac{r_-(m-\ell)}{c+m},
   700	\]
