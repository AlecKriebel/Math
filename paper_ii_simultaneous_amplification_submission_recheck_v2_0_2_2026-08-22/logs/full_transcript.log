   1 #!/bin/sh
   2 set -eu
   3 
   4 package_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
   5 bootstrap_python=${BOOTSTRAP_PYTHON:-python3}
   6 tmp_base=${TMPDIR:-/tmp}
   7 export PYTHONDONTWRITEBYTECODE=1
   8 
   9 case "$tmp_base" in
  10   /) tmp_base=/tmp ;;
  11   /*/) tmp_base=${tmp_base%/} ;;
  12   /*) ;;
  13   *) echo "TMPDIR must be an absolute path: $tmp_base" >&2; exit 2 ;;
  14 esac
  15 
  16 "$bootstrap_python" -c '
  17 import sys
  18 if sys.flags.optimize != 0:
  19     raise SystemExit(
  20         "ERROR: optimized Python is unsupported because verification checks must remain active"
  21     )
  22 if sys.version_info[:3] != (3, 14, 6):
  23     raise SystemExit(f"ERROR: Python 3.14.6 is required; found {sys.version}")
  24 '
  25 
  26 "$bootstrap_python" "$package_dir/verify_referee_package.py"
  27 
  28 for command_name in tectonic pdfinfo pdftoppm; do
  29   if ! command -v "$command_name" >/dev/null 2>&1; then
  30     echo "Missing required document tool: $command_name" >&2
  31     exit 2
  32   fi
  33 done
  34 
  35 if [ "$(tectonic --version)" != "Tectonic 0.16.9" ]; then
  36   echo "Tectonic 0.16.9 is required" >&2
  37   tectonic --version >&2
  38   exit 2
  39 fi
  40 if [ "$(pdfinfo -v 2>&1 | sed -n '1p')" != "pdfinfo version 26.08.0" ]; then
  41   echo "pdfinfo 26.08.0 is required" >&2
  42   pdfinfo -v >&2
  43   exit 2
  44 fi
  45 if [ "$(pdftoppm -v 2>&1 | sed -n '1p')" != "pdftoppm version 26.08.0" ]; then
  46   echo "pdftoppm 26.08.0 is required" >&2
  47   pdftoppm -v >&2
  48   exit 2
  49 fi
  50 
  51 work_dir=$(mktemp -d "$tmp_base/paper2-referee.XXXXXX")
  52 cleanup() {
  53   case "$work_dir" in
  54     "$tmp_base"/paper2-referee.*) rm -rf -- "$work_dir" ;;
  55     *) echo "Refusing to remove unexpected work directory: $work_dir" >&2 ;;
  56   esac
  57 }
  58 trap cleanup EXIT HUP INT TERM
  59 
  60 cp -R "$package_dir/source_and_certificates/." "$work_dir/"
  61 paper_dir="$work_dir/universal_simultaneous_amplification/phase4_landmark_closure/paper_hybrid_threshold"
  62 
  63 PIP_NO_INDEX=1 BOOTSTRAP_PYTHON="$bootstrap_python" \
  64   "$paper_dir/bootstrap_replay.sh"
  65 rebuilt_archive="$work_dir/rebuilt-source-and-certificates.tar.gz"
  66 PYTHON="$work_dir/universal_simultaneous_amplification/.venv-paper2/bin/python" \
  67   "$paper_dir/release_bundle.sh" "$rebuilt_archive"
  68 cmp \
  69   "$package_dir/simultaneous_amplifier_beyond_three_halves_source_and_certificates.tar.gz" \
  70   "$rebuilt_archive"
  71 cmp \
  72   "$package_dir/simultaneous_amplification_beyond_three_halves.pdf" \
  73   "$paper_dir/output/pdf/simultaneous_amplification_beyond_three_halves.pdf"
  74 
  75 "$bootstrap_python" - \
  76   "$rebuilt_archive" \
  77   "$paper_dir/output/pdf/simultaneous_amplification_beyond_three_halves.pdf" <<'PY'
