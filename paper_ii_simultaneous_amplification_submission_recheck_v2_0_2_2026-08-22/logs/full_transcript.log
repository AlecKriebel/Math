    78	def git(repo: Path, *arguments: str) -> bytes:
    79	    process = subprocess.run(
    80	        ["git", "-C", str(repo), *arguments],
    81	        stdout=subprocess.PIPE,
    82	        stderr=subprocess.PIPE,
    83	        check=False,
    84	    )
    85	    if process.returncode != 0:
    86	        detail = process.stderr.decode("utf-8", errors="replace").strip()
    87	        raise VerificationError(
    88	            f"git {' '.join(arguments)} failed with status "
    89	            f"{process.returncode}: {detail}"
    90	        )
    91	    return process.stdout
