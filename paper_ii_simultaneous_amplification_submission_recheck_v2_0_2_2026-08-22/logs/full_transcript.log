 170         if names != sorted(names) or len(names) != len(set(names)):
 171             raise RuntimeError("source archive members are not unique and sorted")
 172         if any(not member.isfile() for member in members):
 173             raise RuntimeError("source archive contains a non-regular member")
 174         for member in members:
 175             name = PurePosixPath(member.name)
