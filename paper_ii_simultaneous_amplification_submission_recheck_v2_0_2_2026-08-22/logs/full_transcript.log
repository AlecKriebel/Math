    35	\title{A fitness-independent family of simultaneous amplifiers beyond relative fitness $3/2$}
    36	\author{Alec Kriebel\\
    37	Independent Researcher\\
    38	\href{mailto:me@aleckriebel.com}{me@aleckriebel.com}\\
    39	\href{https://orcid.org/0009-0001-9320-500X}{ORCID: 0009-0001-9320-500X}}
