===== vendor/README.md =====
   1 # Vendored Python distributions
   2 
   3 This directory contains the two unmodified, pure-Python wheels used by the
   4 exact certificate replay.  `requirements.txt` disables package indexes,
   5 selects only binary distributions from this directory, and requires the
   6 following SHA-256 digests:
   7 
   8 | Distribution | SHA-256 |
   9 |---|---|
  10 | `mpmath-1.3.0-py3-none-any.whl` | `a0b2b9fe80bbcd81a6647ff13108738cfb482d481d826cc0e02f5b35e5c88d2c` |
  11 | `sympy-1.14.0-py3-none-any.whl` | `e091cc3e99d2141a0ba2847328f5479b05d94a6635cb96148ccb3f34671bd8f5` |
  12 
  13 The corresponding upstream distribution releases are
  14 <https://pypi.org/project/mpmath/1.3.0/> and
  15 <https://pypi.org/project/sympy/1.14.0/>.  Their upstream source repositories
  16 as recorded in the wheel metadata are
  17 <https://github.com/fredrik-johansson/mpmath> and
  18 <https://github.com/sympy/sympy>, respectively.
  19 
  20 The wheels retain their upstream license files and metadata.  mpmath and
  21 SymPy are third-party BSD-licensed projects and are not relicensed under this
  22 project's MIT license.
  23 
  24 These wheels make the Python certificate bootstrap offline after a compatible
  25 Python 3.14.6 interpreter is installed.  They do not supply Python itself,
  26 Tectonic, Poppler, or Tectonic's TeX resource bundle; document rebuilding has
  27 the separate external-tool boundary described in `submission/ENVIRONMENT.md`.
===== bootstrap_replay.sh =====
   1 #!/bin/sh
   2 set -eu
   3 
   4 paper_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
   5 project_root=$(CDPATH= cd -- "$paper_dir/../.." && pwd)
   6 bootstrap_python=${BOOTSTRAP_PYTHON:-python3}
   7 venv="$project_root/.venv-paper2"
   8 
   9 "$bootstrap_python" -c '
  10 import sys
  11 if sys.flags.optimize != 0:
  12     raise SystemExit(
  13         "ERROR: optimized Python is unsupported because verification checks must remain active"
  14     )
  15 if sys.version_info[:3] != (3, 14, 6):
  16     raise SystemExit(f"ERROR: Python 3.14.6 is required; found {sys.version}")
  17 '
  18 
  19 if [ ! -x "$venv/bin/python" ]; then
  20   "$bootstrap_python" -m venv "$venv"
  21 fi
  22 
  23 "$venv/bin/python" -m pip install \
  24   --disable-pip-version-check \
  25   --no-cache-dir \
  26   --requirement "$paper_dir/requirements.txt"
  27 
  28 "$venv/bin/python" -c '
  29 import importlib.metadata as metadata
  30 import sys
  31 if sys.flags.optimize != 0:
  32     raise SystemExit(
  33         "ERROR: optimized Python is unsupported because verification checks must remain active"
  34     )
  35 if sys.version_info[:3] != (3, 14, 6):
  36     raise SystemExit(f"ERROR: Python 3.14.6 is required; found {sys.version}")
  37 sympy_version = metadata.version("sympy")
  38 mpmath_version = metadata.version("mpmath")
  39 if sympy_version != "1.14.0":
  40     raise SystemExit(
  41         f"ERROR: SymPy 1.14.0 is required; found {sympy_version}"
  42     )
  43 if mpmath_version != "1.3.0":
  44     raise SystemExit(
  45         f"ERROR: mpmath 1.3.0 is required; found {mpmath_version}"
  46     )
  47 print("PASS: Python 3.14.6, SymPy 1.14.0, and mpmath 1.3.0")
  48 '
  49 
  50 PYTHON="$venv/bin/python" "$paper_dir/replay.sh"
  51 "$venv/bin/python" "$paper_dir/tests/test_verifier_fail_closed.py"
===== replay.sh =====
   1 #!/bin/sh
   2 set -eu
   3 
   4 paper_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
   5 project=$(CDPATH= cd -- "$paper_dir/../.." && pwd)
   6 if [ -n "${PYTHON:-}" ]; then
   7   python=$PYTHON
   8 elif [ -x "$project/.venv-paper2/bin/python" ]; then
   9   python="$project/.venv-paper2/bin/python"
  10 elif [ -x "$project/.venv/bin/python" ]; then
  11   python="$project/.venv/bin/python"
  12 else
  13   python=python3
  14 fi
  15 
  16 export PYTHONDONTWRITEBYTECODE=1
  17 
  18 "$python" -c '
  19 import sys
  20 if sys.flags.optimize != 0:
  21     raise SystemExit(
  22         "ERROR: optimized Python is unsupported because verification checks must remain active"
  23     )
  24 '
  25 
  26 "$python" "$paper_dir/certificates/verify_leading_algebra.py"
