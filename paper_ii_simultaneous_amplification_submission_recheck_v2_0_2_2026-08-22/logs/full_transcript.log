 162         "displayed lambda decimal is inaccurate",
 163     )
 164 
 165     # The exact algebraic definitions use the unique root in the rational
 166     # isolating interval.  Substitution modulo the phase polynomial verifies
 167     # the double-root sigma identity without relying on decimals.
 168     sigma_star = (-r**3 + 4 * r**2 - 3 * r - 1) / (2 * (r - 1))
 169     remainder = sp.rem(
 170         sp.together(equality_numerator.subs(sigma, sigma_star)).as_numer_denom()[0],
 171         phase,
 172         domain=sp.QQ,
 173     )
 174     require(remainder == 0, "exact double-root response identity failed")
 175     derivative_remainder = sp.rem(
 176         sp.together(sp.diff(equality_numerator, sigma).subs(sigma, sigma_star)).as_numer_denom()[0],
 177         phase,
 178         domain=sp.QQ,
 179     )
 180     require(
 181         derivative_remainder == 0,
 182         "exact tangency derivative identity failed",
 183     )
 184 
 185     print(f"rational endpoint margins: Bd={endpoint_b}, dB={endpoint_d}")
 186     print(f"rational-edge-family threshold ~{float(rational_threshold):.15g}")
 187     print(f"optimized phase root ~{float(R_decimal):.15g}")
 188     print(f"optimized sigma ~{float(sigma_decimal):.15g}, lambda ~{float(lambda_decimal):.15g}")
