  18 
  19 PROJECT = "universal_simultaneous_amplification"
  20 PAPER = f"{PROJECT}/phase4_landmark_closure/paper_hybrid_threshold"
  21 EPOCH = 1_787_356_800
  22 HEX64 = re.compile(r"[0-9a-f]{64}")
  23 
  24 # This is an exact file whitelist.  No paper directory is included
  25 # recursively, so a future private handoff file or research artifact cannot
  26 # enter the public archive merely by being created under PAPER.
  27 INCLUDE = (
  28     f"{PROJECT}/LICENSE",
  29     f"{PAPER}/README.md",
  30     f"{PAPER}/RELEASE_NOTES.md",
  31     f"{PAPER}/RESEARCH_LOG.md",
