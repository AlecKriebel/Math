   235	def replace_once(path: Path, old: str, new: str) -> None:
   236	    source = path.read_text(encoding="utf-8")
   237	    require(
   238	        source.count(old) == 1,
   239	        f"mutation anchor is not unique in {path}: {old!r}",
   240	    )
   241	    path.write_text(source.replace(old, new, 1), encoding="utf-8")
   242	
   243	
   244	def run_copied_replay(paper: Path) -> subprocess.CompletedProcess[str]:
   245	    environment = os.environ.copy()
   246	    environment.pop("PYTHONOPTIMIZE", None)
   247	    environment["PYTHONDONTWRITEBYTECODE"] = "1"
   248	    environment["PYTHON"] = sys.executable
   249	    return run([str(paper / "replay.sh")], cwd=paper, environment=environment)
   250	
