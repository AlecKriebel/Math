  39 def check_module_responses() -> None:
  40     r, sigma, lam = sp.symbols("r sigma lam", positive=True)
  41     p = (r - 1) / r
  42 
  43     z_bd = sigma * (r**2 - 1)
  44     z_db = 2 * r * (r - 1) / sigma
  45     pair_bd = sp.factor(2 * ((r / (r + 1)) * z_bd / (1 + z_bd) / p - 1))
  46     pair_db = sp.factor(2 * (sp.Rational(1, 2) * z_db / (1 + z_db) / p - 1))
  47     expected_pair_bd = 2 * (sigma - 1) / (1 + sigma * (r**2 - 1))
  48     expected_pair_db = 2 * (r * (2 - r) - sigma) / (
  49         sigma + 2 * r * (r - 1)
  50     )
  51     require(
  52         sp.factor(pair_bd - expected_pair_bd) == 0,
  53         "Bd pair response does not match the claimed formula",
  54     )
  55     require(
  56         sp.factor(pair_db - expected_pair_db) == 0,
  57         "dB pair response does not match the claimed formula",
  58     )
  59 
  60     # A dilute pendant replaces one baseline core start: 1/p-1 for Bd and
  61     # 0/p-1 for dB.
  62     leaf_bd = sp.factor(1 / p - 1)
  63     leaf_db = sp.Integer(-1)
  64     require(
  65         leaf_bd == 1 / (r - 1),
  66         "Bd pendant response does not equal 1/(r-1)",
  67     )
  68 
  69     response_bd = sp.factor(pair_bd + lam * leaf_bd)
  70     response_db = sp.factor(pair_db + lam * leaf_db)
  71     expected_bd = expected_pair_bd + lam / (r - 1)
  72     expected_db = expected_pair_db - lam
  73     require(
  74         sp.factor(response_bd - expected_bd) == 0,
  75         "Bd hybrid response does not reconstruct from pair and pendant terms",
  76     )
  77     require(
  78         sp.factor(response_db - expected_db) == 0,
  79         "dB hybrid response does not reconstruct from pair and pendant terms",
  80     )
  81 
  82 
  83 def check_feasibility_and_tangency() -> None:
  84     r, sigma = sp.symbols("r sigma", positive=True)
  85     phase = r**6 - 8 * r**5 + 22 * r**4 - 30 * r**3 + 21 * r**2 - 6 * r + 1
  86     lower = 2 * (1 - sigma) * (r - 1) / (1 + sigma * (r**2 - 1))
  87     upper = 2 * (r * (2 - r) - sigma) / (sigma + 2 * r * (r - 1))
  88     quadratic = (
  89         (r - 1) * sigma**2
  90         + (r**3 - 4 * r**2 + 3 * r + 1) * sigma
  91         + r * (2 * r - 3)
  92     )
  93     gap_numerator = sp.factor(sp.together(upper - lower).as_numer_denom()[0])
  94     require(
  95         sp.expand(gap_numerator + 2 * r * quadratic) == 0,
  96         "feasibility-gap numerator does not equal the claimed quadratic",
  97     )
  98 
  99     minimizing_sigma = (-r**3 + 4 * r**2 - 3 * r - 1) / (2 * (r - 1))
 100     minimum = sp.factor(quadratic.subs(sigma, minimizing_sigma))
 101     require(
 102         sp.factor(minimum + phase / (4 * (r - 1))) == 0,
 103         "quadratic minimum does not reduce to the phase polynomial",
 104     )
 105 
 106     polynomial = sp.Poly(phase, r, domain=sp.QQ)
 107     require(
 108         polynomial.count_roots(sp.Rational(1), sp.Rational(3, 2)) == 0,
 109         "phase polynomial has an unexpected root in (1,3/2)",
 110     )
 111     require(
 112         polynomial.count_roots(sp.Rational(3, 2), sp.Rational(151, 100)) == 1,
 113         "phase polynomial does not have exactly one root in (3/2,151/100)",
 114     )
 115     require(
