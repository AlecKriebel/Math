   1 #!/usr/bin/env python3
   2 """Optionally compare every archived source blob and mode with a Git checkout."""
   3 
   4 from __future__ import annotations
   5 
   6 import argparse
   7 from pathlib import Path, PurePosixPath
   8 import subprocess
   9 import sys
  10 import tarfile
  11 
  12 
  13 PACKAGE = Path(__file__).resolve().parent
  14 ARCHIVE = PACKAGE / (
  15     "simultaneous_amplifier_beyond_three_halves_"
  16     "source_and_certificates.tar.gz"
  17 )
  18 COMMIT = "03e94e877ce10d9d459fd284bd652934cde08bb3"
  19 TAG_OBJECT = "be3946c051c7f7e2073d6adf81bca31ae750251a"
  20 TAG = "simultaneous-amplification-beyond-three-halves-v2.0.2"
  21 SYNTHETIC = frozenset(
  22     {PurePosixPath("BUNDLE_METADATA.txt"), PurePosixPath("MANIFEST.sha256")}
  23 )
  24 SOURCE_EXECUTABLES = frozenset(
  25     {
  26         PurePosixPath(
  27             "universal_simultaneous_amplification/phase4_landmark_closure/"
  28             "paper_hybrid_threshold/all.sh"
  29         ),
  30         PurePosixPath(
  31             "universal_simultaneous_amplification/phase4_landmark_closure/"
  32             "paper_hybrid_threshold/bootstrap_replay.sh"
  33         ),
  34         PurePosixPath(
  35             "universal_simultaneous_amplification/phase4_landmark_closure/"
  36             "paper_hybrid_threshold/build.sh"
  37         ),
  38         PurePosixPath(
  39             "universal_simultaneous_amplification/phase4_landmark_closure/"
  40             "paper_hybrid_threshold/bundle_manifest.py"
  41         ),
  42         PurePosixPath(
  43             "universal_simultaneous_amplification/phase4_landmark_closure/"
  44             "paper_hybrid_threshold/release_bundle.sh"
  45         ),
  46         PurePosixPath(
  47             "universal_simultaneous_amplification/phase4_landmark_closure/"
  48             "paper_hybrid_threshold/replay.sh"
  49         ),
  50         PurePosixPath(
  51             "universal_simultaneous_amplification/phase4_landmark_closure/"
  52             "paper_hybrid_threshold/verify_paper_claims.py"
  53         ),
  54     }
  55 )
  56 
  57 
  58 class VerificationError(RuntimeError):
  59     """Raised when the supplied Git checkout does not match the handoff."""
  60 
  61 
  62 def require(condition: object, message: str) -> None:
  63     if not bool(condition):
  64         raise VerificationError(message)
  65 
  66 
  67 def reject_optimized_python() -> None:
  68     if sys.flags.optimize != 0:
  69         raise SystemExit(
  70             "ERROR: optimized Python is unsupported for Git-binding verification"
  71         )
  72 
  73 
  74 def expected_source_mode(name: PurePosixPath) -> int:
  75     return 0o755 if name in SOURCE_EXECUTABLES else 0o644
  76 
  77 
  78 def git(repo: Path, *arguments: str) -> bytes:
  79     process = subprocess.run(
  80         ["git", "-C", str(repo), *arguments],
  81         stdout=subprocess.PIPE,
  82         stderr=subprocess.PIPE,
  83         check=False,
  84     )
  85     if process.returncode != 0:
  86         detail = process.stderr.decode("utf-8", errors="replace").strip()
  87         raise VerificationError(
  88             f"git {' '.join(arguments)} failed with status "
  89             f"{process.returncode}: {detail}"
  90         )
  91     return process.stdout
  92 
  93 
  94 def archive_payloads() -> tuple[dict[PurePosixPath, bytes], dict[PurePosixPath, int]]:
  95     payloads: dict[PurePosixPath, bytes] = {}
  96     modes: dict[PurePosixPath, int] = {}
  97     with tarfile.open(ARCHIVE, mode="r:gz") as archive:
  98         members = archive.getmembers()
  99         member_names = [member.name for member in members]
 100         require(
 101             member_names == sorted(member_names),
 102             "source archive members are not sorted",
 103         )
 104         require(
 105             len(member_names) == len(set(member_names)),
 106             "source archive contains duplicate member names",
 107         )
 108         for member in members:
 109             require(member.isfile(), f"non-regular source member: {member.name}")
 110             name = PurePosixPath(member.name)
 111             require(
 112                 not name.is_absolute()
 113                 and ".." not in name.parts
 114                 and name.as_posix() == member.name,
 115                 f"unsafe or noncanonical source member: {member.name}",
 116             )
 117             require(name not in payloads, f"duplicate source member: {member.name}")
 118             require(
 119                 member.mode == expected_source_mode(name),
 120                 f"unexpected source mode {member.mode:#06o}: {member.name}",
 121             )
 122             stream = archive.extractfile(member)
 123             require(stream is not None, f"unreadable source member: {member.name}")
 124             payloads[name] = stream.read()
 125             modes[name] = member.mode
 126     return payloads, modes
 127 
 128 
 129 def verify(repo: Path) -> int:
 130     root = Path(git(repo, "rev-parse", "--show-toplevel").decode().strip()).resolve()
 131     require(root == repo.resolve(), f"not a repository root: {repo}")
 132     require(
 133         git(repo, "cat-file", "-t", TAG).decode().strip() == "tag",
 134         f"{TAG} is not an annotated tag object",
 135     )
 136     require(
 137         git(repo, "rev-parse", TAG).decode().strip() == TAG_OBJECT,
 138         "annotated tag object does not match the frozen record",
 139     )
 140     require(
 141         git(repo, "rev-parse", f"{TAG}^{{commit}}").decode().strip() == COMMIT,
 142         "annotated tag does not peel to the frozen scientific commit",
 143     )
 144     tag_text = git(repo, "cat-file", "-p", TAG_OBJECT).decode(
 145         "utf-8", errors="strict"
 146     )
 147     require(
 148         tag_text.startswith(f"object {COMMIT}\ntype commit\n"),
 149         "annotated tag payload names a different object",
 150     )
 151 
 152     payloads, archive_modes = archive_payloads()
 153     repository_payloads = sorted(set(payloads) - SYNTHETIC, key=lambda p: p.as_posix())
 154     require(repository_payloads, "source archive has no repository-backed payloads")
 155     for name in repository_payloads:
 156         raw_tree = git(repo, "ls-tree", COMMIT, "--", name.as_posix()).decode(
 157             "utf-8", errors="strict"
 158         )
 159         rows = raw_tree.splitlines()
 160         require(len(rows) == 1, f"Git tree lacks a unique entry for {name}")
 161         metadata, tree_name = rows[0].split("\t", 1)
 162         mode, object_type, _object_id = metadata.split(" ", 2)
 163         require(tree_name == name.as_posix(), f"Git returned a different path for {name}")
 164         require(object_type == "blob", f"Git entry is not a blob: {name}")
 165         expected_mode = "100755" if archive_modes[name] == 0o755 else "100644"
 166         require(mode == expected_mode, f"Git/archive mode mismatch for {name}")
 167         repository_bytes = git(repo, "show", f"{COMMIT}:{name.as_posix()}")
 168         require(
 169             repository_bytes == payloads[name],
 170             f"Git/archive byte mismatch for {name}",
 171         )
 172     return len(repository_payloads)
 173 
 174 
 175 def main() -> None:
 176     reject_optimized_python()
 177     parser = argparse.ArgumentParser(description=__doc__)
 178     parser.add_argument(
 179         "--repo",
 180         required=True,
 181         type=Path,
 182         help="independently obtained repository root containing the frozen tag",
 183     )
 184     arguments = parser.parse_args()
 185     count = verify(arguments.repo.resolve())
 186     print(
 187         f"PASS: annotated unsigned tag and {count} archived source blobs/modes "
 188         "match the supplied Git checkout"
 189     )
 190     print(
 191         "LIMITATION: this comparison does not authenticate the unsigned tag, "
 192         "the checkout, or repository authorship"
 193     )
 194 
 195 
 196 if __name__ == "__main__":
 197     main()
