  28 "$python" "$paper_dir/certificates/verify_hybrid_coefficients.py"
  29 "$python" "$paper_dir/verify_paper_claims.py"
  30 
  31 echo "PASS: Paper II verifier replay complete"
===== release_bundle.sh =====
   1 #!/bin/sh
   2 set -eu
   3 
   4 paper_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
   5 repo_root=$(CDPATH= cd -- "$paper_dir/../../.." && pwd)
   6 project_root=$(CDPATH= cd -- "$paper_dir/../.." && pwd)
   7 default_output="$paper_dir/output/release/simultaneous_amplifier_beyond_three_halves_source_and_certificates.tar.gz"
   8 output=${1:-"$default_output"}
   9 
  10 if [ -n "${PYTHON:-}" ]; then
  11   python=$PYTHON
  12 elif [ -x "$project_root/.venv-paper2/bin/python" ]; then
  13   python="$project_root/.venv-paper2/bin/python"
  14 elif [ -n "${BOOTSTRAP_PYTHON:-}" ]; then
  15   python=$BOOTSTRAP_PYTHON
  16 else
  17   python=python3
  18 fi
  19 
  20 "$python" -c '
  21 import sys
  22 if sys.version_info[:3] != (3, 14, 6):
  23     raise SystemExit(f"Python 3.14.6 is required; found {sys.version}")
  24 '
  25 export PYTHONDONTWRITEBYTECODE=1
  26 
  27 case "$output" in
  28   /*) ;;
  29   *) output="$PWD/$output" ;;
  30 esac
  31 
  32 mkdir -p "$(dirname -- "$output")"
  33 PYTHON="$python" "$paper_dir/replay.sh"
  34 "$paper_dir/build.sh" >/dev/null
  35 "$python" "$paper_dir/bundle_manifest.py" \
  36   --repo-root "$repo_root" \
  37   --output "$output"
===== build.sh =====
   1 #!/bin/sh
   2 set -eu
   3 
   4 paper_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
   5 tmp_dir="$paper_dir/tmp/pdfs"
   6 out_dir="$paper_dir/output/pdf"
   7 render_dir="$paper_dir/output/rendered"
   8 
   9 mkdir -p "$tmp_dir" "$out_dir" "$render_dir"
  10 export SOURCE_DATE_EPOCH=1787356800
  11 export FORCE_SOURCE_DATE=1
  12 export TZ=UTC
  13 
  14 tectonic --keep-logs --keep-intermediates \
  15   --outdir "$tmp_dir" "$paper_dir/main.tex"
  16 install -m 0644 "$tmp_dir/main.pdf" \
  17   "$out_dir/simultaneous_amplification_beyond_three_halves.pdf"
  18 pdfinfo "$out_dir/simultaneous_amplification_beyond_three_halves.pdf"
  19 find "$render_dir" -type f -name 'page-*.png' -delete
  20 pdftoppm -png -r 150 \
  21   "$out_dir/simultaneous_amplification_beyond_three_halves.pdf" \
  22   "$render_dir/page" >/dev/null 2>&1
