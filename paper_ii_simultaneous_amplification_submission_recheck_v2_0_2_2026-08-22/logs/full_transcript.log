   166  
   167      with tarfile.open(archive_path, mode="r:gz") as archive:
   168          members = archive.getmembers()
   169          names = [member.name for member in members]
   170          if names != sorted(names) or len(names) != len(set(names)):
   171              raise RuntimeError("source archive members are not unique and sorted")
   172          if any(not member.isfile() for member in members):
   173              raise RuntimeError("source archive contains a non-regular member")
   174          for member in members:
   175              name = PurePosixPath(member.name)
   176              if (
   177                  name.is_absolute()
   178                  or ".." in name.parts
   179                  or name.as_posix() != member.name
   180              ):
   181                  raise RuntimeError(f"unsafe source archive member: {member.name}")
   182              required_mode = expected_source_mode(name)
