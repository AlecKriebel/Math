   232	            unix_mode = (info.external_attr >> 16) & 0o170000
   233	            require(unix_mode != stat.S_IFLNK, f"wheel symlink: {info.filename}")
   234	        dist_info = f"{expected_name}-{expected_version}.dist-info"
   235	        metadata_name = f"{dist_info}/METADATA"
   236	        wheel_name = f"{dist_info}/WHEEL"
   237	        record_name = f"{dist_info}/RECORD"
   238	        require(metadata_name in names, f"missing METADATA: {path.name}")
   239	        require(wheel_name in names, f"missing WHEEL: {path.name}")
   240	        require(record_name in names, f"missing RECORD: {path.name}")
   241	        metadata = wheel.read(metadata_name).decode("utf-8")
