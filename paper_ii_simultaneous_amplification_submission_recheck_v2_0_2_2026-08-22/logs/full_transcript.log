    83	def check_feasibility_and_tangency() -> None:
    84	    r, sigma = sp.symbols("r sigma", positive=True)
    85	    phase = r**6 - 8 * r**5 + 22 * r**4 - 30 * r**3 + 21 * r**2 - 6 * r + 1
    86	    lower = 2 * (1 - sigma) * (r - 1) / (1 + sigma * (r**2 - 1))
    87	    upper = 2 * (r * (2 - r) - sigma) / (sigma + 2 * r * (r - 1))
    88	    quadratic = (
    89	        (r - 1) * sigma**2
    90	        + (r**3 - 4 * r**2 + 3 * r + 1) * sigma
    91	        + r * (2 * r - 3)
    92	    )
    93	    gap_numerator = sp.factor(sp.together(upper - lower).as_numer_denom()[0])
    94	    require(
    95	        sp.expand(gap_numerator + 2 * r * quadratic) == 0,
    96	        "feasibility-gap numerator does not equal the claimed quadratic",
    97	    )
    98	
    99	    minimizing_sigma = (-r**3 + 4 * r**2 - 3 * r - 1) / (2 * (r - 1))
   100	    minimum = sp.factor(quadratic.subs(sigma, minimizing_sigma))
   101	    require(
   102	        sp.factor(minimum + phase / (4 * (r - 1))) == 0,
   103	        "quadratic minimum does not reduce to the phase polynomial",
   104	    )
   105	
   106	    polynomial = sp.Poly(phase, r, domain=sp.QQ)
   107	    require(
   108	        polynomial.count_roots(sp.Rational(1), sp.Rational(3, 2)) == 0,
   109	        "phase polynomial has an unexpected root in (1,3/2)",
   110	    )
   111	    require(
   112	        polynomial.count_roots(sp.Rational(3, 2), sp.Rational(151, 100)) == 1,
   113	        "phase polynomial does not have exactly one root in (3/2,151/100)",
   114	    )
   115	    require(
   116	        phase.subs(r, sp.Rational(3, 2)) == sp.Rational(1, 64),
   117	        "phase-polynomial value at 3/2 is not 1/64",
   118	    )
   119	    require(
   120	        phase.subs(r, sp.Rational(151, 100))
   121	        == -sp.Rational(39866792399, 10**12),
   122	        "phase-polynomial value at 151/100 is incorrect",
   123	    )
