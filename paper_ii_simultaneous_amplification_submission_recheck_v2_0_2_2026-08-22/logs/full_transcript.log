     1  #!/usr/bin/env python3
     2  """Exact algebra certificate for the dilute pair--leaf hybrid threshold."""
     3  
     4  from __future__ import annotations
     5  
     6  import sys
     7  
     8  import sympy as sp
     9  
    10  
    11  r, sigma = sp.symbols("r sigma", positive=True)
    12  p = r**6 - 8*r**5 + 22*r**4 - 30*r**3 + 21*r**2 - 6*r + 1
    13  
    14  
    15  def require(condition: object, message: str) -> None:
    16      if not bool(condition):
    17          raise RuntimeError(message)
    18  
    19  
    20  def reject_optimized_python() -> None:
    21      if sys.flags.optimize != 0:
    22          raise RuntimeError("optimized Python is not permitted for certificate replay")
    23  
    24  
    25  def main() -> None:
    26      reject_optimized_python()
    27      polynomial = sp.Poly(p, r, domain=sp.QQ)
    28      require(
    29          polynomial.count_roots(sp.Rational(1), sp.Rational(3, 2)) == 0,
    30          "sextic unexpectedly has a root below 3/2",
    31      )
    32      require(
    33          polynomial.count_roots(sp.Rational(3, 2), sp.Rational(151, 100)) == 1,
    34          "sextic root count on (3/2,151/100) is not one",
    35      )
    36      require(
    37          p.subs(r, sp.Rational(3, 2)) == sp.Rational(1, 64),
    38          "sextic value at 3/2 is incorrect",
    39      )
    40      require(
    41          p.subs(r, sp.Rational(151, 100))
    42          == -sp.Rational(39866792399, 10**12),
    43          "sextic value at 151/100 is incorrect",
    44      )
    45      root = sp.CRootOf(polynomial, 0)
    46      require(
    47          sp.Rational(3, 2) < root < sp.Rational(151, 100),
    48          "isolated sextic root lies outside the claimed interval",
    49      )
    50  
    51      lower = 2 * (1 - sigma) * (r - 1) / (1 + sigma * (r**2 - 1))
    52      upper = 2 * (r * (2 - r) - sigma) / (sigma + 2 * r * (r - 1))
    53      gap_numerator = sp.factor(sp.together(upper - lower).as_numer_denom()[0])
    54      expected = -2 * r * (
    55          (r - 1) * sigma**2
    56          + (r**3 - 4 * r**2 + 3 * r + 1) * sigma
    57          + r * (2 * r - 3)
    58      )
    59      require(
    60          sp.expand(gap_numerator - expected) == 0,
    61          "response-gap numerator identity failed",
    62      )
    63  
    64      minimizing_sigma = sp.factor(
    65          -(r**3 - 4 * r**2 + 3 * r + 1) / (2 * (r - 1))
    66      )
    67      quadratic = -gap_numerator / (2 * r)
    68      minimum = sp.factor(quadratic.subs(sigma, minimizing_sigma))
    69      require(
    70          sp.simplify(minimum + p / (4 * (r - 1))) == 0,
    71          "quadratic minimum identity failed",
    72      )
    73  
    74      sigma_star = sp.cancel(minimizing_sigma.subs(r, root))
    75      lambda_star = sp.cancel(lower.subs({r: root, sigma: sigma_star}))
    76      # The exact minimum identity above and p(root)=0 prove L=U at this
    77      # algebraic pair.  Positivity follows throughout the isolating interval:
    78      # neither the numerator of sigma_* nor that of 1-sigma_* has a root
    79      # there, and both are positive at 3/2.
    80      sigma_numerator = -r**3 + 4 * r**2 - 3 * r - 1
    81      one_minus_numerator = 2 * (r - 1) - sigma_numerator
    82      interval_left, interval_right = sp.Rational(3, 2), sp.Rational(151, 100)
    83      for numerator in (sigma_numerator, one_minus_numerator):
    84          require(
    85              sp.Poly(numerator, r).count_roots(interval_left, interval_right) == 0,
    86              f"parameter-positivity numerator has an interval root: {numerator}",
    87          )
    88          require(
    89              numerator.subs(r, interval_left) > 0,
    90              f"parameter-positivity numerator is nonpositive at 3/2: {numerator}",
    91          )
    92  
    93      # For fixed sigma_star, L is increasing and U decreasing throughout the
    94      # relevant interval.  The factored derivatives make both signs exact.
    95      derivative_lower = sp.factor(sp.diff(lower, r))
    96      derivative_upper = sp.factor(sp.diff(upper, r))
    97      expected_lower_derivative = (
    98          2
    99          * (sigma - 1)
   100          * (r**2 * sigma - 2 * r * sigma + sigma - 1)
   101          / (r**2 * sigma - sigma + 1) ** 2
   102      )
   103      expected_upper_derivative = 4 * r * (-r + sigma) / (2 * r**2 - 2 * r + sigma) ** 2
   104      require(
   105          sp.simplify(derivative_lower - expected_lower_derivative) == 0,
   106          "lower-response derivative identity failed",
   107      )
   108      require(
   109          sp.simplify(derivative_upper - expected_upper_derivative) == 0,
   110          "upper-response derivative identity failed",
   111      )
   112  
   113      print(f"R_hyb~{sp.N(root, 18)}")
   114      print(f"sigma_*~{sp.N(sigma_star, 18)}")
   115      print(f"lambda_*~{sp.N(lambda_star, 18)}")
   116      print("PASS exact sextic threshold, tangency, and monotonicity algebra")
   117  
   118  
   119  if __name__ == "__main__":
   120      main()
===== certificates/verify_hybrid_lumping.py =====
     1  #!/usr/bin/env python3
     2  """Exact labelled audit of the five-coordinate hybrid lumping.
     3  
     4  This implementation does not import the discovery solver.  It constructs a
     5  small labelled graph, enumerates every Bd source--target and dB death--parent
     6  event over ``Fraction``, aggregates by the orbit label, and compares with an
     7  independently written formula for ``(h,i,u,v,l)`` transitions.
     8  """
     9  
    10  from __future__ import annotations
    11  
    12  from fractions import Fraction as F
    13  from itertools import combinations
    14  import sys
    15  
    16  
    17  R = F(3, 2)
    18  CORE, PAIRS, PENDANTS = 3, 2, 2
    19  SIGMA, EPSILON = F(19, 137), F(1, 100)
    20  PAIR_WEIGHT = F(CORE, 1) / SIGMA
    21  
    22  
    23  class VerificationError(RuntimeError):
    24      """Raised when a labelled transition row fails to lump exactly."""
    25  
    26  
    27  def require(condition: object, message: str) -> None:
    28      """Fail closed without relying on optimization-sensitive assertions."""
    29      if not bool(condition):
    30          raise VerificationError(message)
    31  
    32  
    33  def reject_optimized_python() -> None:
    34      if sys.flags.optimize != 0:
    35          raise SystemExit(
    36              "ERROR: optimized Python is unsupported because verification "
    37              "checks must remain active"
    38          )
    39  
    40  
    41  def graph():
    42      n = CORE + 2 * PAIRS + PENDANTS
    43      weights = [[F(0) for _ in range(n)] for _ in range(n)]
    44      for a, b in combinations(range(CORE), 2):
    45          weights[a][b] = weights[b][a] = F(1)
    46      offset = CORE
    47      for pair in range(PAIRS):
    48          left, right = offset + 2 * pair, offset + 2 * pair + 1
    49          weights[left][right] = weights[right][left] = PAIR_WEIGHT
    50          for vertex in (left, right):
    51              for core in range(CORE):
    52                  weights[vertex][core] = weights[core][vertex] = EPSILON
    53      offset += 2 * PAIRS
    54      for pendant in range(PENDANTS):
    55          vertex = offset + pendant
    56          weights[0][vertex] = weights[vertex][0] = F(1)
    57      return weights
    58  
    59  
    60  def label(mask: int):
    61      h = (mask >> 0) & 1
    62      i = sum((mask >> vertex) & 1 for vertex in range(1, CORE))
    63      u = v = 0
    64      offset = CORE
    65      for pair in range(PAIRS):
    66          count = ((mask >> (offset + 2 * pair)) & 1) + ((mask >> (offset + 2 * pair + 1)) & 1)
    67          u += count == 1
    68          v += count == 2
    69      offset += 2 * PAIRS
    70      l = sum((mask >> (offset + pendant)) & 1 for pendant in range(PENDANTS))
    71      return h, i, u, v, l
    72  
    73  
    74  def add(row, target, value):
    75      if value:
    76          row[target] = row.get(target, F(0)) + value
    77  
    78  
    79  def labelled(mask: int, rule: str):
    80      weights = graph()
    81      n = len(weights)
    82      mutant = [bool(mask & (1 << vertex)) for vertex in range(n)]
    83      fitness = [R if kind else F(1) for kind in mutant]
    84      row = {}
    85      if rule == "Bd":
    86          total = sum(fitness, F(0))
    87          degree = [sum(values, F(0)) for values in weights]
    88          for parent in range(n):
    89              for target in range(n):
    90                  if weights[parent][target] and mutant[parent] != mutant[target]:
    91                      probability = fitness[parent] / total * weights[parent][target] / degree[parent]
    92                      add(row, label(mask ^ (1 << target)), probability)
    93      elif rule == "dB":
    94          for target in range(n):
    95              denominator = sum(
    96                  (fitness[parent] * weights[parent][target] for parent in range(n)), F(0)
    97              )
    98              for parent in range(n):
    99                  if weights[parent][target] and mutant[parent] != mutant[target]:
   100                      probability = F(1, n) * fitness[parent] * weights[parent][target] / denominator
   101                      add(row, label(mask ^ (1 << target)), probability)
   102      else:
   103          raise ValueError(rule)
   104      return row
   105  
   106  
   107  def declared(state, rule: str):
   108      h, i, u, v, l = state
   109      c, q, k = CORE - 1, PAIRS, PENDANTS
   110      n0 = q - u - v
   111      mp = u + 2 * v
   112      rp = 2 * q - mp
   113      W, e = PAIR_WEIGHT, EPSILON
   114      dh, do, dp = F(c) + 2 * q * e + k, F(c) + 2 * q * e, W + CORE * e
   115      row = {}
   116      if rule == "Bd":
   117          scale = 1 / (F(CORE + 2 * q + k) + (R - 1) * (h + i + mp + l))
   118          if h == 0:
   119              add(row, (1, i, u, v, l), scale * R * (F(i, 1) / do + mp * e / dp + l))
   120          else:
   121              add(row, (0, i, u, v, l), scale * (F(c - i, 1) / do + rp * e / dp + k - l))
   122          if i < c:
   123              add(row, (h, i + 1, u, v, l), scale * R * (c - i) * (F(h, 1) / dh + F(i, 1) / do + mp * e / dp))
   124          if i:
   125              add(row, (h, i - 1, u, v, l), scale * i * (F(1 - h, 1) / dh + F(c - i, 1) / do + rp * e / dp))
   126          mb = e * (F(h, 1) / dh + F(i, 1) / do)
   127          rb = e * (F(1 - h, 1) / dh + F(c - i, 1) / do)
   128          if n0:
   129              add(row, (h, i, u + 1, v, l), scale * R * 2 * n0 * mb)
   130          if u:
   131              add(row, (h, i, u - 1, v + 1, l), scale * R * u * (mb + W / dp))
   132              add(row, (h, i, u - 1, v, l), scale * u * (rb + W / dp))
   133          if v:
   134              add(row, (h, i, u + 1, v - 1, l), scale * 2 * v * rb)
   135          if h and l < k:
   136              add(row, (h, i, u, v, l + 1), scale * R * (k - l) / dh)
   137          if not h and l:
   138              add(row, (h, i, u, v, l - 1), scale * l / dh)
   139      elif rule == "dB":
   140          scale = F(1, CORE + 2 * q + k)
   141          mm, rm = i + mp * e + l, c - i + rp * e + k - l
   142          if h == 0 and mm:
   143              add(row, (1, i, u, v, l), scale * R * mm / (R * mm + rm))
   144          if h == 1 and rm:
   145              add(row, (0, i, u, v, l), scale * rm / (R * mm + rm))
   146          if i < c:
   147              mm = h + i + mp * e; rm = do - mm
   148              add(row, (h, i + 1, u, v, l), scale * (c - i) * R * mm / (R * mm + rm))
   149          if i:
   150              mm = h + i - 1 + mp * e; rm = do - mm
   151              add(row, (h, i - 1, u, v, l), scale * i * rm / (R * mm + rm))
   152          mb, rb = e * (h + i), e * (CORE - h - i)
   153          if n0 and mb:
   154              add(row, (h, i, u + 1, v, l), scale * 2 * n0 * R * mb / (R * mb + W + rb))
   155          if u:
   156              add(row, (h, i, u - 1, v + 1, l), scale * u * R * (W + mb) / (R * (W + mb) + rb))
   157              add(row, (h, i, u - 1, v, l), scale * u * (W + rb) / (R * mb + W + rb))
   158          if v and rb:
   159              add(row, (h, i, u + 1, v - 1, l), scale * 2 * v * rb / (R * (W + mb) + rb))
   160          if h and l < k:
   161              add(row, (h, i, u, v, l + 1), scale * (k - l))
   162          if not h and l:
   163              add(row, (h, i, u, v, l - 1), scale * l)
   164      else:
   165          raise ValueError(rule)
   166      return row
   167  
   168  
   169  def main():
   170      reject_optimized_python()
   171      n = CORE + 2 * PAIRS + PENDANTS
   172      fibres = {}
   173      for mask in range(1 << n):
   174          fibres.setdefault(label(mask), []).append(mask)
   175      for rule in ("Bd", "dB"):
   176          for state, masks in fibres.items():
   177              expected = declared(state, rule)
   178              for mask in masks:
   179                  actual = labelled(mask, rule)
   180                  require(
   181                      actual == expected,
   182                      "labelled row mismatch for "
   183                      f"rule={rule}, state={state}, mask={mask}: "
   184                      f"actual={actual}, expected={expected}",
   185                  )
   186      print(f"PASS exact labelled hybrid lumping: n={n}, masks={1<<n}, fibres={len(fibres)}")
   187  
   188  
   189  if __name__ == "__main__":
   190      main()
===== certificates/verify_hybrid_coefficients.py =====
     1  #!/usr/bin/env python3
     2  """Exact symbolic audit of the dilute hybrid correction coefficients."""
     3  
     4  from __future__ import annotations
     5  
     6  import sys
     7  
     8  import sympy as sp
     9  
    10  
    11  def require(condition: object, message: str) -> None:
    12      if not bool(condition):
    13          raise RuntimeError(message)
    14  
    15  
    16  def reject_optimized_python() -> None:
    17      if sys.flags.optimize != 0:
    18          raise RuntimeError("optimized Python is not permitted for certificate replay")
    19  
    20  
    21  def sturm_count(poly, variable, left, right):
    22      sequence = sp.sturm(poly, variable)
    23  
    24      def variations(point):
    25          signs = []
    26          for entry in sequence:
    27              value = sp.sign(entry.subs(variable, point))
    28              require(
    29                  value in (-1, 0, 1),
    30                  f"non-real or indeterminate Sturm sign at {point}: {value}",
    31              )
    32              if value:
    33                  signs.append(int(value))
    34          return sum(a != b for a, b in zip(signs, signs[1:]))
    35  
    36      return variations(left) - variations(right)
    37  
    38  
    39  def main():
    40      reject_optimized_python()
    41      r, sigma, lam = sp.symbols("r sigma lam", positive=True)
    42      p = (r - 1) / r
    43  
    44      # Direct rare-invasion rates after the common positive factors are
    45      # removed.  The K2-local establishment probabilities are r/(r+1) for Bd
    46      # and 1/2 for dB.
    47      A_b, D_b = 2 * sigma * (r - 1), 2 / (r + 1)
    48      pi_b = sp.factor(A_b / (A_b + D_b))
    49      A_d, D_d = 2 * (r - 1), sigma / r
    50      pi_d = sp.factor(A_d / (A_d + D_d))
    51  
    52      F_b = sp.factor(-2 + 2 * (r / (r + 1)) * pi_b / p)
    53      F_d = sp.factor(-2 + pi_d / p)
    54      expected_b = 2 * (sigma - 1) / (1 + sigma * (r**2 - 1))
    55      expected_d = 2 * (r * (2 - r) - sigma) / (
    56          sigma + 2 * r * (r - 1)
    57      )
    58      require(sp.factor(F_b - expected_b) == 0, "Bd pair response identity failed")
    59      require(sp.factor(F_d - expected_d) == 0, "dB pair response identity failed")
    60  
    61      G_b = sp.factor(F_b + lam / (r - 1))
    62      G_d = sp.factor(F_d - lam)
    63      lower = sp.factor(-(r - 1) * F_b)
    64      upper = sp.factor(F_d)
    65      require(
    66          sp.factor(G_b - (lam - lower) / (r - 1)) == 0,
    67          "Bd admissible-lambda identity failed",
    68      )
    69      require(
    70          sp.factor(G_d - (upper - lam)) == 0,
    71          "dB admissible-lambda identity failed",
    72      )
    73  
    74      # A family with entirely rational edge weights already crosses 3/2.
    75      rational_sigma, rational_lam = sp.Rational(19, 137), sp.Rational(20, 27)
    76      endpoint_b = sp.factor(G_b.subs({r: sp.Rational(3, 2), sigma: rational_sigma, lam: rational_lam}))
