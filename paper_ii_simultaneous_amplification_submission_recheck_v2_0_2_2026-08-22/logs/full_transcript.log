   246	        require("Tag: py3-none-any" in wheel_metadata, f"wrong wheel tag: {path.name}")
   247	
   248	        rows = list(csv.reader(io.StringIO(wheel.read(record_name).decode("utf-8"))))
   249	        record_paths: set[str] = set()
   250	        for row_number, row in enumerate(rows, 1):
   251	            require(len(row) == 3, f"RECORD row shape {path.name}:{row_number}")
