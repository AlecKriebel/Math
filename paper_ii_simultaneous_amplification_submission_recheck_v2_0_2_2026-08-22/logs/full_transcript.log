   129	def verify(repo: Path) -> int:
   130	    root = Path(git(repo, "rev-parse", "--show-toplevel").decode().strip()).resolve()
   131	    require(root == repo.resolve(), f"not a repository root: {repo}")
   132	    require(
   133	        git(repo, "cat-file", "-t", TAG).decode().strip() == "tag",
   134	        f"{TAG} is not an annotated tag object",
   135	    )
   136	    require(
   137	        git(repo, "rev-parse", TAG).decode().strip() == TAG_OBJECT,
   138	        "annotated tag object does not match the frozen record",
   139	    )
   140	    require(
   141	        git(repo, "rev-parse", f"{TAG}^{{commit}}").decode().strip() == COMMIT,
   142	        "annotated tag does not peel to the frozen scientific commit",
   143	    )
   144	    tag_text = git(repo, "cat-file", "-p", TAG_OBJECT).decode(
   145	        "utf-8", errors="strict"
   146	    )
   147	    require(
   148	        tag_text.startswith(f"object {COMMIT}\ntype commit\n"),
   149	        "annotated tag payload names a different object",
   150	    )
   151	
   152	    payloads, archive_modes = archive_payloads()
   153	    repository_payloads = sorted(set(payloads) - SYNTHETIC, key=lambda p: p.as_posix())
   154	    require(repository_payloads, "source archive has no repository-backed payloads")
   155	    for name in repository_payloads:
   156	        raw_tree = git(repo, "ls-tree", COMMIT, "--", name.as_posix()).decode(
   157	            "utf-8", errors="strict"
   158	        )
   159	        rows = raw_tree.splitlines()
   160	        require(len(rows) == 1, f"Git tree lacks a unique entry for {name}")
   161	        metadata, tree_name = rows[0].split("\t", 1)
   162	        mode, object_type, _object_id = metadata.split(" ", 2)
   163	        require(tree_name == name.as_posix(), f"Git returned a different path for {name}")
   164	        require(object_type == "blob", f"Git entry is not a blob: {name}")
   165	        expected_mode = "100755" if archive_modes[name] == 0o755 else "100644"
   166	        require(mode == expected_mode, f"Git/archive mode mismatch for {name}")
   167	        repository_bytes = git(repo, "show", f"{COMMIT}:{name.as_posix()}")
   168	        require(
   169	            repository_bytes == payloads[name],
   170	            f"Git/archive byte mismatch for {name}",
   171	        )
   172	    return len(repository_payloads)
