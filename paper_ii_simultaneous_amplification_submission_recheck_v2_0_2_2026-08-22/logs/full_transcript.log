   252	def check_mutation_failure_propagation() -> None:
   253	    with tempfile.TemporaryDirectory(prefix="paper2-fail-closed-") as temporary:
   254	        temporary_root = Path(temporary)
   255	
   256	        early = copy_replay_tree(temporary_root / "early")
   257	        replace_once(
   258	            early / "certificates/verify_leading_algebra.py",
   259	            "39866792399",
   260	            "39866792398",
   261	        )
   262	        early_result = run_copied_replay(early)
   263	        require_failure_without_sentinel(
   264	            early_result,
   265	            REPLAY_SENTINEL,
   266	            "early mathematical mutation replay",
   267	        )
   268	        early_output = output_of(early_result)
   269	        for _, sentinel in CERTIFIERS:
   270	            require(
   271	                sentinel not in early_output,
   272	                "early mutation did not stop before certificate success output: "
   273	                f"{sentinel}",
   274	            )
   275	
   276	        late = copy_replay_tree(temporary_root / "late")
   277	        replace_once(
   278	            late / "verify_paper_claims.py",
   279	            '"fitness-independent",',
   280	            '"fitness-independent-MUTATED",',
   281	        )
   282	        late_result = run_copied_replay(late)
   283	        require_failure_without_sentinel(
   284	            late_result,
   285	            REPLAY_SENTINEL,
   286	            "late integration mutation replay",
   287	        )
   288	        late_output = output_of(late_result)
   289	        require(
   290	            CERTIFIERS[2][1] in late_output,
