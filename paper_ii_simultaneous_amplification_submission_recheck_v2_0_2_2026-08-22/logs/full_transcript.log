   262	                    digest == f"sha256={wheel_record_digest(member_data)}",
   263	                    f"RECORD digest mismatch: {member_name}",
   264	                )
   265	                require(size == str(len(member_data)), f"RECORD size mismatch: {member_name}")
   266	        require(record_paths == set(names), f"RECORD/member set mismatch: {path.name}")
   267	        require(
