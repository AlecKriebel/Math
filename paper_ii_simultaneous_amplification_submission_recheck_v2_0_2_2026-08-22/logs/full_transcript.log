    37  class RegressionError(RuntimeError):
    38      """Raised when a verifier fails to fail closed."""
    39  
    40  
    41  def require(condition: object, message: str) -> None:
    42      if not bool(condition):
    43          raise RegressionError(message)
    44  
    45  
    46  def reject_optimized_python() -> None:
    47      if sys.flags.optimize != 0:
    48          raise SystemExit(
    49              "ERROR: optimized Python is unsupported because regression "
    50              "checks must remain active"
    51          )
    52  
    53  
    54  def run(
    55      command: list[str],
    56      *,
    57      cwd: Path,
    58      environment: dict[str, str] | None = None,
    59  ) -> subprocess.CompletedProcess[str]:
    60      return subprocess.run(
    61          command,
    62          cwd=cwd,
    63          env=environment,
    64          text=True,
    65          stdout=subprocess.PIPE,
    66          stderr=subprocess.STDOUT,
    67          check=False,
    68          timeout=120,
    69      )
    70  
    71  
    72  def output_of(process: subprocess.CompletedProcess[str]) -> str:
    73      return process.stdout or ""
    74  
    75  
    76  def require_success(
    77      process: subprocess.CompletedProcess[str], sentinel: str, label: str
    78  ) -> None:
    79      output = output_of(process)
    80      require(
    81          process.returncode == 0,
    82          f"{label} unexpectedly failed with status {process.returncode}:\n{output}",
    83      )
    84      require(sentinel in output, f"{label} omitted its success sentinel:\n{output}")
    85  
    86  
    87  def require_failure_without_sentinel(
    88      process: subprocess.CompletedProcess[str], sentinel: str, label: str
    89  ) -> None:
    90      output = output_of(process)
    91      require(process.returncode != 0, f"{label} unexpectedly exited successfully")
    92      require(
    93          sentinel not in output,
    94          f"{label} printed a false success sentinel after failure:\n{output}",
    95      )
