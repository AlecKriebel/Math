   1 #!/usr/bin/env python3
   2 """Exact symbolic audit of the dilute hybrid correction coefficients."""
   3 
   4 from __future__ import annotations
   5 
   6 import sys
   7 
   8 import sympy as sp
   9 
  10 
  11 def require(condition: object, message: str) -> None:
  12     if not bool(condition):
  13         raise RuntimeError(message)
  14 
  15 
  16 def reject_optimized_python() -> None:
  17     if sys.flags.optimize != 0:
  18         raise RuntimeError("optimized Python is not permitted for certificate replay")
  19 
  20 
  21 def sturm_count(poly, variable, left, right):
  22     sequence = sp.sturm(poly, variable)
  23 
  24     def variations(point):
  25         signs = []
  26         for entry in sequence:
  27             value = sp.sign(entry.subs(variable, point))
  28             require(
  29                 value in (-1, 0, 1),
  30                 f"non-real or indeterminate Sturm sign at {point}: {value}",
  31             )
  32             if value:
  33                 signs.append(int(value))
  34         return sum(a != b for a, b in zip(signs, signs[1:]))
  35 
  36     return variations(left) - variations(right)
  37 
  38 
  39 def main():
  40     reject_optimized_python()
  41     r, sigma, lam = sp.symbols("r sigma lam", positive=True)
  42     p = (r - 1) / r
  43 
  44     # Direct rare-invasion rates after the common positive factors are
  45     # removed.  The K2-local establishment probabilities are r/(r+1) for Bd
  46     # and 1/2 for dB.
  47     A_b, D_b = 2 * sigma * (r - 1), 2 / (r + 1)
  48     pi_b = sp.factor(A_b / (A_b + D_b))
  49     A_d, D_d = 2 * (r - 1), sigma / r
  50     pi_d = sp.factor(A_d / (A_d + D_d))
  51 
  52     F_b = sp.factor(-2 + 2 * (r / (r + 1)) * pi_b / p)
  53     F_d = sp.factor(-2 + pi_d / p)
  54     expected_b = 2 * (sigma - 1) / (1 + sigma * (r**2 - 1))
  55     expected_d = 2 * (r * (2 - r) - sigma) / (
  56         sigma + 2 * r * (r - 1)
  57     )
  58     require(sp.factor(F_b - expected_b) == 0, "Bd pair response identity failed")
  59     require(sp.factor(F_d - expected_d) == 0, "dB pair response identity failed")
  60 
  61     G_b = sp.factor(F_b + lam / (r - 1))
  62     G_d = sp.factor(F_d - lam)
  63     lower = sp.factor(-(r - 1) * F_b)
  64     upper = sp.factor(F_d)
  65     require(
  66         sp.factor(G_b - (lam - lower) / (r - 1)) == 0,
  67         "Bd admissible-lambda identity failed",
  68     )
  69     require(
  70         sp.factor(G_d - (upper - lam)) == 0,
  71         "dB admissible-lambda identity failed",
  72     )
  73 
  74     # A family with entirely rational edge weights already crosses 3/2.
  75     rational_sigma, rational_lam = sp.Rational(19, 137), sp.Rational(20, 27)
  76     endpoint_b = sp.factor(G_b.subs({r: sp.Rational(3, 2), sigma: rational_sigma, lam: rational_lam}))
  77     endpoint_d = sp.factor(G_d.subs({r: sp.Rational(3, 2), sigma: rational_sigma, lam: rational_lam}))
  78     require(
  79         endpoint_b == sp.Rational(232, 17361),
  80         "rational Bd endpoint margin is incorrect",
  81     )
  82     require(
  83         endpoint_d == sp.Rational(65, 12123),
  84         "rational dB endpoint margin is incorrect",
  85     )
  86     rational_b = sp.factor(G_b.subs({sigma: rational_sigma, lam: rational_lam}))
  87     rational_d = sp.factor(G_d.subs({sigma: rational_sigma, lam: rational_lam}))
  88     require(
  89         sp.factor(
  90             rational_b
  91             - 4
  92             * (95 * r**2 - 1593 * r + 2183)
  93             / (27 * (r - 1) * (19 * r**2 + 118))
  94         )
  95         == 0,
  96         "rational Bd response factorization failed",
  97     )
  98     require(
  99         sp.factor(
 100             rational_d
 101             + 2
 102             * (6439 * r**2 - 10138 * r + 703)
 103             / (27 * (274 * r**2 - 274 * r + 19))
 104         )
 105         == 0,
 106         "rational dB response factorization failed",
 107     )
 108     rational_threshold = (sp.Integer(5069) + 12 * sp.sqrt(147001)) / 6439
 109     require(
 110         sp.factor(6439 * rational_threshold**2 - 10138 * rational_threshold + 703)
 111         == 0,
 112         "rational-family threshold equation failed",
 113     )
 114     require(
 115         sp.Rational(3, 2) < rational_threshold < sp.Rational(151, 100),
 116         "rational-family threshold lies outside the claimed interval",
 117     )
 118     require(
 119         rational_b.subs(r, rational_threshold) > 0,
 120         "Bd rational response is not positive at the dB threshold",
 121     )
 122 
 123     # Optimize the two-parameter leading family.  Equality of the lower and
 124     # upper admissible lambda bounds is quadratic in sigma.  Its discriminant
 125     # is the displayed degree-six phase polynomial.
 126     phase = r**6 - 8 * r**5 + 22 * r**4 - 30 * r**3 + 21 * r**2 - 6 * r + 1
 127     equality_numerator = sp.factor(sp.together(lower - upper).as_numer_denom()[0])
 128     require(
 129         sp.factor(sp.discriminant(equality_numerator, sigma) - 4 * r**2 * phase)
 130         == 0,
 131         "phase-polynomial discriminant identity failed",
 132     )
 133     require(
 134         sturm_count(phase, r, sp.Rational(3, 2), sp.Rational(151, 100)) == 1,
 135         "phase polynomial does not have one root in the isolating interval",
 136     )
 137     # There are only two real roots; the smaller is the desired one.
 138     require(
 139         sturm_count(phase, r, -100, 100) == 2,
 140         "phase polynomial real-root count is not two",
 141     )
 142 
 143     real_roots = [root for root in sp.nroots(phase, n=50) if abs(sp.im(root)) < sp.Rational(1, 10) ** 40]
 144     small = min(real_roots, key=lambda value: abs(sp.re(value) - sp.Rational(3, 2)))
 145     require(
 146         sp.Rational(3, 2) < sp.re(small) < sp.Rational(151, 100),
 147         "numerical phase root lies outside the exact isolating interval",
 148     )
 149     R_decimal = sp.re(small)
 150     sigma_decimal = (-R_decimal**3 + 4 * R_decimal**2 - 3 * R_decimal - 1) / (2 * (R_decimal - 1))
 151     lambda_decimal = lower.subs({r: R_decimal, sigma: sigma_decimal})
 152     require(
 153         abs(float(R_decimal) - 1.5028569127905696) < 1e-15,
 154         "displayed phase-root decimal is inaccurate",
 155     )
 156     require(
 157         abs(float(sigma_decimal) - 0.13067728228704838) < 1e-15,
