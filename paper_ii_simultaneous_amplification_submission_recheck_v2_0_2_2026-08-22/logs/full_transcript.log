  37     f"{PAPER}/certificates/verify_hybrid_lumping.py",
  38     f"{PAPER}/certificates/verify_leading_algebra.py",
  39     f"{PAPER}/main.tex",
  40     f"{PAPER}/output/pdf/simultaneous_amplification_beyond_three_halves.pdf",
  41     f"{PAPER}/release_bundle.sh",
  42     f"{PAPER}/replay.sh",
  43     f"{PAPER}/requirements.txt",
  44     f"{PAPER}/tests/test_verifier_fail_closed.py",
  45     f"{PAPER}/vendor/README.md",
