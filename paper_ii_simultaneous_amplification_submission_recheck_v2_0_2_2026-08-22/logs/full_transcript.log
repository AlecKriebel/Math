   126	def check_rational_specialization() -> None:
   127	    r = sp.symbols("r", positive=True)
   128	    sigma = sp.Rational(19, 137)
   129	    lam = sp.Rational(20, 27)
   130	    response_bd = 2 * (sigma - 1) / (1 + sigma * (r**2 - 1)) + lam / (r - 1)
   131	    response_db = (
   132	        2 * (r * (2 - r) - sigma) / (sigma + 2 * r * (r - 1)) - lam
   133	    )
   134	    endpoint = sp.Rational(3, 2)
