 237     )
 238     if extracted_manifest_mode != archive_modes[PurePosixPath("MANIFEST.sha256")]:
 239         raise RuntimeError("extracted internal-manifest mode differs from archive")
 240 
 241     nested_pdf = extracted_root / SOURCE_PDF
 242     if (PACKAGE / PDF_NAME).read_bytes() != nested_pdf.read_bytes():
 243         raise RuntimeError("convenience PDF differs from source-tree PDF")
 244 
 245     pdf_digest = digest(PACKAGE / PDF_NAME)
 246     for document_name in ("VERSION.md", "README_FIRST.md"):
 247         text = (PACKAGE / document_name).read_text(encoding="utf-8")
 248         for value, label in (
 249             (archive_digest, "source-archive digest"),
 250             (pdf_digest, "PDF digest"),
 251             (COMMIT, "scientific commit"),
 252             (TAG_OBJECT, "annotated tag object"),
 253             (TAG, "annotated unsigned tag"),
 254         ):
 255             if value not in text:
 256                 raise RuntimeError(f"{document_name} has a stale {label}")
 257         if f"Internal source-archive members: {len(members)}" not in text:
 258             raise RuntimeError(f"{document_name} has a stale member count")
 259     return len(members), archive_digest, pdf_digest
 260 
 261 
 262 def verify_neutral_prompt() -> None:
 263     prompt = (PACKAGE / "REFEREE_PROMPT.md").read_text(encoding="utf-8")
 264     normalized = " ".join(prompt.lower().split())
 265     for verdict in (
 266         "fully validated",
 267         "valid after minor corrections",
 268         "major correction required",
 269         "invalid",
 270         "inconclusive / review incomplete",
 271     ):
 272         if verdict not in normalized:
 273             raise RuntimeError(f"referee prompt omits verdict option: {verdict}")
 274     if "you have not been told whether the results are correct" not in normalized:
 275         raise RuntimeError("referee prompt lacks explicit neutrality instruction")
 276     if "do not infer a proof from a successful program run" not in normalized:
 277         raise RuntimeError("referee prompt fails to separate replay from proof")
 278 
 279 
 280 def main() -> None:
 281     reject_optimized_python()
 282     package_count = verify_package_manifest()
 283     source_count, archive_digest, pdf_digest = verify_source_archive()
 284     verify_neutral_prompt()
 285     print(
 286         f"PASS: {package_count} package payload files match "
 287         "PACKAGE_MANIFEST.sha256"
 288     )
 289     print(
 290         f"PASS: {source_count} source-archive members match the internal manifest"
 291     )
 292     print(f"SOURCE_ARCHIVE_SHA256: {archive_digest}")
 293     print(f"PDF_SHA256: {pdf_digest}")
 294     print("PASS: extracted source tree, convenience PDF, and neutral prompt are bound")
 295 
 296 
 297 if __name__ == "__main__":
 298     main()
