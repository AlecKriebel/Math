   139	    require(
   140	        sp.factor(response_db.subs(r, endpoint)) == sp.Rational(65, 12123),
   141	        "rational dB endpoint margin is incorrect",
   142	    )
   143	
   144	    rational_threshold = (sp.Integer(5069) + 12 * sp.sqrt(147001)) / 6439
   145	    require(
   146	        sp.factor(
   147	            6439 * rational_threshold**2 - 10138 * rational_threshold + 703
