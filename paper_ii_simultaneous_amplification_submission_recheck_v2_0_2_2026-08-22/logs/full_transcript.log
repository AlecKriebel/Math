   275	
   276	To define the positive coupling without reference to a subsequently chosen
   277	fitness, let
   278	\[
   279	 I_t=[1+1/t,\Rhyb-1/t]
   280	\]
   281	when this interval is nonempty.  Let $\rho^0_{U,t}$ denote the finite
   282	separated trace defined in Section~\ref{sec:trace}.  Choose $e_t$ to be the
   283	least positive integer such that, for $\eps_t=2^{-e_t}$,
   284	\[
   285	 \sup_{r\in I_t}\frac{n_t}{q_t}
   286	 \left|
   287	 \frac{\rho_U(G_t(\eps_t),r)}{\rho_U(K_{n_t},r)}
   288	 -\frac{\rho^0_{U,t}(r)}{\rho_U(K_{n_t},r)}
   289	 \right|\leq\frac1t
   290	 \quad (U=\Bd,\dB).
   291	\]
   292	For the finitely many empty intervals, take $e_t=1$.
   293	
   294	\begin{lemma}[Effective dyadic diagonal]
   295	\label{lem:effective-diagonal}
   296	The integer $e_t$ exists and is computable by exact real-algebraic
   297	arithmetic.  In particular, the family $\{G_t\}$ is effectively defined and
   298	every one of its weights is fixed before fitness is quantified.
   299	\end{lemma}
   300	
   301	\begin{proof}
   302	Work over the algebraic number field $\mathbb K=\mathbb Q(\Rhyb)$.
   303	Both $\sigma_*$ and $\lambda_*$ lie in $\mathbb K$, and
   304	$m_t=\lfloor\lambda_*t\rfloor$ is obtained by an exact comparison of real
   305	algebraic numbers.  For fixed $t,e$ and either update rule, the transient
   306	first-step system of $G_t(2^{-e})$ has entries in $\mathbb K(r)$.  Cramer's
   307	rule therefore puts its fixation probability in $\mathbb K(r)$; the same is
   308	true of the finite separated trace and the complete-graph baseline.  For
   309	each $r\in I_t$, every transient block $Q(r)$ occurring in these absorbing
   310	systems is substochastic with spectral radius less than one.  Hence
   311	$I-Q(r)$ is a nonsingular $M$-matrix and
   312	$\det(I-Q(r))>0$; the event denominators are positive as well.
   313	
   314	After clearing those positive denominators, each of the two absolute-value
   315	conditions defining $e_t$ is a pair of polynomial inequalities over
   316	$\mathbb K$ quantified on the algebraic interval $I_t$.  Its truth is
   317	decidable by Sturm--subresultant arithmetic, equivalently by quantifier
   318	elimination in the real closure of $\mathbb K$.  Proposition
   319	\ref{prop:weak-trace} gives uniform convergence on $I_t$, so some exponent is
   320	admissible.  Testing $e=1,2,\ldots$ by the exact decision procedure therefore
   321	terminates at the least admissible $e_t$.
   322	\end{proof}
   323	
   324	\begin{theorem}[Main theorem]
   325	\label{thm:main}
   326	For every fixed $1<r<\Rhyb$, the family above satisfies, for every
   327	sufficiently large $t$,
   328	\[
   329	 \rho_{\Bd}(G_t,r)>\rho_{\Bd}(K_{n_t},r),\qquad
   330	 \rho_{\dB}(G_t,r)>\rho_{\dB}(K_{n_t},r).
   331	\]
   332	Consequently
   333	\[
   334	 \boxed{\Rsim\geq\Rhyb=1.5028569127905696\ldots>3/2.}
   335	\]
   336	\end{theorem}
   337	
   338	\section{Exact lumping and the weak-cut limiting trace}
   339	\label{sec:trace}
   340	
   341	A configuration has orbit label
   342	\[
   343	 (h,i,u,v,\ell),
   344	\]
   345	where $h$ is the hub type, $i$ the number of mutant ordinary clique
   346	vertices, $u$ the number of mixed pairs, $v$ the number of all-mutant pairs,
   347	and $\ell$ the mutant-leaf count.  The group
   348	\[
   349	S_{C_t-1}\times(S_2\wr S_{q_t})\times S_{m_t}
   350	\]
   351	is transitive on every fibre and commutes with both update kernels.  This
   352	immediately gives the following exact reduction.
   353	
   354	\begin{lemma}[Strong orbit lumping]
   355	\label{lem:lumping}
   356	For every positive value of the weak-edge weight and for both update rules,
   357	the total transition probability from a labelled configuration to a target
   358	fibre depends only on $(h,i,u,v,\ell)$.
   359	\end{lemma}
   360	
   361	\begin{proof}
   362	Every permutation in the displayed wreath-product action preserves vertex
   363	degrees, edge weights, types, and fitnesses.  It therefore commutes with each
   364	labelled parent--target event under Bd and each labelled death--parent event
   365	under dB.  Summing events into a target fibre proves strong lumpability.
   366	\end{proof}
   367	
   368	We next fix finite $C,m,q$ and send $\eps\downarrow0$.  At $\eps=0$ the
   369	closed fast classes are precisely the states in which the center module and
   370	every pair are internally homogeneous.  Write a macro state as
   371	\[
   372	 (h,k)\in\{0,1\}\times\{0,\ldots,q\},
   373	\]
   374	where $h$ is the center type and $k$ the number of mutant pairs.  Partition
   375	the finite first-step matrix into mixed-module states $F$ and all
   376	monomorphic-module states $M$, explicitly including global extinction and
   377	fixation.  Their two harmonic values remain fixed at zero and one.
   378	
   379	\begin{proposition}[Finite-state weak-cut limiting trace]
   380	\label{prop:weak-trace}
   381	Let $a_H^U,a_P^U$ be the uniformly initialized isolated fixation
   382	probabilities of the center and one pair, and let $P_U^H,P_U^P$ be fixation
   383	probabilities of the limiting macro chain from $(1,0)$ and $(0,1)$.  For
   384	$U\in\{\Bd,\dB\}$,
   385	\begin{equation}
   386	 \rho_U^0(C,m,q;r)
   387	 =\frac{C+m}{N}a_H^U(r)P_U^H
   388	 +\frac{2q}{N}a_P^U(r)P_U^P,
   389	 \qquad N=C+m+2q.
   390	\label{eq:finite-trace}
   391	\end{equation}
   392	Moreover, $\rho_U(G(C,m,q,\eps),r)\to\rho_U^0(C,m,q;r)$ uniformly in $r$
   393	on every compact subinterval of $(0,\infty)$.
   394	\end{proposition}
   395	
   396	\begin{proof}
   397	Order the states as $M,F$.  At $\eps=0$, the first-step matrix
   398	has the block form
   399	\[
   400	 P_U(0)=
   401	 \begin{pmatrix}I&0\\ C_0&Q_0\end{pmatrix},
   402	 \qquad \rho(Q_0)<1.
   403	\]
   404	Indeed, from a mixed state each finite connected module absorbs internally
   405	almost surely, so $I-Q_0$ is invertible with nonnegative inverse and
   406	$(I-Q_0)^{-1}C_0$ is the stochastic matrix of its first monomorphic return.
   407	Expanding the positive-cut chain gives
   408	\[
   409	 P_{MM}(\eps)=I+\eps A+O(\eps^2),\qquad
   410	 P_{MF}(\eps)=\eps B+O(\eps^2),
   411	\]
   412	and $P_{FM}(\eps)=C_0+O(\eps)$,
   413	$P_{FF}(\eps)=Q_0+O(\eps)$.  Eliminating $F$ from the finite harmonic
   414	system yields, after division by the common factor $\eps$, the macro
   415	generator
   416	\begin{equation}
   417	 \mathcal L_U=A+B(I-Q_0)^{-1}C_0.
   418	\label{eq:schur-trace}
   419	\end{equation}
   420	The second term first makes one cross-module introduction and then resolves
   421	its entire zero-cut internal excursion.  Its absorption distribution is
   422	therefore exactly the affected module's local fixation probability.  On the
   423	two globally absorbing macro states we retain boundary values zero and one;
   424	on every other macro state, the leading harmonic equation is
   425	$\mathcal L_Uh=0$.  Positive introduction rates make every interior state
   426	of this finite macro ladder transient.  On a compact fitness interval its
   427	interior inverse is uniformly bounded, so the boundary-value problem has a
   428	unique solution.  This is the claimed
   429	introduction-rate-times-fixation trace, derived from the finite chain rather
   430	than from independent lineages.
   431	
   432	A uniformly chosen initial mutant first resolves inside its center or pair
   433	module with probability $1-O(\eps)$.  Conditioning on which module fixes
   434	locally gives \eqref{eq:finite-trace}.  All matrices are finite and their
   435	entries are continuous rational functions of $(\eps,r)$ with positive event
   436	denominators.  After fixing the two boundary coordinates, the scaled Schur
   437	complement converges to the invertible interior restriction of
   438	$\mathcal L_U$.  On a compact fitness interval that limiting inverse,
   439	$(I-Q_0)^{-1}$, and the nearby absorbing inverses are uniformly bounded.
   440	The block expansion and hence the convergence are uniform there.
   441	\end{proof}
   442	
   443	\section{Clique--pendant estimates at the gain scale}
   444	
   445	Let $H_{C,m}$ be a unit clique $K_C$ with $m$ unit hub pendants and put
   446	$p=1-1/r$.  Along $C=t^4$, $q=t$, and $m\asymp t$, the following estimates hold
   447	uniformly when $r$ ranges over a compact subset of $(1,\infty)$:
   448	\begin{proposition}[Center module]
   449	\label{prop:center}
   450	\begin{align}
   451	 u_{\rm core}^U(r)&=p+o(q/C),\qquad U=\Bd,\dB,\label{eq:core}\\
   452	 u_{\rm leaf}^{\Bd}(r)&=1-o(1),\label{eq:leaf-Bd}\\
   453	 u_{\rm leaf}^{\dB}(r)&=O(C^{-1}).\label{eq:leaf-dB}
   454	\end{align}
   455	Here $u_{\rm core}^U$ averages the $C$ clique starting vertices.
   456	Consequently
   457	\begin{align}
   458	 a_H^{\Bd}(r)&=\frac{Cp+m}{C+m}+o(q/C),\label{eq:center-Bd}\\
   459	 a_H^{\dB}(r)&=\frac{Cp}{C+m}+o(q/C).\label{eq:center-dB}
   460	\end{align}
   461	At reciprocal fitness $1/r$,
   462	\[
   463	 u_{\mathrm{core}}^{\Bd}(1/r)=o(C^{-1}),\qquad J_H(1/r)=o(C^{-1}),
   464	\]
   465	where $J_H$ is the dB portal functional defined below.
   466	\end{proposition}
   467	
   468	We prove the proposition through five stopped-process lemmas.  This detail is
   469	needed because an $o(1)$ establishment approximation would be too weak: the
   470	final gain is only of order $q/C$.  Fix throughout a compact interval
   471	$\mathcal R=[r_-,r_+]\Subset(1,\infty)$.  Write a center state as
   472	$(h,i,\ell)$, put $c=C-1$, $d=c+m$, and suppress a common positive statewise
   473	time factor.  The six Bd changing rates are
   474	\[
   475	\begin{array}{c|c}
   476	\text{change}&\text{rate}\\ \hline
   477	i\to i+1&r(c-i)\{h/d+i/c\}\\
   478	i\to i-1&i\{(1-h)/d+(c-i)/c\}\\
   479	0\to1\text{ at }h&r(i/c+\ell)\\
   480	1\to0\text{ at }h&(c-i)/c+m-\ell\\
   481	\ell\to\ell+1&rh(m-\ell)/d\\
   482	\ell\to\ell-1&(1-h)\ell/d .
   483	\end{array}
   484	\]
   485	After multiplication by $C+m$, the six dB rates are
   486	\[
   487	\begin{array}{c|c}
   488	i\to i+1&(c-i)\dfrac{r(h+i)}{c+(r-1)(h+i)}\\[1mm]
   489	i\to i-1&i\dfrac{c-i+1-h}{c+(r-1)(i-1+h)}\\[1mm]
   490	0\to1\text{ at }h&\dfrac{r(i+\ell)}{d+(r-1)(i+\ell)}\\[1mm]
   491	1\to0\text{ at }h&\dfrac{d-i-\ell}{d+(r-1)(i+\ell)}\\[1mm]
   492	\ell\to\ell+1&h(m-\ell)\\
   493	\ell\to\ell-1&(1-h)\ell .
   494	\end{array}
   495	\]
   496	These tables follow by summing the labelled parent--target and
   497	death--parent events and are the only estimates used below.
   498	
   499	\begin{lemma}[Early ordinary-core establishment]
   500	\label{lem:early-establishment}
   501	Start from one ordinary clique mutant, with resident hub and no mutant
   502	pendants.  Let $\chi$ be the first change of the hub or pendant coordinates,
   503	let $K=\lceil A_0\log C\rceil$, and let
   504	$\tau_j=\inf\{s:i_s=j\}$ and
   505	$\tau_{0,K}=\tau_0\wedge\tau_K$.  Uniformly for
   506	$r\in\mathcal R$ and $U\in\{\Bd,\dB\}$,
   507	\begin{align}
   508	 \Prob(\chi<\tau_{0,K})&=O(K^2/C),\label{eq:early-mark}\\
   509	 \Prob_1(\tau_K<\tau_0)
   510	 &=1-\frac1r+O(K^2/C)+O(r^{-K}).\label{eq:early-est}
   511	\end{align}
   512	The constants are uniform for every fixed $A_0$.
   513	\end{lemma}
   514	
   515	\begin{proof}
   516	Until $\chi$, the exact embedded ordinary-count up/down odds are
   517	\begin{align}
   518	 R_{\Bd}(i)
   519	 &=r\,\frac{c-i}{c-i+c/(c+m)},\\
   520	 R_{\dB}(i)
   521	 &=r\,\frac{c-i}{c-i+1}
   522	 \frac{c+(r-1)(i-1)}{c+(r-1)i}.
   523	\end{align}
   524	Thus $\lambda_i^U:=(R_U(i))^{-1}=r^{-1}\{1+O(K/C)\}$ uniformly for
   525	$1\leq i<K$.  For large $C$, the embedded ordinary walk has conditional
   526	upward probability at least $1/2+\eta$ for some $\eta>0$ depending only on
   527	$\mathcal R$.  If $N$ is its number of changes before $\{0,K\}$, optional
   528	stopping applied to the count minus its uniform positive drift gives
   529	$\mathbb E_1N\leq K/(2\eta)=O(K)$.  At every visited state the hub-change
   530	hazard divided by the ordinary-change hazard is $O(K/C)$; a union bound over
   531	the stopped changes gives \eqref{eq:early-mark}.  Pendant coordinates cannot
   532	change before the initially resident hub does.
   533	
   534	Suppressing that killing event, the product-odds formula is
   535	\[
   536	 \Prob_1(\tau_K<\tau_0)
   537	 =\left(1+\sum_{k=1}^{K-1}\prod_{j=1}^k\lambda_j^U\right)^{-1}.
   538	\]
   539	For $k<K$, the product is
   540	$r^{-k}\exp\{O(kK/C)\}$; summing the geometric tail and restoring the
   541	killing event changes the answer by
   542	$O(K^2/C)+O(r^{-K})$.  This proves \eqref{eq:early-est}.
   543	\end{proof}
   544	\begin{lemma}[Supercritical completion and core confinement]
   545	\label{lem:core-confinement}
   546	There are constants $\delta>0$, $r_0>1$, $a,b,\gamma>0$, and an integer
   547	$R_0$, depending only on $\mathcal R$, with the following properties.
   548	Uniformly in the hub and pendant coordinates, a core family starting at
   549	$i=K$ reaches $i\geq(1-\delta)c$ before extinction except with probability
   550	\[
   551	 O(r_0^{-K})+e^{-\gamma C}.
   552	\]
   553	If $R=c-i$ and $R(0)\leq\delta c$, then for every fixed $M$,
   554	\begin{equation}
   555	 \Prob\!\left(\sup_{s\leq C^M}R_s\geq2\delta c\right)
   556	 \leq C_M C^{M+1}e^{-\gamma C},
   557	\label{eq:core-confinement}
   558	\end{equation}
   559	where time is measured in the displayed continuous-time clock.  Before the
   560	exceptional exit, the bounded strip is reached with the uniform tail
   561	\begin{equation}
   562	 \Prob\bigl(\tau_{\{R\leq R_0\}}>a\log C+x,
   563	             \tau_{2\delta c}>\tau_{\{R\leq R_0\}}\bigr)
   564	 \leq a e^{-bx}.
   565	\label{eq:deficit-return}
   566	\end{equation}
   567	\end{lemma}
   568	
   569	\begin{proof}
   570	For every hub and pendant state, the ordinary-count odds remain bounded
   571	below by a constant $r_0>1$ from $K$ to a fixed positive core density.
   572	Indeed, the two tables give the uniform lower bounds
   573	\[
   574	 \frac{q^+_{\Bd}}{q^-_{\Bd}}
   575	 \geq\frac{r}{1+c/\{d(c-i)\}},\qquad
   576	 \frac{q^+_{\dB}}{q^-_{\dB}}
   577	 =r\,\frac{h+i}{i}\frac{c-i}{c-i+1-h}
   578	 \frac{c+(r-1)(i-1+h)}{c+(r-1)(i+h)}.
   579	\]
   580	For $K\to\infty$ and $i\leq(1-\delta)c$, their infimum is strictly larger
   581	than one.  This comparison remains valid although the hidden coordinates
   582	move.  At successive $i$-change epochs, condition on the complete past.  The
   583	pointwise intensity ratio implies that the conditional probability of an
   584	upward step is at least $r_0/(1+r_0)$: this follows equivalently by comparing
   585	the two compensator integrals up to the next $i$-change.  Thus
   586	$r_0^{-i_n}$ is a supermartingale for the embedded adapted process.  Stopping
   587	on $\{0,\lfloor(1-\delta)c\rfloor\}$ gives
   588	\[
   589	 \Prob_K\bigl(\tau_0<\tau_{\lfloor(1-\delta)c\rfloor}\bigr)
   590	 \leq r_0^{-K}.
   591	\]
   592	Applying the same conditional-bias comparison across any subsequent
   593	fixed-density interval gives an $e^{-\gamma C}$ failure bound.
   594	
   595	In the upper strip $1\leq R\leq2\delta c$, the same tables give, uniformly
   596	in the hub and pendant coordinates,
   597	\begin{equation}
   598	 \frac{q(R\mapsto R-1)}{q(R\mapsto R+1)}
   599	 \geq r(1-2\delta)\frac{R}{R+1}\{1-o(1)\}.
   600	\label{eq:deficit-odds}
   601	\end{equation}
   602	Writing $r_-$ for the lower end of the chosen fitness compact, choose
   603	\[
   604	 \delta<\min\left\{\frac18,\frac{r_--1}{8r_-},
   605	 \frac{r_-^2-1}{4(r_-^2+1)}\right\}.
   606	\]
   607	Then one may take $\alpha=(r_-+1)/2>1$ and, for all sufficiently large
   608	$C$, replace the right side of \eqref{eq:deficit-odds} by
   609	$\alpha R/(R+1)$.  It is larger than $1+\eta_0$ above the fixed integer
   610	$R_0=\lceil(\alpha+1)/(\alpha-1)\rceil$; no statewise drift assertion is
   611	made below $R_0$.  The hidden hub and pendant coordinates do not make the
   612	deficit marginal Markov, so we use a conditional-bias coupling rather than
   613	assuming that they do.  At successive $R$-change epochs, condition on the
   614	entire past.  Whenever $R>R_0$, the probability of an outward step divided
   615	by that of an inward step is at most $(1+\eta_0)^{-1}$.  Choose
   616	$0<\theta<\log(1+\eta_0)$.  Then
   617	\[
   618	 \exp\{\theta R_{n\wedge\tau}\},\qquad
   619	 \tau=\tau_{\{R\leq R_0\}}\wedge\tau_{\{R\geq2\delta c\}},
   620	\]
   621	is a supermartingale for the embedded adapted process.  Optional stopping
   622	therefore gives, uniformly in all hidden-coordinate histories,
   623	\begin{equation}
   624	 \sup_{k\leq\delta c}
   625	 \Prob_k(\tau_{\{R\geq2\delta c\}}<\tau_{\{R\leq R_0\}})
   626	 \leq e^{-\theta\delta c}=e^{-\gamma C}.
   627	\label{eq:deficit-initial-excursion}
   628	\end{equation}
   629	The same estimate, started at $R_0+1$, controls every later excursion.
   630	The total $R$-change intensity in the displayed clock is at most $\Lambda C$.
   631	Its compensator through time $C^M$ is therefore at most
   632	$\Lambda C^{M+1}$.  Applying the strong Markov property at successive
   633	entries into $R_0+1$ and multiplying the last excursion bound by the expected
   634	number of entries proves \eqref{eq:core-confinement}; Markov's inequality for
   635	the compensator already suffices.
   636	
   637	For completeness, the stopped generator calculation behind the return-time
   638	claim is also explicit.  Substituting $i=c-R$ in the two tables gives
   639	\begin{align*}
   640	 \mathcal G_{\Bd}R
   641	 &=(c-R)\left\{\frac{1-h}{d}+\frac Rc\right\}
   642	   -rR\left\{\frac hd+\frac{c-R}{c}\right\},\\
   643	 \mathcal G_{\dB}R
   644	 &=(c-R)\frac{R+1-h}{c+(r-1)(c-R-1+h)}
   645	   -R\frac{r(c-R+h)}{c+(r-1)(c-R+h)}.
   646	\end{align*}
   647	After increasing $R_0$ and decreasing $\delta$ if necessary, both are at
   648	most $-\kappa R$ for $R_0<R<2\delta c$, uniformly in $h,\ell$, and
   649	$r\in\mathcal R$.  Thus
   650	$e^{\kappa(s\wedge\tau)}R_{s\wedge\tau}$ is a supermartingale in the
   651	displayed clock.  On the event in \eqref{eq:deficit-return} it has not yet
   652	hit either boundary at time $a\log C+x$.  Hence
   653	\[
   654	 \Prob(\tau_{\{R\leq R_0\}}>a\log C+x,
   655	       \tau_{\{R\geq2\delta c\}}>\tau_{\{R\leq R_0\}})
   656	 \leq \frac{\delta C}{R_0}e^{-\kappa(a\log C+x)}.
   657	\]
   658	Taking $a>2/\kappa$ proves \eqref{eq:deficit-return}.  The states below
   659	$R_0$ form the announced boundary layer and require no statewise drift claim.
   660	\end{proof}
   661	
   662	\begin{lemma}[Pendant synchronization and pendant initialization]
   663	\label{lem:pendant-cleanup}
   664	For every fixed $B_0>0$ there is a fixed $D_{\rm cl}=D_{\rm cl}(B_0)$ such
   665	that, under either update
   666	rule and uniformly in $r\in\mathcal R$, a state with
   667	$i\geq(1-\delta)c$ reaches fixation within time $C^{D_{\rm cl}}$, except with
   668	probability
   669	\[
   670	 O(C^{-B_0})+O(C^{D_{\rm cl}+1}e^{-\gamma C}).
   671	\]
   672	Moreover, fixation from one mutant pendant satisfies
   673	\[
   674	 u_{\rm leaf}^{\Bd}(r)=1-o(1),\qquad
   675	 u_{\rm leaf}^{\dB}(r)=O(C^{-1}).
   676	\]
   677	\end{lemma}
   678	
   679	\begin{proof}
   680	We first synchronize the hub and its pendants while the core is confined.  Put
   681	$\tau_\uparrow=\inf\{s\geq0:R_s\geq2\delta c\}$.  Under Bd, freeze
   682	$(i,R,\ell)$ between hub and pendant events and put
   683	\[
   684	 H_+=r(i/c+\ell),\quad H_-=R/c+m-\ell,
   685	 \quad U_\ell=\frac{r(m-\ell)}{c+m},\quad
   686	 V_\ell=\frac{\ell}{c+m}.
   687	\]
   688	If $p_h$ is the probability that the next leaf event is upward, conditional
   689	on the current hub type $h$, renewal at the next hub flip gives
   690	\[
   691	 p_0=\frac{H_+}{H_++V_\ell}p_1,\qquad
   692	 p_1=\frac{U_\ell}{H_-+U_\ell}
   693	     +\frac{H_-}{H_-+U_\ell}p_0.
   694	\]
   695	To make the interruption comparison formal, replace these rates by
   696	\[
   697	 \underline H_+=r_-(1-2\delta+\ell),\qquad
   698	 \overline H_-=2\delta+m-\ell,
   699	 \qquad \underline U_\ell=\frac{r_-(m-\ell)}{c+m},
   700	\]
   701	and let $(\underline p_0,\underline p_1)$ solve the same two equations with
   702	these worst rates and $V_\ell$.  Extend this two-state hitting function by
   703	giving an upper-strip exit the boundary value one.  The resulting function is
   704	subharmonic for the full $(h,i,\ell)$ generator until the next pendant-count
   705	change or $\tau_\uparrow$: core jumps inside the strip leave it unchanged, a
   706	jump through the upper boundary can only increase it, and
   707	$H_+\geq\underline H_+$, $H_-\leq\overline H_-$, and
   708	$U_\ell\geq\underline U_\ell$ move its generator in the favorable direction.
   709	Indeed, the two renewal equations give
   710	\[
   711	 p_0=\frac{H_+U_\ell}
   712	 {H_+U_\ell+V_\ell(H_-+U_\ell)},\qquad
   713	 p_1=\frac{U_\ell(H_++V_\ell)}
   714	 {H_+U_\ell+V_\ell(H_-+U_\ell)};
   715	\]
   716	direct differentiation shows that both are increasing in $H_+$ and
   717	$U_\ell$ and decreasing in $H_-$.  This proves the asserted favorable
   718	monotonicity rather than leaving it implicit.
   719	Optional stopping therefore makes it a lower bound for the probability that
   720	the next stopped outcome is an upward pendant change or upper-strip exit, even
   721	with an adapted sequence of core interruptions.  For $1\leq\ell<m$, its
   722	up-or-exit/down odds, from either hub phase, are bounded below by
   723	\begin{equation}
   724	 \frac{\underline H_+\underline U_\ell}
   725	      {\overline H_-V_\ell}
   726	 \frac1{1+\underline U_\ell/\overline H_-}
   727	 \geq\frac{r_-^2}{1+2\delta}\{1-o(1)\}>1.
   728	\label{eq:leaf-trace-odds}
   729	\end{equation}
   730	
   731	We now keep the same stopping boundary in the calendar-time estimate.  For an
   732	initial state with $\ell<m$, let
   733	$\xi=\tau_{\{\ell=m\}}\wedge\tau_\uparrow$, put $\sigma_0=0$, and, while
   734	$\sigma_j<\xi$, set
   735	\[
   736	 \sigma_{j+1}
   737	 =\inf\{s>\sigma_j:\ell_s\ne\ell_{\sigma_j}\}\wedge\tau_\uparrow.
   738	\]
   739	Assign the stopped trace the level
   740	$\widehat\ell_j=\ell_{\sigma_j}$ when $\sigma_j<\tau_\uparrow$ and the level
   741	$\widehat\ell_j=m$ when $\sigma_j=\tau_\uparrow$, and keep it at $m$
   742	thereafter.  Put $N=\inf\{j:\widehat\ell_j=m\}$.  The stopped committor
   743	comparison above gives a fixed $\beta>1$ such that, on $\{j<N\}$, the
   744	conditional up-or-exit/down odds of $\widehat\ell$ are at least $\beta$; at
   745	$\ell=0$ a downward move is impossible.  Thus, with
   746	$\varepsilon=(\beta-1)/(\beta+1)>0$,
   747	$\widehat\ell_{j\wedge N}-\varepsilon(j\wedge N)$ is a submartingale.
   748	Optional stopping at $N\wedge k$ gives
   749	\[
   750	 \varepsilon\,\mathbb E(N\wedge k)
   751	 \leq\mathbb E\widehat\ell_{N\wedge k}-\ell_0\leq m,
   752	\]
   753	and monotone convergence gives $\mathbb EN\leq m/\varepsilon=O(m)$.
   754	
   755	It remains to convert stopped trace changes into calendar time.  Before
   756	$\tau_\uparrow$, during an $h=0$ phase the activation-or-loss intensity is
   757	bounded below by a positive constant, and during an $h=1$ phase with
   758	$\ell<m$ the deactivation-or-gain intensity is at least
   759	$m-\ell\geq1$.  Moreover,
   760	\begin{align*}
   761	 \Prob(\text{loss or upper exit before activation}\mid h=0)
   762	 &\geq \frac{V_\ell}{r_+(1+\ell)+V_\ell}\geq\frac{c_0}{C},
   763	 &&1\leq\ell<m,\\
   764	 \Prob(\text{gain or upper exit before deactivation}\mid h=1)
   765	 &\geq\frac{\underline U_\ell}
   766	 {2\delta+m-\ell+\underline U_\ell}\geq\frac{c_0}{C},
   767	 &&0\leq\ell<m.
   768	\end{align*}
   769	At $\ell=0$ a resident-hub phase has no loss, but it ends by activation (or
   770	upper exit), after which the mutant-hub bound applies.  Core jumps contribute
   771	zero to functions of $(h,\ell)$ and do not pause these competing clocks.
   772	Consequently, grouping at most two consecutive hub phases, the number of
   773	phases before the next pendant change or upper-strip exit has conditional mean
   774	$O(C)$, and every phase has uniformly bounded conditional mean duration.
   775	Thus, on $\{j<N\}$,
   776	\begin{equation}
   777	 \mathbb E(\sigma_{j+1}-\sigma_j\mid\mathcal F_{\sigma_j})
   778	 \leq K_0C,
   779	\label{eq:leaf-wait}
   780	\end{equation}
   781	and summing over $j<N$ yields
   782	$\mathbb E\xi\leq K_0C\,\mathbb EN=O(Cm)$.  If initially
   783	$(h,\ell)=(0,m)$, activation, pendant loss, or upper-strip exit occurs in
   784	bounded mean time.  The probability that loss occurs first is $O(C^{-1})$;
   785	activation or exit stops the synchronization, while after a loss the preceding
   786	trace starts from $m-1$.  Therefore, for
   787	\[
   788	 \Sigma=\inf\{s\geq0:(h_s,\ell_s)=(1,m)
   789	                         \text{ or }R_s\geq2\delta c\},
   790	\]
   791	\begin{equation}
   792	 \sup_{\substack{0\leq R<2\delta c,\ h\in\{0,1\}\\0\leq\ell\leq m}}
   793	 \mathbb E_{h,R,\ell}\Sigma=O(Cm).
   794	\label{eq:leaf-hitting-time}
   795	\end{equation}
   796	
   797	On the nonexceptional event $\{\Sigma<\tau_\uparrow\}$ the process is at
   798	$(h,\ell)=(1,m)$.  First suppress hub loss and keep $\ell=m$.  The Bd deficit
   799	generator is then exactly
   800	\[
   801	 \mathcal G R
   802	 =-R\left\{\frac r{c+m}+(r-1)\left(1-\frac Rc\right)\right\}.
   803	\]
   804	After shrinking $\delta$ once, the bracket is at least a compact-uniform
   805	$\kappa>0$ on $R\leq3\delta c$.  Starting from $R\leq2\delta c$ and stopping
   806	at $\tau=\tau_0\wedge\tau_{\{R\geq3\delta c\}}$, Dynkin's formula gives
   807	\[
   808	 \mathbb E\int_0^\tau R_s\,ds\leq\frac{R(0)}\kappa
   809	 \leq\frac{2\delta c}\kappa.
   810	\]
   811	The same adapted step calculation, now with $3\delta$ in place of
   812	$2\delta$, also gives
   813	$\Prob(\tau_{\{R\geq3\delta c\}}<\tau_0)\leq e^{-\gamma C}$.  Conditional
   814	on the suppressed path, the probability of no hub loss is
   815	$\exp\{-\int_0^\tau R_s/c\,ds\}$.  Jensen's inequality and subtraction of
   816	the upper-exit event therefore yield
   817	\begin{equation}
   818	 \Prob(\hbox{no hub loss and }\tau_0<\tau_{\{R\geq3\delta c\}})
   819	 \geq e^{-2\delta/\kappa}-e^{-\gamma C}=:s_1+o(1)>0.
   820	\label{eq:Bd-final-cleanup}
   821	\end{equation}
   822	The same exponential Lyapunov estimate makes this final cleanup occur within
   823	$C^2$ with probability $1-o(1)$.  Together with
   824	\eqref{eq:leaf-hitting-time}, $m=o(C)$, Markov's inequality, and
   825	\eqref{eq:core-confinement}, this gives a fixed $s_0>0$ chance of full cleanup
   826	in a block of $2C^2$ time.  If hub loss ends
   827	an unsuccessful final attempt, the same adapted deficit comparison, now
   828	using the nested strips $2\delta c<3\delta c<4\delta c$ after shrinking
   829	$\delta$, returns the process to $R\leq\delta c$ in polynomial time before
   830	the next block; escape to $4\delta c$ before that return costs
   831	$e^{-\gamma C}$.  Starting the next block from $R\leq\delta c$ puts it back
   832	under the $2\delta c$ confinement estimate.  The earlier
   833	hit of $3\delta c$ in \eqref{eq:Bd-final-cleanup} is charged to this same
   834	exceptional event rather than recycled as a new block.  We now formalize the
   835	repetition.
   836	
   837	Here is the stopping-time regeneration behind that last sentence.  Put
   838	$\mathcal E_C=\{R\leq\delta c\}$, write $\tau_{\mathrm{fix}}$ for the
   839	fixation time, and let $S_1$ be the initial time (or the first entry into
   840	$\mathcal E_C$).  Given $S_j$, run the following block:
   841	put
   842	\[
   843	 \Sigma_j=\inf\{s\geq S_j:(h_s,\ell_s)=(1,m)
   844	                         \text{ or }R_s\geq2\delta c\}.
   845	\]
   846	The stopped synchronization estimate \eqref{eq:leaf-hitting-time} gives
   847	$\mathbb E(\Sigma_j-S_j\mid\mathcal F_{S_j})\leq K C m$, with a hit of
   848	$2\delta c$ charged as exceptional.  From a nonexceptional $\Sigma_j$, run
   849	the final cleanup until fixation, hub loss, or a hit of $3\delta c$;
   850	and, after an ordinary hub-loss failure below $3\delta c$, wait for the
   851	first return to $\mathcal E_C$, charging a hit of $4\delta c$ as exceptional.
   852	Let $T_j$ be the time of fixation, exceptional escape, or this return.  On
   853	an ordinary return set $S_{j+1}=T_j$; a hit of $3\delta c$ is charged rather
   854	than recycled.  For that return, shrink $\delta$ so that
   855	$\mathcal G R\leq-\kappa R$ on $\delta c<R<4\delta c$, and put
   856	$\rho=\tau_{\{R\leq\delta c\}}\wedge\tau_{\{R\geq4\delta c\}}$.
   857	The same adapted-step and generator arguments give, from $R<3\delta c$,
   858	\[
   859	 \Prob(\tau_{\{R\geq4\delta c\}}<\tau_{\{R\leq\delta c\}})
   860	 \leq e^{-\gamma C},\qquad
   861	 \Prob(\rho>t)\leq3e^{-\kappa t}.
   862	\]
   863	Equations
   864	\eqref{eq:leaf-hitting-time}, \eqref{eq:Bd-final-cleanup}, and
   865	\eqref{eq:deficit-return}, together with this nested-strip estimate, give
   866	constants $s_*>0$, $D_*=D_*(B_0)$, and $\gamma_*>0$ such that, uniformly on
   867	$\mathcal F_{S_j}$,
   868	\begin{align}
   869	 \Prob(\hbox{fixation during block }j,\ T_j-S_j\leq C^{D_*}
   870	       \mid\mathcal F_{S_j})
   871	 &\geq s_*,\label{eq:Bd-block-success}\\
   872	 \Prob(\hbox{upper-strip escape during block }j,
   873	       \ T_j-S_j\leq C^{D_*}\mid\mathcal F_{S_j})
   874	 &\leq K C^{D_*+1}e^{-\gamma_*C},\label{eq:Bd-block-escape}\\
   875	 \Prob(T_j-S_j>C^{D_*}\mid\mathcal F_{S_j})
   876	 &\leq C^{-B_0-2}.
   877	 \label{eq:Bd-block-duration}
   878	\end{align}
   879	For the last bound, the synchronization part has conditional mean $O(Cm)$
   880	by \eqref{eq:leaf-hitting-time}; the final attempt and return part has
   881	conditional mean $O(C^2)$ by the stopped Lyapunov estimates.  Markov's
   882	inequality gives \eqref{eq:Bd-block-duration} after taking, for example,
   883	$D_*=B_0+4$.  With
   884	\[
   885	 N_C=\left\lceil
   886	 \frac{(B_0+2)\log C}{-\log(1-s_*)}\right\rceil,
   887	\]
   888	the strong Markov property at the $S_j$ gives
   889	\[
   890	 \Prob(\tau_{\mathrm{fix}}>N_CC^{D_*})
   891	 \leq(1-s_*)^{N_C}
   892	   +N_C\{C^{-B_0-2}+K C^{D_*+1}e^{-\gamma_*C}\}
   893	 =O(C^{-B_0}).
   894	\]
   895	Moreover $N_CC^{D_*}\leq C^{D_{\rm cl}}$ for a fixed
   896	$D_{\rm cl}=D_{\rm cl}(B_0)$.  This proves the
   897	claimed Bd time and failure bounds without an implicit independence
   898	assumption between blocks.
   899	
   900	Under dB, every pendant copies the hub at its next death.  In the bounded
   901	$R$ strip, first wait for $R\leq R_0$ using
   902	\eqref{eq:deficit-return}.  The hub activation rate is then bounded below.
   903	During a mutant-hub interval, its deactivation intensity is at most
   904	$K(R+m-\ell)/C$.  Suppressing that deactivation, direct substitution in the
   905	dB table gives $\mathcal G R\leq-\kappa R$ while $R\leq2\delta c$, and the
   906	number $m-\ell$ of resident pendants is a pure-death chain with drift
   907	$-(m-\ell)$.  Choose a fixed $\beta_0=\beta_0(B_0)>0$ such that
   908	\[
   909	 \beta_0-\frac14\geq B_0+2,
   910	 \qquad
   911	 \kappa\beta_0\geq B_0+2,
   912	\]
   913	and put $T=\beta_0\log C$.  Then
   914	\begin{align*}
   915	 \Prob(\ell_T<m)&\leq me^{-T},\\
   916	 \Prob(R_T>0,\ \tau_\uparrow>T)
   917	 &\leq R_0e^{-\kappa T},\\
   918	 \Prob(\text{hub deactivates before }T\wedge\tau_\uparrow)
   919	 &\leq \mathbb E\int_0^{T\wedge\tau_\uparrow}
   920	 K\frac{R_s+m-\ell_s}{C}\,ds
   921	   \leq\frac K C\left(\frac{R_0}{\kappa}+m\right)=o(1).
   922	\end{align*}
   923	The upper-strip exit at the already defined $\tau_\uparrow$ is omitted from
   924	these displays and has probability $e^{-\gamma C}$.  Since $m=O(C^{1/4})$,
   925	the choice of $\beta_0$ makes the first two displayed probabilities
   926	$O(C^{-B_0-2})$,
   927	whereas hub survival has probability $1-o(1)$.  Thus an activated attempt
   928	started in $R\leq R_0$ succeeds with
   929	probability at least $1/2$ for large $C$.  After a failed attempt, confinement
   930	and \eqref{eq:deficit-return} return the process to $R\leq R_0$ in
   931	polynomial time; unless fixation has already occurred, the hub is activated
   932	again at a rate bounded below.  The strong Markov property over
   933	$O_{B_0}(\log C)$ such attempts gives failure $O(C^{-B_0})$, while their
   934	total duration is polynomial.  Taking $D_{\rm cl}$ larger than the two block
   935	exponents and using \eqref{eq:core-confinement} proves the first assertion.
   936	
   937	For a Bd mutant leaf, use the standard weighted graphical construction: each
   938	vertex $u$ has a base reproduction clock of rate one and, when it rings,
   939	targets $v$ with probability $w_{uv}/d_u$; a mutant $u$ has an independent
   940	extra clock of rate $r-1$ with the same target law.  Deleting mutants can
   941	only decrease the mutant set.  Fix the original mutant pendant.  At every
   942	regeneration with resident hub, no ordinary mutants, and that pendant still
   943	alive, delete all other mutants and suppress births to the other pendants.
   944	This produces the adverse lower state $(h,i,\ell)=(0,0,1)$.
   945	In its resident-hub phase, activation has rate $r$ and loss of the
   946	distinguished pendant has rate $1/d$, so loss before activation is
   947	$O(C^{-1})$.  In the ensuing mutant-hub phase, an ordinary seed has rate at
   948	least $rc/d\geq a_0$, while hub loss has rate $m$; hence a seed precedes hub
   949	loss with probability at least $a_1/m$.
   950	
   951	After a seed, stop the ordinary count on $\{0,K\}$.  For every hidden hub
   952	and pendant state, the Bd up/down odds on $1\leq i<K$ are at least a fixed
   953	$r_1>1$.  The conditional-bias argument therefore gives
   954	$\Prob_1(\tau_K<\tau_0)\geq p_0>0$.  The embedded walk makes $O(K)$ expected
   955	changes, and its changing intensity is bounded below, so
   956	$\mathbb E\tau_{0,K}=O(K)$.  The distinguished-pendant loss intensity is at
   957	most $1/d$, giving $O(K/C)$ loss during this stopped trial.  If the count
   958	hits zero while the pendant survives, wait for resident-hub regeneration,
   959	suppressing or deleting every ordinary reseed and every additional mutant
   960	pendant until hub loss.  This is again an adverse graphical coupling: the
   961	distinguished pendant cannot be lost while its sole neighbor is mutant, and
   962	any subsequent resident-phase loss is charged as trial failure.  Delete the
   963	extra mutants again at regeneration.  If it hits $K$, the preceding completion
   964	argument fixes with probability $1-o(1)$.  Thus a trial succeeds with
   965	probability at least $a_2/m$, whereas it loses the distinguished pendant
   966	with probability $O((1+K)/C)$.  The elementary renewal inequality for these
   967	competing outcomes gives loss before success
   968	$O(m(1+K)/C)=o(1)$.  Hence $u_{\rm leaf}^{\Bd}(r)=1-o(1)$.
   969	Under dB, the leaf dies at rate one after the common death-clock time change,
   970	whereas hub activation is at most $r_+/C$.  Fixation requires that activation,
   971	so $u_{\rm leaf}^{\dB}(r)=O(C^{-1})$.
   972	\end{proof}
   973	
   974	\begin{lemma}[Reciprocal killed-Green bounds]
   975	\label{lem:killed-green}
   976	Put $s=1/r$ and suppress hub changes while $h=0,\ell=0$.  Stop the resulting
   977	ordinary-count chain $I$ on hitting $0$ or $\lceil\delta c\rceil$, and define
   978	\[
   979	 G_C^U(i,j)=\mathbb E_i\int_0^\tau
   980	             \mathbf1_{\{I_z=j\}}\,dz.
   981	\]
   982	For every fixed $L$ there are $a_L,\kappa,\theta>0$, uniform for
   983	$s\in[1/r_+,1/r_-]$ and $U\in\{\Bd,\dB\}$, such that
   984	\begin{align}
   985	 \sup_{i\leq L}\Prob_i(\tau_{\lceil\delta c\rceil}<\tau_0)
   986	 &\leq a_Le^{-\kappa C},\label{eq:green-macro}\\
   987	 \sup_{i\leq L}\sum_jjG_C^U(i,j)&\leq a_L,
   988	 \label{eq:green-mass}\\
   989	 \sup_{i\leq L}\sum_{j>L'}jG_C^U(i,j)
   990	 &\leq a_Le^{-\theta L'}.
   991	 \label{eq:green-tail}
   992	\end{align}
   993	Consequently the probability of a hub change before ordinary extinction is
   994	$O_L(C^{-1})$, and the ordinary count at that change has an exponentially
   995	decreasing tail after multiplication by $C$.
   996	\end{lemma}
   997	
   998	\begin{proof}
   999	For $i\leq\delta c$, the reciprocal-fitness versions of the two rate tables
  1000	give
  1001	\[
  1002	 \frac{q_i^+}{q_i^-}\leq s_+\{1+O(\delta)+O(C^{-1})\}\leq\vartheta<1
  1003	\]
  1004	after decreasing $\delta$, where $s_+=1/r_-$.  They also give
  1005	$q_i^--q_i^+\geq\kappa_0i$ in the displayed clock.  The product-odds formula
  1006	for the dominated nearest-neighbor walk proves \eqref{eq:green-macro}.
  1007	Dynkin's formula for $I_{z\wedge\tau}$ gives
  1008	\[
  1009	 \kappa_0\mathbb E_i\int_0^\tau I_z\,dz\leq i,
  1010	\]
  1011	which is \eqref{eq:green-mass}.  To obtain \eqref{eq:green-tail}, let $\nu$
  1012	be the first hit of $L'+1$.  Conditional bias gives
  1013	$\Prob_i(\nu<\tau_0)\leq K_L\vartheta^{L'-L}$.  After $\nu$, the same Dynkin
  1014	estimate bounds the expected remaining particle-time by
  1015	$(L'+1)/\kappa_0$.  Therefore
  1016	\[
  1017	 \mathbb E_i\int_0^\tau I_s\mathbf1_{\{I_s>L'\}}\,ds
  1018	 \leq \frac{K_L(L'+1)}{\kappa_0}\vartheta^{L'-L}
  1019	 \leq a_Le^{-\theta L'},
  1020	\]
  1021	after decreasing $\theta$.
  1022	
  1023	With resident hub and no mutant pendants, the hub-change intensity in either
  1024	rule is at most $K_1I_z/C$.  If $\chi$ is that first change, the two precise
  1025	consequences are
  1026	\begin{align}
  1027	 \Prob_i(\chi<\tau)&\leq \frac{K_1a_L}{C},\label{eq:green-hub-change}\\
  1028	 \Prob_i(\chi<\tau,\ I_\chi>L')
  1029	 &\leq\frac{K_1}{C}\mathbb E_i\int_0^\tau
  1030	 I_s\mathbf1_{\{I_s>L'\}}\,ds
  1031	 \leq\frac{K_1a_L}{C}e^{-\theta L'}.
  1032	\label{eq:green-hub-tail}
  1033	\end{align}
  1034	This proves the asserted change-event bounds.
  1035	\end{proof}
  1036	
  1037	\begin{lemma}[Reciprocal hub-excursion renewal]
  1038	\label{lem:reciprocal-renewal}
  1039	Uniformly for $r\in\mathcal R$,
  1040	\[
  1041	 u_{\mathrm{core}}^{\Bd}(1/r)=o(C^{-1}),\qquad
  1042	 J_H(1/r)=o(C^{-1}).
  1043	\]
  1044	\end{lemma}
  1045	
  1046	\begin{proof}
  1047	For fixed $L$, let $X_L$ be the states with resident hub, no mutant pendants,
  1048	and at most $L$ mutant ordinary vertices; let $Y_L$ be the analogous states
  1049	with mutant hub.  Write $x^U_{C,L}$ and $y^U_{C,L}$ for the largest fixation
  1050	probabilities on these two sets.  Lemma~\ref{lem:killed-green} first gives
  1051	the coarse bound
  1052	\begin{equation}
  1053	 x^U_{C,L}\leq a_Le^{-\kappa C}+a_L/C=O_L(C^{-1}).
  1054	\label{eq:renewal-coarse}
  1055	\end{equation}
  1056	
  1057	We now make the hub-excursion stopping decomposition explicit.  For Bd,
  1058	start from $Y_L$.  The hub-loss rate is at least $m$, while the total
  1059	ordinary-changing rate is $O_L(1)$ and the pendant-seeding rate is $O(m/C)$.
  1060	If hub loss is the first such event, the return state lies in $X_L$ exactly;
  1061	charging every other first event as successful fixation gives
  1062	\begin{equation}
  1063	 y^{\Bd}_{C,L}\leq x^{\Bd}_{C,L}+K_Lm^{-1}+K C^{-1}=o(1).
  1064	\label{eq:renewal-y-Bd}
  1065	\end{equation}
  1066	
  1067	For dB, let $\zeta$ be the first hub loss.  Until the ordinary count reaches
  1068	$\delta c$, the hub-loss intensity is bounded below explicitly:
  1069	\[
  1070	 q_{h:1\mapsto0}
  1071	 =\frac{d-i-\ell}{d+(s-1)(i+\ell)}
  1072	 \geq\frac{(1-\delta)c}{d}=:k_h>0.
  1073	\]
  1074	While the hub is mutant, the ordinary count is dominated by a
  1075	subcritical birth--death process with immigration:
  1076	\[
  1077	 q_i^+\leq b(i+1),\qquad q_i^-\geq d_0i,\qquad b<d_0,
  1078	\]
  1079	after decreasing $\delta$.  A common-clock monotone coupling gives
  1080	$I_s\leq\bar I_s$ for $s\leq\zeta$ until the macro boundary, where $\bar I$ has
  1081	birth rate $b(i+1)$ and death rate $d_0i$.  To make its maximum bound
  1082	explicit, choose $1<z<d_0/b$ and put $V(i)=z^i$.  Its generator satisfies
  1083	\[
  1084	 \overline{\mathcal G}V(i)
  1085	 =(z-1)z^i\left[b-\left(\frac{d_0}{z}-b\right)i\right]
  1086	 \leq K_z-\alpha_zV(i)
  1087	\]
  1088	for suitable compact-uniform $K_z,\alpha_z>0$.  If
  1089	$\bar\tau_M=\inf\{s:\bar I_s\geq M\}$, Dynkin's formula stopped at
  1090	$T\wedge\bar\tau_M$ gives
  1091	\begin{equation}
  1092	 \sup_{i\leq L}\Prob_i\!\left(\sup_{s\leq T}\bar I_s\geq M\right)
  1093	 \leq (z^L+K_zT)z^{-M}.
  1094	\label{eq:immigration-maximum}
  1095	\end{equation}
  1096	Consequently the ordinary cloud before $\zeta$ is uniformly tight.
  1097	Indeed, for fixed $T$ and $L\leq L_1<\delta c$,
  1098	\[
  1099	 \Prob\!\left(\sup_{s<\zeta}I_s>L_1\right)
  1100	 \leq e^{-k_hT}+(z^L+K_zT)z^{-L_1}
  1101	 =:\eta_L(L_1,T),
  1102	\]
  1103	because on the event that the cloud stays below $L_1$ through time $T$, the
  1104	hub-loss intensity remains at least $k_h$ throughout.  Thus the first term
  1105	is precisely the surviving-hub part of the finite-$T$ split; no
  1106	infinite-horizon maximum estimate is being used.
  1107	For fixed $T$, let $L_1\to\infty$ and then let $T\to\infty$; the bound
  1108	vanishes in that order,
  1109	uniformly in $C$ and reciprocal fitness.
  1110	
  1111	On the complementary event, suppress hub reactivation after $\zeta$.
  1112	The mutant pendants are then pure deaths, so
  1113	$\mathbb E\int_0^\infty\ell_s\,ds\leq m$; the killed-Green bound gives
  1114	$\mathbb E\int_0^\tau I_s\,ds\leq a_{L_1}$.  Since the hub-reactivation
  1115	intensity is at most $K(I_s+\ell_s)/C$, its probability before pendant
  1116	clearance and ordinary extinction is at most
  1117	$K(m+a_{L_1})/C$.  Conditional bias also gives
  1118	\[
  1119	 \Prob_{\{I\leq L_1\}}(\tau_{L_2}<\tau_0)
  1120	 \leq K_{L_1}\vartheta^{L_2-L_1}.
  1121	\]
  1122	If neither event occurs, the process enters $X_{L_2}$.  Restoring the
  1123	suppressed reactivation only adds its displayed probability, so the strong
  1124	Markov property yields
  1125	\begin{equation}
  1126	 y^{\dB}_{C,L}
  1127	 \leq \eta_L(L_1,T)+\frac{K(m+a_{L_1})}{C}
  1128	      +K_{L_1}\vartheta^{L_2-L_1}+x^{\dB}_{C,L_2}.
  1129	\label{eq:renewal-y-dB}
  1130	\end{equation}
  1131	For fixed $L_1,L_2,T$, let $C\to\infty$; then let $L_2\to\infty$,
  1132	$L_1\to\infty$, and $T\to\infty$ in that order.  Equations
  1133	\eqref{eq:renewal-y-Bd}--\eqref{eq:renewal-y-dB} prove
  1134	$y^U_{C,L}=o(1)$ for each fixed $L$.
  1135	
  1136	Return now to one ordinary mutant.  At its first hub change, the explicit
  1137	hazard-weighted estimates \eqref{eq:green-macro} and
  1138	\eqref{eq:green-hub-tail} give a constant $a$ such that
  1139	\begin{equation}
  1140	 x^U_{C,1}\leq a e^{-\kappa C}
  1141	 +\frac aC\bigl(y^U_{C,L}+e^{-\theta L}\bigr).
  1142	\label{eq:renewal-refined}
  1143	\end{equation}
  1144	Therefore
  1145	$\limsup_{C\to\infty}Cx^U_{C,1}\leq ae^{-\theta L}$; letting $L\to\infty$
  1146	proves $x^U_{C,1}=o(C^{-1})$, while
  1147	\eqref{eq:renewal-y-Bd}--\eqref{eq:renewal-y-dB} give
  1148	$y^U_{C,0}=o(1)$.  Hence
  1149	\begin{align*}
  1150	 u_{\mathrm{core}}^{\Bd}(1/r)
  1151	 &\leq\frac{C-1}{C}x^{\Bd}_{C,1}+\frac1Cy^{\Bd}_{C,0}
  1152	 =o(C^{-1}),\\
  1153	 J_H(1/r)
  1154	 &\leq x^{\dB}_{C,1}+\frac{y^{\dB}_{C,0}}{c+m}
  1155	 =o(C^{-1}),
  1156	\end{align*}
  1157	because every ordinary clique vertex has degree $c$ and the hub has degree
  1158	$c+m$.
  1159	\end{proof}
  1160	
  1161	\begin{proof}[Proof of Proposition~\ref{prop:center}]
  1162	Choose $A_0$ so that both $r^{-K}$ and $r_0^{-K}$ in
  1163	Lemmas~\ref{lem:early-establishment} and \ref{lem:core-confinement} are
  1164	$o(q/C)=o(C^{-3/4})$, and then choose $B_0>3/4$ in
  1165	Lemma~\ref{lem:pendant-cleanup}.  Since
  1166	\[
  1167	 K^2/C=o(C^{-3/4}),\qquad C^{-B_0}=o(C^{-3/4}),
  1168	\]
  1169	the early-establishment probability is $p+o(q/C)$ and every established
  1170	family completes fixation with failure $o(q/C)$.  The hub starting vertex
  1171	has normalized mass $C^{-1}=o(q/C)$.  This proves \eqref{eq:core};
  1172	Lemma~\ref{lem:pendant-cleanup} proves \eqref{eq:leaf-Bd} and
  1173	\eqref{eq:leaf-dB}; and Lemma~\ref{lem:reciprocal-renewal} proves the two
  1174	reciprocal estimates.
  1175	
  1176	Finally, average the $C-1$ ordinary starts, the hub start, and the $m$
  1177	pendant starts.  Their contributions give
  1178	\eqref{eq:center-Bd}--\eqref{eq:center-dB}; the exceptional hub mass is
  1179	$O(C^{-1})=o(q/C)$.
  1180	\end{proof}
