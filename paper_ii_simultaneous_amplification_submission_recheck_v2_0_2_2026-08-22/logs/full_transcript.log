 1296 \begin{proposition}[Two response functions]
 1297 \label{prop:responses}
 1298 For $C=t^4$, $q=t$, $m/q\to\lambda$, and fixed $\sigma>0$, the separated
 1299 trace satisfies
 1300 \begin{align}
 1301  \frac{\rho^0_{\Bd,t}(r)}{\rho_{\Bd}(K_{n_t},r)}
 1302  &=1+\eta\left[
 1303  \frac{2(\sigma-1)}{1+\sigma(r^2-1)}
 1304  +\frac{\lambda}{r-1}\right]+o_r(\eta),\label{eq:B}\\
 1305  \frac{\rho^0_{\dB,t}(r)}{\rho_{\dB}(K_{n_t},r)}
 1306  &=1+\eta\left[
 1307  \frac{2\{r(2-r)-\sigma\}}{\sigma+2r(r-1)}
 1308  -\lambda\right]+o_r(\eta).\label{eq:D}
 1309 \end{align}
 1310 The remainders are uniform on every compact subinterval of $(1,\infty)$.
 1311 \end{proposition}
 1312 
 1313 \begin{proof}
 1314 The complete-graph Bd baseline differs from $p$ exponentially in $C$, while
 1315 the dB baseline differs from $p$ by $O(C^{-1})$; both errors are
 1316 $o(\eta)$.  The center terms follow from
 1317 \eqref{eq:center-Bd}--\eqref{eq:center-dB}.  The pair terms follow by the
 1318 exact simplifications
 1319 \begin{align}
 1320  2\left\{\frac{[r/(r+1)]Z_B/(1+Z_B)}p-1\right\}
 1321  &=\frac{2(\sigma-1)}{1+\sigma(r^2-1)},\\
 1322  2\left\{\frac{[1/2]Z_D/(1+Z_D)}p-1\right\}
 1323  &=\frac{2\{r(2-r)-\sigma\}}{\sigma+2r(r-1)}.
 1324 \end{align}
 1325 One leaf replaces one core vertex and contributes
 1326 $1/p-1=1/(r-1)$ under Bd and $-1$ under dB.
 1327 All inputs are compact-uniform by Propositions~\ref{prop:weak-trace},
 1328 \ref{prop:center}, and~\ref{prop:gate}, so the combined remainders are as
 1329 stated.
 1330 \end{proof}
 1331 
 1332 \begin{lemma}[Exact tangency]
 1333 \label{lem:tangency}
 1334 At $(\sigma_*,\lambda_*)$, both response functions in
 1335 \eqref{eq:B}--\eqref{eq:D} are strictly positive for every
 1336 $1<r<\Rhyb$ and vanish simultaneously at $r=\Rhyb$.
 1337 \end{lemma}
 1338 
 1339 \begin{proof}
 1340 Both bracketed corrections are positive precisely when
 1341 \[
 1342  L(r,\sigma)<\lambda<U(r,\sigma),
 1343 \]
 1344 where
 1345 \[
 1346  L=\frac{2(1-\sigma)(r-1)}{1+\sigma(r^2-1)},\qquad
 1347  U=\frac{2\{r(2-r)-\sigma\}}{\sigma+2r(r-1)}.
