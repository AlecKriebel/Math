    82  
    83  def sha256(data: bytes) -> str:
    84      return hashlib.sha256(data).hexdigest()
    85  
    86  
    87  def reject_optimized_python() -> None:
    88      if sys.flags.optimize != 0:
    89          raise SystemExit(
    90              "ERROR: optimized Python is unsupported for archive verification"
    91          )
    92  
    93  
    94  def excluded(relative: PurePosixPath) -> bool:
    95      if any(part in EXCLUDED_PARTS for part in relative.parts):
    96          return True
    97      if relative.name in EXCLUDED_NAMES:
    98          return True
    99      return any(relative.name.endswith(suffix) for suffix in EXCLUDED_SUFFIXES)
   100  
   101  
   102  def expected_mode(name: str) -> int:
   103      return 0o755 if name in EXECUTABLES else 0o644
   104  
   105  
   106  def collect(repo_root: Path) -> list[tuple[PurePosixPath, Path]]:
   107      found: dict[PurePosixPath, Path] = {}
   108      for listed in INCLUDE:
   109          source = repo_root / listed
   110          if not source.exists():
   111              raise FileNotFoundError(f"required bundle input is missing: {listed}")
   112          candidates = [source] if source.is_file() else source.rglob("*")
   113          for candidate in candidates:
   114              if candidate.is_symlink():
   115                  raise ValueError(f"symlinks are not permitted in bundle: {candidate}")
   116              if not candidate.is_file():
   117                  continue
   118              relative = PurePosixPath(candidate.relative_to(repo_root).as_posix())
   119              if excluded(relative):
   120                  continue
   121              mode = stat.S_IMODE(candidate.stat().st_mode)
   122              required_mode = expected_mode(relative.as_posix())
   123              if mode != required_mode:
   124                  raise PermissionError(
   125                      f"bundle input has mode {mode:#06o}, expected "
   126                      f"{required_mode:#06o}: {relative}"
   127                  )
   128              found[relative] = candidate
   129      if not found:
   130          raise RuntimeError("bundle inclusion set is empty")
   131      return sorted(found.items(), key=lambda item: item[0].as_posix())
   132  
   133  
   134  def tar_info(name: str, size: int, executable: bool = False) -> tarfile.TarInfo:
   135      info = tarfile.TarInfo(name)
   136      info.size = size
   137      info.mtime = EPOCH
   138      info.uid = 0
   139      info.gid = 0
   140      info.uname = "root"
   141      info.gname = "root"
   142      info.mode = 0o755 if executable else 0o644
   143      return info
   144  
   145  
   146  def synthetic_metadata() -> bytes:
   147      return (
   148          "Package: A fitness-independent family of simultaneous amplifiers beyond relative fitness 3/2\n"
   149          "Author: Alec Kriebel\n"
   150          "ORCID: 0009-0001-9320-500X\n"
   151          "Status: superseding manuscript submission candidate; no new persistent identifier\n"
   152          "Licensing: project-authored files MIT; vendored wheels retain upstream BSD licenses\n"
   153          "Prior source/software DOI: 10.5281/zenodo.21852072\n"
   154          "Contents: manuscript source, PDF, exact certificates, and replay tooling\n"
   155          "Archive format: deterministic POSIX tar compressed with deterministic gzip\n"
   156          f"SOURCE_DATE_EPOCH: {EPOCH}\n"
   157          "Python: 3.14.6\n"
   158          "SymPy: 1.14.0\n"
   159          "mpmath: 1.3.0\n"
   160          "Python dependency policy: vendored pure-Python wheels; offline hash-pinned installation\n"
   161          "PDF toolchain: Tectonic 0.16.9; Poppler 26.08.0\n"
   162          "Document dependency policy: external tools; Tectonic resources may require a populated cache or network access\n"
   163          "Replay entry point: universal_simultaneous_amplification/"
   164          "phase4_landmark_closure/paper_hybrid_threshold/replay.sh\n"
   165      ).encode("utf-8")
   166  
   167  
   168  def write_archive(repo_root: Path, output: Path) -> tuple[int, str]:
   169      files = collect(repo_root)
   170      metadata = synthetic_metadata()
   171      hashes = [(sha256(metadata), "BUNDLE_METADATA.txt")]
   172      payloads: list[tuple[str, bytes, bool]] = [
   173          ("BUNDLE_METADATA.txt", metadata, False)
   174      ]
   175  
   176      for relative, source in files:
   177          data = source.read_bytes()
   178          name = relative.as_posix()
   179          hashes.append((sha256(data), name))
   180          executable = expected_mode(name) == 0o755
   181          payloads.append((name, data, executable))
   182  
   183      manifest = "".join(f"{digest}  {name}\n" for digest, name in hashes).encode(
   184          "utf-8"
   185      )
   186      payloads.append(("MANIFEST.sha256", manifest, False))
   187      payloads.sort(key=lambda item: item[0])
   188  
   189      output.parent.mkdir(parents=True, exist_ok=True)
   190      with tempfile.NamedTemporaryFile(
   191          prefix=f".{output.name}.", dir=output.parent, delete=False
   192      ) as temporary:
   193          temporary_path = Path(temporary.name)
   194  
   195      try:
   196          with temporary_path.open("wb") as raw:
   197              with gzip.GzipFile(
   198                  filename="", mode="wb", fileobj=raw, mtime=EPOCH, compresslevel=9
   199              ) as compressed:
   200                  with tarfile.open(
   201                      fileobj=compressed, mode="w", format=tarfile.PAX_FORMAT
   202                  ) as archive:
   203                      for name, data, executable in payloads:
   204                          archive.addfile(tar_info(name, len(data), executable), io.BytesIO(data))
   205          os.replace(temporary_path, output)
   206          os.chmod(output, 0o644)
   207      finally:
   208          temporary_path.unlink(missing_ok=True)
   209  
   210      verify_archive(output)
   211      return len(files), sha256(output.read_bytes())
   212  
   213  
   214  def verify_archive(output: Path) -> None:
   215      with tarfile.open(output, mode="r:gz") as archive:
   216          members = archive.getmembers()
   217          names = [member.name for member in members]
   218          if names != sorted(names) or len(names) != len(set(names)):
   219              raise RuntimeError("archive members are not unique and sorted")
   220          if any(not member.isfile() for member in members):
   221              raise RuntimeError("archive contains a non-regular member")
   222          for member in members:
   223              required_mode = expected_mode(member.name)
   224              if member.mode != required_mode:
   225                  raise RuntimeError(
   226                      f"archive member has mode {member.mode:#06o}, expected "
   227                      f"{required_mode:#06o}: {member.name}"
   228                  )
   229          expected_names = sorted({"BUNDLE_METADATA.txt", "MANIFEST.sha256", *INCLUDE})
   230          if names != expected_names:
   231              raise RuntimeError("archive differs from the exact public-file whitelist")
   232          extracted = {
   233              member.name: archive.extractfile(member).read()  # type: ignore[union-attr]
   234              for member in members
   235          }
   236  
   237      manifest = extracted.pop("MANIFEST.sha256").decode("utf-8")
   238      expected: dict[str, str] = {}
   239      for number, line in enumerate(manifest.splitlines(), 1):
   240          try:
   241              digest, name = line.split("  ", 1)
   242          except ValueError as exc:
   243              raise RuntimeError(
   244                  f"MANIFEST.sha256:{number}: malformed line"
   245              ) from exc
   246          path = PurePosixPath(name)
   247          if not HEX64.fullmatch(digest):
   248              raise RuntimeError(
   249                  f"MANIFEST.sha256:{number}: malformed SHA-256"
   250              )
   251          if path.is_absolute() or ".." in path.parts or path.as_posix() != name:
   252              raise RuntimeError(
   253                  f"MANIFEST.sha256:{number}: unsafe or noncanonical path"
   254              )
   255          if name in expected:
   256              raise RuntimeError(
   257                  f"MANIFEST.sha256:{number}: duplicate path"
   258              )
   259          expected[name] = digest
   260      if not expected:
   261          raise RuntimeError("MANIFEST.sha256 is empty")
   262      if set(expected) != set(extracted):
   263          raise RuntimeError("manifest and archive file sets differ")
   264      for name, data in extracted.items():
   265          if sha256(data) != expected[name]:
   266              raise RuntimeError(f"archive hash verification failed: {name}")
   267  
   268      forbidden_paths = (
   269          "/submission/",
   270          "endpoint_affine",
   271          "audit_core_uniformity.py",
   272          "/search_",
   273          "/explore_",
   274      )
   275      for name in extracted:
   276          if any(token in name for token in forbidden_paths):
   277              raise RuntimeError(f"forbidden non-proof dependency in archive: {name}")
   278  
   279  
   280  def main() -> None:
   281      reject_optimized_python()
   282      parser = argparse.ArgumentParser(description=__doc__)
   283      parser.add_argument("--repo-root", type=Path, required=True)
   284      parser.add_argument("--output", type=Path, required=True)
   285      args = parser.parse_args()
   286  
   287      repo_root = args.repo_root.resolve()
   288      output = args.output.resolve()
   289      if not (repo_root / PROJECT / "LICENSE").is_file():
   290          raise SystemExit(f"not the expected repository root: {repo_root}")
   291  
   292      count, digest = write_archive(repo_root, output)
   293      print(f"WROTE: {output}")
   294      print(f"FILES: {count + 2} (including metadata and manifest)")
   295      print(f"SHA256: {digest}")
   296  
   297  
   298  if __name__ == "__main__":
   299      main()
