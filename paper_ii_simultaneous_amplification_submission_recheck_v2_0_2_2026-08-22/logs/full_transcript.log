    98	def parse_manifest(text: str, label: str) -> dict[PurePosixPath, str]:
    99	    expected: dict[PurePosixPath, str] = {}
   100	    for number, line in enumerate(text.splitlines(), 1):
   101	        try:
   102	            claimed, raw_name = line.split("  ", 1)
   103	        except ValueError as exc:
   104	            raise RuntimeError(f"{label}:{number}: malformed line") from exc
   105	        name = PurePosixPath(raw_name)
   106	        if not HEX64.fullmatch(claimed):
   107	            raise RuntimeError(f"{label}:{number}: malformed SHA-256")
   108	        if name.is_absolute() or ".." in name.parts or name.as_posix() != raw_name:
   109	            raise RuntimeError(f"{label}:{number}: unsafe or noncanonical path")
   110	        if name in expected:
   111	            raise RuntimeError(f"{label}:{number}: duplicate path")
   112	        expected[name] = claimed
   113	    if not expected:
   114	        raise RuntimeError(f"{label}: empty manifest")
   115	    return expected
