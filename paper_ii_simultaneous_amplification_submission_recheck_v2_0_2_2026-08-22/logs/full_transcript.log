    18          Path("certificates/verify_leading_algebra.py"),
    19          "PASS exact sextic threshold, tangency, and monotonicity algebra",
    20      ),
    21      (
    22          Path("certificates/verify_hybrid_lumping.py"),
    23          "PASS exact labelled hybrid lumping",
    24      ),
    25      (
    26          Path("certificates/verify_hybrid_coefficients.py"),
    27          "PASS exact hybrid coefficient and phase-polynomial audit",
    28      ),
    29      (
    30          Path("verify_paper_claims.py"),
