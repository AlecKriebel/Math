   118	def verify_package_manifest() -> int:
   119	    manifest_path = PACKAGE / "PACKAGE_MANIFEST.sha256"
   120	    manifest_mode = stat.S_IMODE(manifest_path.stat().st_mode)
   121	    if manifest_mode != 0o644:
   122	        raise RuntimeError(
   123	            f"package manifest has mode {manifest_mode:#06o}, expected 0o0644"
   124	        )
   125	    expected = parse_manifest(
   126	        manifest_path.read_text(encoding="ascii"), manifest_path.name
   127	    )
   128	    actual: set[PurePosixPath] = set()
   129	    for path in PACKAGE.rglob("*"):
   130	        if path.is_symlink():
   131	            raise RuntimeError(f"package contains a symlink: {path}")
   132	        if path.is_dir():
   133	            continue
   134	        if not path.is_file():
   135	            raise RuntimeError(f"package contains a non-regular node: {path}")
   136	        if path == manifest_path:
   137	            continue
   138	        relative = PurePosixPath(path.relative_to(PACKAGE).as_posix())
   139	        mode = stat.S_IMODE(path.stat().st_mode)
   140	        required_mode = expected_package_mode(relative)
   141	        if mode != required_mode:
   142	            raise RuntimeError(
   143	                f"package file has mode {mode:#06o}, expected "
   144	                f"{required_mode:#06o}: {relative}"
   145	            )
   146	        actual.add(relative)
   147	    if actual != set(expected):
   148	        missing = sorted(str(path) for path in set(expected) - actual)
   149	        unexpected = sorted(str(path) for path in actual - set(expected))
   150	        raise RuntimeError(
   151	            f"package file-set mismatch; missing={missing}, "
   152	            f"unexpected={unexpected}"
   153	        )
   154	    for name, claimed in expected.items():
   155	        if digest(PACKAGE / name) != claimed:
   156	            raise RuntimeError(f"package hash mismatch: {name}")
   157	    return len(expected)
