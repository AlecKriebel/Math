  "strategy": {
    "algorithm": "conflict_hypergraph_probsat_blocks_v1",
    "conflict_hypergraph": "Each monochromatic five-set is a violated hyperedge over its ten graph-edge variables.",
    "candidate_moves": "At each selected move, enumerate all ten single-edge repairs of one sampled violation, sample conflict-internal two- and three-edge blocks, sample two-conflict paired blocks, and sample global two-edge blocks.",
    "selection": "Seeded mt19937_64 integer ProbSAT roulette on breakout-weighted exact objective delta plus a soft quadratic penalty for degrees outside [18,24], with an independent random-walk probability.",
    "perturbations": "Breakout weights increase on current violations after stagnation. Periodic blocks sample edges from five current violations; later restarts begin after four such blocks.",
    "retention": "Retain every strict objective record in the JSON trace and keep the lowest-E final graph, breaking ties toward lower degree penalty and then greater Hamming distance from the start.",
    "storage": "Retain one graph and three small verification JSONs per run; no trajectory graphs or candidate dumps."
  },
