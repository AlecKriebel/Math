open Kourovka.Linear Kourovka.Ambient
variable {R : Type*} [CommRing R]

/-- The bracket in the paper's ell basis, including all 199 skew-half entries. -/
def LB : V R →ₗ[R] V R →ₗ[R] V R := Sparse.bilinear scaledTerms

theorem LB_alternating (a : V R) : LB a a = 0 := Sparse.fromTerms_self scaledTerms a

theorem mapVec_LB {S : Type*} [CommRing S] (f : R →+* S) (a b : V R) :
    mapVec f (LB a b) = LB (mapVec f a) (mapVec f b) :=
  Ambient.mapVec_terms f scaledTerms a b

def EmbedCheck (i : I) : Prop :=
  ∀ j : I, embed (LB (unitVec i) (unitVec j)) =
    Ambient.B (embed (unitVec i)) (embed (unitVec j))

instance (i : I) : Decidable (EmbedCheck i) :=
  inferInstanceAs (Decidable (∀ j : I, _))

end Kourovka.Lattice
