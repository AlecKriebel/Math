def termVec {R : Type*} [CommRing R] : Option (I × Int) → V R
  | none => 0
  | some (i,c) => (c : R) • unitVec i

def coeff (i j o : I) : Int :=
  match term i j with
  | none => 0
  | some (k,c) => if k = o then c else 0

/-- [i,[j,k]], evaluated sparsely at coordinate o. -/
def nestedLeft (i j k o : I) : Int :=
  match term j k with
  | none => 0
  | some (l,c) => c * coeff i l o

/-- [[i,j],k], evaluated sparsely at coordinate o. -/
def nestedRight (i j k o : I) : Int :=
  match term i j with
  | none => 0
  | some (l,c) => c * coeff l k o

/-- Only a finite arithmetic assertion; its soundness is proved separately. -/
def JacobiCheck (i : I) : Prop :=
  ∀ j k o : I, nestedLeft i j k o = nestedRight i j k o + nestedLeft j i k o

/-- Connects the optimized evaluator to the actual frozen-table bilinear map. -/
def TermCheck (i : I) : Prop :=
  ∀ j : I, (B (unitVec i) (unitVec j) : V Int) = termVec (term i j)

instance (i : I) : Decidable (JacobiCheck i) := inferInstanceAs (Decidable (∀ j k o : I, _))
instance (i : I) : Decidable (TermCheck i) := inferInstanceAs (Decidable (∀ j : I, _))

