SymmetricSector.Active.perturbation_green_q {n : ℕ} (hn : 3 ≤ n) {δ : Matrix (Fin n) (Fin n) ℝ}
  (hδ : SymmetricSector.Active.SymmetricBalanced δ) (y : SymmetricSector.Active.State n) :
