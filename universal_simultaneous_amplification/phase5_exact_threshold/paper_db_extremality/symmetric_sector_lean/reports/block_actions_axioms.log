SymmetricSector.phaseS_mulVec (N : ℕ) (v : SymmetricSector.Good N → ℚ) (i : SymmetricSector.Good N) :
  (SymmetricSector.phaseS N).mulVec v i =
    (↑↑i + 1) / (2 * ↑N) * v i + (↑N - ↑↑i - 1) / (2 * ↑N) * SymmetricSector.zeroExtend v (↑↑i - 1)
