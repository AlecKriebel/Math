SymmetricSector.phaseC_mulVec (N : ℕ) (v : SymmetricSector.Bad N → ℚ) (i : SymmetricSector.Good N) :
  (SymmetricSector.phaseC N).mulVec v i =
    (↑↑i + 1) / (2 * (↑↑i + 2) * ↑N) * SymmetricSector.zeroExtend v ↑↑i +
      (↑N - ↑↑i - 1) / (2 * (↑↑i + 1) * ↑N) * SymmetricSector.zeroExtend v (↑↑i - 1)
