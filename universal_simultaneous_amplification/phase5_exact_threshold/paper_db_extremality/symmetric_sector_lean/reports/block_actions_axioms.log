SymmetricSector.phaseD_mulVec (N : ℕ) (v : SymmetricSector.Good N → ℚ) (i : SymmetricSector.Bad N) :
  (SymmetricSector.phaseD N).mulVec v i = 1 / ↑N * SymmetricSector.zeroExtend v ↑↑i
