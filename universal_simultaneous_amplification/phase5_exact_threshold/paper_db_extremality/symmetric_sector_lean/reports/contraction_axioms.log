SymmetricSector.bad_inverse_D_phaseV_le (N : ℕ) (hN : 3 ≤ N) :
  (1 - SymmetricSector.phaseQ N)⁻¹.mulVec ((SymmetricSector.phaseD N).mulVec (SymmetricSector.phaseV N)) ≤
    SymmetricSector.phaseHhat N
