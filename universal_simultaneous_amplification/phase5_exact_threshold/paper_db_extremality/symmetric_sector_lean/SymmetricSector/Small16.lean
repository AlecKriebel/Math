theorem equations : (1 - coefficientK 16).mulVec response = source 16 := by
  apply funext
  decide +kernel

theorem value : reducedScalar 16 = (141264427021507439158942635139406546304371 / 50863872094586632998763918907423708888907776 : ℚ) := by
  unfold reducedScalar
  rw [← witness_eq_inverse_mulVec (1 - coefficientK 16)
    (coefficient_system_isUnit 16 (by norm_num))
    (source 16) response equations]
  decide +kernel

theorem positive : 0 < reducedScalar 16 := by rw [value]; norm_num

