theorem equations : (1 - coefficientK 21).mulVec response = source 21 := by
  apply funext
  decide +kernel

theorem value : reducedScalar 21 = (1157865613642104879410948725554771662164660110225867 / 660757528205743232859670155709556352212134539877679104 : ℚ) := by
  unfold reducedScalar
  rw [← witness_eq_inverse_mulVec (1 - coefficientK 21)
    (coefficient_system_isUnit 21 (by norm_num))
    (source 21) response equations]
  decide +kernel

theorem positive : 0 < reducedScalar 21 := by rw [value]; norm_num

