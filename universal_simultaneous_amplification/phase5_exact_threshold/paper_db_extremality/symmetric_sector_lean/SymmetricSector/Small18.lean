theorem equations : (1 - coefficientK 18).mulVec response = source 18 := by
  apply funext
  decide +kernel

theorem value : reducedScalar 18 = (2085418647394492137940658652372185743981629 / 913814271446113872129829200951020341491138560 : ℚ) := by
  unfold reducedScalar
  rw [← witness_eq_inverse_mulVec (1 - coefficientK 18)
