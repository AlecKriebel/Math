theorem equations : (1 - coefficientK 17).mulVec response = source 17 := by
  apply funext
  decide +kernel

theorem value : reducedScalar 17 = (210075229952809903594551526588784322479267 / 83631592499196741022319692553829268586496000 : ℚ) := by
  unfold reducedScalar
  rw [← witness_eq_inverse_mulVec (1 - coefficientK 17)
    (coefficient_system_isUnit 17 (by norm_num))
    (source 17) response equations]
  decide +kernel

theorem positive : 0 < reducedScalar 17 := by rw [value]; norm_num

