+def accepted(args,env,body):
+    parent=env.get('EXACT10_PARENT');commit=env.get('EXACT10_COMMIT');urlsha=env.get('EXACT10_URL_SHA256')
+    if len(args)!=2 or args[0]!='origin' or parent!='0880af3e389248dbcd098ac275a880d93e09ea99':return False
+    if not isinstance(commit,str) or len(commit)!=40 or any(c not in '0123456789abcdef' for c in commit):return False
+    if hashlib.sha256(args[1].encode()).hexdigest()!=urlsha:return False
+    expected=(commit+' '+commit+' refs/heads/master '+parent+'\n').encode()
+    return body==expected
+
