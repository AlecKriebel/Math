{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": true,
    "ignore": [
      "**/.*",
      "**/access-logs/**",
      "**/blog.aleckriebel.com/**",
      "**/cache/**",
      "**/etc/**",
      "**/logs/**",
      "**/mail/**",
      "**/minecraft/**",
      "**/perl5/**",
      "**/public_ftp/**",
      "**/ssl/**",
      "**/tmp/**",
      "**/WP-Archive/**",
      "**/wyatt.aleckriebel.com/**",
      "**/deploy.sh",
      "**/README.md",
      "**/backup-12.28.2022_10-08-00_rpgsuz.tar.gz"
    ],
    "redirects": [
      {
        "source": "/blog/tag{,/**}",
        "destination": "/blog",
        "type": 301
      },
      {
        "source": "/blog/category{,/**}",
        "destination": "/blog",
        "type": 301
      },
      {
        "source": "/blog/author{,/**}",
        "destination": "/blog",
        "type": 301
      },
      {
        "source": "/blog/feed/",
        "destination": "/blog/feed/index.xml",
        "type": 301
      },
      {
        "source": "/blog/comments/feed/",
        "destination": "/blog/comments/feed/index.xml",
        "type": 301
      }
    ],
    "headers": [
      {
        "regex": "^/research(/[^/.]+)*(/|/index\\.html)?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
