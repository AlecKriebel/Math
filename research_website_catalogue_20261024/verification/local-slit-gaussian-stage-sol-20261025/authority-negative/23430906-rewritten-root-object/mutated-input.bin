ope_completion_percent": 100, "mathematical_verdict": null, "substantive_defect_found": null, "substantive_defect_field_scope": "Not assessed as a mathematical disposition in this lane; separate analytic/adversarial gates remain pending.", "promotion_authorized": false, "article_candidate_status": "HELD_PENDING_SEPARATE_MATHEMATICAL_GATE", "publication_status": "Publicly deposited unrefereed preprint, version1.0, declared14October2026", "historical_priority": "UNKNOWN; no first-theorem or new-method clearance", "follow_up": null, "source_access_gaps": ["Dickinson2007 complete method body not obtained; primary abstract only; direct DOI403.", "SSRN5031388 full body not obtained; delivery403.", "Jackowski1991 complete formulas/method body not obtained; DOI supplied redirect HTML and web had partial journal OCR.", "Neuenkirch–Shalaiko direct author PDF403; mathematical author text read through web extraction, without journal-byte identity.", "NTU institutional journal-formatted copy acquired and relevant body read; publisher-delivered byte identity and exact coefficient census unverified."], "independence": "No current analytic or adversarial report read. Historical verdict, acceptance and review-report bodies remain opaque. Incidental past acceptance/readiness summaries in actual reader materials and mathematical-derivation headers disclosed in REVIEW.md and read-ledger.json; no opinion treated as proof.", "model_identity": {"model": "gpt-6.1-sol", "reasoning_effort": "ultra", "fork_turns": "none", "descendants": 0}, "source_binding": {"pdf_sha256": "33b90a4d846db58ea93efd453c13455fbeb3a29dcaa3e4cc49a68c0a8ebdff5b", "supplement_sha256": "4e4a1b20c2da7f5a6e686256f7f8d7bba9c8db71e21f316f99da63285f7b0191", "record_raw_sha256": "50b895ad48cc40a5c948428fff572d53f69a3643fb8ebb22122812796d54730b"}, "output_files": ["REVIEW.md", "content.json", "abstract-source.tex", "claim-boundary-map.json", "read-ledger.json", "primary-read-ledger.json", "source-bindings.json", "custody-bef