+def write_complete(fd, body):
+    view = memoryview(body)
+    offset = 0
+    while offset < len(view):
+        try:
+            written = os.write(fd, view[offset:])
+        except InterruptedError:
+            continue
+        need(0 < written <= len(view) - offset, 'complete write must make positive progress')
