      "main_changes_only": [
        "initial main id",
        "exact root object-to-iframe literal replacement"
      ],
      "original_abstract": "We specify six algebraic boundary points, an incoming center, and at least five distinct outgoing centers for a cube move of 16-realizations. Existence follows from strict rational sign bounds for two continuous one-variable residuals. The boundary parameters are uniquely defined real roots of monotone polynomials. This contradicts the at-most-three expectation for construction curves sharing a focus in Remark 4.8 of Melotti–Ramassamy–Thévenin, in the realization setting allowing crossings. The fixed boundary is crossed, so the example concerns no proper embedding. Neither the exact number of centers for this boundary nor a universal maximum is determined.",
      "original_relative_leaf_paths_retained": true,
      "native_version_field_present": false,
      "version_omitted_if_absent": true,
      "root_future_head_and_reader_authority": {
        "path": "/Users/alec/Documents/Math/research_website_catalogue_20261024/verification/root-editorial-23392409-20261115.json",
