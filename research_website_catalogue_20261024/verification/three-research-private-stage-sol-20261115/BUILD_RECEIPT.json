      "record_id": "23205305",
      "title": "Rational-point undecidability for smooth projective varieties over the rational numbers",
      "date": "2026-10-06",
      "doi": "10.5281/zenodo.23205305",
      "url": "https://aleckriebel.com/research/rational-point-undecidability/",
      "description": "A geometric consequence of corrected OpenAI arithmetic input and Poonen’s transfer: rational-point undecidability and noncomputable least-point height bounds, with a conditional height supplement.",
      "native_asset_order": [
        "source.zip",
        "verification.zip",
        "paper.pdf",
        "height-repair.pdf"
      ],
      "whole_MAIN": {
        "bytes": 12794,
        "SHA256": "8cbadb444e31cfaf179438a82a86f9b8bde340bb3a82fa605d782198152d770d"
      },
      "source_scholarly_metadata": {
        "@context": "https://schema.org",
        "@type": "ScholarlyArticle",
        "@id": "https://doi.org/10.5281/zenodo.23205305",
        "headline": "Rational-point undecidability for smooth projective varieties over the rational numbers",
        "name": "Rational-point undecidability for smooth projective varieties over the rational numbers",
        "author": {
          "@type": "Person",
          "name": "Alec Kriebel",
          "identifier": "https://orcid.org/0009-0001-9320-500X"
        },
        "datePublished": "2026-10-06",
        "identifier": {
          "@type": "PropertyValue",
          "propertyID": "DOI",
          "value": "10.5281/zenodo.23205305"
        },
        "url": "https://doi.org/10.5281/zenodo.23205305",
        "description": "A geometric consequence of corrected OpenAI arithmetic input and Poonen’s transfer: rational-point undecidability and noncomputable least-point height bounds, with a conditional height supplement.",
        "abstract": "Combining OpenAI’s negative solution of rational Hilbert’s tenth problem with Poonen’s established effective transfer, we obtain undecidability of rational-point existence for arbitrary smooth projective geometrically integral varieties over ℚ. We specify a homogeneous-equation input promise and reconstruct the terminating contradiction algorithm. There is also no computable uniform bound on the height of one rational point in terms of the size of the presented equations. The arithmetic input is used with two explicit corrections documented here and in the accompanying verification supplement. This is a geometric consequence of that input; neither the geometric reduction nor the base undecidability theorem is claimed as a new independent solution.",
        "inLanguage": "en",
        "license": "https://creativecommons.org/licenses/by/4.0/",
        "isBasedOn": [
          "https://github.com/openai/math/tree/adc7f1241b42e322a6451854ab7e4b4c146bf78a/preprints/Hilberts-tenth-problem-over-the-rational-numbers-September-24-2026",
          "https://github.com/openai/math/tree/adc7f1241b42e322a6451854ab7e4b4c146bf78a/preprints/A-pointwise-2-converse-for-elliptic-curves-with-rational-two-torsion-September-24-2026",
          "https://doi.org/10.4171/JEMS/159"
        ],
