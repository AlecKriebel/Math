    {
      "record_id": "23331295",
      "native_and_scholarly_identity_and_private_gates": {
        "title": "An elementary counterexample to a Nullstellensatz for finite-type link invariants",
        "description": "An explicit principal ideal in the ordinary finite-order link-invariant algebra has a nonempty actual-link zero set whose vanishing ideal strictly exceeds its radical.",
        "abstract": "Let V be the ordinary, uncompleted complex algebra of all finite-order finite-type invariants of links. We give a principal ideal with a nonempty actual-link zero set whose vanishing ideal strictly contains its radical. The generator is g(4g-1), where g is the sum of squared pairwise linking numbers. The obstruction is a character on the entire algebra, obtained by evaluating the standard twist-restriction polynomial at a nonintegral parameter. This gives a negative answer to the arbitrary-ideal formulation of Bar-Natan's Problem 2.27, as recorded by Ohtsuki; the separate linking-number-generated ideal question is not decided.",
        "author": "Alec Kriebel",
        "orcid": "https://orcid.org/0009-0001-9320-500X",
        "publication_date": "2026-10-12",
        "version": "1.0",
        "printed_version": null,
        "canonical_url": null,
