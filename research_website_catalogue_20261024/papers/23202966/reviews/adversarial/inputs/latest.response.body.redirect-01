{"created": "2026-10-07T04:34:37.920372+00:00", "modified": "2026-10-10T21:28:17.848876+00:00", "id": 23202966, "conceptrecid": "23202965", "doi": "10.5281/zenodo.23202966", "conceptdoi": "10.5281/zenodo.23202965", "doi_url": "https://doi.org/10.5281/zenodo.23202966", "metadata": {"title": "Binary consequences of relation-liveness automata lower bounds", "doi": "10.5281/zenodo.23202966", "publication_date": "2026-10-06", "description": "Explicit fixed-binary-alphabet consequences of OpenAI's two relation-liveness lower bounds. A strict h-squared adjacency-block language has a one-way nondeterministic source with (3h^3-h)/2+2 endmarked states, and an ordinary epsilon-free source with one fewer state. Equivalent two-way deterministic automata and two-way nondeterministic automata for its full binary complement require 2^Omega(h), hence 2^Omega(n^(1/3)) in the cubic source size. The note gives exact transitions, an sh^2-state pullback, all-word complement semantics, and an h^3 fooling-set source lower bound. The exponential obstructions are inherited from OpenAI; binary coding is established machinery, attributed to earlier work. AI tools were used extensively. This preprint has not undergone conventional human peer review or refereeing. Automated proof and package audits are documented. Upstream Lean build, axiom printing and Comparator validation were not reproduced due local disk exhaustion; neither reproduced formal verification nor binary formalization is claimed.", "access_right": "open", "creators": [{"name": "Kriebel, Alec", "affiliation": null, "orcid": "0009-0001-9320-500X"}], "keywords": ["two-way finite automata", "Sakoda-Sipser", "binary alphabet", "state complexity", "nondeterministic complementation", "one-way nondeterministic finite automata (1NFA)", "two-way deterministic finite automata (2DFA)", "two-way nondeterministic finite automata (2NFA)", "deterministic simulation", "state lower bounds", "relation liveness", "adjacency-bit encoding", "fixed-length coding", "fooling sets", "read-only automata", "stretched exponential lower bounds"], "related_identifiers": [{"identifier": "https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/preprints/An-exponential-two-way-deterministic-state-lower-bound-for-one-way-liveness-September-25-2026/main.pdf", "relation": "isDerivedFrom", "scheme": "url"}, {"identifier": "https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/preprints/An-exponential-state-lower-bound-for-two-way-nondeterministic-complementation-September-25-2026/paper.pdf", "relation": "isDerivedFrom", "scheme": "url"}], "language": "eng", "resource_type": {"title": "Preprint", "type": "publication", "subtype": "preprint"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23202965"}}]}}, "title": "Binary consequences of relation-liveness automata lower bounds", "links": {"self": "https://zenodo.org/api/records/23202966", "self_html": "https://zenodo.org/records/23202966", "preview_html": "https://zenodo.org/records/23202966?preview=1", "doi": "https://doi.org/10.5281/zenodo.23202966", "self_doi": "https://doi.org/10.5281/zenodo.23202966", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23202966", "reserve_doi": "https://zenodo.org/api/records/23202966/draft/pids/doi", "parent": "https://zenodo.org/api/records/23202965", "parent_html": "https://zenodo.org/records/23202965", "parent_doi": "https://doi.org/10.5281/zenodo.23202965", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23202965", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23202966/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23202966/sequence/default", "files": "https://zenodo.org/api/records/23202966/files", "media_files": "https://zenodo.org/api/records/23202966/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:23202966:paper.pdf/full/%5E10,/0/defa