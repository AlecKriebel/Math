</style><script type="module" src="/_astro/page.Bxj4kPq9.js"></script></head><body class="min-h-screen bg-bg text-navy antialiased"><a class="skip-link" href="#main">Skip to content</a><header class="tdb-site-header"><div class="tdb-site-header-inner"><a href="/" class="tdb-site-brand"><svg class="h-7 w-auto" viewBox="0 0 96 96" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><g stroke="#c7cdd9" stroke-width="3" stroke-linecap="round"><path d="M20 20H76M20 48H76M20 76H76M20 20V76M48 20V76M76 20V76"></path></g><g fill="#c7cdd9"><circle cx="20" cy="48" r="5.5"></circle><circle cx="76" cy="48" r="5.5"></circle><circle cx="20" cy="76" r="5.5"></circle><circle cx="76" cy="76" r="5.5"></circle></g><g stroke="#4f46e5" stroke-width="6.5" stroke-linecap="round"><path d="M20 20H76M48 20V76"></path></g><g fill="#4f46e5"><circle cx="20" cy="20" r="7"></circle><circle cx="48" cy="20" r="7"></circle><circle cx="76" cy="20" r="7"></circle><circle cx="48" cy="48" r="7"></circle><circle cx="48" cy="76" r="7"></circle></g></svg><span>TheoremDB</span></a><button id="tdb-nav-toggle" class="tdb-nav-toggle" type="button" aria-expanded="false" aria-controls="tdb-primary-nav">Menu</button><nav id="tdb-primary-nav" class="tdb-site-nav" aria-label="Primary navigation"><a href="/problems">Problems</a><a href="/community" aria-current="page">Community</a><a href="/connect">Connect</a><a id="tdb-account-link" class="tdb-account-link" href="/account" data-state="signed-out" aria-label="Sign in to your account"><span class="tdb-account-icon" aria-hidden="true"><img id="tdb-account-avatar" class="tdb-account-avatar" alt="" width="24" height="24" hidden><svg viewBox="0 0 20 20" focusable="false"><circle cx="10" cy="6.25" r="3.25"></circle><path d="M3.75 17c.45-3.3 2.55-5.25 6.25-5.25S15.8 13.7 16.25 17"></path></svg><i></i></span><span id="tdb-account-label">Sign in</span></a></nav></div></header><script src="/vendor/katex/katex.min.js" defer></script><script src="/vendor/katex/au