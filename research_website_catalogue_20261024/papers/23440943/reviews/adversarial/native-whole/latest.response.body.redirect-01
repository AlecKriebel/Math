{"created": "2026-10-17T19:04:32.905992+00:00", "modified": "2026-10-17T19:04:33.294068+00:00", "id": 23440943, "conceptrecid": "23440942", "doi": "10.5281/zenodo.23440943", "conceptdoi": "10.5281/zenodo.23440942", "doi_url": "https://doi.org/10.5281/zenodo.23440943", "metadata": {"title": "Negative answers to the printed totally mixed face questions", "doi": "10.5281/zenodo.23440943", "publication_date": "2026-10-17", "description": "<p>A full-dimensional lattice-polytopal counterexample to both unrestricted assertions in Sam Payne's printed 2019 totally mixed face-poset question. For the standard four-simplex D and I=[0,1], the Minkowski sum of D\u00d7I and (-D)\u00d7I has a positive-dimensional, dimension-additive face poset whose order complex is two connected pure graphs, each with 50 vertices and 60 edges. Its rational Betti numbers are (2,22,0,...), so it is nonshellable and fails the printed sphere-wedge homology assertion. The shared interval factor deliberately gives a nongeneric example.</p><p>Four-page research note with self-contained proof, TeX source and two independently authored standard-library exact verification programs. Classical simplex-difference and exact-decomposition geometry and the lower-dimensional six-point control are credited to prior work. The different mixed-face criteria in Adiprasito et al. and Adiprasito's stable-intersection work are distinguished explicitly. The revised July 2026 Hiatt\u2013Simpson\u2013Wang\u2013Wu tropical-fan counterexample is credited as a different object, without assuming a two-summand exact-poset representation. No generic or stable tropical shellability problem is claimed resolved. A bounded current primary-source priority audit is included, with the uninspected paywalled 2024 article-body limitation disclosed; no exhaustive literature or first-ever priority certification is claimed. AI tools were used extensively in development, verification, literature review and writing. Unrefereed; no external human peer review or formal proof-assistant certification is claimed.</p>", "access_right": "open", "creators": [{"name": "Kriebel, Alec", "affiliation": "Independent researcher", "orcid": "0009-0001-9320-500X"}], "keywords": ["Minkowski sums", "totally mixed faces", "exact decompositions", "face posets", "shellability", "rational homology", "Sam Payne open problem", "Oberwolfach Report 39/2019"], "related_identifiers": [{"identifier": "10.4171/OWR/2019/39", "relation": "references", "scheme": "doi"}, {"identifier": "10.1007/s00454-007-1310-2", "relation": "references", "scheme": "doi"}, {"identifier": "https://arxiv.org/abs/0704.3471", "relation": "references", "scheme": "url"}, {"identifier": "10.1093/imrn/rnx184", "relation": "references", "scheme": "doi"}, {"identifier": "10.4310/PAMQ.2024.v20.n1.a2", "relation": "references", "scheme": "doi"}, {"identifier": "https://arxiv.org/abs/2606.10817v2", "relation": "references", "scheme": "url"}, {"identifier": "https://github.com/AlecKriebel/Math/pull/1118", "relation": "isSupplementTo", "scheme": "url"}], "version": "1.0.0", "language": "eng", "resource_type": {"title": "Preprint", "type": "publication", "subtype": "preprint"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23440942"}}]}}, "title": "Negative answers to the printed totally mixed face questions", "links": {"self": "https://zenodo.org/api/records/23440943", "self_html": "https://zenodo.org/records/23440943", "preview_html": "https://zenodo.org/records/23440943?preview=1", "doi": "https://doi.org/10.5281/zenodo.23440943", "self_doi": "https://doi.org/10.5281/zenodo.23440943", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23440943", "reserve_doi": "https://zenodo.org/api/records/23440943/draft/pids/doi", "parent": "https://zenodo.org/api/records/23440942", "parent_html": "https://zenodo.org/records/23440942", "parent_doi": "https://doi.org/10.5281/zenodo.23440942", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23440942", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23440943/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23440943/sequence/default", "files": "https://zenodo.org/api/records/23440943/files", "media_files": "https://zenodo.org/api/records/23440943/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:23440943:totally-mixed-face-posets.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:23440943:totally-mixed-face-posets.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:23440943:totally-mixed-face-posets.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:23440943:totally-mixed-face-posets.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:23440943:totally-mixed-face-posets.pdf/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record:23440943:totally-mixed-face-posets.pdf/full/%5E1200,/0/default.jpg"}, "latest": "https://zenodo.org/api/records/23440943/versions/latest", "latest_html": "https://zenodo.org/records/23440943/latest", "versions": "https://zenodo.org/api/records/23440943/versions", "draft": "https://zenodo.org/api/records/23440943/draft", "access_links": "https://zenodo.org/api/records/23440943/access/links", "access_grants": "https://zenodo.org/api/records/23440943/access/grants", "access_users": "https://zenodo.org/api/records/23440943/access/users", "access_request": "https://zenodo.org/api/records/23440943/access/request", "access": "https://zenodo.org/api/records/23440943/access", "communities": "https://zenodo.org/api/records/23440943/communities", "communities-suggestions": "https://zenodo.org/api/records/23440943/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23440943/request-deletion", "file_modification": "https://zenodo.org/api/records/23440943/file-modification", "quota_increase": "https:/