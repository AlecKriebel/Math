{"created": "2026-10-13T04:42:35.905706+00:00", "modified": "2026-10-13T04:42:36.496531+00:00", "id": 23331709, "conceptrecid": "23331708", "doi": "10.5281/zenodo.23331709", "conceptdoi": "10.5281/zenodo.23331708", "doi_url": "https://doi.org/10.5281/zenodo.23331709", "metadata": {"title": "A relation-incidence proof of Toh\u0103neanu's low-exponent supersolvability conjecture", "doi": "10.5281/zenodo.23331709", "publication_date": "2026-10-13", "description": "Every finite central free hyperplane arrangement over a characteristic-zero field whose nonzero exponents are 1 or 2 with at most one 3 is supersolvable. This research note proves the full conjecture in Toh\u0103neanu's Oberwolfach contribution using linear-relation formality, rank-two counts, a forced K4 incidence core and modular terminal-pencil extensions. The paper credits the earlier all-2, tree, rank-three and modular-pruning results and acknowledges Ferudun's matching October 12, 2026 preprint. The verification archive preserves the October 4 PR candidate and dated disclosure records, source/priority audits and reproducible exact computational diagnostics. No exhaustive first-priority or independent-development claim is made. AI tools were used extensively in solving, writing and verifying the work. This is an unrefereed preprint; internal AI reviews do not constitute independent human peer review.", "access_right": "open", "creators": [{"name": "Kriebel, Alec", "affiliation": "Independent researcher", "orcid": "0009-0001-9320-500X"}], "keywords": ["hyperplane arrangements", "free arrangements", "supersolvable arrangements", "Tohaneanu conjecture", "low exponents", "formality", "modular flats", "incidence graphs"], "related_identifiers": [{"identifier": "https://github.com/AlecKriebel/Math/pull/618", "relation": "isSupplementedBy", "scheme": "url"}, {"identifier": "10.4171/owr/2021/5", "relation": "references", "scheme": "doi"}, {"identifier": "10.5281/zenodo.23313624", "relation": "references", "scheme": "doi"}], "version": "1.0", "resource_type": {"title": "Preprint", "type": "publication", "subtype": "preprint"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23331708"}}]}}, "title": "A relation-incidence proof of Toh\u0103neanu's low-exponent supersolvability conjecture", "links": {"self": "https://zenodo.org/api/records/23331709", "self_html": "https://zenodo.org/records/23331709", "preview_html": "https://zenodo.org/records/23331709?preview=1", "doi": "https://doi.org/10.5281/zenodo.23331709", "self_doi": "https://doi.org/10.5281/zenodo.23331709", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23331709", "reserve_doi": "https://zenodo.org/api/records/23331709/draft/pids/doi", "parent": "https://zenodo.org/api/records/23331708", "parent_html": "https://zenodo.org/records/23331708", "parent_doi": "https://doi.org/10.5281/zenodo.23331708", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23331708", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23331709/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23331709/sequence/default", "files": "https://zenodo.org/api/records/23331709/files", "media_files": "https://zenodo.org/api/records/23331709/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:23331709:low_exponent_supersolvability.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:23331709:low_exponent_supersolvability.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:23331709:low_exponent_supersolvability.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:23331709:low_exponent_supersolvability.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:23331709:low_exponent_supersolvability.pdf/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record:23331709:low_exponent_supersolvability.pdf/full/%5E1200