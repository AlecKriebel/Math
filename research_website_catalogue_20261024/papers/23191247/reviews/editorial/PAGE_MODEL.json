  "full_original_abstract": "Reznik, Garcia and Koiller observed that the sums of the distances from the two foci of an ellipse to their respective antipedal vertices agree along every closed elliptic billiard orbit. We prove this equality for every regular closed orbit tangent to a strictly nested confocal ellipse, including odd primitive periods, star orbits and repeated traversals. The difference of the two ordinary positive antipedal distances on each edge is a fixed coefficient times the vertical displacement of that edge. Closure therefore gives the equality without a parity restriction.",
  "abstract_representations": [
    "visible #original-abstract",
    "ScholarlyArticle.abstract",
    "DC.description"
  ],
  "public_scope": {
    "parameters": "a>b>0 and 0<lambda<b^2",
    "object": "Original orbit polygon's focal antipedal vertices; intersections of full perpendicular-to-focus-radius lines",
    "norms": "Ordinary finite strictly positive Euclidean distances",
    "regularity": "Distinct consecutive endpoints, same elliptic caustic, other-tangent continuation; no immediate retracing",
    "quantifier": "Every admitted regular closed orbit, conditional on existence; no every-integer-period existence assertion",
    "periods": "All admitted periods/windings, including odd primitive periods, stars, global reversal and repeated traversal",
    "identity": "sum q_plus = sum q_minus; ratio one",
    "mechanism": "Consistent caustic-side orientation and q_plus-q_minus=Gamma*(y_B-y_A), followed by cyclic telescoping",
    "limitations": [
      "Neither individual sum asserted constant",
      "No signed lengths, pedal feet, outer tangent polygon or side perimeters",
      "No hyperbolic/degenerate caustics, two-bounce limits, immediate retracing or circular extension",
      "No absolute-first, exhaustive-literature or continued-open-status guarantee"
    ],
