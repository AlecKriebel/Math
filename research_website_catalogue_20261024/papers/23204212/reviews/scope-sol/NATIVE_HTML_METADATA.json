  "JSON_LD_literal_scripts": [
    "{\"@context\": \"http://schema.org\", \"@id\": \"https://doi.org/10.5281/zenodo.23204212\", \"@type\": \"https://schema.org/ScholarlyArticle\", \"author\": [{\"@id\": \"https://orcid.org/0009-0001-9320-500X\", \"@type\": \"Person\", \"familyName\": \"Kriebel\", \"givenName\": \"Alec\", \"name\": \"Kriebel, Alec\"}], \"citation\": [{\"@id\": \"https://doi.org/10.24033/asens.2361\", \"@type\": \"CreativeWork\"}, {\"@id\": \"https://doi.org/10.1007/s10240-017-0091-2\", \"@type\": \"CreativeWork\"}, {\"@id\": \"https://github.com/openai/math/tree/adc7f1241b42e322a6451854ab7e4b4c146bf78a/preprints/Thompsons-group-F-is-nonamenable-September-23-2026\", \"@type\": \"CreativeWork\"}], \"contentSize\": \"112.27 KB\", \"creator\": [{\"@id\": \"https://orcid.org/0009-0001-9320-500X\", \"@type\": \"Person\", \"familyName\": \"Kriebel\", \"givenName\": \"Alec\", \"name\": \"Kriebel, Alec\"}], \"dateCreated\": \"2026-10-07T05:35:37.608378+00:00\", \"dateModified\": \"2026-10-10T21:24:52.833389+00:00\", \"datePublished\": \"2026-10-06\", \"description\": \"An attributed consequence note applying OpenAI\\u0027s nonamenability theorem for standard Thompson F to the published equivalences of Le Boudec and Matte Bon. The reduced group C*-algebras of F, T, the full automorphism group Aut(F), and the abstract commensurator Comm(F) are simple and have their canonical traces as their unique tracial states, by the discrete-group trace theorem of Breuillard, Kalantar, Kennedy and Ozawa. The countable standard circle-overgroup consequence is also recorded. All these simplicity reductions are inherited; T\\u0027s unique trace was already unconditional. No new simplicity criterion, independent proof of nonamenability, or first-priority claim is made. The conclusions depending on the new input have exactly the same dependency on its validity. The source proof was manually audited; actual Lean source and semantics were inspected, but no fresh Lean kernel build was reproduced owing to insufficient disk space, and the follow-on theorem is not claimed to be formalized. AI tools were used extensively in research, drafting and verification. This preprint has not undergone conventional human peer review or refereeing; automated adversarial audits are not human peer review.\", \"identifier\": \"https://doi.org/10.5281/zenodo.23204212\", \"inLanguage\": {\"@type\": \"Language\", \"alternateName\": \"eng\", \"name\": \"English\"}, \"keywords\": \"Thompson groups, reduced group C*-algebras, C*-simplicity, unique trace, Thompson group F, Thompson group T, automorphism group Aut(F), abstract commensurator Comm(F), nonamenability, amenable radical, operator algebras, discrete groups, groups of homeomorphisms, circle actions, canonical tracial state\", \"license\": \"https://creativecommons.org/licenses/by/4.0/legalcode\", \"name\": \"Reduced C*-algebras of the Thompson family: an attributed consequence of nonamenability\", \"publisher\": {\"@type\": \"Organization\", \"name\": \"Zenodo\"}, \"size\": \"112.27 KB\", \"url\": \"https://zenodo.org/records/23204212\"}"
  ],
  "full_API_Description": "An attributed consequence note applying OpenAI's nonamenability theorem for standard Thompson F to the published equivalences of Le Boudec and Matte Bon. The reduced group C*-algebras of F, T, the full automorphism group Aut(F), and the abstract commensurator Comm(F) are simple and have their canonical traces as their unique tracial states, by the discrete-group trace theorem of Breuillard, Kalantar, Kennedy and Ozawa. The countable standard circle-overgroup consequence is also recorded. All these simplicity reductions are inherited; T's unique trace was already unconditional. No new simplicity criterion, independent proof of nonamenability, or first-priority claim is made. The conclusions depending on the new input have exactly the same dependency on its validity. The source proof was manually audited; actual Lean source and semantics were inspected, but no fresh Lean kernel build was reproduced owing to insufficient disk space, and the follow-on theorem is not claimed to be formalized. AI tools were used extensively in research, drafting and verification. This preprint has not undergone conventional human peer review or refereeing; automated adversarial audits are not human peer review.",
