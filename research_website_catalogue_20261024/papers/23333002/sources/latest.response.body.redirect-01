inks", "access_grants": "https://zenodo.org/api/records/23333002/access/grants", "access_users": "https://zenodo.org/api/records/23333002/access/users", "access_request": "https://zenodo.org/api/records/23333002/access/request", "access": "https://zenodo.org/api/records/23333002/access", "communities": "https://zenodo.org/api/records/23333002/communities", "communities-suggestions": "https://zenodo.org/api/records/23333002/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23333002/request-deletion", "file_modification": "https://zenodo.org/api/records/23333002/file-modification", "quota_increase": "https://zenodo.org/api/records/23333002/quota-increase", "requests": "https://zenodo.org/api/records/23333002/requests"}, "updated": "2026-10-13T05:49:13.546664+00:00", "recid": "23333002", "revision": 3, "files": [{"id": "86ca8950-6155-42bd-94fd-528149f9e51d", "key": "robinson-tangency-certificates-v1.0.pdf", "size": 65807, "checksum": "md5:de41f1c1ca4203154b65f03695ae57f3", "links": {"self": "https://zenodo.org/api/records/23333002/files/robinson-tangency-certificates-v1.0.pdf/content"}}, {"id": "6cfe3be7-b01e-4143-afd7-bf6e61c654b2", "key": "robinson-tangency-source-verification-v1.0.zip", "size": 186891, "checksum": "md5:2134ecad888c7d78412529cc70b1470b", "links": {"self": "https://zenodo.org/api/records/23333002/files/robinson-tangency-source-verification-v1.0.zip/content"}}], "swh": {}, "owners": [{"id": "1789874"}], "status": "published", "stats": {"downloads": 15, "unique_downloads": 15, "views": 24, "unique_views": 24, "version_downloads": 15, "version_unique_downloads": 15, "version_unique_views": 24, "version_views": 24}, "state": "done", "submitted": true}