      "claim": "Lemma 2, two-parameter Lipschitz covers",
      "location": "PDF pp.3–5",
      "result": "Supported by preserved cap normal cones, signed own/cross estimates, full-domain root brackets and contraction, with fixed-cap countability."
    },
    {
      "claim": "Lemma 3, rank at every selected contact of a good parameter",
      "location": "PDF pp.5–6",
      "result": "Supported independently in dimensions 0,1,2,3; density-one sequences suffice and planar exclusions justify the denominator."
    },
    {
      "claim": "Proposition 4, null complete sweep",
      "location": "PDF p.6",
      "result": "Supported: three distinct contact heights annihilate a quadratic, product exceptional set is null, and local area formula permits the Borel subset and multiplicity."
    },
    {
      "claim": "Exhaustion of lower-dimensional configurations",
      "location": "PDF p.7",
      "result": "Supported by point direction charts and segment-pair incidence charts on genuinely open domains, plus discarded planes/lines."
    },
    {
      "claim": "Boundary examples",
      "location": "PDF pp.7–8",
      "result": "Two-contact volume 2/3, repeated singleton, zero-density parameter and nonclosed locus examples check at stated interpretations."
    }
