4"}], "status": "published", "stats": {"downloads": 14, "unique_downloads": 14, "views": 23, "unique_views": 22, "version_downloads": 14, "version_unique_downloads": 14, "version_unique_views": 22, "version_views": 23}, "state": "done", "submitted": true}], "total": 1}, "links": {"self": "https://zenodo.org/api/records/23411227/versions?page=1&size=25&sort=version"}}