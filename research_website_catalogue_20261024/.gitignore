__pycache__/
*.pyc
tmp/
screenshots/
verification/PUSH_RECEIPT.json
verification/staging.json
sources/spreadsheet-initial.json
# Downloaded reading copies and generated renderings are retained locally;
# review notes record their primary URLs and checksums.
/papers/*/reviews/**/*.pdf
/papers/*/reviews/**/*.png
# Scratch copies of already archived source and their generated outputs.
/papers/*/reviews/*/source-binding/
/papers/*/reviews/*/published-replay/
/papers/*/reviews/*/replay-work/
/papers/*/reviews/scope/published-paper.txt

# Downloaded third-party HTML is a local research cache.
papers/*/reviews/**/*.html

# Public download binaries remain local reading copies. Their Zenodo URLs,
# sizes and checksums are preserved in acquisition receipts.
/papers/*/sources/**/*.zip
/papers/*/sources/**/*.tar.gz
/papers/*/sources/**/*.tgz
/papers/*/sources/**/*.pdf
/papers/*/sources/**/*.part
/papers/*/sources/published-source/
/papers/*/sources/related-records/*/published-source/
/papers/*/sources/**/published-source/

# Third-party upstream reading copies; acquisition receipts and hashes remain tracked.
/papers/23203100/reviews/upstream_analytic/pinned_extraction.txt
/papers/23203100/reviews/upstream_adversarial/inputs/tex/
