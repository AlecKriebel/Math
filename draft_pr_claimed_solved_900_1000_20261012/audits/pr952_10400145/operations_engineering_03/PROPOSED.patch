+def native_attempt_inventory():
+    """A partial/orphan/later attempt must never cause a fresh blind push."""
+    groups={}
+    for entry in W.iterdir():
+        if not entry.name.casefold().startswith('native_publication_cas_'):continue
+        match=re.fullmatch(r'NATIVE_PUBLICATION_CAS_([0-9]{2})_(INTENT|PREPARED|ACTION|DEFINITIVE_RACE)\.json',entry.name)
+        need(match is not None,'noncanonical or unsupported native attempt artifact')
+        number=int(match[1]);need(1<=number<=6,'native attempt outside fixed bound')
+        groups.setdefault(number,set()).add(match[2])
+    numbers=sorted(groups)
+    need(not numbers or numbers==list(range(1,numbers[-1]+1)),'native attempt history gap')
+    for number,parts in groups.items():
+        need({'INTENT','PREPARED'}<=parts,'partial/orphan native attempt requires exact reconciliation')
+        if number!=numbers[-1]:need('DEFINITIVE_RACE' in parts,'later native attempt after unresolved uncertainty')
+    return groups
+
