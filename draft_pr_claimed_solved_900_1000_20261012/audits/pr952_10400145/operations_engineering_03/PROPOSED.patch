+    replacements=native_replacements(blob(parent,QUEUE),blob(parent,STATE),blob(parent,HISTORY),event)
+    need(exact({name:fingerprint(body) for name,body in replacements.items()},pair['planned']['replacement_pins']),'native prepared full replacement pins differ')
+    need(all(blob(commit,name)==body for name,body in replacements.items()),'native prepared full raw replacement bytes differ')
+    original_check(merge['mergeCommit']['oid']);original_check(parent);original_check(commit)
