+    need(len(parents)==2 and parents[1]==HEAD,'native prepared ordinary original-head merge')
+    need(exact(native_safety(parent),pair['prepared']['native_safety']),'native prepared absent/UNKNOWN parent baseline differs')
+    source=source_gate(parent);saved=pair['prepared']['source_gate']
+    need(type(saved.get('utc')) is str,'native saved source timestamp');utc(saved['utc'])
