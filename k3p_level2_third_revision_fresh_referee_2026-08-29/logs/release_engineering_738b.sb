(version 1)
(deny default)

(allow process*)
(allow signal (target self))
(allow signal (target children))
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow ipc-posix-shm)

(allow file-read-metadata
  (literal "/")
  (literal "/Users") (literal "/Users/alec")
  (literal "/Users/alec/Documents")
  (literal "/Users/alec/Documents/Math")
  (literal "/Users/alec/Documents/Math/k3p_level2_identifiability_final")
  (literal "/Users/alec/Documents/Math/k3p_level2_third_revision_fresh_referee_2026-08-29")
  (literal "/Users/alec/Documents/Math/k3p_level2_third_revision_fresh_referee_2026-08-29/execution")
  (literal "/Users/alec/Documents/Math/k3p_level2_third_revision_fresh_referee_2026-08-29/execution/release_engineering_738b")
  (literal "/opt") (literal "/opt/homebrew"))

(allow file-read*
  (literal "/")
  (literal "/dev") (subpath "/dev")
  (literal "/System") (subpath "/System")
  (literal "/usr") (subpath "/usr")
  (literal "/bin") (subpath "/bin")
  (literal "/sbin") (subpath "/sbin")
  (literal "/Library")
  (literal "/Library/Apple") (subpath "/Library/Apple")
  (literal "/Library/Frameworks") (subpath "/Library/Frameworks")
  (literal "/private") (literal "/private/var")
  (literal "/private/var/db")
  (literal "/private/var/db/dyld") (subpath "/private/var/db/dyld")
  (literal "/private/var/db/timezone") (subpath "/private/var/db/timezone")
  (literal "/opt") (literal "/opt/homebrew") (subpath "/opt/homebrew")
  (literal "/Users") (literal "/Users/alec")
  (literal "/Users/alec/Documents")
  (literal "/Users/alec/Documents/Math")
  (literal "/Users/alec/Documents/Math/k3p_level2_identifiability_final")
  (literal "/Users/alec/Documents/Math/k3p_level2_identifiability_final/.venv")
  (subpath "/Users/alec/Documents/Math/k3p_level2_identifiability_final/.venv")
  (literal "/Users/alec/Documents/Math/k3p_level2_third_revision_fresh_referee_2026-08-29")
  (literal "/Users/alec/Documents/Math/k3p_level2_third_revision_fresh_referee_2026-08-29/execution")
  (literal "/Users/alec/Documents/Math/k3p_level2_third_revision_fresh_referee_2026-08-29/execution/release_engineering_738b")
  (subpath "/Users/alec/Documents/Math/k3p_level2_third_revision_fresh_referee_2026-08-29/execution/release_engineering_738b"))

(allow file-write*
  (subpath "/Users/alec/Documents/Math/k3p_level2_third_revision_fresh_referee_2026-08-29/execution/release_engineering_738b/repo/k3p_level2_identifiability_final/release/work")
  (subpath "/Users/alec/Documents/Math/k3p_level2_third_revision_fresh_referee_2026-08-29/execution/release_engineering_738b/runtime_home")
  (subpath "/Users/alec/Documents/Math/k3p_level2_third_revision_fresh_referee_2026-08-29/execution/release_engineering_738b/runtime_tmp")
  (literal "/dev/null"))

(deny network*)
