(version 1)

;; Default-deny review boundary.  Package code may execute local processes,
;; read this audit directory and the pinned Python environment, and write only
;; inside the disposable package copy.  Network endpoints, credentials,
;; browser profiles, cloud storage, and sibling projects remain unavailable.
(deny default)

(allow process*)
(allow signal (target self))
(allow signal (target children))
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow mach-lookup)
(allow ipc-posix-shm)

(deny mach-lookup
  (global-name "com.apple.securityd")
  (global-name "com.apple.securityd.xpc")
  (global-name "com.apple.security.agent")
  (global-name "com.apple.trustd")
  (global-name "com.apple.trustd.agent"))

;; macOS runtime libraries are distributed across system and developer roots.
;; Permit ordinary reads, then carve out the complete user home except for the
;; audit directory and the dependency-only virtual environment.
(allow file-read*)

(deny file-read*
  (require-all
    (subpath "/Users/alec")
    (require-not (literal "/Users/alec"))
    (require-not (literal "/Users/alec/Documents"))
    (require-not (literal "/Users/alec/Documents/Math"))
    (require-not
      (literal "/Users/alec/Documents/Math/k3p_level2_second_revision_referee_2026-08-28"))
    (require-not
      (subpath "/Users/alec/Documents/Math/k3p_level2_second_revision_referee_2026-08-28/package_copy"))
    (require-not
      (literal "/Users/alec/Documents/Math/k3p_level2_identifiability_final"))
    (require-not
      (subpath "/Users/alec/Documents/Math/k3p_level2_identifiability_final/.venv"))))

(deny file-read*
  (subpath "/Library/Keychains")
  (subpath "/private/var/root")
  (subpath "/private/var/db/SystemKey")
  (subpath "/private/var/db/dslocal"))

(allow file-write*
  (subpath "/Users/alec/Documents/Math/k3p_level2_second_revision_referee_2026-08-28/package_copy/review_runs")
  (literal "/dev/null"))

(deny network*)

;; Defense in depth against broad runtime service allowances.
(deny file-read*
  (subpath "/Users/alec/.ssh")
  (subpath "/Users/alec/.aws")
  (subpath "/Users/alec/.config")
  (subpath "/Users/alec/Library/Keychains")
  (subpath "/Users/alec/Library/Application Support/Google/Chrome")
  (subpath "/Users/alec/Library/CloudStorage"))
