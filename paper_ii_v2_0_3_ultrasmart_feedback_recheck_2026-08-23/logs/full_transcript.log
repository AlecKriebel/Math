   131	def sha256(path: Path) -> str:
   132	    digest = hashlib.sha256()
   133	    with path.open("rb") as handle:
   134	        for block in iter(lambda: handle.read(1024 * 1024), b""):
   135	            digest.update(block)
   136	    return digest.hexdigest()
