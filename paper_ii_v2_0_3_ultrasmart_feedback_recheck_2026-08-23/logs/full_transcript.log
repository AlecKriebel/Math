   277	
   278	To define the positive coupling without reference to a subsequently chosen
   279	fitness, let
   280	\[
   281	 I_t=[1+1/t,\Rhyb-1/t]
   282	\]
   283	when this interval is nonempty.  Let $\rho^0_{U,t}$ denote the finite
   284	separated trace defined in Section~\ref{sec:trace}.  Choose $e_t$ to be the
   285	least positive integer such that, for $\eps_t=2^{-e_t}$,
   286	\[
   287	 \sup_{r\in I_t}\frac{n_t}{q_t}
   288	 \left|
   289	 \frac{\rho_U(G_t(\eps_t),r)}{\rho_U(K_{n_t},r)}
   290	 -\frac{\rho^0_{U,t}(r)}{\rho_U(K_{n_t},r)}
   291	 \right|\leq\frac1t
   292	 \quad (U=\Bd,\dB).
   293	\]
   294	For the finitely many empty intervals, take $e_t=1$.
   295	
   296	\begin{lemma}[Effective dyadic diagonal]
   297	\label{lem:effective-diagonal}
   298	The integer $e_t$ exists and is computable by exact real-algebraic
   299	arithmetic.  In particular, the family $\{G_t\}$ is effectively defined and
   300	every one of its weights is fixed before fitness is quantified.
   301	\end{lemma}
   302	
   303	\begin{proof}
   304	Work over the algebraic number field $\mathbb K=\mathbb Q(\Rhyb)$.
   305	Both $\sigma_*$ and $\lambda_*$ lie in $\mathbb K$, and
   306	$m_t=\lfloor\lambda_*t\rfloor$ is obtained by an exact comparison of real
   307	algebraic numbers.  For fixed $t,e$ and either update rule, the transient
   308	first-step system of $G_t(2^{-e})$ has entries in $\mathbb K(r)$.  Cramer's
   309	rule therefore puts its fixation probability in $\mathbb K(r)$; the same is
   310	true of the finite separated trace and the complete-graph baseline.  For
   311	each $r\in I_t$, every transient block $Q(r)$ occurring in these absorbing
   312	systems is substochastic with spectral radius less than one.  Hence
   313	$I-Q(r)$ is a nonsingular $M$-matrix and
   314	$\det(I-Q(r))>0$; the event denominators are positive as well.
   315	
   316	After clearing those positive denominators, each of the two absolute-value
   317	conditions defining $e_t$ is a pair of polynomial inequalities over
   318	$\mathbb K$ quantified on the algebraic interval $I_t$.  Its truth is
   319	decidable by Sturm--subresultant arithmetic, equivalently by quantifier
   320	elimination in the real closure of $\mathbb K$.  Proposition
   321	\ref{prop:weak-trace} gives uniform convergence on $I_t$, so some exponent is
   322	admissible.  Testing $e=1,2,\ldots$ by the exact decision procedure therefore
   323	terminates at the least admissible $e_t$.
   324	\end{proof}
   325	
   326	\begin{theorem}[Main theorem]
   327	\label{thm:main}
   328	For every fixed $1<r<\Rhyb$, the family above satisfies, for every
   329	sufficiently large $t$,
   330	\[
   331	 \rho_{\Bd}(G_t,r)>\rho_{\Bd}(K_{n_t},r),\qquad
   332	 \rho_{\dB}(G_t,r)>\rho_{\dB}(K_{n_t},r).
   333	\]
   334	Consequently
   335	\[
   336	 \boxed{\Rsim\geq\Rhyb=1.5028569127905696\ldots>3/2.}
   337	\]
   338	\end{theorem}
   339	
   340	\section{Exact lumping and the weak-cut limiting trace}
   341	\label{sec:trace}
   342	
   343	A configuration has orbit label
   344	\[
   345	 (h,i,u,v,\ell),
   346	\]
   347	where $h$ is the hub type, $i$ the number of mutant ordinary clique
   348	vertices, $u$ the number of mixed pairs, $v$ the number of all-mutant pairs,
   349	and $\ell$ the mutant-leaf count.  The group
   350	\[
   351	S_{C_t-1}\times(S_2\wr S_{q_t})\times S_{m_t}
   352	\]
   353	is transitive on every fibre and commutes with both update kernels.  This
   354	immediately gives the following exact reduction.
   355	
   356	\begin{lemma}[Strong orbit lumping]
   357	\label{lem:lumping}
   358	For every positive value of the weak-edge weight and for both update rules,
   359	the total transition probability from a labelled configuration to a target
   360	fibre depends only on $(h,i,u,v,\ell)$.
   361	\end{lemma}
   362	
   363	\begin{proof}
   364	Every permutation in the displayed wreath-product action preserves vertex
   365	degrees, edge weights, types, and fitnesses.  It therefore commutes with each
   366	labelled parent--target event under Bd and each labelled death--parent event
   367	under dB.  Summing events into a target fibre proves strong lumpability.
   368	\end{proof}
   369	
   370	We next fix finite $C,m,q$ and send $\eps\downarrow0$.  At $\eps=0$ the
   371	closed fast classes are precisely the states in which the center module and
   372	every pair are internally homogeneous.  Write a macro state as
   373	\[
   374	 (h,k)\in\{0,1\}\times\{0,\ldots,q\},
   375	\]
   376	where $h$ is the center type and $k$ the number of mutant pairs.  Partition
   377	the finite first-step matrix into mixed-module states $F$ and all
   378	monomorphic-module states $M$, explicitly including global extinction and
   379	fixation.  Their two harmonic values remain fixed at zero and one.
   380	
   430	unique solution.  This is the claimed
   431	introduction-rate-times-fixation trace, derived from the finite chain rather
   432	than from independent lineages.
   433	
   434	A uniformly chosen initial mutant first resolves inside its center or pair
   435	module with probability $1-O(\eps)$.  Conditioning on which module fixes
   436	locally gives \eqref{eq:finite-trace}.  All matrices are finite and their
   437	entries are continuous rational functions of $(\eps,r)$ with positive event
   438	denominators.  After fixing the two boundary coordinates, the scaled Schur
   439	complement converges to the invertible interior restriction of
   440	$\mathcal L_U$.  On a compact fitness interval that limiting inverse,
   441	$(I-Q_0)^{-1}$, and the nearby absorbing inverses are uniformly bounded.
   442	The block expansion and hence the convergence are uniform there.
   443	\end{proof}
   444	
   445	\section{Clique--pendant estimates at the gain scale}
   446	
   447	Let $H_{C,m}$ be a unit clique $K_C$ with $m$ unit hub pendants and put
   448	$p=1-1/r$.  Along $C=t^4$, $q=t$, and $m\asymp t$, the following estimates hold
   449	uniformly when $r$ ranges over a compact subset of $(1,\infty)$:
   450	\begin{proposition}[Center module]
   451	\label{prop:center}
   452	\begin{align}
   453	 u_{\rm core}^U(r)&=p+o(q/C),\qquad U=\Bd,\dB,\label{eq:core}\\
   454	 u_{\rm leaf}^{\Bd}(r)&=1-o(1),\label{eq:leaf-Bd}\\
   455	 u_{\rm leaf}^{\dB}(r)&=O(C^{-1}).\label{eq:leaf-dB}
   456	\end{align}
   457	Here $u_{\rm core}^U$ averages the $C$ clique starting vertices.
   458	Consequently
   459	\begin{align}
   460	 a_H^{\Bd}(r)&=\frac{Cp+m}{C+m}+o(q/C),\label{eq:center-Bd}\\
   461	 a_H^{\dB}(r)&=\frac{Cp}{C+m}+o(q/C).\label{eq:center-dB}
   462	\end{align}
   463	At reciprocal fitness $1/r$,
   464	\[
   465	 u_{\mathrm{core}}^{\Bd}(1/r)=o(C^{-1}),\qquad J_H(1/r)=o(C^{-1}),
   466	\]
   467	where $J_H$ is the dB portal functional defined below.
   468	\end{proposition}
   469	
   470	We prove the proposition through five stopped-process lemmas.  This detail is
   471	needed because an $o(1)$ establishment approximation would be too weak: the
   472	final gain is only of order $q/C$.  Fix throughout a compact interval
   473	$\mathcal R=[r_-,r_+]\Subset(1,\infty)$.  Write a center state as
   474	$(h,i,\ell)$, put $c=C-1$, $d=c+m$, and suppress a common positive statewise
   475	time factor.  The six Bd changing rates are
   476	\[
   477	\begin{array}{c|c}
   478	\text{change}&\text{rate}\\ \hline
   479	i\to i+1&r(c-i)\{h/d+i/c\}\\
   480	i\to i-1&i\{(1-h)/d+(c-i)/c\}\\
   481	0\to1\text{ at }h&r(i/c+\ell)\\
   482	1\to0\text{ at }h&(c-i)/c+m-\ell\\
   483	\ell\to\ell+1&rh(m-\ell)/d\\
   484	\ell\to\ell-1&(1-h)\ell/d .
   485	\end{array}
   486	\]
   487	After multiplication by $C+m$, the six dB rates are
   488	\[
   489	\begin{array}{c|c}
   490	i\to i+1&(c-i)\dfrac{r(h+i)}{c+(r-1)(h+i)}\\[1mm]
   491	i\to i-1&i\dfrac{c-i+1-h}{c+(r-1)(i-1+h)}\\[1mm]
   492	0\to1\text{ at }h&\dfrac{r(i+\ell)}{d+(r-1)(i+\ell)}\\[1mm]
   493	1\to0\text{ at }h&\dfrac{d-i-\ell}{d+(r-1)(i+\ell)}\\[1mm]
   494	\ell\to\ell+1&h(m-\ell)\\
   495	\ell\to\ell-1&(1-h)\ell .
   496	\end{array}
   497	\]
   498	These tables follow by summing the labelled parent--target and
   499	death--parent events and are the only estimates used below.
   500	
   501	\begin{lemma}[Early ordinary-core establishment]
   502	\label{lem:early-establishment}
   503	Start from one ordinary clique mutant, with resident hub and no mutant
   504	pendants.  Let $\chi$ be the first change of the hub or pendant coordinates,
   505	let $K=\lceil A_0\log C\rceil$, and let
   506	$\tau_j=\inf\{s:i_s=j\}$ and
   507	$\tau_{0,K}=\tau_0\wedge\tau_K$.  Uniformly for
   508	$r\in\mathcal R$ and $U\in\{\Bd,\dB\}$,
   509	\begin{align}
   510	 \Prob(\chi<\tau_{0,K})&=O(K/C),\label{eq:early-mark}\\
   511	 \Prob_1(\tau_K<\tau_0)
   512	 &=1-\frac1r+O(K/C)+O(r^{-K}).\label{eq:early-est}
   513	\end{align}
   514	The constants are uniform for every fixed $A_0$.
   515	\end{lemma}
   516	
   517	\begin{proof}
   518	Until $\chi$, the exact embedded ordinary-count up/down odds are
   519	\begin{align}
   520	 R_{\Bd}(i)
   521	 &=r\,\frac{c-i}{c-i+c/(c+m)},\\
   522	 R_{\dB}(i)
   523	 &=r\,\frac{c-i}{c-i+1}
   524	 \frac{c+(r-1)(i-1)}{c+(r-1)i}.
   525	\end{align}
   526	Thus $\lambda_i^U:=(R_U(i))^{-1}=r^{-1}\{1+O(C^{-1})\}$ uniformly for
   527	$1\leq i<K$.  For large $C$, the embedded ordinary walk has conditional
   528	upward probability at least $1/2+\eta$ for some $\eta>0$ depending only on
   529	$\mathcal R$.  If $N$ is its number of changes before $\{0,K\}$, optional
   530	stopping applied to the count minus its uniform positive drift gives
   531	$\mathbb E_1N\leq K/(2\eta)=O(K)$.  At every visited state the hub-change
   532	rate is $O(i/C)$ and the ordinary-change rate is $\Theta(i)$, so their hazard
   533	ratio is $O(C^{-1})$; a union bound over
   534	the stopped changes gives \eqref{eq:early-mark}.  Pendant coordinates cannot
   535	change before the initially resident hub does.
   536	
   537	Suppressing that killing event, the product-odds formula is
   538	\[
   539	 \Prob_1(\tau_K<\tau_0)
   540	 =\left(1+\sum_{k=1}^{K-1}\prod_{j=1}^k\lambda_j^U\right)^{-1}.
   541	\]
   542	For $k<K$, the product is
   543	$r^{-k}\exp\{O(k/C)\}$; summing the geometric tail and restoring the
   544	killing event changes the answer by
   545	$O(K/C)+O(r^{-K})$.  This proves \eqref{eq:early-est}.
   546	\end{proof}
   547	\begin{lemma}[Supercritical completion and core confinement]
   548	\label{lem:core-confinement}
   549	There are constants $\delta>0$, $r_0>1$, $a,b,\gamma>0$, and an integer
   550	$R_0$, depending only on $\mathcal R$, with the following properties.
   551	Uniformly in the hub and pendant coordinates, a core family starting at
   552	$i=K$ reaches $i\geq(1-\delta)c$ before extinction except with probability
   553	\[
   554	 O(r_0^{-K})+e^{-\gamma C}.
   555	\]
   556	If $R=c-i$ and $R(0)\leq\delta c$, then for every fixed $M$,
   557	\begin{equation}
   558	 \Prob\!\left(\sup_{s\leq C^M}R_s\geq2\delta c\right)
   559	 \leq C_M C^{M+1}e^{-\gamma C},
   560	\label{eq:core-confinement}
   561	\end{equation}
   562	where time is measured in the displayed continuous-time clock.  Before the
   563	exceptional exit, the bounded strip is reached with the uniform tail
   564	\begin{equation}
   565	 \Prob\bigl(\tau_{\{R\leq R_0\}}>a\log C+x,
   566	             \tau_{2\delta c}>\tau_{\{R\leq R_0\}}\bigr)
   567	 \leq a e^{-bx}.
   568	\label{eq:deficit-return}
   569	\end{equation}
   570	\end{lemma}
   571	
   572	\begin{proof}
   573	For every hub and pendant state, the ordinary-count odds remain bounded
   574	below by a constant $r_0>1$ from $K$ to a fixed positive core density.
   575	Indeed, the two tables give the uniform lower bounds
   576	\[
   577	 \frac{q^+_{\Bd}}{q^-_{\Bd}}
   578	 \geq\frac{r}{1+c/\{d(c-i)\}},\qquad
   579	 \frac{q^+_{\dB}}{q^-_{\dB}}
   580	 =r\,\frac{h+i}{i}\frac{c-i}{c-i+1-h}
   581	 \frac{c+(r-1)(i-1+h)}{c+(r-1)(i+h)}.
   582	\]
   583	For $K\to\infty$ and $i\leq(1-\delta)c$, their infimum is strictly larger
   584	than one.  This comparison remains valid although the hidden coordinates
   585	move.  At successive $i$-change epochs, condition on the complete past.  The
   586	pointwise intensity ratio implies that the conditional probability of an
   587	upward step is at least $r_0/(1+r_0)$: this follows equivalently by comparing
   588	the two compensator integrals up to the next $i$-change.  Thus
   589	$r_0^{-i_n}$ is a supermartingale for the embedded adapted process.  Stopping
   590	on $\{0,\lfloor(1-\delta)c\rfloor\}$ gives
   591	\[
   592	 \Prob_K\bigl(\tau_0<\tau_{\lfloor(1-\delta)c\rfloor}\bigr)
   593	 \leq r_0^{-K}.
   594	\]
   595	Applying the same conditional-bias comparison across any subsequent
   596	fixed-density interval gives an $e^{-\gamma C}$ failure bound.
   597	
   598	In the upper strip $1\leq R\leq2\delta c$, the same tables give, uniformly
   599	in the hub and pendant coordinates,
   600	\begin{equation}
   601	 \frac{q(R\mapsto R-1)}{q(R\mapsto R+1)}
   602	 \geq r(1-2\delta)\frac{R}{R+1}\{1-o(1)\}.
   603	\label{eq:deficit-odds}
   604	\end{equation}
   605	Writing $r_-$ for the lower end of the chosen fitness compact, choose
   606	\[
   607	 \delta<\min\left\{\frac18,\frac{r_--1}{8r_-},
   608	 \frac{r_-^2-1}{4(r_-^2+1)}\right\}.
   609	\]
   610	Then one may take $\alpha=(r_-+1)/2>1$ and, for all sufficiently large
   611	$C$, replace the right side of \eqref{eq:deficit-odds} by
   612	$\alpha R/(R+1)$.  It is larger than $1+\eta_0$ above the fixed integer
   613	$R_0=\lceil(\alpha+1)/(\alpha-1)\rceil$; no statewise drift assertion is
   614	made below $R_0$.  The hidden hub and pendant coordinates do not make the
   615	deficit marginal Markov, so we use a conditional-bias coupling rather than
   616	assuming that they do.  At successive $R$-change epochs, condition on the
   617	entire past.  Whenever $R>R_0$, the probability of an outward step divided
   618	by that of an inward step is at most $(1+\eta_0)^{-1}$.  Choose
   619	$0<\theta<\log(1+\eta_0)$.  Then
   620	\[
   621	 \exp\{\theta R_{n\wedge\tau}\},\qquad
   622	 \tau=\tau_{\{R\leq R_0\}}\wedge\tau_{\{R\geq2\delta c\}},
   623	\]
   624	is a supermartingale for the embedded adapted process.  Optional stopping
   625	therefore gives, uniformly in all hidden-coordinate histories,
   626	\begin{equation}
   627	 \sup_{k\leq\delta c}
   628	 \Prob_k(\tau_{\{R\geq2\delta c\}}<\tau_{\{R\leq R_0\}})
   629	 \leq e^{-\theta\delta c}=e^{-\gamma C}.
   630	\label{eq:deficit-initial-excursion}
   631	\end{equation}
   632	The same estimate, started at $R_0+1$, controls every later excursion.
   633	The total $R$-change intensity in the displayed clock is at most $\Lambda C$.
   634	Its compensator through time $C^M$ is therefore at most
   635	$\Lambda C^{M+1}$.  Applying the strong Markov property at successive
   636	entries into $R_0+1$ and multiplying the last excursion bound by the expected
   637	number of entries proves \eqref{eq:core-confinement}; Markov's inequality for
   638	the compensator already suffices.
   639	
   640	For completeness, the stopped generator calculation behind the return-time
   641	claim is also explicit.  Substituting $i=c-R$ in the two tables gives
   642	\begin{align*}
   643	 \mathcal G_{\Bd}R
   644	 &=(c-R)\left\{\frac{1-h}{d}+\frac Rc\right\}
   645	   -rR\left\{\frac hd+\frac{c-R}{c}\right\},\\
   646	 \mathcal G_{\dB}R
   647	 &=(c-R)\frac{R+1-h}{c+(r-1)(c-R-1+h)}
   648	   -R\frac{r(c-R+h)}{c+(r-1)(c-R+h)}.
   649	\end{align*}
   650	After increasing $R_0$ and decreasing $\delta$ if necessary, both are at
   651	most $-\kappa R$ for $R_0<R<2\delta c$, uniformly in $h,\ell$, and
   652	$r\in\mathcal R$.  Thus
   653	$e^{\kappa(s\wedge\tau)}R_{s\wedge\tau}$ is a supermartingale in the
   654	displayed clock.  On the event in \eqref{eq:deficit-return} it has not yet
   655	hit either boundary at time $a\log C+x$.  Hence
   656	\[
   657	 \Prob(\tau_{\{R\leq R_0\}}>a\log C+x,
   658	       \tau_{\{R\geq2\delta c\}}>\tau_{\{R\leq R_0\}})
   659	 \leq \frac{\delta C}{R_0}e^{-\kappa(a\log C+x)}.
   660	\]
   661	Taking $a>2/\kappa$ proves \eqref{eq:deficit-return}.  The states below
   662	$R_0$ form the announced boundary layer and require no statewise drift claim.
   663	\end{proof}
   664	
   665	\begin{lemma}[Pendant synchronization and pendant initialization]
   666	\label{lem:pendant-cleanup}
   667	For every fixed $B_0>0$ there is a fixed $D_{\rm cl}=D_{\rm cl}(B_0)$ such
   668	that, under either update
   669	rule and uniformly in $r\in\mathcal R$, a state with
   670	$i\geq(1-\delta)c$ reaches fixation within time $C^{D_{\rm cl}}$, except with
  1130	 \leq \eta_L(L_1,T)+\frac{K(m+a_{L_1})}{C}
  1131	      +K_{L_1}\vartheta^{L_2-L_1}+x^{\dB}_{C,L_2}.
  1132	\label{eq:renewal-y-dB}
  1133	\end{equation}
  1134	For fixed $L_1,L_2,T$, let $C\to\infty$; then let $L_2\to\infty$,
  1135	$L_1\to\infty$, and $T\to\infty$ in that order.  Equations
  1136	\eqref{eq:renewal-y-Bd}--\eqref{eq:renewal-y-dB} prove
  1137	$y^U_{C,L}=o(1)$ for each fixed $L$.
  1138	
  1139	Return now to one ordinary mutant.  At its first hub change, the explicit
  1140	hazard-weighted estimates \eqref{eq:green-macro} and
  1141	\eqref{eq:green-hub-tail} give a constant $a$ such that
  1142	\begin{equation}
  1143	 x^U_{C,1}\leq a e^{-\kappa C}
  1144	 +\frac aC\bigl(y^U_{C,L}+e^{-\theta L}\bigr).
  1145	\label{eq:renewal-refined}
  1146	\end{equation}
  1147	Therefore
  1148	$\limsup_{C\to\infty}Cx^U_{C,1}\leq ae^{-\theta L}$; letting $L\to\infty$
  1149	proves $x^U_{C,1}=o(C^{-1})$, while
  1150	\eqref{eq:renewal-y-Bd}--\eqref{eq:renewal-y-dB} give
  1151	$y^U_{C,0}=o(1)$.  Hence
  1152	\begin{align*}
  1153	 u_{\mathrm{core}}^{\Bd}(1/r)
  1154	 &\leq\frac{C-1}{C}x^{\Bd}_{C,1}+\frac1Cy^{\Bd}_{C,0}
  1155	 =o(C^{-1}),\\
  1156	 J_H(1/r)
  1157	 &\leq x^{\dB}_{C,1}+\frac{y^{\dB}_{C,0}}{c+m}
  1158	 =o(C^{-1}),
  1159	\end{align*}
  1160	because every ordinary clique vertex has degree $c$ and the hub has degree
  1161	$c+m$.
  1162	\end{proof}
  1163	
  1164	\begin{proof}[Proof of Proposition~\ref{prop:center}]
  1165	Choose $A_0$ so that both $r^{-K}$ and $r_0^{-K}$ in
  1166	Lemmas~\ref{lem:early-establishment} and \ref{lem:core-confinement} are
  1167	$o(q/C)=o(C^{-3/4})$, and then choose $B_0>3/4$ in
  1168	Lemma~\ref{lem:pendant-cleanup}.  Since
  1169	\[
  1170	 K/C=o(C^{-3/4}),\qquad C^{-B_0}=o(C^{-3/4}),
  1171	\]
  1172	the early-establishment probability is $p+o(q/C)$ and every established
  1173	family completes fixation with failure $o(q/C)$.  The hub starting vertex
  1174	has normalized mass $C^{-1}=o(q/C)$.  This proves \eqref{eq:core};
  1175	Lemma~\ref{lem:pendant-cleanup} proves \eqref{eq:leaf-Bd} and
  1176	\eqref{eq:leaf-dB}; and Lemma~\ref{lem:reciprocal-renewal} proves the two
  1177	reciprocal estimates.
  1178	
  1179	Finally, average the $C-1$ ordinary starts, the hub start, and the $m$
  1180	pendant starts.  Their contributions give
  1181	\eqref{eq:center-Bd}--\eqref{eq:center-dB}; the exceptional hub mass is
  1182	$O(C^{-1})=o(q/C)$.
  1183	\end{proof}
