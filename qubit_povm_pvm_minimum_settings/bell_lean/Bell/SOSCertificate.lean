/-- Positive rational pivots; no numerical eigenvalue assertion is used. -/
def d : Fin 12 → ℝ :=
  ![1709/200, 1426919/512700, 14708674207/5136908400, 9898090813/220630113105, 24456772829/18273398424000, 41401715648/23845353508275, 34772929105711/49682058777600, 18303116918443169/20863757463426600, 111070262548793587/2745467537766475350, 2243221727747830703/53313726023420921760, 819112451261122424/841208147905436513625, 1041574196880775019/561677109436198233600]

theorem pivot_positive (k : Fin 12) : 0 < d k := by
  fin_cases k <;> norm_num [d]

theorem coefficient_factorization : Q = ldl L d := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [Q, numerator, ldl, L, d, Fin.sum_univ_succ]

theorem numerator_symmetric (i j : Fin 12) : numerator i j = numerator j i := by
  fin_cases i <;> fin_cases j <;> norm_num [numerator]

