     1	\section{Model and main results}\label{sec:model-results}
     2	
     3	Let $V=\{1,\ldots,n\}$ and let $w_{uv}\ge0$ be the weight with which source
     4	$u$ competes to replace target $v$.  We assume $w_{vv}=0$ and every incoming
     5	degree $d_v^-=\sum_{u\ne v}w_{uv}$ is positive.  Normalize
     6	\[
     7	 P_{vu}=\frac{w_{uv}}{d_v^-}.                              \tag{2.1}\label{2.1}
     8	\]
     9	Write $P(W)$ for this kernel.  Then $P(W)$ is loopless and row stochastic.
    10	Conversely, every such $P$ is a normalized directed replacement structure.
    11	This quotient removes exactly the dynamically irrelevant positive rescalings
    12	of individual incoming columns.  When weights rather than their normalized
    13	kernel are displayed, we use the shorthand
    14	$\rho_{\dB}(W,r):=\rho_{\dB}(P(W),r)$.
    15	
    16	A uniformly chosen target dies.  If the current mutant set is $S$ and mutant
    17	fitness is $r>0$, the probability that target $v$ receives a mutant parent is
    18	\[
    19	 f_r(P_{vS})=\frac{rP_{vS}}{1+(r-1)P_{vS}},
    20	 \qquad P_{vS}=\sum_{u\in S}P_{vu}.                         \tag{2.2}\label{2.2}
    21	\]
    22	The all-resident and all-mutant states are absorbing.  We write
    23	$\rho_{\dB}(P,r)$ for fixation probability averaged over a uniformly random
    24	singleton mutant.  For the complete kernel
    25	\[
    26	 (J_n)_{vu}=\frac1{n-1}\quad(u\ne v),                       \tag{2.3}\label{2.3}
    27	\]
    28	one-dimensional first-step equations give
    29	\[
    30	 \rho_{\dB}(J_n,r)
    31	 =\frac{n-1}{n}\frac{1-r^{-1}}{1-r^{-(n-1)}}.               \tag{2.4}\label{2.4}
    32	\]
    33	At $r=1$, the right-hand side is understood by continuity and equals $1/n$.
    34	
    35	Let
    36	\[
    37	 \calT_n=\{\delta\in\mathbb R^{n\times n}:
    38	     \delta_{ii}=0,\ \delta\one=0\}                       \tag{2.5}\label{2.5}
    39	\]
    40	be the tangent space to the normalized kernel polytope at $J_n$, and let
    41	\[
    42	 \calB_n=\{\delta\in\calT_n:\one^{\mathsf T}\delta=0\}       \tag{2.5b}\label{2.5b}
    43	\]
    44	be its balanced, or bistochastic, tangent subspace.
    45	
    46	\begin{theorem}[fitness-two strict local optimality]
    47	\label{thm:local}
    48	For every $n\ge3$ there is a quadratic form $\Rtwo_{n}$ on $\calT_n$ such
    49	that, for every $\delta\in\calT_n$ and all sufficiently small
    50	$\varepsilon$ for which $J_n+\varepsilon\delta$ is nonnegative,
    51	\[
    52	 \frac1{n\rho_{\dB}(J_n+\varepsilon\delta,2)}
    53	 =\frac1{m_n}+\varepsilon^2\Rtwo_{n}(\delta)
    54	   +O(\varepsilon^3),                                      \tag{2.6}\label{2.6}
    55	\]
    56	where
    57	\[
    58	 m_n=\frac{(n-1)2^{n-2}}{2^{n-1}-1}.                       \tag{2.7}\label{2.7}
    59	\]
    60	The quadratic form $\Rtwo_n$ is positive definite on $\calT_n$.
    61	Consequently, the first variation vanishes for every $\delta\in\calT_n$,
    62	and, for every nonzero $\delta\in\calT_n$,
    63	\[
    64	 \left.\frac{d}{d\varepsilon}\rho_{\dB}
    65	 (J_n+\varepsilon\delta,2)\right|_{0}=0,
    66	 \qquad
    67	 \left.\frac{d^2}{d\varepsilon^2}\rho_{\dB}
    68	 (J_n+\varepsilon\delta,2)\right|_{0}
    69	 =-\frac{2m_n^2}{n}\Rtwo_{n}(\delta)<0.                    \tag{2.8}\label{2.8}
    70	\]
    71	Thus $J_n$ is a strict nondegenerate local maximizer in the full positive
    72	loopless row-stochastic kernel polytope.  For $n=2$ every positive weighting
    73	induces the same two-vertex chain and ties the baseline.
    74	\end{theorem}
    75	
    76	For clarity, the positive-kernel hypothesis used by the duality proof loses
    77	no tangent direction.  For fixed nonzero $\delta\in\calT_n$, put
    78	$M=\max_{i\ne j}|\delta_{ij}|$.  Whenever
    79	$|\varepsilon|<1/[(n-1)M]$, every off-diagonal entry of
    80	$J_n+\varepsilon\delta$ is strictly positive.  The zero direction is
    81	trivial.  Thus the expansion in Theorem~\ref{thm:local} is proved entirely
    82	inside the positive kernel polytope before being interpreted at its tangent
    83	space.
    84	
    85	For a positive normalized kernel on complete directed support, define the
    86	scale-free defect
    87	\[
    88	 \calE_{\rm dir}(P)=
    89	 \sum_v\sum_{\substack{u<z\\u,z\ne v}}
    90	 \frac{(P_{vu}-P_{vz})^2}{P_{vu}P_{vz}}.                   \tag{2.9}\label{2.9}
    91	\]
    92	For unnormalized weights $W$, set
    93	$\calE_{\rm dir}(W):=\calE_{\rm dir}(P(W))$; equivalently,
    94	\[
    95	 \calE_{\rm dir}(W)=
    96	 \sum_v\sum_{\substack{u<z\\u,z\ne v}}
    97	 \frac{(w_{uv}-w_{zv})^2}{w_{uv}w_{zv}}.                  \tag{2.9b}\label{2.9b}
    98	\]
    99	
   100	\begin{theorem}[complete-support strong-selection correction]
   101	\label{thm:strong-complete}
   102	Let $n\ge3$ and suppose $w_{uv}>0$ for every $u\ne v$.  For fixed $W$,
   103	\[
   104	 \rho_{\dB}(J_n,r)-\rho_{\dB}(W,r)
   105	 =\frac{\calE_{\rm dir}(W)}{n^2(n-2)r}+O(r^{-2})
   106	 \qquad(r\to\infty).                                      \tag{2.10}\label{2.10}
   107	\]
   108	The defect vanishes if and only if, for every target $v$, all incoming
   109	weights $w_{uv}$ with $u\ne v$ are equal.  In that equality class the entire
   110	chain, not merely the asymptotic expansion, equals the complete-graph chain.
   111	\end{theorem}
   112	
   113	\begin{corollary}[no fixed finite universal dB amplifier]
   114	\label{cor:fixed}
   115	No finite loopless directed weighting with positive incoming degrees is a
   116	strict dB amplifier for every $r>1$.  More precisely, it is strictly
   117	suppressing for all sufficiently large fitness unless it has complete
   118	support and is dynamically equivalent to $J_n$; in the latter case it ties
   119	the baseline for every fitness.
   120	\end{corollary}
   121	
   122	For undirected weights, write $s_i$ for the number of positive-weight
   123	neighbors of $i$.
   124	
   125	\begin{proposition}[undirected support limit]\label{prop:support-limit}
   126	For every finite connected undirected weighted graph,
   127	\[
   128	 \lim_{r\to\infty}\rho_{\dB}(W,r)
   129	 =\frac1n\sum_{i=1}^n\frac{s_i}{s_i+1}.                     \tag{2.11}\label{2.11}
   130	\]
   131	Hence an incomplete support has the positive limiting deficit
   132	\[
   133	 \frac{n-1}{n}-\frac1n\sum_i\frac{s_i}{s_i+1}
   134	 =\sum_i\frac{n-1-s_i}{n^2(s_i+1)}.                         \tag{2.12}\label{2.12}
   135	\]
   136	\end{proposition}
   137	
   138	Finally, the complete kernel is globally extremal on the smallest
   139	nontrivial undirected order.
   140	
   141	\begin{theorem}[weighted triangles]\label{thm:triangle}
   142	For every positive undirected weighted triangle and every $r>1$,
   143	\[
   144	 \rho_{\dB}(W,r)\le\rho_{\dB}(J_3,r)=\frac{2r}{3(r+1)}.     \tag{2.13}\label{2.13}
   145	\]
   146	Equality holds if and only if the three edge weights are equal.
   147	\end{theorem}
   148	
   149	The two symmetric $K_4$ families and their equality statements are recorded
   150	in Appendix~\ref{app:k4}.  They provide global four-vertex slices but are not
   151	needed for Theorems~\ref{thm:local} or \ref{thm:strong-complete}.
