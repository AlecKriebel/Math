     1	\section{Boolean ancestry, coverage, and collision}\label{sec:duality}
     2	
     3	This section is valid for every positive loopless row-stochastic $P$;
     4	reversibility is not used.
     5	
     6	\subsection{The fair-geometric union dual}
     7	
     8	At fitness two, \eqref{2.2} becomes $2x/(1+x)$.  This is a finite additive
     9	graphical system in the sense of \citet{Harris1978}.  Let $L$ have the fair
    10	geometric law
    11	\[
    12	 \Pp(L=\ell)=2^{-\ell},\qquad \ell\ge1,                       \tag{3.1}\label{3.1}
    13	\]
    14	and, conditionally on target $v$, draw $U_1,\ldots,U_L$
    15	independently from row $P_v$.  For any mutant set $S$,
    16	\[
    17	 \Pp(U_1,\ldots,U_L\notin S)
    18	 =\E(1-P_{vS})^L=\frac{1-P_{vS}}{1+P_{vS}}.                  \tag{3.2}\label{3.2}
    19	\]
    20	Thus the forward update at $v$ is exactly the additive Boolean map
    21	\[
    22	 x_v\longleftarrow x_{U_1}\vee\cdots\vee x_{U_L}.           \tag{3.3}\label{3.3}
    23	\]
    24	The transpose graphical map sends a nonempty ancestral set $A$ to
    25	\[
    26	 A\longmapsto
    27	 \begin{cases}
    28	 (A\setminus\{v\})\cup\{U_1,\ldots,U_L\},&v\in A,\\
    29	 A,&v\notin A.
    30	 \end{cases}                                                 \tag{3.4}\label{3.4}
    31	\]
    32	Because $P_{vv}=0$, the updated set in the first line omits $v$ and is
    33	always nonempty; hence the dual remains a proper nonempty subset whenever it
    34	starts there.
    35	
    36	Using the same graphical marks forward and backward gives the exact duality
    37	\[
    38	 \Pp_S(X_t\cap A\ne\varnothing)
    39	 =\Pp_A(S\cap A_t\ne\varnothing).                            \tag{3.5}\label{3.5}
    40	\]
    41	
    42	\begin{lemma}[ergodicity of the union dual]\label{lem:dual-ergodic}
    43	If every off-diagonal entry of $P$ is positive, then the chain in
    44	\eqref{3.4} is irreducible and aperiodic on the proper nonempty subsets of
    45	$V$.
    46	\end{lemma}
    47	
    48	\begin{proof}
    49	From any set $A$ of size at least two, choose a target $v\in A$, take $L=1$,
    50	and sample $U_1\in A\setminus\{v\}$.  This removes $v$ and changes no other
    51	element.  Repetition reaches a singleton.  Conversely, fix any proper
    52	nonempty destination $B$ and choose $x\notin B$.  A singleton can first be
    53	moved to $\{x\}$ using a one-sample update.  An update targeted at $x$ whose
    54	finite geometric burst visits every element of $B$ and no element outside
    55	$B$ then has output exactly $B$.  Every event just described has positive
    56	probability because $P$ is positive off the diagonal and every finite value
    57	of $L$ has positive probability.  Hence the chain is irreducible.  Finally,
    58	every proper $A$ has a target outside $A$; choosing it leaves $A$ unchanged,
    59	so every state has a positive self-loop and the chain is aperiodic.
    60	\end{proof}
    61	
    62	Let $\Pi_P$ denote its stationary law and put
    63	\[
    64	 m(P)=\E_{\Pi_P}|A|.                                         \tag{3.6}\label{3.6}
    65	\]
    66	For a set function $f$ and $i\notin S$, write
    67	\[
    68	 \Delta_i f(S)=f(S\cup\{i\})-f(S),\qquad
    69	 \Delta_T=\prod_{i\in T}\Delta_i
    70	 \quad(T\cap S=\varnothing).                                \tag{3.6a}\label{3.6a}
    71	\]
    72	The difference operators in the product commute.
    73	
    74	\begin{proposition}[coverage representation]\label{prop:coverage}
    75	The fixation committor at fitness two is
    76	\[
    77	 h_P(S)=\Pp_{A\sim\Pi_P}(A\cap S\ne\varnothing),            \tag{3.7}\label{3.7}
    78	\]
    79	and therefore
    80	\[
    81	 \rho_{\dB}(P,2)=\frac{m(P)}n.                              \tag{3.8}\label{3.8}
    82	\]
    83	Moreover, for every nonempty $T$ disjoint from $S$,
    84	\[
    85	 (-1)^{|T|+1}\Delta_T h_P(S)
    86	 =\Pp_{\Pi_P}(A\cap S=\varnothing,\ T\subseteq A)\ge0.      \tag{3.9}\label{3.9}
    87	\]
    88	Thus $h_P$ is a normalized completely alternating coverage function.
    89	\end{proposition}
    90	
    91	\begin{proof}
    92	The finite forward chain absorbs almost surely.  Indeed, from every
    93	nonabsorbing mutant set, a sequence of resident-target deaths followed by
    94	mutant-parent choices gives a positive-probability path to $V$; hence the
    95	finite chain has no other closed communicating class.  Start the dual from $V$ in
    96	\eqref{3.5}.  Its first active update sends $V$ to $V\setminus\{v\}$ because
    97	all sampled parents differ from the target $v$; Lemma~\ref{lem:dual-ergodic}
    98	then gives convergence to $\Pi_P$.  Letting $t\to\infty$, the left side
    99	converges to the fixation probability from $S$, giving \eqref{3.7}.
   100	Averaging $h_P(\{i\})=\Pp(i\in A)$ over $i$ proves
   101	\eqref{3.8}.  For fixed $A$, the indicator
   102	$\one_{\{A\cap S\ne\varnothing\}}$ has mixed difference
   103	$(-1)^{|T|+1}\Delta_T$ equal to
   104	$\one_{\{A\cap S=\varnothing,\ T\subseteq A\}}$; averaging proves
   105	\eqref{3.9}.
   106	\end{proof}
   107	
   108	\subsection{A one-sample active chain}
   109	
   110	The geometric burst can be factored into one-sample steps.  Two phase spaces
   111	are required:
   112	\[
   113	 \mathcal Z_n=\{(C,v):C\subseteq V\setminus\{v\}\},\qquad
   114	 \mathcal Y_n=\{(B,v):\varnothing\ne B\subseteq V\setminus\{v\}\}.
   115	                                                                    \tag{3.10}\label{3.10}
   116	\]
   117	The pre-sampling space $\mathcal Z_n$ permits the empty cache created when a
   118	singleton is stopped.  Let $A:\mathcal Z_n\to\mathcal Y_n$ adjoin one source
   119	$i$ sampled from row $P_v$.  Let $R:\mathcal Y_n\to\mathcal Z_n$ be the fair
   120	continue-or-retarget channel: on continue it sends $(B,v)$ to $(B,v)$, while
   121	on stop it chooses $w$ uniformly from $B$ and sends $(B,v)$ to
   122	$(B\setminus\{w\},w)$.  Row laws act on the right, so $K(P)=RA$ is a kernel
   123	on $\mathcal Y_n$ and $M(P)=AR$ is a kernel on $\mathcal Z_n$.  Explicitly,
   124	from $y=(B,v)$, with $b=|B|$, $K(P)$ is the following fair mixture:
   125	\begin{enumerate}
   126	\item sample $i$ from row $P_v$ and move to $(B\cup\{i\},v)$;
   127	\item choose $w$ uniformly from $B$, sample $i$ from row $P_w$, and move to
   128	      $((B\setminus\{w\})\cup\{i\},w)$.
   129	\end{enumerate}
   130	Each branch has probability $1/2$.  The first branch continues a geometric
   131	burst; the second stops it and retargets the active ancestral mark.
   132	
   133	\begin{lemma}[active collision identity]\label{lem:active}
   134	The active kernel $K(P)$ is irreducible and aperiodic.  Let $\nu(P)$ be its
   135	unique stationary law and put
   136	\[
   137	 H(B,v)=\frac1{|B|}.                                        \tag{3.11}\label{3.11}
   138	\]
   139	Then
   140	\[
   141	 \nu(P)H=\frac1{m(P)}=\frac1{n\rho_{\dB}(P,2)}.             \tag{3.12}\label{3.12}
   142	\]
   143	The map $P\mapsto K(P)$ is linear.
   144	\end{lemma}
   145	
   146	\begin{proof}
   147	We include the marked-current calculation because it is the bridge from the
   148	coverage law to the Hessian.  Let $T_v(A,B)$ be the transition kernel of one
   149	union-dual update with target fixed at $v$.  Extend $\Pi_P$ by zero off the
   150	proper nonempty subsets of $V$.  For $v\notin C$, including
   151	$C=\varnothing$, define
   152	\[
   153	 \sigma_v(C)=\Pi_P(C\cup\{v\}),\qquad
   154	 \eta_v(C)=\sum_A\Pi_P(A)T_v(A,C)-\Pi_P(C).                 \tag{3.13a}\label{3.13a}
   155	\]
   156	The subtracted term is exactly the passive current from $A=C$, for which
   157	$v\notin A$ and no ancestral update occurs; hence $\eta_v(C)$ is the
   158	nonnegative active current arriving at output $(C,v)$.  Stationarity of the
   159	union dual, after summing its $n$ equally likely target updates, gives
   160	\[
   161	 \sum_{v\notin B}\eta_v(B)=|B|\Pi_P(B).                    \tag{3.13}\label{3.13}
   162	\]
   163	If $A_v$ adjoins one sample from row $P_v$, the fair-geometric resolvent
   164	identity gives
   165	\[
   166	 \lambda_v=\frac{\sigma_v+\eta_v}{2},\qquad
   167	 \eta_v=\lambda_vA_v.                                      \tag{3.14}\label{3.14}
   168	\]
   169	For the rectangular channels just defined, after the sample, continuing contributes
   170	$\eta_v(B)/2$ to $(B,v)$.  Stopping, choosing $w$ uniformly from $B$, and
   171	ending at $(B\setminus\{w\},w)$ contributes, by \eqref{3.13},
   172	$\Pi_P(B)/2=\sigma_w(B\setminus\{w\})/2$.  Hence
   173	$\lambda AR=\lambda$.  Thus $\lambda$ is stationary on $\mathcal Z_n$ for
   174	$M=AR$.  Since $\eta=\lambda A$, associativity gives $\eta RA=\eta$; hence
   175	$\eta$ is stationary on $\mathcal Y_n$ for the active kernel $K=RA$.  Both
   176	$\sigma_v$ and $\eta_v$ have total mass
   177	$\Pp_{\Pi_P}(v\in A)$, so
   178	\[
   179	 \sum_{v,C}\lambda_v(C)=m(P).                              \tag{3.15}\label{3.15}
   180	\]
   181	Normalizing gives the probability laws $\lambda/m(P)$ on $\mathcal Z_n$ and
   182	$\nu(P)=\eta/m(P)$ on $\mathcal Y_n$.  The latter stationary law is unique:
   183	if $|B|\ge2$, a stop at $w\in B$ followed by sampling a member of
   184	$B\setminus\{w\}$ shrinks $B$ by one.  From a singleton state, one or two
   185	positive stop moves reach any prescribed singleton--target pair $(\{j\},v)$
   186	with $j\ne v$.  Positive continue moves then sample the remaining members of
   187	any prescribed active set.  Hence $K(P)$ is irreducible; sampling an already
   188	present source on a continue move gives a self-loop, so it is also aperiodic.
   189	Dividing
   190	\eqref{3.13} by $|B|$ and summing over $B$ yields
   191	\[
   192	 \nu(P)H=\sum_{k\ge1}\frac{k\Pi_P(|A|=k)}{m(P)}\frac1k
   193	 =\frac1{m(P)}.                                             \tag{3.16}\label{3.16}
   194	\]
   195	Both active moves contain exactly one use of a row of $P$, proving linearity.
   196	\end{proof}
   197	
   198	At the complete kernel, put $N=n-1$.  Direct substitution gives
   199	\[
   200	 \nu_0(B,v)=\frac{|B|}{nN2^{N-1}},\qquad
   201	 c_0:=\nu_0H=\frac{2^N-1}{N2^{N-1}}=\frac1{m_n}.             \tag{3.17}\label{3.17}
   202	\]
   203	This agrees with \eqref{2.4} at $r=2$.
   204	
   205	The collision interpretation uses the conjugate sample-then-retarget chain,
   206	not the retarget-then-sample phase order of $K=RA$.  Specifically,
   207	\[
   208	 \frac{\lambda}{m(P)}\xrightarrow{\ A\ }
   209	 \frac{\eta}{m(P)}=\nu(P)\xrightarrow{\ R\ }
   210	 \frac{\lambda}{m(P)},
   211	 \qquad
   212	 \frac{\eta}{m(P)}\xrightarrow{\ R\ }
   213	 \frac{\lambda}{m(P)}\xrightarrow{\ A\ }
   214	 \frac{\eta}{m(P)}.                                      \tag{3.18a}\label{3.18a}
   215	\]
   216	Thus $M(P)=AR$ has stationary law $\lambda/m(P)$, while $K(P)=RA$ has
   217	stationary law $\eta/m(P)=\nu(P)$.  In one $M(P)$ step, let $I$ be the source
   218	drawn by $A$.  The post-sampling set $B$ contains $I$ and has law $\nu(P)$.
   219	If the subsequent fair coin in $R$ stops, it chooses the new target $W$
   220	uniformly from that same set $B$.  Consequently
   221	\[
   222	 \Pp(W=I\mid B,\mathrm{stop})=\frac1{|B|},
   223	\]
   224	and averaging with \eqref{3.12} gives
   225	\[
   226	 \Pp(\mathrm{stop},W=I)=\frac1{2m(P)},\qquad
   227	 \Pp(W=I\mid\mathrm{stop})=\frac1{m(P)}.                  \tag{3.18}\label{3.18}
   228	\]
   229	Thus maximizing fixation is equivalent to minimizing this stationary
   230	collision rate.
