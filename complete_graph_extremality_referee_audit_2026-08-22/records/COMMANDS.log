P_1&0\\
P_k&k(k-1)d_k/(k+1),\quad 2\le k<N\\
R_1&0\\
R_2&Nd_2+Nd_1/2\\
R_k&Nd_k+{\frac{k-1}{ k}}(N+1-2/k)d_{k-1},\quad 3\le k<N
