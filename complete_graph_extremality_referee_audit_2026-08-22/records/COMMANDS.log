     1	\section{Fixed structures at strong selection}\label{sec:strong}
     2	
     3	We now prove Theorem~\ref{thm:strong-complete},
     4	Corollary~\ref{cor:fixed}, and Proposition~\ref{prop:support-limit}.
     5	
     6	\subsection{Complete-graph baseline}
     7	
     8	Let $\phi_k$ be complete-graph fixation from $k$ mutants and let
     9	$\gamma_k$ be the ratio of the probabilities of decreasing and increasing
    10	$k$.  First-step equations give
    11	\[
    12	 \phi_1=\left(1+\sum_{j=1}^{n-1}\prod_{k=1}^j\gamma_k\right)^{-1}.
    13	                                                                    \tag{5.1}\label{5.1}
    14	\]
    15	Under dB updating,
    16	\[
    17	 \gamma_k=\frac{n-1+(r-1)k}{r\{n-1+(r-1)(k-1)\}},                 \tag{5.2}\label{5.2}
    18	\]
    19	so the product telescopes and yields \eqref{2.4}.  For $n\ge3$,
    20	\[
    21	 \rho_{\dB}(J_n,r)=\frac{n-1}{n}-\frac{n-1}{nr}+O(r^{-2}).       \tag{5.3}\label{5.3}
    22	\]
    23	
    24	We use the following standard finite-state observation.
    25	
    26	\begin{lemma}[finite-state perturbation]\label{lem:finite-perturb}
    27	Let a finite absorbing transition matrix depend analytically on
    28	$\varepsilon$ near zero.  If the transient restriction at $\varepsilon=0$
    29	has spectral radius below one, then all absorption probabilities are analytic
    30	near zero.  More generally, if a limiting reachable transient class has a
    31	bounded fundamental matrix and one-step leakage is $O(\varepsilon)$, then
    32	leakage before absorption is $O(\varepsilon)$.
    33	\end{lemma}
    34	
    35	\begin{proof}
    36	Write the transient absorption equation as $(I-Q(\varepsilon))h=b$.  The
    37	inverse exists near zero and is analytic by the adjugate formula.  On a
    38	restricted limiting class, its bounded fundamental matrix times the leakage
    39	vector bounds the probability of leaving before absorption.
    40	\end{proof}
    41	
    42	\subsection{Complete directed support}
    43	
    44	Assume $n\ge3$ and $w_{uv}>0$ for $u\ne v$.  Put
    45	\[
    46	 \varepsilon=r^{-1},\qquad
    47	 a_{uv}=\frac{d_v^--w_{uv}}{w_{uv}}.                         \tag{5.4}\label{5.4}
    48	\]
    49	Let $q_S(\varepsilon)$ be extinction probability from mutant set $S$.  At
    50	$\varepsilon=0$, every set with at least two mutants fixates, while
    51	$q_{\{i\}}(0)=1/n$.  The limiting transient chain absorbs, so Lemma
    52	\ref{lem:finite-perturb} gives analyticity.
    53	
    54	Differentiate the exact first-step system.  If $3\le|S|\le n-1$, a
    55	first-order loss still leaves at least two mutants, whose zeroth-order
    56	extinction is zero.  The derivative therefore satisfies
    57	\[
    58	 (n-|S|)q'_S(0)=\sum_{v\notin S}q'_{S\cup\{v\}}(0).           \tag{5.5}\label{5.5}
    59	\]
    60	Backward induction from $q'_V(0)=0$ gives
    61	\[
    62	 q_S(\varepsilon)=O(\varepsilon^2),\qquad |S|\ge3.           \tag{5.6}\label{5.6}
    63	\]
    64	
    65	For a pair $S=\{i,j\}$, loss of target $i$ has probability
    66	\[
    67	 \frac1n\frac{\varepsilon(d_i^--w_{ji})}
    68	 {w_{ji}+\varepsilon(d_i^--w_{ji})}
    69	 =\frac{\varepsilon a_{ji}}n+O(\varepsilon^2),               \tag{5.7}\label{5.7}
    70	\]
    71	and similarly for target $j$.  The leading self-loop mass is $2/n$, the
    72	leading gain mass is $(n-2)/n$, and a resulting singleton has extinction
    73	$1/n+O(\varepsilon)$.  Hence
    74	\[
    75	 q_{\{i,j\}}(\varepsilon)
    76	 =\frac{a_{ij}+a_{ji}}{n(n-2)}\varepsilon+O(\varepsilon^2).  \tag{5.8}\label{5.8}
    77	\]
    78	
    79	From singleton $\{i\}$, death of resident target $v$ creates the pair
    80	$\{i,v\}$ with probability
    81	\[
    82	 t_{iv}=\frac1n\frac{w_{iv}}
    83	 {w_{iv}+\varepsilon(d_v^--w_{iv})}
    84	 =\frac1n(1-a_{iv}\varepsilon)+O(\varepsilon^2).             \tag{5.9}\label{5.9}
    85	\]
    86	Death of $i$ causes extinction with probability $1/n$.  Removing holding
    87	probabilities gives
    88	\[
    89	 \left(\frac1n+\sum_{v\ne i}t_{iv}\right)q_{\{i\}}
    90	 =\frac1n+\sum_{v\ne i}t_{iv}q_{\{i,v\}}.                   \tag{5.10}\label{5.10}
    91	\]
    92	Define
    93	\[
    94	 O_i=\sum_{v\ne i}a_{iv},\qquad I_i=\sum_{u\ne i}a_{ui}.    \tag{5.11}\label{5.11}
    95	\]
    96	Substitution of \eqref{5.8} into \eqref{5.10} yields
    97	\[
    98	 q_{\{i\}}(\varepsilon)
    99	 =\frac1n+\frac{\varepsilon}{n^2}
   100	 \left[O_i+\frac{O_i+I_i}{n-2}\right]+O(\varepsilon^2).    \tag{5.12}\label{5.12}
   101	\]
   102	Since $\sum_iO_i=\sum_iI_i=:T_{\rm dir}(W)$, uniform averaging gives
   103	\[
   104	 \rho_{\dB}(W,r)
   105	 =\frac{n-1}{n}-\frac{T_{\rm dir}(W)}{n^2(n-2)r}+O(r^{-2}), \tag{5.13}\label{5.13}
   106	\]
   107	where
   108	\[
   109	 T_{\rm dir}(W)=\sum_v\sum_{u\ne v}\frac{d_v^--w_{uv}}{w_{uv}}.
   110	                                                                    \tag{5.14}\label{5.14}
   111	\]
   112	
   113	For each target column, the elementary identity
   114	\[
   115	 d_v^-\sum_{u\ne v}\frac1{w_{uv}}-(n-1)^2
   116	 =\sum_{\substack{u<z\\u,z\ne v}}
   117	   \frac{(w_{uv}-w_{zv})^2}{w_{uv}w_{zv}}                   \tag{5.15}\label{5.15}
   118	\]
   119	gives
   120	\[
   121	 T_{\rm dir}(W)-n(n-1)(n-2)=\calE_{\rm dir}(W).             \tag{5.16}\label{5.16}
   122	\]
   123	Equations \eqref{5.3}, \eqref{5.13}, and \eqref{5.16} prove
   124	Theorem~\ref{thm:strong-complete}.  Equality in \eqref{5.15} forces each
   125	incoming column to be constant.  Such column constants cancel from every
   126	parent competition, so the full chain is exactly the $J_n$ chain.
   127	
   128	\subsection{Noncomplete supports and fixed-graph closure}
   129	
   130	If the positive directed support is strongly connected but noncomplete,
   131	Theorem~1 of \citet{Tkadlec2020} proves eventual strict dB suppression.  It
   132	remains to remove strong connectivity.
   133	
   134	Consider the condensation DAG.  If it has at least two source strongly
   135	connected components, then a uniformly initialized singleton leaves at least
   136	one source component entirely resident and unable to receive mutant ancestry;
   137	fixation is impossible.  Otherwise let $C\subsetneq V$ be the unique source
   138	component.  Initial mutants outside $C$ cannot fixate.  For $i\in C$, let
   139	$s_i^+$ be its positive out-support size.  While $i$ is the only mutant, its
   140	chance to make a first gain before dying is at most $s_i^+/(s_i^++1)$.  Thus
   141	\[
   142	 \rho_{\dB}(W,r)
   143	 \le\frac1n\sum_{i\in C}\frac{s_i^+}{s_i^++1}
   144	 \le\frac{(n-1)^2}{n^2}.                                  \tag{5.17}\label{5.17}
   145	\]
   146	The complete baseline tends to $(n-1)/n$, leaving limiting gap
   147	$(n-1)/n^2$.  Combining this case, the cited strongly connected
   148	noncomplete-support theorem, and Theorem~\ref{thm:strong-complete} proves
   149	Corollary~\ref{cor:fixed}.
   150	
   151	\subsection{Undirected incomplete support}
   152	
   153	Fix an initial mutant $i$ in a connected undirected support.  At
   154	$r=\infty$, death of $i$ causes extinction, while death of any one of its
   155	$s_i$ neighbors creates an adjacent mutant pair.  After deleting holding
   156	steps, the probability of reaching a pair first is $s_i/(s_i+1)$.  Once an
   157	adjacent pair exists, the mutant set remains support-connected; every mutant
   158	has a mutant neighbor and cannot be replaced by a resident in the limiting
   159	chain, while every boundary resident death produces monotone growth.  The
   160	limiting chain therefore reaches fixation almost surely from the pair.
   161	Lemma~\ref{lem:finite-perturb} controls $O(1/r)$ leakage from this limiting
   162	class.  Uniform averaging proves \eqref{2.11}; elementary subtraction proves
   163	\eqref{2.12}.
