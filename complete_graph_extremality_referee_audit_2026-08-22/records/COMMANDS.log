   138	\end{aligned}
   139	\]
   140	Every displayed coefficient is positive except for the single grouped factor
   141	\[
   142	 g^4+4g^3-2g^2+4g+1=(g^2-1)^2+4g(g^2+1)>0.                  \tag{B.6}\label{B.6}
   143	\]
   144	Thus $C_j>0$ for $j\ge1$ and $C_0\ge0$.  If $d>0$, then $C_1d>0$; if $d=0$,
   145	$H_{22}=C_0$ vanishes only at $g=1$.
   146	
   147	\begin{theorem}[symmetric weighted $K_4$ families]\label{thm:k4}
   148	For every $r>1$,
   149	\[
   150	 \rho_{\dB}(G_{13}(x),r)\le\rho_{\dB}(J_4,r),\qquad
   151	 \rho_{\dB}(G_{22}(x,y),r)\le\rho_{\dB}(J_4,r).
   152	\]
   153	Equality holds only at $x=1$ in the first family and $x=y=1$ in the second.
   154	\end{theorem}
   155	
   156	This is not a classification of the unrestricted six-edge weighted $K_4$.
--- FILE: appendices/C_quantifier_ledger.tex
     1	\section{Quantifier and scope ledger}\label{app:quantifiers}
     2	
     3	The statements in this paper have deliberately different orders of
     4	quantification.
     5	
     6	\medskip
     7	\noindent\textbf{Fitness-two local theorem.}
     8	For every $n\ge3$ there is an $\eta_n>0$ such that every positive loopless
     9	row-stochastic $P$ with $0<\|P-J_n\|_F<\eta_n$ satisfies
    10	$\rho_{\dB}(P,2)<\rho_{\dB}(J_n,2)$.
    11	
    12	\medskip
    13	\noindent\textbf{Full-tangent curvature.}
    14	For every $n\ge3$ and every $\delta\in\calT_n\setminus\{0\}$,
    15	\[
    16	 D\rho_{\dB}(J_n,2)[\delta]=0,\qquad
    17	 D^2\rho_{\dB}(J_n,2)[\delta,\delta]<0.
    18	\]
    19	
    20	\medskip
    21	\noindent\textbf{Fixed-graph strong selection.}
    22	For every fixed normalized kernel $P\ne J_n$, there is an $r_0(P)$
    23	such that $\rho_{\dB}(P,r)<\rho_{\dB}(J_n,r)$ for every $r>r_0(P)$.
    24	
    25	\medskip
    26	\noindent\textbf{Triangle theorem.}
    27	Every positive weighted triangle and every $r>1$ obey complete-graph
    28	maximality, with strictness away from equal weights.
    29	
    30	\medskip
    31	\noindent\textbf{Open global fitness-two statement.}
    32	It remains open whether every $n$ and every kernel $P$ induced by an
    33	undirected weighting satisfies
    34	$\rho_{\dB}(P,2)\le\rho_{\dB}(J_n,2)$.
    35	
    36	\medskip
    37	\noindent\textbf{Open asymptotic-family statement.}
    38	It also remains open whether there is one sequence $(P_n)$ such that, for
    39	every fixed $r>1$, some $n_0(r)$ makes every $P_n$ with $n\ge n_0(r)$ an
    40	amplifier.
    41	
    42	The proved rows do not imply either open row.  In particular, local
    43	optimality has a radius $\eta_n$ that need not be bounded below, and the strong-selection threshold
    44	$r_0(P_n)$ may diverge with $n$.
