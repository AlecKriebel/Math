path\": \"TURN_1_STATE.json\",\n+      \"bytes\": 2165,\n+      \"sha256\": \"cfcd468b584186aea3c10eff17eb9f6fa9f602bc6b3d65b816f98fdb066f4cf9\"\n+    },\n+    {\n+      \"path\": \"TURN_2.md\",\n+      \"bytes\": 7048,\n+      \"sha256\": \"f03d4d7db0d32725c420f1ace8fd55fe78e70cbdf002fc78bf1773d8a237321b\"\n+    },\n+    {\n+      \"path\": \"TURN_2_CHECKS.json\",\n+      \"bytes\": 321,\n+      \"sha256\": \"7e833b1258942cb31f5403a202789da7f775fa4fc03d17020a5f322c67056af5\"\n+    },\n+    {\n+      \"path\": \"TURN_2_LEDGER.jsonl\",\n+      \"bytes\": 6129,\n+      \"sha256\": \"e415a28074a3414fb90041fe70c35672d8824d96bafcf6fd4323b309d2b1fcae\"\n+    },\n+    {\n+      \"path\": \"TURN_2_STATE.json\",\n+      \"bytes\": 2216,\n+      \"sha256\": \"9ef8cf4395972a4b05c5d8f61385f462268b77f6b2f0206c3061f43624eb0ac9\"\n+    },\n+    {\n+      \"path\": \"finite_markov.py\",\n+      \"bytes\": 1131,\n+      \"sha256\": \"57cf5b9e324d7ba92893d1cc11c216f91f93c56028c7df7c7626770278a5be8e\"\n+    },\n+    {\n+      \"path\": \"observable_space.py\",\n+      \"bytes\": 894,\n+      \"sha256\": \"3f5fdc67932efb1a250e122eae75d40f7e0a177a7998a32f0db01edac0636a4c\"\n+    },\n+    {\n+      \"path\": \"verify_turn1.py\",\n+      \"bytes\": 3224,\n+      \"sha256\": \"a1fa882fab22ca16888dc730828ec7cee53ee3e76e1c449bb996a07bde8f3f03\"\n+    },\n+    {\n+      \"path\": \"verify_turn2.py\",\n+      \"bytes\": 2894,\n+      \"sha256\": \"0ddadd80256280711675205de18f4b120da8930e85bee383ba5bb748a183382e\"\n+    }\n+  ]\n+}"},{"sha":"e9dde41bd1fd071d458691b2a8fe1447250770eb","filename":"unsolved_math_prioritization/attempts/30004435/TURN_2_STATE.json","status":"added","additions":25,"deletions":0,"changes":25,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_2_STATE.json","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_2_STATE.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_2_STATE.json?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,25 @@\n+{\n+  \"at\": \"2026-10-02T17:04:26+00:00\",\n+  \"id\": \"30004435\",\n+  \"status\": \"in_progress\",\n+  \"note\": \"Turn 2: all three observable tail fields of a finite hidden Markov process equal the quotient of hidden recurrent-class/phase states by their conditional observation laws. Two-sided empirical block frequencies recover the quotient; exact invariant-column proof gives word-length bound s-1. General stationary process remains unresolved.\",\n+  \"evidence\": {\n+    \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\",\n+    \"exact_claim\": \"For every strictly stationary two-sided finite-alphabet process indexed by Z, prove equality modulo null sets of the remote-past and remote-future tail sigma fields using only probability theory, without entropy theory. Steif QuestionC, OWR11/2020 printed632.\",\n+    \"primary_sources\": [\n+      \"https://ems.press/content/serial-article-files/46847\",\n+      \"https://arxiv.org/abs/1406.6670\",\n+      \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"\n+    ],\n+    \"literature_checked_at\": \"2026-10-02T16:44:00Z\",\n+    \"success_test\": \"A full entropy-free proof for arbitrary stationary finite-alphabet processes. Markov, hidden-Markov, mixing or coding subclasses do not suffice; neither does renaming Shannon/relative entropy or invoking the Pinsker theorem.\",\n+    \"budget\": \"Five genuine author turns unless complete general method-compliant result earlier, then independent review.\",\n+    \"prior_attempt_gap\": \"Exact ID/code, tail fields/tail sigma/Pinsker PR searches empty; live branches and recovered paths/commits/recovery inventory show no target attempt. Imported research report absent.\",\n+    \"duplicate_check\": \"409 live branches and379 recovered refs checked. Adjacent30004434 is Gibbs uniform coupling QuestionA, mathematically distinct. No guarantee for inaccessible deleted/unhydrated content.\"\n+  },\n+  \"statement_hash\": \"30f82fb5516bf7b6151b3524bce6bc5e75149f6be67367899f63a35c192762ce\",\n+  \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\",\n+  \"turns_used\": 2,\n+  \"readiness_review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\",\n+  \"event\": \"proof_attempt_turn\"\n+}"},{"sha":"f6439b6e75178cec1906a1fae97835007481e658","filename":"unsolved_math_prioritization/attempts/30004435/TURN_3.md","status":"added","additions":75,"deletions":0,"changes":75,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_3.md","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_3.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_3.md?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,75 @@\n+# Turn 3: an entropy-free coupling criterion beyond finite memory\n+\n+The general question remains unresolved. This turn proves equality (in fact triviality) of the two one-sided tails for a uniformly overlapping, summably continuous infinite-memory transition kernel. The classical complete-connections coupling strategy is credited to Bressaud–Fernández–Galves, *Decay of correlations for non Hölderian dynamics. A coupling approach*, EJP4 (1999), especially Sections4.1–4.4. Those sections were read; the proof below supplies its own elementary bound under explicitly stated total-variation hypotheses. Neither the whole paper nor its sharper rates are imported as a theorem.\n+\n+## 1. Hypotheses and conclusion\n+\n+Let A be finite and let g(.|x) be a measurable probability vector for each left-infinite history x. Let v_k bound the total variation distance of g(.|x) and g(.|y) whenever the last k symbols of x,y agree, with k=0 imposing no agreement. Assume\n+\n+    0<=v_(k+1)<=v_k,  v_0<1,  sum_(k>=0) v_k<infinity.\n+\n+Write epsilon=1−v_0>0. A stationary process is compatible if its next-symbol conditional distribution given its entire past is g, almost surely. Assume such a process exists.\n+\n+**Theorem.** Its left and right remote tails are trivial. There is at most one compatible stationary law. A uniform remote-future coupling bound after n generated symbols is\n+\n+    b(n)=min(1, inf_(1<=l<=n) [(1−epsilon^l)^floor(n/l)\n+                              + sum_(k>=l) v_k]).           (1.1)\n+\n+In particular b(n)→0. No assertion about the bilateral tail follows from the argument. No Markov or finite-memory condition is imposed, but the uniform overlap and continuity assumptions are substantial restrictions absent from the source.\n+\n+## 2. Constructing the coupling and a stopping-time bound\n+\n+Starting from any two histories, at each time use a maximal coupling of their next-symbol distributions, independently of earlier auxiliary randomness given the current histories. This has disagreement probability equal to their total variation distance. It can be realized with a fresh uniform U so that U<=epsilon always forces agreement: first use a common-output branch of length equal to the common mass, then the residual disjoint distributions. Thus, regardless of the histories, a block of l auxiliary uniforms all at most epsilon forces l consecutive equal outputs.\n+\n+Let tau be the first time that l consecutive generated outputs have agreed. In disjoint length-l blocks the forcing uniform events are independent, each of probability epsilon^l. Therefore\n+\n+    P(tau>n)<=(1−epsilon^l)^floor(n/l).                     (2.1)\n+\n+This is only an upper bound; actual agreement can happen much sooner. At time tau, the histories share at least l terminal symbols. Conditional on the entire coupling history at this stopping time, the probability that the first later disagreement occurs after k−l further agreements is at most v_k. A union bound gives\n+\n+    P(any later disagreement | history at tau)\n+       <= sum_(k>=l) v_k.                                 (2.2)\n+\n+One can first sum over a finite future horizon and then increase it; no assertion that tau is the final disagreement time is used. Combining(2.1)–(2.2), the coupled output sequences agree at every coordinate n+1,n+2,... with probability at least1 minus the displayed bound in(1.1). The coupling inequality gives the same bound for total variation of the entire remote-future path laws. It is uniform over the two initial histories.\n+\n+To see convergence to0, first choose a fixed large l to make the summable tail small, then send n to infinity in the first term. Finally increase l. This ordered limit requires no rate uniform in l.\n+\n+## 3. From the path coupling to both tail zero-one laws\n+\n+For the given stationary compatible process, its conditional future law given a past history is generated by the successive g kernels. This follows by the conditional chain rule for finite future words, followed by uniqueness of a measure on the countable product. The uniform estimate applies for almost every conditioning history; comparison with a mixture of the other histories gives\n+\n+    |P(B | sigma(X_k:k<=0))−P(B)| <= b(n) a.s.\n+\n+for every B in sigma(X_k:k>=n+1). Equivalently the alpha-mixing coefficient between these two fields is at most b(n). Finite-alphabet product spaces supply regular conditional distributions, so this statement can also be expressed as total variation of the conditional remote-future law. A fixed B suffices for the argument.\n+\n+Let A be a right-tail event and let C be any finite-coordinate cylinder supported in[−r,r]. Since A belongs to every future field, stationarity and the estimate above imply |P(A intersect C)−P(A)P(C)|<=b(n) for arbitrarily large separations n. Hence A is independent of every cylinder. A monotone-class argument makes it independent of the entire process field, including itself; P(A) is0 or1.\n+\n+For a left-tail event interchange which event is in the remote past and which is in the fixed central cylinder. The same alpha coefficient controls the correlation, without reversing g or assuming reversibility. This proves the left-tail zero-one law as well.\n+\n+For uniqueness, start one coupled chain with the past drawn from one stationary compatible law and the other from a second law. Their future blocks at times n+1,...,n+L differ in total variation by at most b(n). Stationarity identifies these with their respective blocks at1,...,L. Let n→infinity. All finite block laws coincide, giving equality of the stationary laws. This does not by itself prove existence for every merely measurable g.\n+\n+## 4. A genuine infinite-memory example\n+\n+On binary histories define\n+\n+    g(1|x)=1/2 +(1/4) sum_(j>=1) 2^(−j)(2 x_(−j)−1),\n+    g(0|x)=1−g(1|x).\n+\n+All probabilities lie in[1/4,3/4]. Matching k terminal symbols leaves a maximal difference exactly\n+\n+    v_k=2^(−k−1),  epsilon=1/2,\n+    sum_(j>=k) v_j=2^(−k).\n+\n+The extrema are attained by choosing all unmatched symbols oppositely. Each remote coordinate changes the kernel, so it is not a finite-order transition kernel. The series is uniformly convergent, making the append-a-symbol transition on the compact history space Feller. An invariant measure exists: take Cesàro averages of iterates of any initial measure, choose a weakly convergent subsequence by compactness, and use the Feller property and the telescoping difference of the averages to verify invariance. The usual stationary Markov extension on histories then gives a compatible two-sided symbol process. The history coordinates shift consistently, so the kernel really is the conditional next-symbol law. Section3 proves uniqueness and both tail zero-one laws.\n+\n+For example choosing l=floor((log_2 n)/2), when l>=1, gives the explicit bound\n+\n+    b(n)<=(1−2^(−l))^floor(n/l)+2^(−l).\n+\n+It tends to0. It is a deliberately coarse bound, not a claim of an optimal mixing rate.\n+\n+## 5. Exact controls and scope\n+\n+verify_turn3.py checks maximal-coupling marginals and disagreement mass with exact fractions, continuity bounds for all pairs of binary finite-history truncations through length7, and finite-horizon agreement-run probabilities against both terms of(1.1). The controls do not replace the stopping-time proof or establish a general stationary tail theorem.\n+\n+The obstruction left after this turn is that arbitrary finite-alphabet stationary laws may have discontinuous conditional kernels, no uniform overlap, and nonsummable memory. Conditioning on a hypothetical common tail to force these hypotheses would be circular. No such reduction is claimed."},{"sha":"6c427ac76ad026b9844986835d52ac625d1f5ddb","filename":"unsolved_math_prioritization/attempts/30004435/TURN_3_CHECKS.json","status":"added","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_3_CHECKS.json","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_3_CHECKS.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_3_CHECKS.json?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,6 @@\n+{\n+  \"assertions\": 25455,\n+  \"run_length_models\": 2,\n+  \"scope\": \"Exact algebraic and finite-horizon controls for a proved infinite-memory coupling criterion; unrestricted original still unresolved.\",\n+  \"truncated_history_pairs\": 21844\n+}"},{"sha":"803ee7c7d84b74573458ace73d545162b1132e49","filename":"unsolved_math_prioritization/attempts/30004435/TURN_3_LEDGER.jsonl","status":"added","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_3_LEDGER.jsonl","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_3_LEDGER.jsonl","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_3_LEDGER.jsonl?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,4 @@\n+{\"at\": \"2026-10-02T16:46:17+00:00\", \"id\": \"30004435\", \"status\": \"in_progress\", \"note\": \"Exact finite-state stationary method-restricted source and prior gate complete; begin turn1 with entropy-free structural cases and test barriers.\", \"evidence\": {\"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"exact_claim\": \"For every strictly stationary two-sided finite-alphabet process indexed by Z, prove equality modulo null sets of the remote-past and remote-future tail sigma fields using only probability theory, without entropy theory. Steif QuestionC, OWR11/2020 printed632.\", \"primary_sources\": [\"https://ems.press/content/serial-article-files/46847\", \"https://arxiv.org/abs/1406.6670\", \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"], \"literature_checked_at\": \"2026-10-02T16:44:00Z\", \"success_test\": \"A full entropy-free proof for arbitrary stationary finite-alphabet processes. Markov, hidden-Markov, mixing or coding subclasses do not suffice; neither does renaming Shannon/relative entropy or invoking the Pinsker theorem.\", \"budget\": \"Five genuine author turns unless complete general method-compliant result earlier, then independent review.\", \"prior_attempt_gap\": \"Exact ID/code, tail fields/tail sigma/Pinsker PR searches empty; live branches and recovered paths/commits/recovery inventory show no target attempt. Imported research report absent.\", \"duplicate_check\": \"409 live branches and379 recovered refs checked. Adjacent30004434 is Gibbs uniform coupling QuestionA, mathematically distinct. No guarantee for inaccessible deleted/unhydrated content.\"}, \"statement_hash\": \"30f82fb5516bf7b6151b3524bce6bc5e75149f6be67367899f63a35c192762ce\", \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"turns_used\": 0, \"readiness_review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\"}\n+{\"at\": \"2026-10-02T16:58:50+00:00\", \"id\": \"30004435\", \"status\": \"in_progress\", \"note\": \"Turn 1: entropy-free L2 tail-defect reduction; complete finite stationary Markov classification by recurrent class and periodic phase, including bilateral tails; exact weak-limit and infinite-alphabet coding barriers. Original general finite-alphabet method request remains unresolved.\", \"evidence\": {\"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"exact_claim\": \"For every strictly stationary two-sided finite-alphabet process indexed by Z, prove equality modulo null sets of the remote-past and remote-future tail sigma fields using only probability theory, without entropy theory. Steif QuestionC, OWR11/2020 printed632.\", \"primary_sources\": [\"https://ems.press/content/serial-article-files/46847\", \"https://arxiv.org/abs/1406.6670\", \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"], \"literature_checked_at\": \"2026-10-02T16:44:00Z\", \"success_test\": \"A full entropy-free proof for arbitrary stationary finite-alphabet processes. Markov, hidden-Markov, mixing or coding subclasses do not suffice; neither does renaming Shannon/relative entropy or invoking the Pinsker theorem.\", \"budget\": \"Five genuine author turns unless complete general method-compliant result earlier, then independent review.\", \"prior_attempt_gap\": \"Exact ID/code, tail fields/tail sigma/Pinsker PR searches empty; live branches and recovered paths/commits/recovery inventory show no target attempt. Imported research report absent.\", \"duplicate_check\": \"409 live branches and379 recovered refs checked. Adjacent30004434 is Gibbs uniform coupling QuestionA, mathematically distinct. No guarantee for inaccessible deleted/unhydrated content.\"}, \"statement_hash\": \"30f82fb5516bf7b6151b3524bce6bc5e75149f6be67367899f63a35c192762ce\", \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"turns_used\": 1, \"readiness_review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"event\": \"proof_attempt_turn\"}\n+{\"at\": \"2026-10-02T17:04:26+00:00\", \"id\": \"30004435\", \"status\": \"in_progress\", \"note\": \"Turn 2: all three observable tail fields of a finite hidden Markov process equal the quotient of hidden recurrent-class/phase states by their conditional observation laws. Two-sided empirical block frequencies recover the quotient; exact invariant-column proof gives word-length bound s-1. General stationary process remains unresolved.\", \"evidence\": {\"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"exact_claim\": \"For every strictly stationary two-sided finite-alphabet process indexed by Z, prove equality modulo null sets of the remote-past and remote-future tail sigma fields using only probability theory, without entropy theory. Steif QuestionC, OWR11/2020 printed632.\", \"primary_sources\": [\"https://ems.press/content/serial-article-files/46847\", \"https://arxiv.org/abs/1406.6670\", \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"], \"literature_checked_at\": \"2026-10-02T16:44:00Z\", \"success_test\": \"A full entropy-free proof for arbitrary stationary finite-alphabet processes. Markov, hidden-Markov, mixing or coding subclasses do not suffice; neither does renaming Shannon/relative entropy or invoking the Pinsker theorem.\", \"budget\": \"Five genuine author turns unless complete general method-compliant result earlier, then independent review.\", \"prior_attempt_gap\": \"Exact ID/code, tail fields/tail sigma/Pinsker PR searches empty; live branches and recovered paths/commits/recovery inventory show no target attempt. Imported research report absent.\", \"duplicate_check\": \"409 live branches and379 recovered refs checked. Adjacent30004434 is Gibbs uniform coupling QuestionA, mathematically distinct. No guarantee for inaccessible deleted/unhydrated content.\"}, \"statement_hash\": \"30f82fb5516bf7b6151b3524bce6bc5e75149f6be67367899f63a35c192762ce\", \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"turns_used\": 2, \"readiness_review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"event\": \"proof_attempt_turn\"}\n+{\"at\": \"2026-10-02T17:08:56+00:00\", \"id\": \"30004435\", \"status\": \"in_progress\", \"note\": \"Turn 3: uniform maximal-coupling bound for complete-connections kernels with v0<1 and summable total-variation continuity. Proved both one-sided tail zero-one laws and stationary uniqueness, with a genuine infinite-memory example; no bilateral-tail claim. Original unrestricted method question remains unresolved.\", \"evidence\": {\"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"exact_claim\": \"For every strictly stationary two-sided finite-alphabet process indexed by Z, prove equality modulo null sets of the remote-past and remote-future tail sigma fields using only probability theory, without entropy theory. Steif QuestionC, OWR11/2020 printed632.\", \"primary_sources\": [\"https://ems.press/content/serial-article-files/46847\", \"https://arxiv.org/abs/1406.6670\", \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"], \"literature_checked_at\": \"2026-10-02T16:44:00Z\", \"success_test\": \"A full entropy-free proof for arbitrary stationary finite-alphabet processes. Markov, hidden-Markov, mixing or coding subclasses do not suffice; neither does renaming Shannon/relative entropy or invoking the Pinsker theorem.\", \"budget\": \"Five genuine author turns unless complete general method-compliant result earlier, then independent review.\", \"prior_attempt_gap\": \"Exact ID/code, tail fields/tail sigma/Pinsker PR searches empty; live branches and recovered paths/commits/recovery inventory show no target attempt. Imported research report absent.\", \"duplicate_check\": \"409 live branches and379 recovered refs checked. Adjacent30004434 is Gibbs uniform coupling QuestionA, mathematically distinct. No guarantee for inaccessible deleted/unhydrated content.\"}, \"statement_hash\": \"30f82fb5516bf7b6151b3524bce6bc5e75149f6be67367899f63a35c192762ce\", \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"turns_used\": 3, \"readiness_review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"event\": \"proof_attempt_turn\"}"},{"sha":"f4ce61346bc299da569dffc599b4e4dd434c13a7","filename":"unsolved_math_prioritization/attempts/30004435/TURN_3_MANIFEST.json","status":"added","additions":132,"deletions":0,"changes":132,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_3_MANIFEST.json","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_3_MANIFEST.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_3_MANIFEST.json?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,132 @@\n+{\n+  \"id\": 30004435,\n+  \"turns_used\": 3,\n+  \"status\": \"Partial results; original unresolved\",\n+  \"files\": [\n+    {\n+      \"path\": \"PRIOR_GATE.json\",\n+      \"bytes\": 507,\n+      \"sha256\": \"fd0ad0c4ad23751d9f27fecc5a8f499c73b406c07b84b5d59e0a9ba2e4aa5cf8\"\n+    },\n+    {\n+      \"path\": \"READINESS.json\",\n+      \"bytes\": 1418,\n+      \"sha256\": \"90fd19020abce398906e76a0dfce9f21b879f644a64832d11b55538f1c7332e1\"\n+    },\n+    {\n+      \"path\": \"RESEARCH_LOG.md\",\n+      \"bytes\": 658,\n+      \"sha256\": \"25a6d3f70118c6b3bdf713015a41b7c2bcf2be5929b7c4a4ee78f408f17e0355\"\n+    },\n+    {\n+      \"path\": \"SOURCE_MANIFEST.json\",\n+      \"bytes\": 970,\n+      \"sha256\": \"33b68ea48a0137520f58438cf46cd58c6d0ae3fe46425d61a3872a4191276289\"\n+    },\n+    {\n+      \"path\": \"SOURCE_NORMALIZATION.md\",\n+      \"bytes\": 2456,\n+      \"sha256\": \"dc2bb2208f8a3d5a1d5be56a3a07a3594874ba3644392e674b44a0efb91f537f\"\n+    },\n+    {\n+      \"path\": \"TURN_1.md\",\n+      \"bytes\": 9259,\n+      \"sha256\": \"ea6cab9e3f11c16fe387209a0d383d1fe8067e941ebe5a689f5d8e9ed133d3b0\"\n+    },\n+    {\n+      \"path\": \"TURN_1_CHECKS.json\",\n+      \"bytes\": 849,\n+      \"sha256\": \"593c5f633877d58408e348b9b39b5c8739e4f3cb4961b6187bcd3cdf90afcc33\"\n+    },\n+    {\n+      \"path\": \"TURN_1_LEDGER.jsonl\",\n+      \"bytes\": 3995,\n+      \"sha256\": \"83b008ec140c8cc21c0dc69552b20cb6059a9224c4a0e4f8cb57780165a82070\"\n+    },\n+    {\n+      \"path\": \"TURN_1_MANIFEST.json\",\n+      \"bytes\": 1771,\n+      \"sha256\": \"836fa9cb1f3bf3c705f502a386dddc571404daae54f66a2a579ba36194656107\"\n+    },\n+    {\n+      \"path\": \"TURN_1_STATE.json\",\n+      \"bytes\": 2165,\n+      \"sha256\": \"cfcd468b584186aea3c10eff17eb9f6fa9f602bc6b3d65b816f98fdb066f4cf9\"\n+    },\n+    {\n+      \"path\": \"TURN_2.md\",\n+      \"bytes\": 7048,\n+      \"sha256\": \"f03d4d7db0d32725c420f1ace8fd55fe78e70cbdf002fc78bf1773d8a237321b\"\n+    },\n+    {\n+      \"path\": \"TURN_2_CHECKS.json\",\n+      \"bytes\": 321,\n+      \"sha256\": \"7e833b1258942cb31f5403a202789da7f775fa4fc03d17020a5f322c67056af5\"\n+    },\n+    {\n+      \"path\": \"TURN_2_LEDGER.jsonl\",\n+      \"bytes\": 6129,\n+      \"sha256\": \"e415a28074a3414fb90041fe70c35672d8824d96bafcf6fd4323b309d2b1fcae\"\n+    },\n+    {\n+      \"path\": \"TURN_2_MANIFEST.json\",\n+      \"bytes\": 2831,\n+      \"sha256\": \"f37aa14d17fb3cad76bc29f1fa8205560a60e112f5752aa07d43afe44586f4bb\"\n+    },\n+    {\n+      \"path\": \"TURN_2_STATE.json\",\n+      \"bytes\": 2216,\n+      \"sha256\": \"9ef8cf4395972a4b05c5d8f61385f462268b77f6b2f0206c3061f43624eb0ac9\"\n+    },\n+    {\n+      \"path\": \"TURN_3.md\",\n+      \"bytes\": 7616,\n+      \"sha256\": \"79a89c565537987c93b21f7e94d511f0d82fdc0bb8f43181b19f94fe194e3ede\"\n+    },\n+    {\n+      \"path\": \"TURN_3_CHECKS.json\",\n+      \"bytes\": 235,\n+      \"sha256\": \"6cf107355e7fb9dc610ec69f4cb8a035534a40f9cc824db4d4703edb0c70199b\"\n+    },\n+    {\n+      \"path\": \"TURN_3_LEDGER.jsonl\",\n+      \"bytes\": 8240,\n+      \"sha256\": \"15498e024b598e3094240b7b5d28813598c2fed68a014e1c235c3d4f77493a14\"\n+    },\n+    {\n+      \"path\": \"TURN_3_SOURCE.json\",\n+      \"bytes\": 506,\n+      \"sha256\": \"8d543e9720e941ca98c55f6a9c07acff92e49062ec74660bbb5ba71db2820f90\"\n+    },\n+    {\n+      \"path\": \"TURN_3_STATE.json\",\n+      \"bytes\": 2193,\n+      \"sha256\": \"ef1f3692aa2517e14182563b862fe45c716b60f3213416aba661b87030837a90\"\n+    },\n+    {\n+      \"path\": \"finite_markov.py\",\n+      \"bytes\": 1131,\n+      \"sha256\": \"57cf5b9e324d7ba92893d1cc11c216f91f93c56028c7df7c7626770278a5be8e\"\n+    },\n+    {\n+      \"path\": \"observable_space.py\",\n+      \"bytes\": 894,\n+      \"sha256\": \"3f5fdc67932efb1a250e122eae75d40f7e0a177a7998a32f0db01edac0636a4c\"\n+    },\n+    {\n+      \"path\": \"verify_turn1.py\",\n+      \"bytes\": 3224,\n+      \"sha256\": \"a1fa882fab22ca16888dc730828ec7cee53ee3e76e1c449bb996a07bde8f3f03\"\n+    },\n+    {\n+      \"path\": \"verify_turn2.py\",\n+      \"bytes\": 2894,\n+      \"sha256\": \"0ddadd80256280711675205de18f4b120da8930e85bee383ba5bb748a183382e\"\n+    },\n+    {\n+      \"path\": \"verify_turn3.py\",\n+      \"bytes\": 2756,\n+      \"sha256\": \"e4a6cb87c96cd661a292d98dd1b8510f8b41cc477ba1e09087e5c79a5be5ef12\"\n+    }\n+  ]\n+}"},{"sha":"993f06404d7bc79419246a01f7220e66584f76f3","filename":"unsolved_math_prioritization/attempts/30004435/TURN_3_SOURCE.json","status":"added","additions":9,"deletions":0,"changes":9,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_3_SOURCE.json","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_3_SOURCE.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_3_SOURCE.json?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,9 @@\n+{\n+  \"title\": \"Decay of correlations for non H\\u00f6lderian dynamics. A coupling approach\",\n+  \"authors\": \"Xavier Bressaud, Roberto Fernandez, Antonio Galves\",\n+  \"url\": \"https://arxiv.org/pdf/math/9806132\",\n+  \"local_source\": \"bressaud_fernandez_galves_1999.pdf\",\n+  \"bytes\": 219454,\n+  \"sha256\": \"54d177c978932ac1d52bf65a14b898328cb260cb2ed07f6f07f64ff771e3555a\",\n+  \"use\": \"Credit for complete-connections coupling strategy; scoped proof in TURN_3.md is self-contained, no full external theorem dependency.\"\n+}"},{"sha":"ca27e6dde5ce4fe4b091b7d5085674fb6ae4e150","filename":"unsolved_math_prioritization/attempts/30004435/TURN_3_STATE.json","status":"added","additions":25,"deletions":0,"changes":25,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_3_STATE.json","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_3_STATE.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_3_STATE.json?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,25 @@\n+{\n+  \"at\": \"2026-10-02T17:08:56+00:00\",\n+  \"id\": \"30004435\",\n+  \"status\": \"in_progress\",\n+  \"note\": \"Turn 3: uniform maximal-coupling bound for complete-connections kernels with v0<1 and summable total-variation continuity. Proved both one-sided tail zero-one laws and stationary uniqueness, with a genuine infinite-memory example; no bilateral-tail claim. Original unrestricted method question remains unresolved.\",\n+  \"evidence\": {\n+    \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\",\n+    \"exact_claim\": \"For every strictly stationary two-sided finite-alphabet process indexed by Z, prove equality modulo null sets of the remote-past and remote-future tail sigma fields using only probability theory, without entropy theory. Steif QuestionC, OWR11/2020 printed632.\",\n+    \"primary_sources\": [\n+      \"https://ems.press/content/serial-article-files/46847\",\n+      \"https://arxiv.org/abs/1406.6670\",\n+      \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"\n+    ],\n+    \"literature_checked_at\": \"2026-10-02T16:44:00Z\",\n+    \"success_test\": \"A full entropy-free proof for arbitrary stationary finite-alphabet processes. Markov, hidden-Markov, mixing or coding subclasses do not suffice; neither does renaming Shannon/relative entropy or invoking the Pinsker theorem.\",\n+    \"budget\": \"Five genuine author turns unless complete general method-compliant result earlier, then independent review.\",\n+    \"prior_attempt_gap\": \"Exact ID/code, tail fields/tail sigma/Pinsker PR searches empty; live branches and recovered paths/commits/recovery inventory show no target attempt. Imported research report absent.\",\n+    \"duplicate_check\": \"409 live branches and379 recovered refs checked. Adjacent30004434 is Gibbs uniform coupling QuestionA, mathematically distinct. No guarantee for inaccessible deleted/unhydrated content.\"\n+  },\n+  \"statement_hash\": \"30f82fb5516bf7b6151b3524bce6bc5e75149f6be67367899f63a35c192762ce\",\n+  \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\",\n+  \"turns_used\": 3,\n+  \"readiness_review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\",\n+  \"event\": \"proof_attempt_turn\"\n+}"},{"sha":"dd2eb7903dcaee4eb7f34ed3e53cb6098fe50ac1","filename":"unsolved_math_prioritization/attempts/30004435/TURN_4.md","status":"added","additions":70,"deletions":0,"changes":70,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_4.md","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_4.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_4.md?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,70 @@\n+# Turn 4: transferring tail information through finite-mean finitary codes\n+\n+This turn proves a coding transfer theorem, including the measurability of the outside-only reconstruction. It gives an entropy-free route for an additional class of processes and identifies a precise integrability obstacle. It does not represent every stationary finite-alphabet process by such a code, nor infer equality of two subfields merely because they lie in a common field.\n+\n+## 1. Definitions that make the reconstruction valid\n+\n+Let X be a stationary finite-alphabet process. Let Y=F(X) be a shift-equivariant measurable finite-alphabet factor. Work on a shift-invariant conull set G on which the code is defined. A finite centered input block is decisive if every point of G having that block has the same output at its center. Blocks with no compatible point of G can be ignored. Assume that almost every input has a decisive centered block of some finite radius.\n+\n+Let R(x) be the least such radius for the coordinate at0, and R_k(x)=R(shift^k x). These are measurable: for each radius there are finitely many input blocks, and decisiveness and its output label can be fixed once for each block. No algorithm for deciding admissibility or computing these labels is asserted. Assume\n+\n+    E[R]<infinity.                                         (1.1)\n+\n+**Theorem.** In the common input probability space,\n+\n+    T_Y^- subset T_X^-,  T_Y^+ subset T_X^+,\n+    T_Y^bilateral subset T_X^bilateral,                     (1.2)\n+\n+with completed fields throughout.\n+\n+The hypothesis refers to an actual cylinder-determined coding radius, not an arbitrary random variable after which a chosen sample path happens to agree. The common conull set is part of the definition.\n+\n+## 2. A measurable remote-future decoder\n+\n+Fix m and N>=m. For each k>=N, inspect only the input coordinates at least m. If some decisive centered block around k has radius at most k−m, output its prescribed value. If none does, output a fixed default symbol. The possible blocks in this test all lie in[m,2k−m], a finite observed interval. If more than one decisive block is found, their prescribed values agree on G; on exceptional or inconsistent inputs choose by a fixed ordering. The resulting entire vector Yhat_[N,infinity) is measurable in sigma(X_j:j>=m).\n+\n+On G, its kth entry agrees with Y_k whenever R_k<=k−m. The probability that the two infinite vectors differ anywhere is consequently at most\n+\n+    e_(N,m)=sum_(k>=N) P(R>k−m).                           (2.1)\n+\n+Stationarity is used only to identify the coding-radius distributions, and the union bound requires no independence. For integer-valued nonnegative R, E[R]=sum_(j>=0)P(R>j). Hence e_(N,m)→0 as N→infinity with m fixed.\n+\n+If A belongs to the completed future tail of Y, then for each N there is a Borel subset B_N of the remote output product with 1_A=1_{B_N}(Y_[N,infinity)) almost surely. Replace that vector by Yhat to obtain an event A_N measurable in sigma(X_j:j>=m). Its symmetric difference with A has probability at most e_(N,m). Passing to an almost-surely convergent subsequence shows A belongs to the completion of this input field. Since m was arbitrary, A lies in the completed right tail of X.\n+\n+This avoids an unjustified prescription to fill the missing past with arbitrary symbols: such a filling need not be in the support or the conull coding domain. Only decisive blocks compatible with the actual observed input are used.\n+\n+## 3. Past and bilateral transfer\n+\n+For the past, inspect centered decisive blocks at k<=−N having radius at most−k−m, so they remain inside the input half-line j<=−m. The same bound(2.1) applies after changing k to−k.\n+\n+For the bilateral outside field, decode separately at every |k|>=N using radius at most|k|−m. Each block then lies wholly in one of the two input half-lines outside the central interval. The union bound is at most2 e_(N,m), which again tends to0. The identical approximation-of-events argument proves the bilateral inclusion in(1.2).\n+\n+All intersections here are intersections of completed subfields in the measure algebra. Equivalently one can use representatives: for decreasing fields and representatives agreeing almost surely, the limsup of the representatives is measurable in every earlier field and agrees almost surely with the original event.\n+\n+## 4. Consequences and limits\n+\n+If X is iid, each of its three tails is trivial. For the bilateral tail this follows directly from independence of a fixed central cylinder and every sufficiently remote outside field, followed by a monotone-class argument. Therefore a finite-mean finitary factor of iid has all three tails trivial. The same conclusion holds for a finite-mean finitary factor of an aperiodic irreducible finite stationary Markov chain, by Turn1.\n+\n+If F is an isomorphism modulo null sets and its inverse is also finitary with finite mean coding radius, apply(1.2) in both directions. Corresponding left, right and bilateral tail fields are equal under the identification of the two probability spaces. Thus equality of the two one-sided tails transfers through such an isomorphism.\n+\n+For a factor of a process with a nontrivial common input tail H, (1.2) alone gives only that the two output tails are subfields of H. Two subfields of H need not coincide. No equality conclusion is inferred from that alone. An arbitrary measurable factor is not covered either.\n+\n+## 5. Almost-sure finitariness does not imply finite mean radius\n+\n+For a two-sided iid fair binary input, let L_k be the number of consecutive zeros starting at k before the first1. Define\n+\n+    Y_k=X_(k+2^(L_k)).\n+\n+On the conull shift-invariant set where every such run is finite this is a shift-equivariant finitary code. Its least centered decisive radius is R_k=2^(L_k). To see the lower bound, change the bit at k+2^(L_k) while leaving a smaller centered block unchanged. That bit is strictly after the first1, including L_k=0, and does not alter L_k. Both extensions remain in the conull domain and give opposite outputs. Conversely the radius2^(L_k) block contains the first1 and the queried bit, so it determines the output.\n+\n+Since P(L_k=l)=2^(−l−1),\n+\n+    E[R_k]=sum_(l>=0) 2^l 2^(−l−1)=infinity.\n+\n+Thus finitariness alone does not provide the summability needed in(2.1). This example is a limitation of the proof's sufficient condition; no unequal-tail example or failure of the source theorem is asserted. Its future-only dependence in fact makes the right-tail inclusion immediate without an integrability argument.\n+\n+## 6. Controls and the remaining source gap\n+\n+verify_turn4.py exhaustively checks decisive-block reconstructions for a truncated version of the variable-radius code, using truth tables rather than an oracle for the unseen symbols. It tests eventwise boundary errors against the union bound and exact tail-sum identities for finite and heavy-tailed radius laws. These finite controls support the decoder algebra; the measure-theoretic theorem is established above.\n+\n+The missing step remains a representation or direct probability argument for every stationary finite-alphabet process. Neither finite expected coding radius nor an invertible finite-mean code has been established in that generality, and imposing either would discard part of the source's scope."},{"sha":"b8d198e89900ab30114a34d445aa99488c304ba5","filename":"unsolved_math_prioritization/attempts/30004435/TURN_4_CHECKS.json","status":"added","additions":26,"deletions":0,"changes":26,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_4_CHECKS.json","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_4_CHECKS.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_4_CHECKS.json?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,26 @@\n+{\n+  \"assertions\": 123026,\n+  \"boundary_union_counts\": {\n+    \"1\": 5120,\n+    \"2\": 3072,\n+    \"3\": 2048,\n+    \"4\": 0,\n+    \"5\": 0,\n+    \"6\": 0,\n+    \"7\": 0,\n+    \"8\": 0\n+  },\n+  \"decoded_coordinates\": 65536,\n+  \"input_configurations\": 8192,\n+  \"past_decoder_error_counts\": {\n+    \"1\": 3136,\n+    \"2\": 1792,\n+    \"3\": 1024,\n+    \"4\": 0,\n+    \"5\": 0,\n+    \"6\": 0,\n+    \"7\": 0,\n+    \"8\": 0\n+  },\n+  \"scope\": \"Finite truth-table controls for the proved finite-mean coding transfer; no general coding representation is asserted.\"\n+}"},{"sha":"2c62b48848d9c7a901c51e5619873ebadd62dd90","filename":"unsolved_math_prioritization/attempts/30004435/TURN_4_LEDGER.jsonl","status":"added","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_4_LEDGER.jsonl","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_4_LEDGER.jsonl","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_4_LEDGER.jsonl?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,5 @@\n+{\"at\": \"2026-10-02T16:46:17+00:00\", \"id\": \"30004435\", \"status\": \"in_progress\", \"note\": \"Exact finite-state stationary method-restricted source and prior gate complete; begin turn1 with entropy-free structural cases and test barriers.\", \"evidence\": {\"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"exact_claim\": \"For every strictly stationary two-sided finite-alphabet process indexed by Z, prove equality modulo null sets of the remote-past and remote-future tail sigma fields using only probability theory, without entropy theory. Steif QuestionC, OWR11/2020 printed632.\", \"primary_sources\": [\"https://ems.press/content/serial-article-files/46847\", \"https://arxiv.org/abs/1406.6670\", \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"], \"literature_checked_at\": \"2026-10-02T16:44:00Z\", \"success_test\": \"A full entropy-free proof for arbitrary stationary finite-alphabet processes. Markov, hidden-Markov, mixing or coding subclasses do not suffice; neither does renaming Shannon/relative entropy or invoking the Pinsker theorem.\", \"budget\": \"Five genuine author turns unless complete general method-compliant result earlier, then independent review.\", \"prior_attempt_gap\": \"Exact ID/code, tail fields/tail sigma/Pinsker PR searches empty; live branches and recovered paths/commits/recovery inventory show no target attempt. Imported research report absent.\", \"duplicate_check\": \"409 live branches and379 recovered refs checked. Adjacent30004434 is Gibbs uniform coupling QuestionA, mathematically distinct. No guarantee for inaccessible deleted/unhydrated content.\"}, \"statement_hash\": \"30f82fb5516bf7b6151b3524bce6bc5e75149f6be67367899f63a35c192762ce\", \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"turns_used\": 0, \"readiness_review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\"}\n+{\"at\": \"2026-10-02T16:58:50+00:00\", \"id\": \"30004435\", \"status\": \"in_progress\", \"note\": \"Turn 1: entropy-free L2 tail-defect reduction; complete finite stationary Markov classification by recurrent class and periodic phase, including bilateral tails; exact weak-limit and infinite-alphabet coding barriers. Original general finite-alphabet method request remains unresolved.\", \"evidence\": {\"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"exact_claim\": \"For every strictly stationary two-sided finite-alphabet process indexed by Z, prove equality modulo null sets of the remote-past and remote-future tail sigma fields using only probability theory, without entropy theory. Steif QuestionC, OWR11/2020 printed632.\", \"primary_sources\": [\"https://ems.press/content/serial-article-files/46847\", \"https://arxiv.org/abs/1406.6670\", \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"], \"literature_checked_at\": \"2026-10-02T16:44:00Z\", \"success_test\": \"A full entropy-free proof for arbitrary stationary finite-alphabet processes. Markov, hidden-Markov, mixing or coding subclasses do not suffice; neither does renaming Shannon/relative entropy or invoking the Pinsker theorem.\", \"budget\": \"Five genuine author turns unless complete general method-compliant result earlier, then independent review.\", \"prior_attempt_gap\": \"Exact ID/code, tail fields/tail sigma/Pinsker PR searches empty; live branches and recovered paths/commits/recovery inventory show no target attempt. Imported research report absent.\", \"duplicate_check\": \"409 live branches and379 recovered refs checked. Adjacent30004434 is Gibbs uniform coupling QuestionA, mathematically distinct. No guarantee for inaccessible deleted/unhydrated content.\"}, \"statement_hash\": \"30f82fb5516bf7b6151b3524bce6bc5e75149f6be67367899f63a35c192762ce\", \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"turns_used\": 1, \"readiness_review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"event\": \"proof_attempt_turn\"}\n+{\"at\": \"2026-10-02T17:04:26+00:00\", \"id\": \"30004435\", \"status\": \"in_progress\", \"note\": \"Turn 2: all three observable tail fields of a finite hidden Markov process equal the quotient of hidden recurrent-class/phase states by their conditional observation laws. Two-sided empirical block frequencies recover the quotient; exact invariant-column proof gives word-length bound s-1. General stationary process remains unresolved.\", \"evidence\": {\"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"exact_claim\": \"For every strictly stationary two-sided finite-alphabet process indexed by Z, prove equality modulo null sets of the remote-past and remote-future tail sigma fields using only probability theory, without entropy theory. Steif QuestionC, OWR11/2020 printed632.\", \"primary_sources\": [\"https://ems.press/content/serial-article-files/46847\", \"https://arxiv.org/abs/1406.6670\", \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"], \"literature_checked_at\": \"2026-10-02T16:44:00Z\", \"success_test\": \"A full entropy-free proof for arbitrary stationary finite-alphabet processes. Markov, hidden-Markov, mixing or coding subclasses do not suffice; neither does renaming Shannon/relative entropy or invoking the Pinsker theorem.\", \"budget\": \"Five genuine author turns unless complete general method-compliant result earlier, then independent review.\", \"prior_attempt_gap\": \"Exact ID/code, tail fields/tail sigma/Pinsker PR searches empty; live branches and recovered paths/commits/recovery inventory show no target attempt. Imported research report absent.\", \"duplicate_check\": \"409 live branches and379 recovered refs checked. Adjacent30004434 is Gibbs uniform coupling QuestionA, mathematically distinct. No guarantee for inaccessible deleted/unhydrated content.\"}, \"statement_hash\": \"30f82fb5516bf7b6151b3524bce6bc5e75149f6be67367899f63a35c192762ce\", \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"turns_used\": 2, \"readiness_review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"event\": \"proof_attempt_turn\"}\n+{\"at\": \"2026-10-02T17:08:56+00:00\", \"id\": \"30004435\", \"status\": \"in_progress\", \"note\": \"Turn 3: uniform maximal-coupling bound for complete-connections kernels with v0<1 and summable total-variation continuity. Proved both one-sided tail zero-one laws and stationary uniqueness, with a genuine infinite-memory example; no bilateral-tail claim. Original unrestricted method question remains unresolved.\", \"evidence\": {\"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"exact_claim\": \"For every strictly stationary two-sided finite-alphabet process indexed by Z, prove equality modulo null sets of the remote-past and remote-future tail sigma fields using only probability theory, without entropy theory. Steif QuestionC, OWR11/2020 printed632.\", \"primary_sources\": [\"https://ems.press/content/serial-article-files/46847\", \"https://arxiv.org/abs/1406.6670\", \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"], \"literature_checked_at\": \"2026-10-02T16:44:00Z\", \"success_test\": \"A full entropy-free proof for arbitrary stationary finite-alphabet processes. Markov, hidden-Markov, mixing or coding subclasses do not suffice; neither does renaming Shannon/relative entropy or invoking the Pinsker theorem.\", \"budget\": \"Five genuine author turns unless complete general method-compliant result earlier, then independent review.\", \"prior_attempt_gap\": \"Exact ID/code, tail fields/tail sigma/Pinsker PR searches empty; live branches and recovered paths/commits/recovery inventory show no target attempt. Imported research report absent.\", \"duplicate_check\": \"409 live branches and379 recovered refs checked. Adjacent30004434 is Gibbs uniform coupling QuestionA, mathematically distinct. No guarantee for inaccessible deleted/unhydrated content.\"}, \"statement_hash\": \"30f82fb5516bf7b6151b3524bce6bc5e75149f6be67367899f63a35c192762ce\", \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"turns_used\": 3, \"readiness_review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"event\": \"proof_attempt_turn\"}\n+{\"at\": \"2026-10-02T17:14:42+00:00\", \"id\": \"30004435\", \"status\": \"in_progress\", \"note\": \"Turn 4: proved completed past/future/bilateral tail inclusions through a finite-mean finitary code via measurable decisive-block decoders and summable boundary errors. Transfer through two-sided finite-mean isomorphisms; explicit almost-sure finite coding with infinite mean radius blocks an automatic integrability step. Original remains unresolved.\", \"evidence\": {\"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"exact_claim\": \"For every strictly stationary two-sided finite-alphabet process indexed by Z, prove equality modulo null sets of the remote-past and remote-future tail sigma fields using only probability theory, without entropy theory. Steif QuestionC, OWR11/2020 printed632.\", \"primary_sources\": [\"https://ems.press/content/serial-article-files/46847\", \"https://arxiv.org/abs/1406.6670\", \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"], \"literature_checked_at\": \"2026-10-02T16:44:00Z\", \"success_test\": \"A full entropy-free proof for arbitrary stationary finite-alphabet processes. Markov, hidden-Markov, mixing or coding subclasses do not suffice; neither does renaming Shannon/relative entropy or invoking the Pinsker theorem.\", \"budget\": \"Five genuine author turns unless complete general method-compliant result earlier, then independent review.\", \"prior_attempt_gap\": \"Exact ID/code, tail fields/tail sigma/Pinsker PR searches empty; live branches and recovered paths/commits/recovery inventory show no target attempt. Imported research report absent.\", \"duplicate_check\": \"409 live branches and379 recovered refs checked. Adjacent30004434 is Gibbs uniform coupling QuestionA, mathematically distinct. No guarantee for inaccessible deleted/unhydrated content.\"}, \"statement_hash\": \"30f82fb5516bf7b6151b3524bce6bc5e75149f6be67367899f63a35c192762ce\", \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"turns_used\": 4, \"readiness_review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"event\": \"proof_attempt_turn\"}"},{"sha":"96bb40677c2ac06fe31294db0335759737a13906","filename":"unsolved_math_prioritization/attempts/30004435/TURN_4_MANIFEST.json","status":"added","additions":162,"deletions":0,"changes":162,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_4_MANIFEST.json","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_4_MANIFEST.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_4_MANIFEST.json?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,162 @@\n+{\n+  \"id\": 30004435,\n+  \"turns_used\": 4,\n+  \"status\": \"Partial results; original unresolved\",\n+  \"files\": [\n+    {\n+      \"path\": \"PRIOR_GATE.json\",\n+      \"bytes\": 507,\n+      \"sha256\": \"fd0ad0c4ad23751d9f27fecc5a8f499c73b406c07b84b5d59e0a9ba2e4aa5cf8\"\n+    },\n+    {\n+      \"path\": \"READINESS.json\",\n+      \"bytes\": 1418,\n+      \"sha256\": \"90fd19020abce398906e76a0dfce9f21b879f644a64832d11b55538f1c7332e1\"\n+    },\n+    {\n+      \"path\": \"RESEARCH_LOG.md\",\n+      \"bytes\": 658,\n+      \"sha256\": \"25a6d3f70118c6b3bdf713015a41b7c2bcf2be5929b7c4a4ee78f408f17e0355\"\n+    },\n+    {\n+      \"path\": \"SOURCE_MANIFEST.json\",\n+      \"bytes\": 970,\n+      \"sha256\": \"33b68ea48a0137520f58438cf46cd58c6d0ae3fe46425d61a3872a4191276289\"\n+    },\n+    {\n+      \"path\": \"SOURCE_NORMALIZATION.md\",\n+      \"bytes\": 2456,\n+      \"sha256\": \"dc2bb2208f8a3d5a1d5be56a3a07a3594874ba3644392e674b44a0efb91f537f\"\n+    },\n+    {\n+      \"path\": \"TURN_1.md\",\n+      \"bytes\": 9259,\n+      \"sha256\": \"ea6cab9e3f11c16fe387209a0d383d1fe8067e941ebe5a689f5d8e9ed133d3b0\"\n+    },\n+    {\n+      \"path\": \"TURN_1_CHECKS.json\",\n+      \"bytes\": 849,\n+      \"sha256\": \"593c5f633877d58408e348b9b39b5c8739e4f3cb4961b6187bcd3cdf90afcc33\"\n+    },\n+    {\n+      \"path\": \"TURN_1_LEDGER.jsonl\",\n+      \"bytes\": 3995,\n+      \"sha256\": \"83b008ec140c8cc21c0dc69552b20cb6059a9224c4a0e4f8cb57780165a82070\"\n+    },\n+    {\n+      \"path\": \"TU