\"sha256\": \"15498e024b598e3094240b7b5d28813598c2fed68a014e1c235c3d4f77493a14\"\n+    },\n+    {\n+      \"path\": \"TURN_3_MANIFEST.json\",\n+      \"bytes\": 3890,\n+      \"sha256\": \"48d14f56774a07c93a691e3d74eebe448fdceccb72e13eaa06381cd86cd7d98d\"\n+    },\n+    {\n+      \"path\": \"TURN_3_SOURCE.json\",\n+      \"bytes\": 506,\n+      \"sha256\": \"8d543e9720e941ca98c55f6a9c07acff92e49062ec74660bbb5ba71db2820f90\"\n+    },\n+    {\n+      \"path\": \"TURN_3_STATE.json\",\n+      \"bytes\": 2193,\n+      \"sha256\": \"ef1f3692aa2517e14182563b862fe45c716b60f3213416aba661b87030837a90\"\n+    },\n+    {\n+      \"path\": \"TURN_4.md\",\n+      \"bytes\": 7316,\n+      \"sha256\": \"a863f3f38f24c64248e4be1306fe7d25ea5432147887d786b0d18a3cd22531d2\"\n+    },\n+    {\n+      \"path\": \"TURN_4_CHECKS.json\",\n+      \"bytes\": 503,\n+      \"sha256\": \"1c2cc67cce983e6242054e25bfa07e4cd68e1f1266a2cf39e80ec92fd52a4097\"\n+    },\n+    {\n+      \"path\": \"TURN_4_LEDGER.jsonl\",\n+      \"bytes\": 10388,\n+      \"sha256\": \"dd2a171afdc7be9aedcecfb396f351ad33db1e006ff419daeb2c36f53490f315\"\n+    },\n+    {\n+      \"path\": \"TURN_4_MANIFEST.json\",\n+      \"bytes\": 4798,\n+      \"sha256\": \"e3ba378578fa9f774f990e8f7dcc854b7bd8ab62501d9d675e2ae0502be86d24\"\n+    },\n+    {\n+      \"path\": \"TURN_4_STATE.json\",\n+      \"bytes\": 2230,\n+      \"sha256\": \"355f69bb4642da9c64ea9152fb941f1f8596b5d6a0e8feddc92def2fac1498e4\"\n+    },\n+    {\n+      \"path\": \"TURN_5.md\",\n+      \"bytes\": 9631,\n+      \"sha256\": \"71f9476d52ee78036f8cb6b4431fe239cd624b7773cc1ad1ae0307abbb871548\"\n+    },\n+    {\n+      \"path\": \"TURN_5_CHECKS.json\",\n+      \"bytes\": 2986,\n+      \"sha256\": \"35a09b6618b88d2f125fe8936102be189f46181f8d7b9a911af7fd0ccfe1b6cf\"\n+    },\n+    {\n+      \"path\": \"TURN_5_LEDGER.jsonl\",\n+      \"bytes\": 12570,\n+      \"sha256\": \"349b84a82836b8d5a88b1661b15bef324019f9ecd563e35c3d66616fac0d8b81\"\n+    },\n+    {\n+      \"path\": \"TURN_5_STATE.json\",\n+      \"bytes\": 2264,\n+      \"sha256\": \"c1fd64beb73878e21b52d07518f343a901fe0ebef673a00116c92264ec4ce0a3\"\n+    },\n+    {\n+      \"path\": \"finite_markov.py\",\n+      \"bytes\": 1131,\n+      \"sha256\": \"57cf5b9e324d7ba92893d1cc11c216f91f93c56028c7df7c7626770278a5be8e\"\n+    },\n+    {\n+      \"path\": \"observable_space.py\",\n+      \"bytes\": 894,\n+      \"sha256\": \"3f5fdc67932efb1a250e122eae75d40f7e0a177a7998a32f0db01edac0636a4c\"\n+    },\n+    {\n+      \"path\": \"verify_turn1.py\",\n+      \"bytes\": 3224,\n+      \"sha256\": \"a1fa882fab22ca16888dc730828ec7cee53ee3e76e1c449bb996a07bde8f3f03\"\n+    },\n+    {\n+      \"path\": \"verify_turn2.py\",\n+      \"bytes\": 2894,\n+      \"sha256\": \"0ddadd80256280711675205de18f4b120da8930e85bee383ba5bb748a183382e\"\n+    },\n+    {\n+      \"path\": \"verify_turn3.py\",\n+      \"bytes\": 2756,\n+      \"sha256\": \"e4a6cb87c96cd661a292d98dd1b8510f8b41cc477ba1e09087e5c79a5be5ef12\"\n+    },\n+    {\n+      \"path\": \"verify_turn4.py\",\n+      \"bytes\": 2379,\n+      \"sha256\": \"6fac853c14f3905bd53555bfdd2081e2bcf11aaca3b9e57eb568ba445c51ed95\"\n+    },\n+    {\n+      \"path\": \"verify_turn5.py\",\n+      \"bytes\": 2978,\n+      \"sha256\": \"26ede76425c2a65c8bc0730faa09029971550abafacbc36f6da880811410122a\"\n+    }\n+  ]\n+}"},{"sha":"4accaef8eea78371e844b326279800cd8aa75de9","filename":"unsolved_math_prioritization/attempts/30004435/TURN_5_STATE.json","status":"added","additions":25,"deletions":0,"changes":25,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_5_STATE.json","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_5_STATE.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_5_STATE.json?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,25 @@\n+{\n+  \"at\": \"2026-10-02T17:21:08+00:00\",\n+  \"id\": \"30004435\",\n+  \"status\": \"exhausted\",\n+  \"note\": \"Turn 5: proved random-law tail classification for non-atomic mixtures of conditionally mixing common-D-stationary laws, without uniform rates; explicit beta-Bernoulli defect and full binary irrational-rotation tail reconstruction isolate the remaining nonmixing obstruction. Five turns complete; original probability-only request unresolved, scoped packet frozen for independent review.\",\n+  \"evidence\": {\n+    \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\",\n+    \"exact_claim\": \"For every strictly stationary two-sided finite-alphabet process indexed by Z, prove equality modulo null sets of the remote-past and remote-future tail sigma fields using only probability theory, without entropy theory. Steif QuestionC, OWR11/2020 printed632.\",\n+    \"primary_sources\": [\n+      \"https://ems.press/content/serial-article-files/46847\",\n+      \"https://arxiv.org/abs/1406.6670\",\n+      \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"\n+    ],\n+    \"literature_checked_at\": \"2026-10-02T16:44:00Z\",\n+    \"success_test\": \"A full entropy-free proof for arbitrary stationary finite-alphabet processes. Markov, hidden-Markov, mixing or coding subclasses do not suffice; neither does renaming Shannon/relative entropy or invoking the Pinsker theorem.\",\n+    \"budget\": \"Five genuine author turns unless complete general method-compliant result earlier, then independent review.\",\n+    \"prior_attempt_gap\": \"Exact ID/code, tail fields/tail sigma/Pinsker PR searches empty; live branches and recovered paths/commits/recovery inventory show no target attempt. Imported research report absent.\",\n+    \"duplicate_check\": \"409 live branches and379 recovered refs checked. Adjacent30004434 is Gibbs uniform coupling QuestionA, mathematically distinct. No guarantee for inaccessible deleted/unhydrated content.\"\n+  },\n+  \"statement_hash\": \"30f82fb5516bf7b6151b3524bce6bc5e75149f6be67367899f63a35c192762ce\",\n+  \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\",\n+  \"turns_used\": 5,\n+  \"readiness_review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\",\n+  \"event\": \"proof_attempt_turn\"\n+}"},{"sha":"dabe6ba37e30a974ff0466979cb4f79729c0bda6","filename":"unsolved_math_prioritization/attempts/30004435/final_review/ADVERSARIAL_REVIEW.md","status":"added","additions":67,"deletions":0,"changes":67,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2Ffinal_review%2FADVERSARIAL_REVIEW.md","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2Ffinal_review%2FADVERSARIAL_REVIEW.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2Ffinal_review%2FADVERSARIAL_REVIEW.md?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,67 @@\n+# Independent full audit: probability-only tail equality (30004435)\n+\n+**PASS for all stated scoped results; original method-restricted problem unresolved,5/5. No mandatory mathematical revision.** AI-assisted source/proof audit, not external peer review or historical novelty certification.\n+\n+## Frozen target and source scope\n+\n+The42-file author packet is bound by FINAL_FROZEN_MANIFEST.json SHA25648fce3e6630fd1bfd81c49054ab4c5640eeb7079f2bd6cc62b65ea479750d78c and exact WIPf1c1e710597b4d9d0993290091f601d086666126, branchdot/math-30004435, folderunsolved_math_prioritization/attempts/30004435. Every raw Git blob was independently compared to the frozen local bytes. No author file was edited.\n+\n+I read Steif's full contribution and visually checked QuestionC on printed632. The question asks for a proof without entropy of the already-known equality of completed past and future tail fields for every stationary two-sided finite-alphabet process. It does not assume ergodicity, finite memory, reversibility or mixing. Bilateral tails are separate and may be strictly larger. Adjacent Gibbs-coupling QuestionA is not the target.\n+\n+Al-Najjar–Shmaya Theorem5.2 expressly invokes the entropy-based equality, and Example6.1 supplies the infinite-spin asymmetry control. Lemańczyk AppendixB.1 uses Pinsker/entropy theory; AppendixB.3.2 separately records the classical finite-Markov phase classification, crediting Blackwell–Freedman. The original1964 paper is not independently re-audited here. The packet supplies its own finite-chain proof and does not smuggle the general entropy theorem into a subclass argument.\n+\n+## Turn1: projections and Markov phases\n+\n+Reverse-martingale L² convergence proves the stated defect identity. Equality of the two conditional-expectation projections on the cylinder algebra extends by contraction and density to the whole generated L² space, and hence to equality of completed fields. The ordered finite-window limits are essential; no unjustified diagonal or limit interchange occurs.\n+\n+Removing zero-stationary-mass states leaves closed recurrent classes. The period label at time0 is recoverable from every remote coordinate after subtracting its known time index. Conditioning on a class/phase yields stationarity only under a common multipleD of the periods, which the proof preserves.\n+\n+The central two-sided bridge formula is valid after finite-window factorization and martingale passage. Alongm divisible byD, the endpoint denominator tends uniformly to the strictly positive phase-stationary mass. The cancellation gives the correct conditional central-cylinder law. Cofinal reverse-martingale convergence then identifies the bilateral tail and both one-sided tails with the finite phase variable. No reversibility is needed.\n+\n+The alternation example correctly separates an invariant field as a collection from individually invariant events. The weak-limit calculation and infinite-alphabet encoding are limitations of approximation arguments, not counterexamples to the finite-alphabet equality.\n+\n+## Turn2: observable quotient and finite certificate\n+\n+ConditionalD-stationarity and uniform finite-chain mixing give summable covariance bounds for word indicators in either time direction. Chebyshev along squares, Borel–Cantelli and bounded interpolation prove the empirical convergence without invoking an entropy theorem or reversibility. Deleting finitely many observations makes the limiting conditional word probabilities measurable in every completed remote field.\n+\n+An observed bilateral-tail event lies in the hidden bilateral tail, so is a function of the hidden phase variable. Equal forward conditional word profiles imply equal full two-sided observation laws by a commonD-shift, forcing that function to be constant on observationally equivalent phases. This proves precisely the quotient classification, rather than falsely preserving every hidden phase.\n+\n+The column spaces generated by M_w1 stabilize by dimensions−1: once consecutive spaces agree, invariance under eachM_a prevents later growth. The resulting finite word test is exact. Stochastic emissions are legitimately converted into a finite joint Markov chain; the stated bound uses supported joint states, not an unproved sharper count. Independent controls include genuinely stochastic period-two chains, supplementing the author's cyclic examples.\n+\n+## Turn3: uniform complete-connections criterion\n+\n+The assumptions are explicitly stronger than arbitrary stationarity. A maximal next-symbol coupling has common mass at leastε=1−v₀ and can be driven by fresh uniforms with an initial interval guaranteeing agreement. Independent disjoint forcing blocks give the hitting bound. At the stopping time of an agreement run, summing the conditional probabilities of the first later disagreement gives the stated summable tail bound. One first works over finite future horizons and then increases them, so this controls the entire remote-future path, not just one coordinate.\n+\n+The infimum bound tends to0 by first choosing a fixed long agreement run and then increasing separation. Conditional future kernels are correctly generated by successiveg kernels almost surely. The uniform path estimate gives alpha-mixing, both one-sided zero-one laws by cylinder approximation, and uniqueness through stationary finite-block laws. Existence is separately assumed in the general statement and proved for the displayed continuous example via the Feller invariant-measure construction.\n+\n+Bressaud–Fernández–Galves §§4.1–4.4 were read for the classical coupling strategy and maximal-coupling credit. Their ratio-continuity assumptions are not silently identified with the packet's total-variation hypotheses; the packet proves its own sufficient estimate. No bilateral-tail claim is inferred from alpha-mixing.\n+\n+## Turn4: finite-mean coding transfer\n+\n+The decisive-block definition is on one fixed shift-invariant conull domain. It is substantially stronger than a sample-specific eventual agreement assertion. The finite alphabet makes the catalog of decisive blocks and labels measurable even without an algorithm deciding them.\n+\n+The outside-only decoder uses blocks entirely in the observed input half-line, with deterministic labels and defaults. On the conull domain, any decisive block found contains the actual point, so conflicting labels cannot occur. The probability that any remote output coordinate is wrongly decoded is bounded by the sum of radius tails. Finite mean makes this sum tend to0, with no independence assumption.\n+\n+Approximating a fixed tail event by applying its Borel representative to the decoded vector gives convergence in probability inside each fixed completed input field; an almost-sure subsequence proves membership. The past and bilateral versions use the same argument, the latter with two boundary sums. Intersections of completed fields are used correctly. The theorem transfers equality under a finite-mean finitary isomorphism, but does not equate two arbitrary subfields of a common nontrivial input tail.\n+\n+The variable-radius example has least decisive radius2^L: the queried bit can be changed without changing the earlier run or leaving the conull domain, while that full radius determines both run and query. Its infinite mean is genuine. This only blocks automatic applicability of the sufficient condition, as stated.\n+\n+## Turn5: non-atomic laws and rotation\n+\n+For each conditionalD-stationary mixing law, block covariances vanish. Cesàro summation gives variance tending to0; bounded dominated convergence integrates this over the parameter without a uniform mixing rate. The joint L² limit is the random word-probability profile and belongs to both completed tails. Countably many cylinder evaluations determine the random full path law throughD-stationarity.\n+\n+For the reverse inclusion, a fixed global tail event has countably many remote representatives. Disintegration puts those representatives into the completed component tails simultaneously for almost every parameter. Component one-sided triviality makes its conditional probability0 or1. Conditional variance then identifies the event with evaluation of the random law. The proof does not assume that conditioning on an arbitrary tail is automatically tail-trivial, nor recover redundant parameter labels. Bilateral equality is correctly made conditional on a separate component hypothesis.\n+\n+The beta-Bernoulli formulas have the correct posterior and two-block defect. For the irrational-rotation process, both forward and backward sums telescope with the stated strict/non-strict threshold conventions. Dense thresholds give measurable recovery of the phase from every remote half-line. Fourier ergodicity and interval near-returns show that no positive shift power is mixing. These classical ingredients support a special-case equality and an obstruction to a proposed reduction; they do not settle the unrestricted method question.\n+\n+## Reproduction and conclusion\n+\n+The full author replay passes byte-for-byte:210,974 assertions,166 historical/final manifest entries and four primary PDF hashes. All42 remote raw blobs match. The separate reviewer script adds9,334 exact controls for stochastic hidden-path probabilities and word spaces, beta mixtures, forcing-block probabilities and decisive-code truth tables. These finite tests supplement the written infinite-probability arguments; they do not prove general tail equality.\n+\n+Publish only a scoped **unsolved5/5** result. The original equality is known through entropy, while the requested unrestricted probability-only proof remains absent. No general finite-hidden-state, summably continuous, finite-mean finitary or conditionally mixing representation has been established. No original counterexample, sixth author search or novelty certification follows from this packet.\n+\n+Primary evidence:\n+- Steif QuestionC and bilateral warning: https://ems.press/content/serial-article-files/46847\n+- Al-Najjar–Shmaya Theorem5.2/Example6.1: https://arxiv.org/pdf/1406.6670\n+- Lemańczyk AppendixB.1,B.3.2: https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\n+- Complete-connections coupling credit: https://arxiv.org/pdf/math/9806132"},{"sha":"a895f3a751c4efc7c1a50fc5627d64fe3da0c362","filename":"unsolved_math_prioritization/attempts/30004435/final_review/AUTHOR_REPLAY.json","status":"added","additions":13,"deletions":0,"changes":13,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2Ffinal_review%2FAUTHOR_REPLAY.json","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2Ffinal_review%2FAUTHOR_REPLAY.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2Ffinal_review%2FAUTHOR_REPLAY.json?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,13 @@\n+{\n+  \"author_assertions\": 210974,\n+  \"manifest_entries_verified\": 166,\n+  \"per_turn\": [\n+    5527,\n+    25404,\n+    25455,\n+    123026,\n+    31562\n+  ],\n+  \"scope\": \"Five-turn partial packet; unrestricted probability-only tail equality remains unresolved.\",\n+  \"source_pdfs_verified\": 4\n+}"},{"sha":"696ad3f7875eb46e5ab4fb0f59b6d5ce1b6e8289","filename":"unsolved_math_prioritization/attempts/30004435/final_review/INDEPENDENT_CHECKS.json","status":"added","additions":21,"deletions":0,"changes":21,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2Ffinal_review%2FINDEPENDENT_CHECKS.json","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2Ffinal_review%2FINDEPENDENT_CHECKS.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2Ffinal_review%2FINDEPENDENT_CHECKS.json?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,21 @@\n+{\n+  \"assertions\": 9334,\n+  \"by_family\": {\n+    \"beta_mixture_moments\": 288,\n+    \"beta_posterior\": 3024,\n+    \"beta_two_block_defect\": 288,\n+    \"decisive_block_consistency\": 3328,\n+    \"decisive_radius_exact\": 512,\n+    \"direct_hidden_path_sum\": 1152,\n+    \"forced_run_probability\": 110,\n+    \"infinite_mean_truncations\": 20,\n+    \"phase_observability_quotient\": 144,\n+    \"stationary_uniform\": 9,\n+    \"stochastic\": 9,\n+    \"uniform_beta_specialization\": 18,\n+    \"word_span_invariance\": 288,\n+    \"word_span_stabilization\": 144\n+  },\n+  \"scope\": \"Independent exact hidden-path/word-space, beta-mixture, forcing-block and decisive-code controls. Infinite tail arguments were audited separately.\",\n+  \"status\": \"PASS\"\n+}"},{"sha":"7e638b6441849d4d1765f3718e9c654687676cf6","filename":"unsolved_math_prioritization/attempts/30004435/final_review/REMOTE_BINDING.json","status":"added","additions":217,"deletions":0,"changes":217,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2Ffinal_review%2FREMOTE_BINDING.json","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2Ffinal_review%2FREMOTE_BINDING.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2Ffinal_review%2FREMOTE_BINDING.json?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,217 @@\n+{\n+  \"head\": \"f1c1e710597b4d9d0993290091f601d086666126\",\n+  \"folder\": \"unsolved_math_prioritization/attempts/30004435\",\n+  \"files\": [\n+    {\n+      \"path\": \"FINAL_FROZEN_MANIFEST.json\",\n+      \"sha\": \"6fe5862fe5dd9b0b4537b857b1a3900dca57190d\",\n+      \"size\": 6354\n+    },\n+    {\n+      \"path\": \"FINAL_REVIEW_REQUEST.md\",\n+      \"sha\": \"554d096ac93713fce2bb239343bba7bd87ab28c8\",\n+      \"size\": 2695\n+    },\n+    {\n+      \"path\": \"PRIOR_GATE.json\",\n+      \"sha\": \"37bbeb6f3b53ae34ac18a594c4a4c24a6beebb59\",\n+      \"size\": 507\n+    },\n+    {\n+      \"path\": \"READINESS.json\",\n+      \"sha\": \"62b1643adc7b48b62b3223611afe65bab7cf2f88\",\n+      \"size\": 1418\n+    },\n+    {\n+      \"path\": \"REPLAY_ALL.py\",\n+      \"sha\": \"170122b1df152abee3951956697720b7f7d713a2\",\n+      \"size\": 1546\n+    