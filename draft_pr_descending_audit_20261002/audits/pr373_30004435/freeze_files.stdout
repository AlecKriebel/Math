   \"bytes\": 3890,\n+      \"sha256\": \"48d14f56774a07c93a691e3d74eebe448fdceccb72e13eaa06381cd86cd7d98d\"\n+    },\n+    {\n+      \"path\": \"TURN_3_SOURCE.json\",\n+      \"bytes\": 506,\n+      \"sha256\": \"8d543e9720e941ca98c55f6a9c07acff92e49062ec74660bbb5ba71db2820f90\"\n+    },\n+    {\n+      \"path\": \"TURN_3_STATE.json\",\n+      \"bytes\": 2193,\n+      \"sha256\": \"ef1f3692aa2517e14182563b862fe45c716b60f3213416aba661b87030837a90\"\n+    },\n+    {\n+      \"path\": \"TURN_4.md\",\n+      \"bytes\": 7316,\n+      \"sha256\": \"a863f3f38f24c64248e4be1306fe7d25ea5432147887d786b0d18a3cd22531d2\"\n+    },\n+    {\n+      \"path\": \"TURN_4_CHECKS.json\",\n+      \"bytes\": 503,\n+      \"sha256\": \"1c2cc67cce983e6242054e25bfa07e4cd68e1f1266a2cf39e80ec92fd52a4097\"\n+    },\n+    {\n+      \"path\": \"TURN_4_LEDGER.jsonl\",\n+      \"bytes\": 10388,\n+      \"sha256\": \"dd2a171afdc7be9aedcecfb396f351ad33db1e006ff419daeb2c36f53490f315\"\n+    },\n+    {\n+      \"path\": \"TURN_4_MANIFEST.json\",\n+      \"bytes\": 4798,\n+      \"sha256\": \"e3ba378578fa9f774f990e8f7dcc854b7bd8ab62501d9d675e2ae0502be86d24\"\n+    },\n+    {\n+      \"path\": \"TURN_4_STATE.json\",\n+      \"bytes\": 2230,\n+      \"sha256\": \"355f69bb4642da9c64ea9152fb941f1f8596b5d6a0e8feddc92def2fac1498e4\"\n+    },\n+    {\n+      \"path\": \"TURN_5.md\",\n+      \"bytes\": 9631,\n+      \"sha256\": \"71f9476d52ee78036f8cb6b4431fe239cd624b7773cc1ad1ae0307abbb871548\"\n+    },\n+    {\n+      \"path\": \"TURN_5_CHECKS.json\",\n+      \"bytes\": 2986,\n+      \"sha256\": \"35a09b6618b88d2f125fe8936102be189f46181f8d7b9a911af7fd0ccfe1b6cf\"\n+    },\n+    {\n+      \"path\": \"TURN_5_LEDGER.jsonl\",\n+      \"bytes\": 12570,\n+      \"sha256\": \"349b84a82836b8d5a88b1661b15bef324019f9ecd563e35c3d66616fac0d8b81\"\n+    },\n+    {\n+      \"path\": \"TURN_5_MANIFEST.json\",\n+      \"bytes\": 6157,\n+      \"sha256\": \"398a58e14e98dae29ec9968be55a27089595e98365f47b929646deee90fa7575\"\n+    },\n+    {\n+      \"path\": \"TURN_5_STATE.json\",\n+      \"bytes\": 2264,\n+      \"sha256\": \"c1fd64beb73878e21b52d07518f343a901fe0ebef673a00116c92264ec4ce0a3\"\n+    },\n+    {\n+      \"path\": \"final_review/ADVERSARIAL_REVIEW.md\",\n+      \"bytes\": 10232,\n+      \"sha256\": \"8963d394c0e47256a517000460a40f74942585e04a1e8ac093b5800e06c6aa76\"\n+    },\n+    {\n+      \"path\": \"final_review/AUTHOR_REPLAY.json\",\n+      \"bytes\": 278,\n+      \"sha256\": \"1b687c0249b1d054607aca4a0990282c675275a67d6e6f37b78d664087adec5f\"\n+    },\n+    {\n+      \"path\": \"final_review/INDEPENDENT_CHECKS.json\",\n+      \"bytes\": 703,\n+      \"sha256\": \"d89a3352260f426385fa2a68f45051e2a445b3c7f4d5f0459cc9d56c89dbdc48\"\n+    },\n+    {\n+      \"path\": \"final_review/REMOTE_BINDING.json\",\n+      \"bytes\": 5361,\n+      \"sha256\": \"6b774ff6aa65ff1c18ec1a198c05b5cb8d24a140854e81f58abf829afe95a693\"\n+    },\n+    {\n+      \"path\": \"final_review/REVIEW_MANIFEST.json\",\n+      \"bytes\": 1032,\n+      \"sha256\": \"fd9fdd983fc29b09fad2d2cc9c5264db782f0a6748404a639d837335f28aa5eb\"\n+    },\n+    {\n+      \"path\": \"final_review/independent_checks.py\",\n+      \"bytes\": 3910,\n+      \"sha256\": \"c760b4656feb834fd3d2f57b89de174fbfef4db11ac7c4146846edca44b9c274\"\n+    },\n+    {\n+      \"path\": \"final_review/verify_review.py\",\n+      \"bytes\": 984,\n+      \"sha256\": \"b37ddb51201e2d99b0691e289dd37bd83230e5acc07badb51e103e47da2dadba\"\n+    },\n+    {\n+      \"path\": \"finite_markov.py\",\n+      \"bytes\": 1131,\n+      \"sha256\": \"57cf5b9e324d7ba92893d1cc11c216f91f93c56028c7df7c7626770278a5be8e\"\n+    },\n+    {\n+      \"path\": \"observable_space.py\",\n+      \"bytes\": 894,\n+      \"sha256\": \"3f5fdc67932efb1a250e122eae75d40f7e0a177a7998a32f0db01edac0636a4c\"\n+    },\n+    {\n+      \"path\": \"verify_turn1.py\",\n+      \"bytes\": 3224,\n+      \"sha256\": \"a1fa882fab22ca16888dc730828ec7cee53ee3e76e1c449bb996a07bde8f3f03\"\n+    },\n+    {\n+      \"path\": \"verify_turn2.py\",\n+      \"bytes\": 2894,\n+      \"sha256\": \"0ddadd80256280711675205de18f4b120da8930e85bee383ba5bb748a183382e\"\n+    },\n+    {\n+      \"path\": \"verify_turn3.py\",\n+      \"bytes\": 2756,\n+      \"sha256\": \"e4a6cb87c96cd661a292d98dd1b8510f8b41cc477ba1e09087e5c79a5be5ef12\"\n+    },\n+    {\n+      \"path\": \"verify_turn4.py\",\n+      \"bytes\": 2379,\n+      \"sha256\": \"6fac853c14f3905bd53555bfdd2081e2bcf11aaca3b9e57eb568ba445c51ed95\"\n+    },\n+    {\n+      \"path\": \"verify_turn5.py\",\n+      \"bytes\": 2978,\n+      \"sha256\": \"26ede76425c2a65c8bc0730faa09029971550abafacbc36f6da880811410122a\"\n+    }\n+  ]\n+}"},{"sha":"62b1643adc7b48b62b3223611afe65bab7cf2f88","filename":"unsolved_math_prioritization/attempts/30004435/READINESS.json","status":"added","additions":14,"deletions":0,"changes":14,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FREADINESS.json","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FREADINESS.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FREADINESS.json?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,14 @@\n+{\n+  \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\",\n+  \"exact_claim\": \"For every strictly stationary two-sided finite-alphabet process indexed by Z, prove equality modulo null sets of the remote-past and remote-future tail sigma fields using only probability theory, without entropy theory. Steif QuestionC, OWR11/2020 printed632.\",\n+  \"primary_sources\": [\n+    \"https://ems.press/content/serial-article-files/46847\",\n+    \"https://arxiv.org/abs/1406.6670\",\n+    \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"\n+  ],\n+  \"literature_checked_at\": \"2026-10-02T16:44:00Z\",\n+  \"success_test\": \"A full entropy-free proof for arbitrary stationary finite-alphabet processes. Markov, hidden-Markov, mixing or coding subclasses do not suffice; neither does renaming Shannon/relative entropy or invoking the Pinsker theorem.\",\n+  \"budget\": \"Five genuine author turns unless complete general method-compliant result earlier, then independent review.\",\n+  \"prior_attempt_gap\": \"Exact ID/code, tail fields/tail sigma/Pinsker PR searches empty; live branches and recovered paths/commits/recovery inventory show no target attempt. Imported research report absent.\",\n+  \"duplicate_check\": \"409 live branches and379 recovered refs checked. Adjacent30004434 is Gibbs uniform coupling QuestionA, mathematically distinct. No guarantee for inaccessible deleted/unhydrated content.\"\n+}"},{"sha":"114ef766cbd491f931b368a1665726b93386428f","filename":"unsolved_math_prioritization/attempts/30004435/README.md","status":"added","additions":31,"deletions":0,"changes":31,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FREADME.md","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FREADME.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FREADME.md?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,31 @@\n+# Problem 30004435: probability-only tail-field partials\n+\n+**Reviewed disposition: unsolved, 5/5. Independent full scoped audit: PASS.**\n+\n+Steif's original Question C asks for a probability-only proof, without entropy theory, of the equality of the remote-past and remote-future tail fields of every stationary two-sided finite-alphabet process. The general equality is already known through entropy-based arguments. This five-turn packet does not supply the unrestricted requested method.\n+\n+- [Final scope and limitations](RESULT.md)\n+- [Exact source normalization](SOURCE_NORMALIZATION.md)\n+- [Independent full source/proof audit](final_review/ADVERSARIAL_REVIEW.md)\n+- [Original source, printed632](https://ems.press/content/serial-article-files/46847)\n+\n+## Proven subclasses and reductions\n+\n+1. [Finite stationary Markov chains](TURN_1.md): all three tails equal the recurrent-class/periodic-phase field; an exact L² defect formulation and approximation barriers are included.\n+2. [Finite hidden Markov observations](TURN_2.md): the surviving observable tail is a conditional-law quotient, with a proved finite word-length certificate.\n+3. [Complete-connections kernels](TURN_3.md): uniform overlap and summable continuity give both one-sided zero-one laws and a quantitative coupling bound.\n+4. [Finitary codes](TURN_4.md): finite mean coding radius gives corresponding tail inclusions; two-sided finite-mean isomorphisms transfer equality.\n+5. [Non-atomic mixtures and rotation](TURN_5.md): conditional mixing with a common stationary skeleton identifies the random-law tail, while binary irrational rotation explicitly shows a nonmixing common tail outside that reduction.\n+\n+All hypotheses remain essential to the stated results. Alpha-mixing alone is not used to infer bilateral-tail triviality. No general finite-state, coupling, coding or conditional-mixing representation has been established. Classical Markov, coupling, observable-space and rotation ingredients are credited; no novelty claim is made.\n+\n+## Reproduction\n+\n+Python3.10+ standard library only, no third-party packages:\n+\n+    python REPLAY_ALL.py\n+    python final_review/verify_review.py --author-dir .\n+\n+The first command reproduces all210,974 author assertions byte-for-byte and checks166 author manifest bindings. The second validates the unchanged seven-file independent review, all42 frozen author blob identities and9,334 separate exact controls. Optional `python REPLAY_ALL.py --sources PATH` verifies the four source PDFs if they have been obtained separately; they are not redistributed here.\n+\n+The written infinite-probability arguments were independently audited; finite controls alone do not prove tail equalities. The audit is AI-assisted, not external peer review or a historical novelty certification. All42 frozen author files and seven frozen review files are unchanged. Earlier pending-review wording remains part of that history; this additive wrapper records the completed scoped PASS."},{"sha":"170122b1df152abee3951956697720b7f7d713a2","filename":"unsolved_math_prioritization/attempts/30004435/REPLAY_ALL.py","status":"added","additions":18,"deletions":0,"changes":18,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FREPLAY_ALL.py","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FREPLAY_ALL.py","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FREPLAY_ALL.py?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,18 @@\n+\"\"\"Portable standard-library replay and frozen-byte integrity checks.\"\"\"\n+import argparse,hashlib,json,pathlib,subprocess,sys\n+p=pathlib.Path(__file__).resolve().parent\n+ap=argparse.ArgumentParser();ap.add_argument('--sources',type=pathlib.Path);args=ap.parse_args()\n+entries=0\n+for manifest in [*sorted(p.glob('TURN_*_MANIFEST.json')), *sorted(p.glob('FINAL_FROZEN_MANIFEST.json'))]:\n+ for item in json.loads(manifest.read_text())['files']:\n+  b=(p/item['path']).read_bytes();assert len(b)==item['bytes'];assert hashlib.sha256(b).hexdigest()==item['sha256'],(manifest.name,item['path']);entries+=1\n+counts=[]\n+for turn in range(1,6):\n+ output=subprocess.check_output([sys.executable,str(p/f'verify_turn{turn}.py')],cwd=p)\n+ expected=(p/f'TURN_{turn}_CHECKS.json').read_bytes();assert output==expected,f'turn {turn} replay mismatch';counts.append(json.loads(output)['assertions'])\n+source_count=0\n+if args.sources:\n+ items=json.loads((p/'SOURCE_MANIFEST.json').read_text())['primary_pdfs'];extra=json.loads((p/'TURN_3_SOURCE.json').read_text());items.append(dict(file=extra['local_source'],bytes=extra['bytes'],sha256=extra['sha256']))\n+ for item in items:\n+  b=(args.sources/item['file']).read_bytes();assert len(b)==item['bytes'];assert hashlib.sha256(b).hexdigest()==item['sha256'];source_count+=1\n+print(json.dumps(dict(author_assertions=sum(counts),per_turn=counts,manifest_entries_verified=entries,source_pdfs_verified=source_count,scope='Five-turn partial packet; unrestricted probability-only tail equality remains unresolved.'),indent=2,sort_keys=True))"},{"sha":"f071193dba9f1232efcd20e7539e4db4492418b4","filename":"unsolved_math_prioritization/attempts/30004435/RESEARCH_LOG.md","status":"added","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FRESEARCH_LOG.md","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FRESEARCH_LOG.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FRESEARCH_LOG.md?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,5 @@\n+# Tail-field research log\n+\n+Turn1 fixes the exact entropy-free method constraint, gives an L² conditional-expectation defect formulation, and reconstructs the complete finite stationary Markov classification including periodic phases and mixtures. It also proves two approximation barriers: tails are not continuous under fixed-alphabet weak limits, and increasing finite coding limits need not commute with tail intersections. Source examples and classical Markov results are explicitly credited.\n+\n+The unrestricted probability-only proof remains unresolved. Four genuine author turns remain unless a complete method-compliant candidate is obtained earlier."},{"sha":"fbc41f3597ae986ef2160c6d51238286e5f2d785","filename":"unsolved_math_prioritization/attempts/30004435/RESULT.md","status":"added","additions":31,"deletions":0,"changes":31,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FRESULT.md","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FRESULT.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FRESULT.md?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,31 @@\n+# Result: probability-only tail equality remains unresolved after five turns\n+\n+**Proposed disposition: unsolved,5/5 substantive author turns, pending independent review.** This is a scoped partial packet. It does not give the probability-only proof requested for every stationary finite-alphabet process.\n+\n+## Exact original scope\n+\n+Jeffrey Steif's Question C in Oberwolfach Report11/2020, printed632 (report published2021), asks for a proof that the remote-past and remote-future sigma fields of a stationary finite-spin process coincide modulo null sets, using only probability theory and no entropy theory. A standard entropy-based equality theorem is already known. Ergodicity, finite Markov memory, mixing and reversibility are not source assumptions. Bilateral tails are a separate issue and can be larger.\n+\n+Primary source: https://ems.press/content/serial-article-files/46847\n+\n+## Complete scoped results\n+\n+1. TURN_1.md: an exact L² projection-defect reformulation; a probability-only finite stationary Markov classification of all three tails by recurrent class and periodic phase, including mixtures and zero-mass transient states; weak-limit and infinite-alphabet coding-limit obstructions.\n+2. TURN_2.md: for finite hidden-Markov observations, all three tails are generated by the quotient of hidden phases having the same conditional observation law. An invariant-column proof shows that words of length at most s−1 suffice for s supported deterministic hidden states. Finite stochastic emissions are handled by the joint-state construction, with its corresponding state-count bound.\n+3. TURN_3.md: a complete-connections kernel with uniform overlap v_0<1 and summable total-variation continuity has a unique stationary compatible law if one exists, and both one-sided tails are trivial. An explicit uniform remote-future coupling bound and a genuine infinite-memory example are supplied. No bilateral conclusion is drawn from this mixing criterion.\n+4. TURN_4.md: finite-mean finitary codes give corresponding past, future and bilateral tail inclusions via decisive-block decoders. Two-sided finite-mean finitary isomorphisms transfer equality. Mere almost-sure finitariness need not provide integrability, as an explicit variable-radius code shows.\n+5. TURN_5.md: arbitrary standard-Borel mixtures of conditionally mixing, common-D-stationary laws have both tails generated by their random conditional path law, with no uniform mixing rate or parameter identifiability assumption. Bilateral equality needs a separate component hypothesis. A beta-Bernoulli example and an explicit binary irrational-rotation reconstruction demonstrate non-atomic common tails and the failure of an automatic conditional-mixing reduction.\n+\n+The original unrestricted gap is the same in every result: no valid entropy-free reduction places all stationary finite-alphabet processes in the proved subclasses or forces the general projection defect to vanish. No claimed original counterexample, general representation theorem or novelty certification is made.\n+\n+## Credit and dependencies\n+\n+Finite Markov class/phase tail classification is classical, credited through Lemańczyk's thesis AppendixB.3.2 and its Blackwell–Freedman1964 reference. The original Blackwell–Freedman paper was not independently reread; the packet supplies its own finite-chain proof. The infinite-state past-encoding example is credited to Al-Najjar–Shmaya Example6.1. Complete-connections coupling follows the classical strategy of Bressaud–Fernández–Galves1999, whose relevant coupling sections were read. Finite observable spaces, beta mixtures and irrational-rotation itineraries are standard ingredients, with no novelty claim.\n+\n+Proof foundations used explicitly include conditional expectations and martingale convergence, regular conditional distributions on standard Borel spaces, finite Markov period decomposition, elementary maximal coupling, Borel–Cantelli, density of cylinders, finite-dimensional linear algebra, and the basic density/Fourier facts for irrational rotations. No Pinsker, entropy chain-rule or renamed information quantity is used as a substitute for the requested general proof.\n+\n+## Reproducibility and frozen history\n+\n+Python3.10+ standard library only. Run `python REPLAY_ALL.py` from this directory or any other directory. It invokes all five checkers, compares their outputs byte-for-byte with the frozen receipts, and verifies all author manifest entries. Optional `--sources PATH` also validates four locally available source PDFs, which are intentionally excluded from this public packet.\n+\n+The five checkers contain210,974 assertions. These are finite exact controls, not proofs of infinite tail equalities. The proofs and all hypotheses are in the five turn documents. Earlier RESEARCH_LOG.md and state snapshots are intentionally unchanged historical records; this RESULT.md is the final five-turn scope statement."},{"sha":"308b21ce03a18c4cc72d1b4e8e4e092184510c0d","filename":"unsolved_math_prioritization/attempts/30004435/SOURCE_MANIFEST.json","status":"added","additions":25,"deletions":0,"changes":25,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FSOURCE_MANIFEST.json","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FSOURCE_MANIFEST.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FSOURCE_MANIFEST.json?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,25 @@\n+{\n+  \"problem_id\": 30004435,\n+  \"dataset_revision\": \"37e53eabe540fb458758e198be61634bd02ee008\",\n+  \"primary_pdfs\": [\n+    {\n+      \"file\": \"owr_2020_11.pdf\",\n+      \"bytes\": 495851,\n+      \"sha256\": \"9dbb5e7b6cd613e3dd111bdb56ce72714d32bb6d1c368d01cdf8c52ec80b07a3\",\n+      \"url\": \"https://ems.press/content/serial-article-files/46847\"\n+    },\n+    {\n+      \"file\": \"alnajjar_shmaya_2014.pdf\",\n+      \"bytes\": 206635,\n+      \"sha256\": \"3b0ee74e13136388c9d557c88861a1d195bc48b1677a87448466a77c3b9f116e\",\n+      \"url\": \"https://arxiv.org/pdf/1406.6670\"\n+    },\n+    {\n+      \"file\": \"lemanczyk_thesis.pdf\",\n+      \"bytes\": 1633186,\n+      \"sha256\": \"811de0919aeeda6f1f3cb79deedf79a878d8849f45191256ab83ba38ba6fbde4\",\n+      \"url\": \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"\n+    }\n+  ],\n+  \"source_pages\": \"Original Steif pp632-633 QuestionC; Al-Najjar/Shmaya Theorem5.2 pp13-14 and infinite-stateExample6.1; Lemanczyk2020 AppendixB.1 andB.3.2 pp111-115.\"\n+}"},{"sha":"33f081eccdd9db395054bb158589c74662074d79","filename":"unsolved_math_prioritization/attempts/30004435/SOURCE_NORMALIZATION.md","status":"added","additions":15,"deletions":0,"changes":15,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FSOURCE_NORMALIZATION.md","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FSOURCE_NORMALIZATION.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FSOURCE_NORMALIZATION.md?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,15 @@\n+# Exact source and proof-method boundary\n+\n+Problem30004435 / OWR-17474-009 is Jeffrey Steif's Question C in “Some results and open questions concerning Gibbs states, quasilocality and bilateral determinism,” printed pp.632–633 of OWR11/2020. The complete contribution was read and Question C was visually checked. [Primary report](https://ems.press/content/serial-article-files/46847).\n+\n+The process is strictly stationary, indexed by all integers, with a finite alphabet. No Markov, finite-memory, mixing, reversibility or ergodicity assumption is present. The remote-left and remote-right tail fields must coincide modulo null sets. All fields here are understood as completed measure algebras.\n+\n+The equality itself is known. The source explicitly requests a proof using probability theory without entropy theory. A proof via the Pinsker algebra, a Shannon/relative-entropy calculation, or an information-rate argument with terminology changed would not satisfy this request. Our partial arguments use conditional expectation, Markov coupling and finite-dimensional probability only; a full result is not asserted for a subclass.\n+\n+The bilateral tail is a different field. The source explicitly notes finite-state bilaterally deterministic examples with trivial one-sided tails and maximal bilateral tail. Thus equality of all three tails cannot be assumed for general stationary processes. An invariant sigma algebra also differs from a sigma algebra whose individual events are invariant; periodic phase information is an elementary warning.\n+\n+Primary literature consulted:\n+- Al-Najjar–Shmaya, *Learning the ergodic decomposition*, arXiv1406.6670, Theorem5.2, pp.13–14. Their proof explicitly invokes the entropy-based equality, citing Weiss, *Single Orbit Dynamics*, §7. Example6.1 gives the infinite-alphabet asymmetric-tail example used as a control here\n+- M. D. Lemańczyk, *Recurrence of stochastic processes in some concentration of measure and entropy problems*, University of Warsaw dissertation, December2020, AppendixB.1 andB.3.2. The general equality is obtained through entropy/Pinsker theory. The finite-Markov classification is recorded separately in(B.3.3), with credit to Blackwell–Freedman(1964)\n+\n+No method-compliant proof for the unrestricted original was identified in these sources. The literature search is not a worldwide novelty or open-status certification. Adjacent30004434 is the different Gibbs-coupling Question A."},{"sha":"f4d4478c2d7707e7b0385d103965a8a6c91d7e31","filename":"unsolved_math_prioritization/attempts/30004435/TURN_1.md","status":"added","additions":106,"deletions":0,"changes":106,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_1.md","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_1.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_1.md?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,106 @@\n+# Turn 1: exact tail-defect reduction and finite-Markov classification\n+\n+Original method-restricted question remains unresolved. This turn gives a probability-only reduction, reconstructs the complete finite-Markov case including periodicity and mixtures, and exhibits two barriers to passing from finite models to the general process. These are scoped results with prior credit, not a new proof for arbitrary stationary processes.\n+\n+## 1. An exact conditional-expectation formulation\n+\n+Work on the canonical space of the process, with all fields completed. Write\n+\n+    F_m^- = sigma(X_k:k<=−m),\n+    F_m^+ = sigma(X_k:k>=m),\n+    T^- = intersection_m F_m^-,  T^+ = intersection_m F_m^+.\n+\n+For a bounded finite-coordinate cylinder function f, define\n+\n+    D_m(f)=E[(E[f|F_m^-]−E[f|F_m^+])²].\n+\n+Reverse-martingale convergence in L² gives\n+\n+    lim_m D_m(f)=||E[f|T^-]−E[f|T^+]||²_2.             (1.1)\n+\n+The desired equality of the two fields is equivalent to lim_m D_m(f)=0 for every cylinder indicator. Indeed, equality implies equal conditional expectations. Conversely cylinder functions are dense in the L² space generated by the process, and conditional expectations are contractions, so equal projections on cylinders imply equal projections everywhere. Applying them to indicators of events in either field gives equality modulo null sets.\n+\n+For fixed m, the half-line conditional expectations can themselves be obtained as L² limits of conditioning on X_[−N,−m] and X_[m,N] as N→infinity. Thus the exact formulation has an ordered double limit, first N then m. No interchange, finite diagonal test or uniform rate follows from stationarity alone. The finite alphabet does not yet supply the missing estimate in this formulation.\n+\n+## 2. Finite stationary Markov chains: the actual common field\n+\n+Let Y be a stationary Markov chain with finite transition matrix P and stationary law pi. Remove states of pi-mass zero. The remaining states decompose into closed irreducible classes C. For a class of positive mass, write pi_C for its normalized stationary law, d_C for its period, and\n+\n+    C=C_0 union ... union C_(d_C−1)\n+\n+for cyclic subclasses, labeled so transitions advance the label by1 modulo d_C. All cyclic classes have pi_C-mass1/d_C. Define Z=(C,j), where Y_0 lies in C_j.\n+\n+**Claim.** The left tail, right tail and bilateral tail of Y all equal sigma(Z) modulo null sets.\n+\n+The removal of transient states is legitimate. In a finite chain every transient state reaches a closed class almost surely; there is a uniform positive chance of doing so in a bounded number of steps. A stationary distribution therefore assigns zero mass to all transient states. Alternatively, any transition out of positive-pi support would contradict pi P=pi at a zero-mass destination.\n+\n+The variable Z is measurable in each remote half-line: from Y_k one reads its closed class and subtracts k from its cyclic label. This works for any positive or negative k, so sigma(Z) lies in both one-sided tails.\n+\n+## 3. Probability-only mixing within cyclic classes\n+\n+Let D be a common multiple of the finitely many periods. On each C_j, the D-step chain is finite, irreducible and aperiodic. A sufficiently large power Q^a of its transition matrix Q has all entries positive. Set epsilon=|C_j| min_(x,y) Q^a(x,y)>0. Then each row has the common minorization epsilon times the uniform law on C_j.\n+\n+Couple two copies at every a-th step using the common part. They coalesce with probability at least epsilon at each attempt and can remain together thereafter. Their non-coalescence probability is at most(1−epsilon)^k after k attempts. This proves uniform convergence to the stationary phase law, whose mass at a state y in C_j is d_C pi_C(y). The finite graph period decomposition and this coupling use no entropy.\n+\n+Conditioning on Z does not make the chain stationary under a single step when d_C>1. It makes the D-step skeleton stationary on its fixed phase. The proof below retains that distinction.\n+\n+## 4. Two-sided bridges prove the tail upper bound\n+\n+It suffices to handle the bilateral tail, which contains both one-sided tails. Fix a central path y=(y_−r,...,y_r), and let m>r be a multiple of D. Given the entire outside field sigma(Y_k:k<=−m or k>=m), the conditional probability of this central path depends only on i=Y_−m and j=Y_m, and is\n+\n+    P^(m−r)(i,y_−r)\n+      [product_(k=−r)^(r−1) P(y_k,y_(k+1))]\n+      P^(m−r)(y_r,j) / P^(2m)(i,j).                  (4.1)\n+\n+This bridge formula follows by factoring finite Markov path probabilities and canceling the outside factors. Conditioning on larger finite outside windows and taking the martingale limit gives the same formula for the entire outside field. Zero-probability endpoint pairs can be discarded.\n+\n+Fix Z=(C,j_0). Since m is a multiple of D, both endpoints have phase j_0. The mixing just proved gives, uniformly over their possible states,\n+\n+    P^(m−r)(i,y_−r) → d_C pi_C(y_−r)\n+       on the compatible phase j_0−r,\n+    P^(m−r)(y_r,j) → d_C pi_C(j),\n+    P^(2m)(i,j) → d_C pi_C(j)>0.\n+\n+Formula(4.1) therefore converges uniformly to\n+\n+    d_C pi_C(y_−r) product P(y_k,y_(k+1)),\n+\n+which is precisely the probability of the central path conditional on Z. Incompatible paths have probability zero. There are finitely many endpoints and classes, so the convergence is uniform across every positive-mass Z value.\n+\n+Reverse-martingale convergence along the cofinal sequence of these m now yields\n+\n+    E[f | T_bilateral] = E[f | Z]\n+\n+for every finite-coordinate function f. Density of cylinders extends this identity to every bounded measurable f generated by the chain. In particular an indicator measurable in the bilateral tail equals its conditional expectation given Z, so it is sigma(Z)-measurable. This proves the claim in Section2.\n+\n+This classification is standard: see Lemańczyk AppendixB.3.2, formula(B.3.3), and its Blackwell–Freedman reference. The bridge argument here makes its probability-only content and the periodic/mixed cases explicit.\n+\n+## 5. Periodic phase is not the invariant-event field\n+\n+Take the stationary deterministic binary alternation, with the two phases equally likely. All three tails are sigma(Y_0), since any distant observation reveals the phase. But the only shift-invariant events have probability0 or1: the shift interchanges the two sample sequences. Thus replacing the common tail by the invariant-event field would already be wrong in this elementary finite Markov example.\n+\n+The common tail sigma algebra is preserved by the shift as a collection of events. That is different from every event in it being individually shift invariant.\n+\n+## 6. Why finite approximations do not finish the original problem\n+\n+**Fixed-alphabet weak convergence.** Let P_epsilon have binary transition probabilities1−epsilon to stay and epsilon to flip, with the uniform stationary law. For0<epsilon<1 it is irreducible and aperiodic, so both one-sided tails are trivial. As epsilon decreases to0, the finite-dimensional distributions tend to those of a random constant sequence, whose two tails contain the nontrivial initial bit.\n+\n+For an n-letter block the total variation distance is exactly\n+\n+    1−(1−epsilon)^(n−1) <= (n−1)epsilon.\n+\n+One coupling uses the same initial bit and regards any transition as a possible disagreement with the constant sequence. Thus even arbitrarily accurate finite-block approximation does not make tail fields continuous. Both limiting one-sided fields still coincide; this example blocks an argument, not the source theorem.\n+\n+**Increasing alphabet/infinite-memory encoding.** Let(B_k)_(k in Z) be independent fair bits and put\n+\n+    V_k=(B_k,B_(k−1),B_(k−2),...) in {0,1}^N.\n+\n+This process is stationary. Its remote past field is the ordinary iid past tail and is trivial. Every future half-line determines every B_j: choose k>=max(m,j) and read coordinate k−j of V_k. Hence its future tail is the full bit field. This is the source's excluded infinite-spin phenomenon, also explicitly given by Al-Najjar–Shmaya Example6.1.\n+\n+Truncate V_k to its first L coordinates. The resulting finite-state shift-register Markov chain has a transition power of length L with every row uniform, so all three tails are trivial. Passing to the increasing coordinate limit changes the future tail to the full field. One cannot commute an increasing coding limit with the remote-tail intersection.\n+\n+## 7. Exact controls and remaining gap\n+\n+finite_markov.py computes supported closed classes, graph periods and cyclic subclasses using exact rational transitions. verify_turn1.py checks stationary identities, cyclic masses, uniform-coupling bounds and bridge normalizations on33 finite-chain examples with mixtures, periodic classes and a zero-mass transient state. It also checks the alternation, shift-register and weak-limit formulas exactly. These controls do not prove an infinite tail statement; the proofs above do.\n+\n+The remaining source problem is still arbitrary finite-alphabet stationarity, with no Markov or mixing assumption. The defect formulation(1.1) isolates a probability-theoretic target, but no general bound forcing it to zero has been established in this turn. No entropy-based theorem is used to fill that gap."},{"sha":"e0444352b2697710d0663c816314498c479ca30e","filename":"unsolved_math_prioritization/attempts/30004435/TURN_1_CHECKS.json","status":"added","additions":36,"deletions":0,"changes":36,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_1_CHECKS.json","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_1_CHECKS.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_1_CHECKS.json?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,36 @@\n+{\n+  \"assertions\": 5527,\n+  \"bridge_cases\": 1428,\n+  \"chain_cases\": 33,\n+  \"scope\": \"Finite exact controls for the phase/bridge proof and approximation barriers; no finite scan proves the general source method request.\",\n+  \"weak_limit_controls\": [\n+    {\n+      \"epsilon\": \"1/2\",\n+      \"ten_block_tv\": \"511/512\"\n+    },\n+    {\n+      \"epsilon\": \"1/4\",\n+      \"ten_block_tv\": \"242461/262144\"\n+    },\n+    {\n+      \"epsilon\": \"1/8\",\n+      \"ten_block_tv\": \"93864121/134217728\"\n+    },\n+    {\n+      \"epsilon\": \"1/16\",\n+      \"ten_block_tv\": \"30276117361/68719476736\"\n+    },\n+    {\n+      \"epsilon\": \"1/32\",\n+      \"ten_block_tv\": \"8744749928161/35184372088832\"\n+    },\n+    {\n+      \"epsilon\": \"1/64\",\n+      \"ten_block_tv\": \"2380584352628161/18014398509481984\"\n+    },\n+    {\n+      \"epsilon\": \"1/128\",\n+      \"ten_block_tv\": \"628617288245377921/9223372036854775808\"\n+    }\n+  ]\n+}"},{"sha":"1dee66e9cc084de9d919fdf8ac53b8ea94bf5b40","filename":"unsolved_math_prioritization/attempts/30004435/TURN_1_LEDGER.jsonl","status":"added","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_1_LEDGER.jsonl","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_1_LEDGER.jsonl","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_1_LEDGER.jsonl?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,2 @@\n+{\"at\": \"2026-10-02T16:46:17+00:00\", \"id\": \"30004435\", \"status\": \"in_progress\", \"note\": \"Exact finite-state stationary method-restricted source and prior gate complete; begin turn1 with entropy-free structural cases and test barriers.\", \"evidence\": {\"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"exact_claim\": \"For every strictly stationary two-sided finite-alphabet process indexed by Z, prove equality modulo null sets of the remote-past and remote-future tail sigma fields using only probability theory, without entropy theory. Steif QuestionC, OWR11/2020 printed632.\", \"primary_sources\": [\"https://ems.press/content/serial-article-files/46847\", \"https://arxiv.org/abs/1406.6670\", \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"], \"literature_checked_at\": \"2026-10-02T16:44:00Z\", \"success_test\": \"A full entropy-free proof for arbitrary stationary finite-alphabet processes. Markov, hidden-Markov, mixing or coding subclasses do not suffice; neither does renaming Shannon/relative entropy or invoking the Pinsker theorem.\", \"budget\": \"Five genuine author turns unless complete general method-compliant result earlier, then independent review.\", \"prior_attempt_gap\": \"Exact ID/code, tail fields/tail sigma/Pinsker PR searches empty; live branches and recovered paths/commits/recovery inventory show no target attempt. Imported research report absent.\", \"duplicate_check\": \"409 live branches and379 recovered refs checked. Adjacent30004434 is Gibbs uniform coupling QuestionA, mathematically distinct. No guarantee for inaccessible deleted/unhydrated content.\"}, \"statement_hash\": \"30f82fb5516bf7b6151b3524bce6bc5e75149f6be67367899f63a35c192762ce\", \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"turns_used\": 0, \"readiness_review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\"}\n+{\"at\": \"2026-10-02T16:58:50+00:00\", \"id\": \"30004435\", \"status\": \"in_progress\", \"note\": \"Turn 1: entropy-free L2 tail-defect reduction; complete finite stationary Markov classification by recurrent class and periodic phase, including bilateral tails; exact weak-limit and infinite-alphabet coding barriers. Original general finite-alphabet method request remains unresolved.\", \"evidence\": {\"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"exact_claim\": \"For every strictly stationary two-sided finite-alphabet process indexed by Z, prove equality modulo null sets of the remote-past and remote-future tail sigma fields using only probability theory, without entropy theory. Steif QuestionC, OWR11/2020 printed632.\", \"primary_sources\": [\"https://ems.press/content/serial-article-files/46847\", \"https://arxiv.org/abs/1406.6670\", \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"], \"literature_checked_at\": \"2026-10-02T16:44:00Z\", \"success_test\": \"A full entropy-free proof for arbitrary stationary finite-alphabet processes. Markov, hidden-Markov, mixing or coding subclasses do not suffice; neither does renaming Shannon/relative entropy or invoking the Pinsker theorem.\", \"budget\": \"Five genuine author turns unless complete general method-compliant result earlier, then independent review.\", \"prior_attempt_gap\": \"Exact ID/code, tail fields/tail sigma/Pinsker PR searches empty; live branches and recovered paths/commits/recovery inventory show no target attempt. Imported research report absent.\", \"duplicate_check\": \"409 live branches and379 recovered refs checked. Adjacent30004434 is Gibbs uniform coupling QuestionA, mathematically distinct. No guarantee for inaccessible deleted/unhydrated content.\"}, \"statement_hash\": \"30f82fb5516bf7b6151b3524bce6bc5e75149f6be67367899f63a35c192762ce\", \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"turns_used\": 1, \"readiness_review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"event\": \"proof_attempt_turn\"}"},{"sha":"9785bde043c0b73b604ce5ee5e4f648e29e82549","filename":"unsolved_math_prioritization/attempts/30004435/TURN_1_MANIFEST.json","status":"added","additions":62,"deletions":0,"changes":62,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_1_MANIFEST.json","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_1_MANIFEST.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_1_MANIFEST.json?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,62 @@\n+{\n+  \"id\": 30004435,\n+  \"turns_used\": 1,\n+  \"status\": \"Partial results; original unresolved\",\n+  \"files\": [\n+    {\n+      \"path\": \"PRIOR_GATE.json\",\n+      \"bytes\": 507,\n+      \"sha256\": \"fd0ad0c4ad23751d9f27fecc5a8f499c73b406c07b84b5d59e0a9ba2e4aa5cf8\"\n+    },\n+    {\n+      \"path\": \"READINESS.json\",\n+      \"bytes\": 1418,\n+      \"sha256\": \"90fd19020abce398906e76a0dfce9f21b879f644a64832d11b55538f1c7332e1\"\n+    },\n+    {\n+      \"path\": \"RESEARCH_LOG.md\",\n+      \"bytes\": 658,\n+      \"sha256\": \"25a6d3f70118c6b3bdf713015a41b7c2bcf2be5929b7c4a4ee78f408f17e0355\"\n+    },\n+    {\n+      \"path\": \"SOURCE_MANIFEST.json\",\n+      \"bytes\": 970,\n+      \"sha256\": \"33b68ea48a0137520f58438cf46cd58c6d0ae3fe46425d61a3872a4191276289\"\n+    },\n+    {\n+      \"path\": \"SOURCE_NORMALIZATION.md\",\n+      \"bytes\": 2456,\n+      \"sha256\": \"dc2bb2208f8a3d5a1d5be56a3a07a3594874ba3644392e674b44a0efb91f537f\"\n+    },\n+    {\n+      \"path\": \"TURN_1.md\",\n+      \"bytes\": 9259,\n+      \"sha256\": \"ea6cab9e3f11c16fe387209a0d383d1fe8067e941ebe5a689f5d8e9ed133d3b0\"\n+    },\n+    {\n+      \"path\": \"TURN_1_CHECKS.json\",\n+      \"bytes\": 849,\n+      \"sha256\": \"593c5f633877d58408e348b9b39b5c8739e4f3cb4961b6187bcd3cdf90afcc33\"\n+    },\n+    {\n+      \"path\": \"TURN_1_LEDGER.jsonl\",\n+      \"bytes\": 3995,\n+      \"sha256\": \"83b008ec140c8cc21c0dc69552b20cb6059a9224c4a0e4f8cb57780165a82070\"\n+    },\n+    {\n+      \"path\": \"TURN_1_STATE.json\",\n+      \"bytes\": 2165,\n+      \"sha256\": \"cfcd468b584186aea3c10eff17eb9f6fa9f602bc6b3d65b816f98fdb066f4cf9\"\n+    },\n+    {\n+      \"path\": \"finite_markov.py\",\n+      \"bytes\": 1131,\n+      \"sha256\": \"57cf5b9e324d7ba92893d1cc11c216f91f93c56028c7df7c7626770278a5be8e\"\n+    },\n+    {\n+      \"path\": \"verify_turn1.py\",\n+      \"bytes\": 3224,\n+      \"sha256\": \"a1fa882fab22ca16888dc730828ec7cee53ee3e76e1c449bb996a07bde8f3f03\"\n+    }\n+  ]\n+}"},{"sha":"afc6fdd378b4503e432f47025bdfe90e898cdc79","filename":"unsolved_math_prioritization/attempts/30004435/TURN_1_STATE.json","status":"added","additions":25,"deletions":0,"changes":25,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_1_STATE.json","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_1_STATE.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_1_STATE.json?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,25 @@\n+{\n+  \"at\": \"2026-10-02T16:58:50+00:00\",\n+  \"id\": \"30004435\",\n+  \"status\": \"in_progress\",\n+  \"note\": \"Turn 1: entropy-free L2 tail-defect reduction; complete finite stationary Markov classification by recurrent class and periodic phase, including bilateral tails; exact weak-limit and infinite-alphabet coding barriers. Original general finite-alphabet method request remains unresolved.\",\n+  \"evidence\": {\n+    \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\",\n+    \"exact_claim\": \"For every strictly stationary two-sided finite-alphabet process indexed by Z, prove equality modulo null sets of the remote-past and remote-future tail sigma fields using only probability theory, without entropy theory. Steif QuestionC, OWR11/2020 printed632.\",\n+    \"primary_sources\": [\n+      \"https://ems.press/content/serial-article-files/46847\",\n+      \"https://arxiv.org/abs/1406.6670\",\n+      \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"\n+    ],\n+    \"literature_checked_at\": \"2026-10-02T16:44:00Z\",\n+    \"success_test\": \"A full entropy-free proof for arbitrary stationary finite-alphabet processes. Markov, hidden-Markov, mixing or coding subclasses do not suffice; neither does renaming Shannon/relative entropy or invoking the Pinsker theorem.\",\n+    \"budget\": \"Five genuine author turns unless complete general method-compliant result earlier, then independent review.\",\n+    \"prior_attempt_gap\": \"Exact ID/code, tail fields/tail sigma/Pinsker PR searches empty; live branches and recovered paths/commits/recovery inventory show no target attempt. Imported research report absent.\",\n+    \"duplicate_check\": \"409 live branches and379 recovered refs checked. Adjacent30004434 is Gibbs uniform coupling QuestionA, mathematically distinct. No guarantee for inaccessible deleted/unhydrated content.\"\n+  },\n+  \"statement_hash\": \"30f82fb5516bf7b6151b3524bce6bc5e75149f6be67367899f63a35c192762ce\",\n+  \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\",\n+  \"turns_used\": 1,\n+  \"readiness_review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\",\n+  \"event\": \"proof_attempt_turn\"\n+}"},{"sha":"1d99a820af9a7086dd41b4c2b542ba483a19392b","filename":"unsolved_math_prioritization/attempts/30004435/TURN_2.md","status":"added","additions":65,"deletions":0,"changes":65,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_2.md","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_2.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_2.md?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,65 @@\n+# Turn 2: observable tail quotients for finite hidden Markov processes\n+\n+This turn extends the first-turn probability-only classification to every deterministic observation of a finite stationary Markov chain, with a finite linear-algebra test for the surviving tail information. Stochastic finite-alphabet emissions reduce to this case by enlarging the Markov state. The unrestricted stationary-process method request remains unresolved. No novelty claim is made for the standard Markov/observable-space ingredients.\n+\n+## 1. Statement and the finite hidden phase variable\n+\n+Let Y be a stationary Markov chain with s supported states, transition P and stationary distribution pi. Let X_k=f(Y_k) take values in a finite alphabet A. Let Z denote the recurrent-class/cyclic-phase variable from Turn 1, and let D be the least common multiple of the class periods. All Z values considered have positive probability. Conditional on Z=z, the chain and its observation are invariant under shift by D, with exponential mixing of finite cylinders along this skeleton.\n+\n+For a word w in A^l let\n+\n+    p_z(w)=P(X_[0,l−1]=w | Z=z).\n+\n+Put z~z' if p_z(w)=p_z'(w) for every finite word. Denote this finite quotient by Q(Z).\n+\n+**Theorem.** Each of the past, future and bilateral tail fields of X equals sigma(Q(Z)), modulo null sets. Moreover the equivalence relation is determined by words of length at most s−1 (including the empty word when s=1).\n+\n+Distinct hidden phases need not remain distinguishable after observation. The quotient, rather than the original hidden phase, is essential.\n+\n+## 2. Recovering the conditional law in either remote direction\n+\n+Fix z and a finite word w. For integer k set\n+\n+    I_k=1{X_[kD,kD+l−1]=w}.\n+\n+Under P(.|Z=z), the I_k are stationary. Their covariances are bounded in absolute value by C rho^|k−j| once the windows do not overlap, for constants C<infinity and rho<1 depending on z and the word. Indeed condition on the hidden state at the end of the earlier block; the finite cyclic mixing estimate from Turn 1 makes the distribution at the start of the later block uniformly close to its conditional stationary phase distribution. The finitely many overlapping separations can be absorbed in C. The same bound applies when both indices are negative, by stationarity and symmetry of covariance; no reversibility is required.\n+\n+Consequently the variance of the average of N consecutive I_k is at most C'/N. Chebyshev along N=j² and Borel–Cantelli give almost-sure convergence along the squares to p_z(w). Since 0<=I_k<=1 and (j+1)²/j²→1, the averages between successive squares have the same limit. This proves a probability-only strong law in both directions.\n+\n+The limiting future average is unchanged by deleting any finite number of initial terms. For every m it can be computed using only windows with kD>=m. The past average similarly uses only windows ending at kD+l−1<=−m. Thus the random vector (p_Z(w):w finite) is measurable in both completed one-sided tails. There are only finitely many z and countably many words, so the statements hold simultaneously outside one null set. In particular sigma(Q(Z)) is contained in both tails.\n+\n+## 3. The upper bound and equality of conditional laws\n+\n+Any X-tail event is a Y-bilateral-tail event because each observed coordinate is a function of the corresponding hidden coordinate. Turn 1 therefore makes it an event h(Z), with h taking values0 or1. We must show h is constant on equivalence classes of ~.\n+\n+First, equality of all forward word probabilities implies equality of the entire two-sided conditional X laws. Given a cylinder whose coordinates include negative times, translate the cylinder by a sufficiently large multiple of D so that all its coordinates are nonnegative. Conditional D-stationarity preserves its probability. Fill any gaps and sum contiguous word probabilities. This proves equality on a generating cylinder algebra and hence on all measurable X events.\n+\n+If z~z', an X-measurable event A=h(Z) has conditional probability h(z) under z and h(z') under z'. Equal conditional observation laws force these two numbers to agree. Therefore h factors through Q. Every bilateral X-tail event lies in sigma(Q(Z)); Section2 supplies the converse inclusion already in each one-sided tail. This proves all three equalities. No exchange of an intersection with a join or conditional sigma field is used.\n+\n+## 4. A finite word-length certificate\n+\n+Write alpha_z for the conditional row distribution of Y_0 given Z=z. For a in A define\n+\n+    M_a=diag(1{f(i)=a}) P.\n+\n+For w=a_1...a_l put M_w=M_(a_1)...M_(a_l), and M_empty=Id. Since P1=1,\n+\n+    p_z(w)=alpha_z M_w 1.\n+\n+In the real vector space of columns of length s define\n+\n+    V_k=span{M_w 1: |w|<=k}.\n+\n+Then V_0=span{1}, and V_(k+1) is the span of V_k and all M_a V_k. If two consecutive spaces agree, the space is invariant under every M_a and contains every later word column. Otherwise its dimension increases by at least1. Since the ambient dimension is s, stabilization occurs by V_(s−1).\n+\n+Therefore (alpha_z−alpha_z') vanishes on every word column if and only if it vanishes on the words of length at most s−1. This is an exact linear-algebra certificate, not a finite experimental guess. Rational P permits exact arithmetic. The same argument is the usual finite-dimensional observable-space construction; the contribution here is an explicit certificate for the scoped tail quotient, without a novelty assertion.\n+\n+For finite stochastic emissions e_i(a), the joint process (Y_k,X_k) has transition P(i,j)e_j(b) and stationary law pi(i)e_i(a). Remove zero-mass joint states and apply the theorem to the deterministic projection onto X. The stated word bound then uses the number of supported joint states. No claim of a sharper hidden-state bound is needed here.\n+\n+## 5. Examples, controls and the remaining obstruction\n+\n+A deterministic six-cycle observed as001001 has three surviving observable phases, although its hidden phase variable has six values. A constant observation collapses every hidden phase and recurrent class. Conversely two closed aperiodic classes with iid binary observations of different biases retain their class label in both tails through empirical frequencies.\n+\n+verify_turn2.py checks exact word probabilities, the invariant observable-space construction, stabilization by s−1, and agreement of short-word and longer-word quotients on finite deterministic observations of cyclic chains and mixtures. It separately enumerates hidden paths to check matrix-word probabilities. These are algebraic controls; the all-length theorem is proved above.\n+\n+This argument cannot classify arbitrary finite-alphabet stationary processes: there need not be a finite hidden phase variable or a finite-dimensional invariant word space. Replacing the original process by increasingly large hidden-Markov approximations would require a justified tail-limit passage, which Turn 1's examples show cannot be taken for granted. The source's no-entropy condition is still unmet in full generality."},{"sha":"c73db040f7b502bb24f6a4fb6dd8c75076f5f0af","filename":"unsolved_math_prioritization/attempts/30004435/TURN_2_CHECKS.json","status":"added","additions":15,"deletions":0,"changes":15,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_2_CHECKS.json","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_2_CHECKS.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_2_CHECKS.json?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,15 @@\n+{\n+  \"assertions\": 25404,\n+  \"independent_path_probability_checks\": 15569,\n+  \"observable_dimensions\": {\n+    \"1\": 17,\n+    \"2\": 7,\n+    \"3\": 21,\n+    \"4\": 44,\n+    \"5\": 46,\n+    \"6\": 50,\n+    \"7\": 29\n+  },\n+  \"observation_cases\": 214,\n+  \"scope\": \"Exact finite controls; the tail and finite-word theorems are proved in TURN_2.md.\"\n+}"},{"sha":"37427f4b9905aa3b4f1a16a6ad1e69c458071519","filename":"unsolved_math_prioritization/attempts/30004435/TURN_2_LEDGER.jsonl","status":"added","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_2_LEDGER.jsonl","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_2_LEDGER.jsonl","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_2_LEDGER.jsonl?ref=4e635c77d7399d671ea58700e41bbd92cbdeeb46","patch":"@@ -0,0 +1,3 @@\n+{\"at\": \"2026-10-02T16:46:17+00:00\", \"id\": \"30004435\", \"status\": \"in_progress\", \"note\": \"Exact finite-state stationary method-restricted source and prior gate complete; begin turn1 with entropy-free structural cases and test barriers.\", \"evidence\": {\"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"exact_claim\": \"For every strictly stationary two-sided finite-alphabet process indexed by Z, prove equality modulo null sets of the remote-past and remote-future tail sigma fields using only probability theory, without entropy theory. Steif QuestionC, OWR11/2020 printed632.\", \"primary_sources\": [\"https://ems.press/content/serial-article-files/46847\", \"https://arxiv.org/abs/1406.6670\", \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"], \"literature_checked_at\": \"2026-10-02T16:44:00Z\", \"success_test\": \"A full entropy-free proof for arbitrary stationary finite-alphabet processes. Markov, hidden-Markov, mixing or coding subclasses do not suffice; neither does renaming Shannon/relative entropy or invoking the Pinsker theorem.\", \"budget\": \"Five genuine author turns unless complete general method-compliant result earlier, then independent review.\", \"prior_attempt_gap\": \"Exact ID/code, tail fields/tail sigma/Pinsker PR searches empty; live branches and recovered paths/commits/recovery inventory show no target attempt. Imported research report absent.\", \"duplicate_check\": \"409 live branches and379 recovered refs checked. Adjacent30004434 is Gibbs uniform coupling QuestionA, mathematically distinct. No guarantee for inaccessible deleted/unhydrated content.\"}, \"statement_hash\": \"30f82fb5516bf7b6151b3524bce6bc5e75149f6be67367899f63a35c192762ce\", \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"turns_used\": 0, \"readiness_review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\"}\n+{\"at\": \"2026-10-02T16:58:50+00:00\", \"id\": \"30004435\", \"status\": \"in_progress\", \"note\": \"Turn 1: entropy-free L2 tail-defect reduction; complete finite stationary Markov classification by recurrent class and periodic phase, including bilateral tails; exact weak-limit and infinite-alphabet coding barriers. Original general finite-alphabet method request remains unresolved.\", \"evidence\": {\"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"exact_claim\": \"For every strictly stationary two-sided finite-alphabet process indexed by Z, prove equality modulo null sets of the remote-past and remote-future tail sigma fields using only probability theory, without entropy theory. Steif QuestionC, OWR11/2020 printed632.\", \"primary_sources\": [\"https://ems.press/content/serial-article-files/46847\", \"https://arxiv.org/abs/1406.6670\", \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"], \"literature_checked_at\": \"2026-10-02T16:44:00Z\", \"success_test\": \"A full entropy-free proof for arbitrary stationary finite-alphabet processes. Markov, hidden-Markov, mixing or coding subclasses do not suffice; neither does renaming Shannon/relative entropy or invoking the Pinsker theorem.\", \"budget\": \"Five genuine author turns unless complete general method-compliant result earlier, then independent review.\", \"prior_attempt_gap\": \"Exact ID/code, tail fields/tail sigma/Pinsker PR searches empty; live branches and recovered paths/commits/recovery inventory show no target attempt. Imported research report absent.\", \"duplicate_check\": \"409 live branches and379 recovered refs checked. Adjacent30004434 is Gibbs uniform coupling QuestionA, mathematically distinct. No guarantee for inaccessible deleted/unhydrated content.\"}, \"statement_hash\": \"30f82fb5516bf7b6151b3524bce6bc5e75149f6be67367899f63a35c192762ce\", \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"turns_used\": 1, \"readiness_review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"event\": \"proof_attempt_turn\"}\n+{\"at\": \"2026-10-02T17:04:26+00:00\", \"id\": \"30004435\", \"status\": \"in_progress\", \"note\": \"Turn 2: all three observable tail fields of a finite hidden Markov process equal the quotient of hidden recurrent-class/phase states by their conditional observation laws. Two-sided empirical block frequencies recover the quotient; exact invariant-column proof gives word-length bound s-1. General stationary process remains unresolved.\", \"evidence\": {\"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"exact_claim\": \"For every strictly stationary two-sided finite-alphabet process indexed by Z, prove equality modulo null sets of the remote-past and remote-future tail sigma fields using only probability theory, without entropy theory. Steif QuestionC, OWR11/2020 printed632.\", \"primary_sources\": [\"https://ems.press/content/serial-article-files/46847\", \"https://arxiv.org/abs/1406.6670\", \"https://www.mimuw.edu.pl/media/uploads/doctorates/thesis-michal-lemanczyk.pdf\"], \"literature_checked_at\": \"2026-10-02T16:44:00Z\", \"success_test\": \"A full entropy-free proof for arbitrary stationary finite-alphabet processes. Markov, hidden-Markov, mixing or coding subclasses do not suffice; neither does renaming Shannon/relative entropy or invoking the Pinsker theorem.\", \"budget\": \"Five genuine author turns unless complete general method-compliant result earlier, then independent review.\", \"prior_attempt_gap\": \"Exact ID/code, tail fields/tail sigma/Pinsker PR searches empty; live branches and recovered paths/commits/recovery inventory show no target attempt. Imported research report absent.\", \"duplicate_check\": \"409 live branches and379 recovered refs checked. Adjacent30004434 is Gibbs uniform coupling QuestionA, mathematically distinct. No guarantee for inaccessible deleted/unhydrated content.\"}, \"statement_hash\": \"30f82fb5516bf7b6151b3524bce6bc5e75149f6be67367899f63a35c192762ce\", \"review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"turns_used\": 2, \"readiness_review_hash\": \"a3b19a60e2f5f77bbf4e437e5a85c849ef451e01109f287fe943b007f44c0265\", \"event\": \"proof_attempt_turn\"}"},{"sha":"d661206f9f88664964b9093dfc4e37bced62b79f","filename":"unsolved_math_prioritization/attempts/30004435/TURN_2_MANIFEST.json","status":"added","additions":97,"deletions":0,"changes":97,"blob_url":"https://github.com/AlecKriebel/Math/blob/4e635c77d7399d671ea58700e41bbd92cbdeeb46/unsolved_math_prioritization%2Fattempts%2F30004435%2FTURN_2_MANIFEST.json","raw_url":"https://github.com/AlecKriebel/Math/raw/4e635c77d7399d671ea