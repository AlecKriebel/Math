+for ns in [(2,3),(2,3,4),(3,3,3),(2,2,2,2)]:
+ es=list(product(*(range(n) for n in ns)));ix={x:i for i,x in enumerate(es)};M=[[ix[tuple((a+b)%n for a,b,n in zip(x,y,ns))] for y in es] for x in es]
+ choices=[]
