+#!/usr/bin/env python3
+from math import gcd
+from fractions import Fraction as F
+from itertools import product
+import json
+checks=complexes=kernels=0
+for m in range(1,101):
+ for n in range(1,101):
+  g=gcd(m,n);v=(m//g,n//g)
