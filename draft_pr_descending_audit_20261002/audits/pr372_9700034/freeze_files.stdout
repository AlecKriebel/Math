[[{"sha":"78c59cb2212f07ab00b5f2d46d668db8c6f6006b","filename":"problems/9700034_sirsn_maximal_routes/FINAL_AUTHOR_MANIFEST.json","status":"added","additions":195,"deletions":0,"changes":195,"blob_url":"https://github.com/AlecKriebel/Math/blob/f30fb696da92fd4b998d61859d6ed06012ce78d4/problems%2F9700034_sirsn_maximal_routes%2FFINAL_AUTHOR_MANIFEST.json","raw_url":"https://github.com/AlecKriebel/Math/raw/f30fb696da92fd4b998d61859d6ed06012ce78d4/problems%2F9700034_sirsn_maximal_routes%2FFINAL_AUTHOR_MANIFEST.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F9700034_sirsn_maximal_routes%2FFINAL_AUTHOR_MANIFEST.json?ref=f30fb696da92fd4b998d61859d6ed06012ce78d4","patch":"@@ -0,0 +1,195 @@\n+{\n+  \"problem_id\": 9700034,\n+  \"substantive_author_turns_used\": 5,\n+  \"original_target_resolved\": false,\n+  \"proposed_status\": \"unsolved\",\n+  \"author_search_stopped\": true,\n+  \"independent_review_pending\": true,\n+  \"files\": [\n+    {\n+      \"path\": \"FINAL_REPLAY.json\",\n+      \"bytes\": 1275,\n+      \"sha256\": \"d9959f2160968273b7e5a2897d467812921a72db1f564a6fc2b795178ce66080\"\n+    },\n+    {\n+      \"path\": \"FINAL_RESULT.md\",\n+      \"bytes\": 5625,\n+      \"sha256\": \"dc9f495a48092fb2031cc573b34ead086ce87746accf6bfdf05ace74efb22638\"\n+    },\n+    {\n+      \"path\": \"FINAL_REVIEW_REQUEST.md\",\n+      \"bytes\": 2812,\n+      \"sha256\": \"2f3b59908c1cf7d1d1e217a298d7fa5394f6dd029ce2018b83e771749a0f0faa\"\n+    },\n+    {\n+      \"path\": \"FINAL_SOURCE_MAP.md\",\n+      \"bytes\": 3665,\n+      \"sha256\": \"c19f6087f0acc2afbd82f511ccd771d20da40b763f9f6372d33805fe26240097\"\n+    },\n+    {\n+      \"path\": \"LOG_T2.md\",\n+      \"bytes\": 829,\n+      \"sha256\": \"cdc473142d8a15da12d7b210e3bebd75c102ad017f1eede44e38bf7e36374dcb\"\n+    },\n+    {\n+      \"path\": \"LOG_T3.md\",\n+      \"bytes\": 698,\n+      \"sha256\": \"794ad35e8072b6d5ebda3b75546a7c63cf872799308041fb375516e2e3f7d0e5\"\n+    },