{"created": "2026-10-03T21:48:32.746178+00:00", "modified": "2026-10-03T21:48:33.076998+00:00", "id": 23127646, "conceptrecid": "23127645", "doi": "10.5281/zenodo.23127646", "conceptdoi": "10.5281/zenodo.23127645", "doi_url": "https://doi.org/10.5281/zenodo.23127646", "metadata": {"title": "Non-symmetry of biconstrained two-step reachability", "doi": "10.5281/zenodo.23127646", "publication_date": "2026-10-03", "description": "We give a negative answer to the symmetry question for the universal finite-tripartite biconstrained two-step reachability function psi: the absolute difference at (13/27,14/27) and its swap is at least 1/108. For rational theta in (0,1), we prove the exact boundary formula psi(1-theta,theta)=1-theta/d(theta), where d is a minimum integer degree over positively rational weighted regular incidence templates. The credited seven-type example of Chudnovsky, Hompe, Scott, Seymour and Spirkl and its complement bound the two relevant integers by four, which makes equality impossible. The exact values, their ordering and the invariant minima are not evaluated. A self-contained four-page research note and portable exact verification supplement accompany the result. The matrix and weighted framework are prior work. A dated bounded literature audit found no earlier equivalent theorem but does not certify global novelty; the cited 2019 senior thesis was inaccessible. AI tools were used extensively in solving, verifying, literature research, writing and adversarial review. This is an unrefereed preprint and has not received external human peer review.", "access_right": "open", "creators": [{"name": "Kriebel, Alec", "affiliation": "Independent researcher", "orcid": "0009-0001-9320-500X"}], "keywords": ["graph theory", "biconstrained graphs", "two-step reachability", "weighted regular matrices", "symmetry", "exact verification"], "version": "1.0", "resource_type": {"title": "Preprint", "type": "publication", "subtype": "preprint"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23127645"}}]}}, "title": "Non-symmetry of biconstrained two-step reachability", "links": {"self": "https://zenodo.org/api/records/23127646", "self_html": "https://zenodo.org/records/23127646", "preview_html": "https://zenodo.org/records/23127646?preview=1", "doi": "https://doi.org/10.5281/zenodo.23127646", "self_doi": "https://doi.org/10.5281/zenodo.23127646", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23127646", "reserve_doi": "https://zenodo.org/api/records/23127646/draft/pids/doi", "parent": "https://zenodo.org/api/records/23127645", "parent_html": "https://zenodo.org/records/23127645", "parent_doi": "https://doi.org/10.5281/zenodo.23127645", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23127645", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23127646/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23127646/sequence/default", "files": "https://zenodo.org/api/records/23127646/files", "media_files": "https://zenodo.org/api/records/23127646/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:23127646:biconstrained_asymmetry.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:23127646:biconstrained_asymmetry.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:23127646:biconstrained_asymmetry.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:23127646:biconstrained_asymmetry.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:23127646:biconstrained_asymmetry.pdf/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record:23127646:biconstrained_asymmetry.pdf/full/%5E1200,/0/default.jpg"}, "archive": "https://zenodo.org/api/records/23127646/files-archive", "archive_media": "https://zenodo.org/api/records/23127646/media-files-archive", "latest": "https://zenodo.org/api/records/23127646/versions/latest", "latest_html": "https://zenodo.org/records/23127646/latest", "versions": "https://zenodo.org/api/records/23127646/versions", "draft": "https://zenodo.org/api/records/23127646/draft", "access_links": "https://zenodo.org/api/records/23127646/access/links", "access_grants": "https://zenodo.org/api/records/23127646/access/grants", "access_users": "https://zenodo.org/api/records/23127646/access/users", "access_request": "https://zenodo.org/api/records/23127646/access/request", "access": "https://zenodo.org/api/records/23127646/access", "communities": "https://zenodo.org/api/records/23127646/communities", "communities-suggestions": "https://zenodo.org/api/records/23127646/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23127646/request-deletion", "file_modification": "https://zenodo.org/api/records/23127646/file-modification", "quota_increase": "https://zenodo.org/api/records/23127646/quota-increase", "requests": "https://zenodo.org/api/records/23127646/requests"}, "updated": "2026-10-03T21:48:33.076998+00:00", "recid": "23127646", "revision": 3, "files": [{"id": "171f87bb-03d6-4b0b-bb39-cf1b861c93d8", "key": "biconstrained_asymmetry.pdf", "size": 67359, "checksum": "md5:82911cd471138ea4c5c40d2ba0747634", "links": {"self": "https://zenodo.org/api/records/23127646/files/biconstrained_asymmetry.pdf/content"}}, {"id": "002a4f8b-c56b-443d-b12d-53581047fe71", "key": "biconstrained-asymmetry-verification.zip", "size": 198015, "checksum": "md5:75a0dfae581142f858d6c2455e14dbf1", "links": {"self": "https://zenodo.org/api/records/23127646/files/biconstrained-asymmetry-verification.zip/content"}}], "swh": {}, "owners": [{"id": "1789874"}], "status": "published", "stats": {"downloads": 0, "unique_downloads": 0, "views": 0, "unique_views": 0, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 0, "version_views": 0}, "state": "done", "submitted": true}