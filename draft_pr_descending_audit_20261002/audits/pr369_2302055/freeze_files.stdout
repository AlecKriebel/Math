dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Freview%2FAUTHOR_REPLAY.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Freview%2FAUTHOR_REPLAY.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F2302055%2Freview%2FAUTHOR_REPLAY.json?ref=d9e4600d05b8272fe913a22ae7dcc0fbe0a26344","patch":"@@ -0,0 +1,41 @@\n+{\n+  \"status\": \"PASS\",\n+  \"author_manifest_sha256\": \"474097376562f1af729fbafdacabe3a5df8ed2a16da92f337b5f2dedd0c62c52\",\n+  \"bound_files\": 39,\n+  \"receipts\": [\n+    {\n+      \"cases\": 84,\n+      \"cases_with_repeated_roots\": 33,\n+      \"exact_assertions\": 1764,\n+      \"degree_patterns\": 7,\n+      \"analytic_claims_tested\": false\n+    },\n+    {\n+      \"exact_assertions\": 7551,\n+      \"lattice_cases\": 518,\n+      \"product_monodromy_cases\": 49,\n+      \"symmetric_component_cases\": 300,\n+      \"analytic_claims_tested\": false\n+    },\n+    {\n+      \"laurent_maps\": 374,\n+      \"exact_assertions\": 7421,\n+      \"sample_fibers_per_map\": 4,\n+      \"analytic_claims_tested\": false\n+    },\n+    {\n+      \"exact_assertions\": 11956,\n+      \"group_law_cases\": 500,\n+      \"iterated_commutator_cases\": 1152,\n+      \"analytic_counterexample_claimed\": false\n+    },\n+    {\n+      \"exact_assertions\": 9374,\n+      \"translation_parameter_cases\": 1053,\n+      \"jordan_power_cases\": 440,\n+      \"gaussian_norm_cases\": 676,\n+      \"polynomial_translation_cases\": 1155,\n+      \"analytic_resolution_claimed\": false\n+    }\n+  ]\n+}"},{"sha":"df5946d1f2708fe6c3c05b1a9211954b329fba9c","filename":"unsolved_math_prioritization/attempts/2302055/review/INDEPENDENT_CHECKS.json","status":"added","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/AlecKriebel/Math/blob/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Freview%2FINDEPENDENT_CHECKS.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Freview%2FINDEPENDENT_CHECKS.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F2302055%2Freview%2FINDEPENDENT_CHECKS.json?ref=d9e4600d05b8272fe913a22ae7dcc0fbe0a26344","patch":"@@ -0,0 +1,5 @@\n+{\n+  \"status\": \"PASS\",\n+  \"independent_assertions\": 1420,\n+  \"scope\": \"Independent resultant/companion equality, exact infinite-lamp finite differences, fractional exponents and Jordan powers; analytic and topological implications audited in full prose.\"\n+}"},{"sha":"95978f25a3b405a9e5331374cd952d67fa684276","filename":"unsolved_math_prioritization/attempts/2302055/review/REVIEW.md","status":"added","additions":43,"deletions":0,"changes":43,"blob_url":"https://github.com/AlecKriebel/Math/blob/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Freview%2FREVIEW.md","raw_url":"https://github.com/AlecKriebel/Math/raw/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Freview%2FREVIEW.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F2302055%2Freview%2FREVIEW.md?ref=d9e4600d05b8272fe913a22ae7dcc0fbe0a26344","patch":"@@ -0,0 +1,43 @@\n+# Independent full source/proof review: 2302055\n+\n+PASS for all stated partial results; original unsolved5/5. No mandatory revision found. This is an independent AI-assisted audit, not external peer review or a historical novelty certification.\n+\n+## Source and exact target\n+\n+Hayman–Lingham Problem2.55 printed43 was visually checked: all three inputs are arbitrary nonconstant entire functions; F is ambient entire and bounded on the full zero hypersurface; constancy is required on that hypersurface, not the ambient space. Demailly's printed179–180 and both pages39–40 of his C.R. note were checked. They credit the separated-sum irreducibility theorem and establish the known rational-input and two-exponential cases. Demailly–Wakabayashi's Liouville curve input and Lin–Zaidenberg Theorem1.6 are external classical dependencies, not new discoveries. The latter really requires ultra-Liouville and permits hypernilpotent deck groups.\n+\n+The original full Rubel–Squires–Taylor proof remains unretrieved. Its precise theorem statement is explicitly available in Demailly's primary publication and is a credited input here. The audit checks its applicability, not a new proof of it. Keep this retrieval qualification and the lack of novelty certification prominent.\n+\n+## Turn1\n+\n+The companion-matrix tensor functional calculus is entire by compact-uniform absolute convergence of the ambient entire Taylor series. Separate triangularization handles all fiber multiplicities, including critical values; its characteristic coefficients are ambient entire. Bounded symmetric coefficients on the original hypersurface force the lifted function to take a fixed finite set of values; connectedness, with the stated irreducibility input, supplies constancy. The reverse implication uses actual surjectivity. Thus the polynomial-precomposition equivalence has both directions. Discrete critical products give reducedness and isolated singularities; connected regular loci and the coordinate exponential map give the required connected regular abelian cover of the algebraic quotient.\n+\n+## Turn2\n+\n+For generic c, the two finite sets of branch punctures are disjoint. Their individual loops act only on the appropriate root factor and generate the transitive factor monodromy groups, proving product transitivity and generic connectedness. Meromorphic coordinate degree bounds control all boundary valuations. If those vectors had rank less than two, an integer monomial would be constant on the compact normalization, forcing a torus coset and c equal to the excluded constant coefficient. The determinant index bound follows. The proof does not assume the boundary loops generate all homology.\n+\n+The local sphere isotopies fix the requisite branch images and distinguished0/infinity images. Isotopy lifting from the identity and local branched-map models justify their extension and preservation of0/infinity. Their logarithmic lifts supply continuous component labels, while separate implicit-function sections supply holomorphic component values. Only after that is the bounded symmetric polynomial formed. Removable singularities in the third variable and the explicit local-openness density argument cover all exceptional fibers. No improper global trace or finite count alone replaces local triviality.\n+\n+## Turn3\n+\n+The finite-fiber maximum of a bounded continuous plurisubharmonic function is locally plurisubharmonic over the regular covering locus. Bounded extension across the analytic base set is legitimate. Its constancy on C^n, actual maximum attainment in a finite fiber, density upstairs and the maximum principle prove ultra-Liouville. The finite rational quotient satisfies every hypothesis even with the other two inputs arbitrary. Lin's theorem is applied to the connected cyclic cover of that ultra-Liouville regular locus, not merely a Liouville base. The transient-curve example is correctly a failed quotient-method route on a hypersurface already known affirmative.\n+\n+## Turn4\n+\n+The normal closure of the inverse covering has deck group equal to inverse monodromy, without assuming the initial cover normal. A component of its pullback has the corresponding subgroup as deck group and covers the connected original pullback surjectively. A subgroup of a virtually nilpotent group is virtually nilpotent; taking its finite-index nilpotent core and the finite-cover maximum lemma makes the application of Lin exact. Removal of the analytic excluded fibers and final density are justified.\n+\n+For exp(exp z), the two basic puncture loops give a shift on the inner logarithm index and a unit outer-log translation on one index fiber. Relabeling removes the shift's cocycle without changing that lamp. Their faithful group is the restricted wreath product Z wr Z. Any finite-index subgroup contains positive powers of shift and lamp; iterated commutators give nonzero finite differences at arbitrary depth. Thus no finite-index nilpotent subgroup exists. This is a criterion obstruction, not a bounded-function counterexample.\n+\n+## Turn5\n+\n+The smooth quotient Y is the product of the classical Liouville curve with C. Its coordinate divisors are smooth with only pairwise normal crossings and no triple intersection. The meridian argument correctly checks connectedness of the exponential lift independently of the general irreducibility theorem.\n+\n+A nonzero bounded character function has unitary character by both positive and negative translates. Choosing each exponent in[0,1) makes the multiplier descent single-valued. The bound with strictly subunit negative powers removes each divisor by Laurent coefficients, including intersections by two-variable coefficients. The common-translation entire line then decays at infinity whenever any exponent is positive, forcing zero. For the trivial character the descended function is bounded on the whole Liouville quotient and constant. Finite-dimensional translate spaces carry commuting invertible isometries; unit-modulus spectra and absence of Jordan blocks give simultaneous diagonalization. This proves the finite-orbit/exponential-polynomial corollary. No analogous diagonalization for an infinite-dimensional space is assumed; the original arbitrary-entire gap remains explicit.\n+\n+## Exact verification\n+\n+AUTHOR_REPLAY.json binds the39 manifest-listed files and records byte-exact replay of all five author receipts, totaling38,066 assertions. An independently written elimination/resultant check verifies the companion construction including repeated fibers; integer-lamp finite differences, fractional exponent bounds and Jordan powers are checked separately, totaling1,420 assertions. These finite controls supplement the analytic proof audit, not certify a Liouville theorem by sampling. The scripts require Python and SymPy. Raw primary PDFs are not included in the public review.\n+\n+## Disposition\n+\n+Publish unsolved5/5 with the polynomial-pullback equivalence, one-input sufficient class, virtually-nilpotent monodromy criterion and double-exponential finite-orbit rigidity retained. Neither the non-ultra-Liouville base nor non-nilpotent monodromy nor lack of eigenfunctions settles the original problem. No sixth author search and no new claim of a complete solution are supported."},{"sha":"b563eb8f5ce571aaa3015d22c748b3b930dbb577","filename":"unsolved_math_prioritization/attempts/2302055/review/REVIEW_MANIFEST.json","status":"added","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/AlecKriebel/Math/blob/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Freview%2FREVIEW_MANIFEST.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Freview%2FREVIEW_MANIFEST.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F2302055%2Freview%2FREVIEW_MANIFEST.json?ref=d9e4600d05b8272fe913a22ae7dcc0fbe0a26344","patch":"@@ -0,0 +1,32 @@\n+{\n+  \"problem_id\": 2302055,\n+  \"author_manifest_sha256\": \"474097376562f1af729fbafdacabe3a5df8ed2a16da92f337b5f2dedd0c62c52\",\n+  \"verdict\": \"PASS_SCOPED_ORIGINAL_UNSOLVED_5_OF_5\",\n+  \"files\": [\n+    {\n+      \"path\": \"REVIEW.md\",\n+      \"bytes\": 7250,\n+      \"sha256\": \"d094c02798b816a1cb8c1fc5fd3ec6a8b1b9dde4dc69d7bc85598c25574260f6\"\n+    },\n+    {\n+      \"path\": \"AUTHOR_REPLAY.json\",\n+      \"bytes\": 1067,\n+      \"sha256\": \"c8da994ccafb752c16254746632d2f7aba8663f57163fd20a1aca3417b67a4fb\"\n+    },\n+    {\n+      \"path\": \"INDEPENDENT_CHECKS.json\",\n+      \"bytes\": 254,\n+      \"sha256\": \"3d42686acfdfaa64b738fc867e01e137b662415f4bde2edee07fad3dfa493e2a\"\n+    },\n+    {\n+      \"path\": \"replay_author.py\",\n+      \"bytes\": 668,\n+      \"sha256\": \"cec21794eff8023730626765039eeed1608b40f21ead574836d3d2e5756d5851\"\n+    },\n+    {\n+      \"path\": \"independent_check.py\",\n+      \"bytes\": 1917,\n+      \"sha256\": \"39d1b7b688a67921df87a08a5454144a375a135193ac121b31d67130176c6de9\"\n+    }\n+  ]\n+}"},{"sha":"7c0a0adb090f7d615dbc1059daf788bcbf2fa6e1","filename":"unsolved_math_prioritization/attempts/2302055/review/independent_check.py","status":"added","additions":42,"deletions":0,"changes":42,"blob_url":"https://github.com/AlecKriebel/Math/blob/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Freview%2Findependent_check.py","raw_url":"https://github.com/AlecKriebel/Math/raw/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Freview%2Findependent_check.py","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F2302055%2Freview%2Findependent_check.py?ref=d9e4600d05b8272fe913a22ae7dcc0fbe0a26344","patch":"@@ -0,0 +1,42 @@\n+import sympy as s,json,itertools,math\n+from fractions import Fraction as F\n+N=0\n+def ck(x):\n+ global N\n+ assert x;N+=1\n+z,w,T=s.symbols('z w T')\n+# Elimination-based push-forward independently tests the companion-matrix route,\n+# including repeated fibers at w=0 and polynomial values of the lifted function.\n+for degree in range(1,6):\n+ for a in range(-2,3):\n+  poly=z**degree+(a*z if degree>1 else a)-w\n+  # Monic polynomial companion on quotient basis 1,z,...\n+  C=s.zeros(degree)\n+  for j in range(degree):\n+   rem=s.rem(z**(j+1),poly,z)\n+   for i in range(degree):C[i,j]=rem.coeff(z,i)\n+  value=z*z+2*z+3\n+  M=C*C+2*C+3*s.eye(degree)\n+  lhs=s.expand(M.charpoly(T).as_expr());rhs=s.resultant(poly,T-value,z)\n+  ck(s.expand(lhs-rhs)==0)\n+  for b in [-1,0,1]:ck(s.Poly(lhs.subs(w,b),T).LC()==1)\n+# Universal finite-difference nonvanishing checked on several step sizes/orders,\n+# exact integer lamps rather than finite cyclic truncations.\n+for r in range(1,9):\n+ for scale in range(1,7):\n+  lamps={0:scale}\n+  for k in range(1,13):\n+   nxt={}\n+   for pos,c in lamps.items():nxt[pos+r]=nxt.get(pos+r,0)+c;nxt[pos]=nxt.get(pos,0)-c\n+   lamps={p:c for p,c in nxt.items() if c}\n+   ck(lamps[k*r]==scale)\n+   ck(lamps=={j*r:scale*(-1)**(k-j)*math.comb(k,j) for j in range(k+1)})\n+# Fractional removable exponents and total decay, including mixed zero exponents.\n+for alpha in itertools.product([F(0),F(1,7),F(1,2),F(6,7)],repeat=3):\n+ ck(all(F(m)-a>0 for a in alpha for m in range(1,5)))\n+ ck((sum(alpha)>0)==any(alpha))\n+# Nontrivial Jordan block powers violate uniform boundedness.\n+for k in range(1,21):\n+ J=s.Matrix([[1,1,0],[0,1,1],[0,0,1]])**k\n+ ck(J[0,2]==s.binomial(k,2));ck(J[0,1]==k)\n+print(json.dumps({'status':'PASS','independent_assertions':N,'scope':'Independent resultant/companion equality, exact infinite-lamp finite differences, fractional exponents and Jordan powers; analytic and topological implications audited in full prose.'},indent=2))"},{"sha":"61dac8854b2be06d34b7ab43942ab436b566fc4d","filename":"unsolved_math_prioritization/attempts/2302055/review/replay_author.py","status":"added","additions":9,"deletions":0,"changes":9,"blob_url":"https://github.com/AlecKriebel/Math/blob/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Freview%2Freplay_author.py","raw_url":"https://github.com/AlecKriebel/Math/raw/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Freview%2Freplay_author.py","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F2302055%2Freview%2Freplay_author.py?ref=d9e4600d05b8272fe913a22ae7dcc0fbe0a26344","patch":"@@ -0,0 +1,9 @@\n+from pathlib import Path\n+import hashlib,json,subprocess,sys\n+p=Path(sys.argv[1]) if len(sys.argv)>1 else Path('/workspace/shared/math-2302055/research')\n+m=json.loads((p/'FINAL_AUTHOR_MANIFEST.json').read_text())\n+for f in m['files']:assert hashlib.sha256((p/f['path']).read_bytes()).hexdigest()==f['sha256']\n+r=[]\n+for i in range(1,6):\n+ b=subprocess.check_output([sys.executable,str(p/f'verify_turn{i}.py')]);assert b==(p/f'TURN_{i}_CHECKS.json').read_bytes();r.append(json.loads(b))\n+print(json.dumps({'status':'PASS','author_manifest_sha256':hashlib.sha256((p/'FINAL_AUTHOR_MANIFEST.json').read_bytes()).hexdigest(),'bound_files':len(m['files']),'receipts':r},indent=2))"},{"sha":"d916f51f9bed9b4b3d50f314b9e8fe8af0d3bc23","filename":"unsolved_math_prioritization/attempts/2302055/verify_turn1.py","status":"added","additions":60,"deletions":0,"changes":60,"blob_url":"https://github.com/AlecKriebel/Math/blob/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Fverify_turn1.py","raw_url":"https://github.com/AlecKriebel/Math/raw/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Fverify_turn1.py","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F2302055%2Fverify_turn1.py?ref=d9e4600d05b8272fe913a22ae7dcc0fbe0a26344","patch":"@@ -0,0 +1,60 @@\n+#!/usr/bin/env python3\n+\"\"\"Exact finite controls for the polynomial push-forward; no analytic surrogate.\"\"\"\n+from itertools import product\n+from math import comb\n+from fractions import Fraction\n+import json,random\n+rng=random.Random(2302055)\n+checks=0\n+def ck(x):\n+ global checks\n+ assert x\n+ checks+=1\n+def mul(A,B):\n+ n=len(A);return [[sum(A[i][k]*B[k][j] for k in range(n)) for j in range(n)] for i in range(n)]\n+def eye(n):return [[int(i==j) for j in range(n)]for i in range(n)]\n+def add(A,B):return [[a+b for a,b in zip(r,s)]for r,s in zip(A,B)]\n+def scale(a,A):return [[a*x for x in r]for r in A]\n+def pmul(p,q):\n+ r=[0]*(len(p)+len(q)-1)\n+ for i,x in enumerate(p):\n+  for j,y in enumerate(q):r[i+j]+=x*y\n+ return r\n+def polyroots(rs):\n+ p=[1]\n+ for r in rs:p=pmul(p,[-r,1])\n+ return p\n+def companion(rs):\n+ p=polyroots(rs);n=len(rs);A=[[0]*n for _ in range(n)]\n+ for i in range(1,n):A[i][i-1]=1\n+ for i in range(n):A[i][-1]=-p[i]\n+ return A\n+def kron(A,B):return [[a*b for a in r for b in s] for r in A for s in B]\n+def trace(A):return sum(A[i][i]for i in range(len(A)))\n+cases=0;repeated=0\n+for ds in [(1,1,1),(2,1,1),(2,2,1),(3,2,1),(2,2,2),(3,3,1),(3,2,2)]:\n+ for sample in range(12):\n+  roots=[[rng.randrange(-2,3) for _ in range(d)]for d in ds]\n+  repeated+=any(len(set(r))<len(r)for r in roots)\n+  C=[companion(r)for r in roots];d=ds[0]*ds[1]*ds[2];I=eye(d)\n+  A=[kron(kron(C[0],eye(ds[1])),eye(ds[2])),kron(kron(eye(ds[0]),C[1]),eye(ds[2])),kron(kron(eye(ds[0]),eye(ds[1])),C[2])]\n+  for i in range(3):\n+   for j in range(i):ck(mul(A[i],A[j])==mul(A[j],A[i]))\n+  terms=[(rng.randrange(-3,4),tuple(rng.randrange(3)for _ in range(3)))for _ in range(5)]\n+  M=scale(0,I)\n+  for c,alpha in terms:\n+   T=I\n+   for i,e in enumerate(alpha):\n+    for _ in range(e):T=mul(T,A[i])\n+   M=add(M,scale(c,T))\n+  vals=[sum(c*rs[0]**a[0]*rs[1]**a[1]*rs[2]**a[2]for c,a in terms)for rs in product(*roots)]\n+  Q=polyroots(vals);powers=I;sums=[0]\n+  for k in range(1,d+1):\n+   powers=mul(powers,M);sums.append(trace(powers));ck(sums[-1]==sum(v**k for v in vals))\n+  # Newton recurrence for characteristic coefficients, with multiplicity.\n+  cs=[Fraction(1)]\n+  for k in range(1,d+1):\n+   cs.append(-sum(cs[k-j]*sums[j]for j in range(1,k+1))/k)\n+   ck(cs[k]==Q[d-k]);ck(abs(cs[k])<=comb(d,k)*max(map(abs,vals))**k)\n+  cases+=1\n+print(json.dumps({'cases':cases,'cases_with_repeated_roots':repeated,'exact_assertions':checks,'degree_patterns':7,'analytic_claims_tested':False},indent=2))"},{"sha":"c3c38514697a7ade37117bdb1179d2cd1490b93d","filename":"unsolved_math_prioritization/attempts/2302055/verify_turn2.py","status":"added","additions":56,"deletions":0,"changes":56,"blob_url":"https://github.com/AlecKriebel/Math/blob/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Fverify_turn2.py","raw_url":"https://github.com/AlecKriebel/Math/raw/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Fverify_turn2.py","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F2302055%2Fverify_turn2.py?ref=d9e4600d05b8272fe913a22ae7dcc0fbe0a26344","patch":"@@ -0,0 +1,56 @@\n+#!/usr/bin/env python3\n+from itertools import product\n+from math import comb\n+from fractions import Fraction\n+import random,json\n+rng=random.Random(230205502);checks=0\n+def ck(v):\n+ global checks\n+ assert v\n+ checks+=1\n+def pmul(a,b):\n+ c=[0]*(len(a)+len(b)-1)\n+ for i,x in enumerate(a):\n+  for j,y in enumerate(b):c[i+j]+=x*y\n+ return c\n+def poly(vals):\n+ a=[1]\n+ for v in vals:a=pmul(a,[-v,1])\n+ return a\n+lattices=0\n+for _ in range(600):\n+ d1,d2=rng.randrange(1,7),rng.randrange(1,7)\n+ u=(rng.randrange(-d2,d2+1),rng.randrange(-d1,d1+1));v=(rng.randrange(-d2,d2+1),rng.randrange(-d1,d1+1))\n+ D=abs(u[0]*v[1]-u[1]*v[0])\n+ if not D:continue\n+ ck(1<=D<=2*d1*d2)\n+ # Index of the two-generator lattice computed by its finite quotient.\n+ S={(0,0)};todo=[(0,0)]\n+ while todo:\n+  x=todo.pop()\n+  for w in (u,v):\n+   y=((x[0]+w[0])%D,(x[1]+w[1])%D)\n+   if y not in S:S.add(y);todo.append(y)\n+ ck(D*D//len(S)==D);lattices+=1\n+monodromy=0\n+for d1,d2 in product(range(1,8),repeat=2):\n+ # Independent transitive cycle actions on the two root coordinates.\n+ S={(0,0)};todo=[(0,0)]\n+ while todo:\n+  i,j=todo.pop()\n+  for y in (((i+1)%d1,j),(i,(j+1)%d2)):\n+   if y not in S:S.add(y);todo.append(y)\n+ ck(len(S)==d1*d2);monodromy+=1\n+symcases=0\n+for q in range(1,21):\n+ for _ in range(15):\n+  vals=[Fraction(rng.randrange(-20,21),rng.randrange(1,11))for _ in range(q)];p=poly(vals);M=max(map(abs,vals));vs=list(vals);rng.shuffle(vs)\n+  ck(poly(vs)==p)\n+  for k in range(1,q+1):ck(abs(p[q-k])<=comb(q,k)*M**k)\n+  # Every component value is a root, even when values repeat.\n+  for v in set(vals):\n+   t=Fraction(0)\n+   for a in reversed(p):t=t*v+a\n+   ck(t==0)\n+  symcases+=1\n+print(json.dumps({'exact_assertions':checks,'lattice_cases':lattices,'product_monodromy_cases':monodromy,'symmetric_component_cases':symcases,'analytic_claims_tested':False},indent=2))"},{"sha":"02aa2ea7f8d500dd8a9b2527755506b1119d6196","filename":"unsolved_math_prioritization/attempts/2302055/verify_turn3.py","status":"added","additions":37,"deletions":0,"changes":37,"blob_url":"https://github.com/AlecKriebel/Math/blob/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Fverify_turn3.py","raw_url":"https://github.com/AlecKriebel/Math/raw/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Fverify_turn3.py","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F2302055%2Fverify_turn3.py?ref=d9e4600d05b8272fe913a22ae7dcc0fbe0a26344","patch":"@@ -0,0 +1,37 @@\n+#!/usr/bin/env python3\n+from fractions import Fraction as F\n+import random,json\n+rng=random.Random(230205503);checks=0\n+def ck(x):\n+ global checks\n+ assert x\n+ checks+=1\n+def clean(p):return {k:v for k,v in p.items()if v}\n+def add(p,q):\n+ r=p.copy()\n+ for k,v in q.items():r[k]=r.get(k,0)+v\n+ return clean(r)\n+def mul(p,q):\n+ r={}\n+ for i,x in p.items():\n+  for j,y in q.items():r[i+j]=r.get(i+j,0)+x*y\n+ return clean(r)\n+def deriv(p):return clean({k-1:k*v for k,v in p.items()})\n+def val(p,u):return sum(F(v)*u**k for k,v in p.items())\n+cases=0\n+for _ in range(400):\n+ R=clean({k:rng.randrange(-3,4)for k in range(rng.randrange(-5,1),rng.randrange(1,6))})\n+ if not R or all(k==0 for k in R):continue\n+ m=max(0,-min(R));P={k+m:v for k,v in R.items()};Q={m:1};d=max(max(P),m)\n+ ck(min(P)>=0);ck(d>=1)\n+ if m:ck(P.get(0,0)!=0)\n+ C=add(mul(deriv(P),Q),{k:-v for k,v in mul(P,deriv(Q)).items()})\n+ # R'=(P'Q-PQ')/Q^2 as an exact Laurent identity.\n+ ck(C==mul(deriv(R),mul(Q,Q)))\n+ for u in [F(1),F(-1),F(2),F(1,2)]:\n+  t=val(R,u);B=add(P,{m:-t});ck(val(B,u)==0)\n+  ck(val(C,u)==val(deriv(R),u)*val(Q,u)**2)\n+  ck(val(mul({1:1},deriv(R)),u)==u*val(deriv(R),u))\n+  ck(max(B,default=0)<=d)\n+ cases+=1\n+print(json.dumps({'laurent_maps':cases,'exact_assertions':checks,'sample_fibers_per_map':4,'analytic_claims_tested':False},indent=2))"},{"sha":"8e06f25abbc2b7945b03e4780a6ebd075530c766","filename":"unsolved_math_prioritization/attempts/2302055/verify_turn4.py","status":"added","additions":34,"deletions":0,"changes":34,"blob_url":"https://github.com/AlecKriebel/Math/blob/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Fverify_turn4.py","raw_url":"https://github.com/AlecKriebel/Math/raw/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Fverify_turn4.py","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F2302055%2Fverify_turn4.py?ref=d9e4600d05b8272fe913a22ae7dcc0fbe0a26344","patch":"@@ -0,0 +1,34 @@\n+#!/usr/bin/env python3\n+from math import comb\n+import random,json\n+rng=random.Random(230205504);checks=0\n+def ck(v):\n+ global checks\n+ assert v\n+ checks+=1\n+def clean(A):return {k:v for k,v in A.items()if v}\n+def plus(A,B):\n+ C=A.copy()\n+ for k,v in B.items():C[k]=C.get(k,0)+v\n+ return clean(C)\n+def shift(A,m):return {k+m:v for k,v in A.items()}\n+def prod(g,h):\n+ A,m=g;B,r=h;return (plus(A,shift(B,m)),m+r)\n+def inv(g):\n+ A,m=g;return ({k:-v for k,v in shift(A,-m).items()},-m)\n+def action(g,x):\n+ A,m=g;k,n=x;return (k+m,n+A.get(k+m,0))\n+def comm(g,h):return prod(prod(prod(g,h),inv(g)),inv(h))\n+I=({},0)\n+for _ in range(500):\n+ g=(clean({k:rng.randrange(-3,4)for k in range(-3,4)}),rng.randrange(-4,5));h=(clean({k:rng.randrange(-3,4)for k in range(-3,4)}),rng.randrange(-4,5))\n+ ck(prod(g,inv(g))==I);ck(prod(inv(g),g)==I)\n+ for k in range(-7,8):ck(action(prod(g,h),(k,2))==action(g,action(h,(k,2))))\n+finite_difference_cases=0\n+for r in range(1,9):\n+ for s in range(1,7):\n+  a=({},r);b=({0:s},0);c=b\n+  for k in range(1,25):\n+   c=comm(a,c);expected={r*j:s*(-1)**(k-j)*comb(k,j)for j in range(k+1)}\n+   ck(c==(expected,0));ck(c[0][r*k]==s);ck(c!=I);finite_difference_cases+=1\n+print(json.dumps({'exact_assertions':checks,'group_law_cases':500,'iterated_commutator_cases':finite_difference_cases,'analytic_counterexample_claimed':False},indent=2))"},{"sha":"1b2f1ded5b009e864d1143a7ec715401b45352bc","filename":"unsolved_math_prioritization/attempts/2302055/verify_turn5.py","status":"added","additions":42,"deletions":0,"changes":42,"blob_url":"https://github.com/AlecKriebel/Math/blob/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Fverify_turn5.py","raw_url":"https://github.com/AlecKriebel/Math/raw/d9e4600d05b8272fe913a22ae7dcc0fbe0a26344/unsolved_math_prioritization%2Fattempts%2F2302055%2Fverify_turn5.py","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F2302055%2Fverify_turn5.py?ref=d9e4600d05b8272fe913a22ae7dcc0fbe0a26344","patch":"@@ -0,0 +1,42 @@\n+#!/usr/bin/env python3\n+from fractions import Fraction as F\n+from math import comb\n+from itertools import product\n+import json,random\n+rng=random.Random(230205505);checks=0\n+def ck(v):\n+ global checks\n+ assert v\n+ checks+=1\n+param_cases=0\n+for p in range(-20,21):\n+ for q in range(1,10):\n+  a=F(p,q)\n+  if a in (0,1):continue\n+  b=1-a\n+  for t in [F(1),F(-2),F(3,5)]:ck(-a*t-b*t+t==0);param_cases+=1\n+# Exact subunit exponents, including irrational-case-independent inequalities.\n+exponents=[F(p,q)for q in range(1,20)for p in range(q)]\n+for alpha in exponents:\n+ for m in range(1,20):ck(m-alpha>0)\n+for _ in range(2000):\n+ a=[rng.choice(exponents)for _ in range(3)];ck((sum(a)>0)==any(x>0 for x in a))\n+# I+N Jordan powers, as coefficient identities in a nilpotent variable.\n+jordan_cases=0\n+for d in range(2,13):\n+ p=[1]+[0]*(d-1)\n+ for n in range(1,41):\n+  p=[p[0]]+[p[k]+p[k-1]for k in range(1,d)]\n+  ck(p==[comb(n,k)if k<=n else 0 for k in range(d)]);ck(p[1]==n);jordan_cases+=1\n+# Lower bound |t+c|>=|t|/2 under |t|>=2|c|, Gaussian integers.\n+norm_cases=0\n+for _ in range(5000):\n+ x,y,a,b=[rng.randrange(-40,41)for _ in range(4)];T=x*x+y*y;C=a*a+b*b\n+ if T and T>=4*C:ck(4*((x+a)**2+(y+b)**2)>=T);norm_cases+=1\n+# Polynomial translations preserve the declared finite monomial span.\n+poly_cases=0\n+for degree in range(15):\n+ for shift in range(-5,6):\n+  coeff=[comb(degree,k)*shift**(degree-k)for k in range(degree+1)]\n+  for x in range(-3,4):ck(sum(c*x**k for k,c in enumerate(coeff))==(x+shift)**degree);poly_cases+=1\n+print(json.dumps({'exact_assertions':checks,'translation_parameter_cases':param_cases,'jordan_power_cases':jordan_cases,'gaussian_norm_cases':norm_cases,'polynomial_translation_cases':poly_cases,'analytic_resolution_claimed':False},indent=2))"}]]