+# Free group words: a=1,b=2, inverses negative.
+def reduce(w):
+ s=[]
+ for x in w:
+  if s and s[-1]==-x:s.pop()
+  else:s.append(x)
+ return s
+def inverse(w):return [-x for x in w[::-1]]
+def apply(images,w):return reduce([y for x in w for y in (images[x] if x>0 else inverse(images[-x]))])
