b84266a6a153c087e182cf427ed502d6c/problems%2F30005116_induced_four_cycle_profile%2FFINAL_PUBLIC_SCOPE.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F30005116_induced_four_cycle_profile%2FFINAL_PUBLIC_SCOPE.json?ref=c683fc4b84266a6a153c087e182cf427ed502d6c","patch":"@@ -0,0 +1,44 @@\n+{\n+  \"problem_id\": 30005116,\n+  \"files\": [\n+    \"FINAL_AUTHOR_MANIFEST.json\",\n+    \"FINAL_PUBLIC_SCOPE.json\",\n+    \"FINAL_REPLAY_RECEIPT.json\",\n+    \"FINAL_RESULT.md\",\n+    \"FINAL_REVIEW_REQUEST.md\",\n+    \"PRIOR_GATE.json\",\n+    \"PUBLIC_SCOPE.json\",\n+    \"SOURCE_ADDENDUM_TURN_2.json\",\n+    \"SOURCE_ADDENDUM_TURN_4.json\",\n+    \"SOURCE_GATE.md\",\n+    \"SOURCE_HASHES.json\",\n+    \"TURN_1.md\",\n+    \"TURN_1_CHECKS.json\",\n+    \"TURN_1_MANIFEST.json\",\n+    \"TURN_1_STATE.json\",\n+    \"TURN_2.md\",\n+    \"TURN_2_CHECKS.json\",\n+    \"TURN_2_MANIFEST.json\",\n+    \"TURN_2_STATE.json\",\n+    \"TURN_3.md\",\n+    \"TURN_3_CHECKS.json\",\n+    \"TURN_3_MANIFEST.json\",\n+    \"TURN_3_STATE.json\",\n+    \"TURN_4.md\",\n+    \"TURN_4_CHECKS.json\",\n+    \"TURN_4_MANIFEST.json\",\n+    \"TURN_4_STATE.json\",\n+    \"TURN_5.md\",\n+    \"TURN_5_CHECKS.json\",\n+    \"TURN_5_MANIFEST.json\",\n+    \"TURN_5_STATE.json\",\n+    \"verify_turn1.py\",\n+    \"verify_turn2.py\",\n+    \"verify_turn3.py\",\n+    \"verify_turn4.py\",\n+    \"verify_turn5.py\"\n+  ],\n+  \"excluded\": \"All raw source PDFs, texts/screenshots, HTML, imports, retrieval logs, local payloads and private coordination. Source hash records are public; source bytes remain local-only.\",\n+  \"history\": \"PUBLIC_SCOPE.json is preserved as the first-turn scope.\",\n+  \"disposition\": \"unsolved 5/5; full independent review pending\"\n+}"},{"sha":"e3e17fe5752c98ac97ceea6daad8de123178c0c2","filename":"problems/30005116_induced_four_cycle_profile/FINAL_REPLAY_RECEIPT.json","status":"added","additions":40,"deletions":0,"changes":40,"blob_url":"https://github.com/AlecKriebel/Math/blob/c683fc4b84266a6a153c087e182cf427ed502d6c/problems%2F30005116_induced_four_cycle_profile%2FFINAL_REPLAY_RECEIPT.json","raw_url":"https://github.com/AlecKriebel/Math/raw/c683fc4b84266a6a153c087e182cf427ed502d6c/problems%2F30005116_induced_four_cycle_profile%2FFINAL_REPLAY_RECEIPT.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F30005116_induced_four_cycle_profile%2FFINAL_REPLAY_RECEIPT.json?ref=c683fc4b84266a6a153c087e182cf427ed502d6c","patch":"@@ -0,0 +1,40 @@\n+{\n+  \"problem_id\": 30005116,\n+  \"replays\": [\n+    {\n+      \"turn\": 1,\n+      \"assertions\": 38829,\n+      \"stdout_sha256\": \"921f9bf56be996710c9f6ded62f7686e76c6195ff5c50296008051cae0eb9115\",\n+      \"exact\": true\n+    },\n+    {\n+      \"turn\": 2,\n+      \"assertions\": 611,\n+      \"stdout_sha256\": \"75c5d88281436aad2b4bcde37b9891bef051e802b83f08f4039a89923d12dbb9\",\n+      \"exact\": true\n+    },\n+    {\n+      \"turn\": 3,\n+      \"assertions\": 502,\n+      \"stdout_sha256\": \"a5f3f097ed4d5a2893e784dd2181607302d938a7eaf158a510c03c2dccdd0bbf\",\n+      \"exact\": true\n+    },\n+    {\n+      \"turn\": 4,\n+      \"assertions\": 44939,\n+      \"stdout_sha256\": \"8badfbb1ff9c26ce4d76be0bf4955f50150607c042b121e6fba9bce7e00701ac\",\n+      \"exact\": true\n+    },\n+    {\n+      \"turn\": 5,\n+      \"assertions\": 8624,\n+      \"stdout_sha256\": \"81244d020ec8b958492f8357e7384c53f2acbeb29916f2604ca14199dd3733e7\",\n+      \"exact\": true\n+    }\n+  ],\n+  \"total_exact_assertions\": 93505,\n+  \"historical_manifest_entries_verified\": 25,\n+  \"source_bindings_verified\": 15,\n+  \"dependencies\": \"Python 3 standard library only.\",\n+  \"scope\": \"Exact supplementary finite controls; written universal proofs and credited primary theorems remain essential.\"\n+}"},{"sha":"6de9bff6cfb5801e37ae42a7c5c8bca3caca905a","filename":"problems/30005116_induced_four_cycle_profile/FINAL_RESULT.md","status":"added","additions":29,"deletions":0,"changes":29,"blob_url":"https://github.com/AlecKriebel/Math/blob/c683fc4b84266a6a153c087e182cf427ed502d6c/problems%2F30005116_induced_four_cycle_profile%2FFINAL_RESULT.md","raw_url":"https://github.com/AlecKriebel/Math/raw/c683fc4b84266a6a153c087e182cf427ed502d6c/problems%2F30005116_induced_four_cycle_profile%2FFINAL_RESULT.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F30005116_induced_four_cycle_profile%2FFINAL_RESULT.md?ref=c683fc4b84266a6a153c087e182cf427ed502d6c","patch":"@@ -0,0 +1,29 @@\n+# Induced four-cycle profile: five-turn partial results\n+\n+**30005116 / OWR-10252930-028 remains unsolved after five substantive author turns. Independent full review pending.**\n+\n+The exact source is Dhruv Mubayi's Problem10 and Conjecture11, OWR22/2022, printed1227, reference1228. The report was published14April2023. The question asks for the maximum asymptotic induced-C4 density at a prescribed edge density, conjecturing the clique-density construction above1/2. Its known isolated sharp densities do not settle the intermediate-density problem. The nearby announcement of a solved problem belongs to another contributor's Littlewood–Offord question.\n+\n+Source: https://ems.press/journals/owr/articles/10252930\n+Primary profile paper: https://arxiv.org/abs/2106.16203v2\n+\n+## Strongest verified author claims, pending independent review\n+\n+- **Exact multipartite profile at every density.** An all-support-size moment minimization proves the candidate's optimality over every complete multipartite sequence, with a finite-size identity uniform in the number of parts. This is an elementary reconstruction of the credited candidate family, without a novelty claim.\n+- **Density-preserving complete-join replacement.** Arbitrary internal blocks of density at most1/2 can be replaced by bipartite blocks, preserving global edge density and increasing induced-C4 density. With the credited Pikhurko–Razborov triangle-stability theorem, every asymptotic triangle-minimizing sequence satisfies the proposed C4 bound.\n+- **Explicit non-multipartite ties.** A paw blow-up with masses(4,2,2,1)/9 has edge density16/27 and induced-C4 density64/243, exactly the proposed value, but has edit distance at least8/729 from every multipartite graphon. This is consistent with known triangle-minimizer flexibility and is not a source counterexample.\n+- **Qualified local stability.** The candidate is strictly optimal under density-preserving small-L∞-amplitude perturbations, with an explicit remainder bound. Exact tying paths are arbitrarily close in L1 and show why this calculation cannot prove edit-distance uniqueness or global optimality.\n+- **Full profile for weighted cographs and their limits.** The proposed bound is closed under complete joins and disjoint unions. Cotree induction proves it for all weighted cographs, without any size or depth bound, and hence for every cograph sequence. The high-density disjoint-union step has an explicit positive gap.\n+- **Exact rank-one profile.** For W(s,t)=f(s)f(t),0≤f≤1, the full vertical profile is[0,R(p)], where R(p)=3p²/16 for p≤1/2 and R(p)=3p⁴(1−p)² for p≥1/2. Equality cases are classified. This family is strictly below the achievable multipartite construction at every interior density, with explicit gaps.\n+\n+## Remaining gap\n+\n+There is no proof that every arbitrary host lies in one of these classes, has asymptotically minimum triangle density, or can be replaced at the same edge density by a controlled host. Non-cograph, non-rank-one hosts with positive triangle excess remain unbounded by the candidate profile. The original conjecture is neither proved nor refuted.\n+\n+Known low-density and discrete-density results, the clique-density construction, complete-multipartite symmetrization, the triangle-stability theorem and cograph terminology are credited. The January2026 semi-induced alternating-cycle paper is distinguished from the induced-C4 target. No historical novelty, external peer review or formal verification is claimed.\n+\n+## Frozen checks and scope\n+\n+All five exact receipts replay byte-for-byte: **93,505 assertions**, using Python's standard library only. They include exact moment/radical controls, direct weighted motif counts, 33,867 labeled-graph recognition controls through order6, and all6,039 cographs in that finite range. The cograph theorem is proved by all-size induction, not by that scan. No floating-point or Monte Carlo evidence is used.\n+\n+`FINAL_AUTHOR_MANIFEST.json` binds the complete36-file public packet. Historical files and statuses are preserved unchanged. Source PDFs, extracted texts, screenshots, HTML, raw imports, retrieval logs and private coordination stay local-only; public files provide primary links and hashes. `PUBLIC_SCOPE.json` is the first-turn scope; `FINAL_PUBLIC_SCOPE.json` is the final list. No sixth author search is included or authorized by this packet."},{"sha":"1f5c8dd527b1df8be242ba34e25b93a7ef7a3b96","filename":"problems/30005116_induced_four_cycle_profile/FINAL_REVIEW_REQUEST.md","status":"added","additions":30,"deletions":0,"changes":30,"blob_url":"https://github.com/AlecKriebel/Math/blob/c683fc4b84266a6a153c087e182cf427ed502d6c/problems%2F30005116_induced_four_cycle_profile%2FFINAL_REVIEW_REQUEST.md","raw_url":"https://github.com/AlecKriebel/Math/raw/c683fc4b84266a6a153c087e182cf427ed502d6c/problems%2F30005116_induced_four_cycle_profile%2FFINAL_REVIEW_REQUEST.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F30005116_induced_four_cycle_profile%2FFINAL_REVIEW_REQUEST.md?ref=c683fc4b84266a6a153c087e182cf427ed502d6c","patch":"@@ -0,0 +1,30 @@\n+# Independent full review request: induced-C4 profiles\n+\n+Problem30005116 / OWR-10252930-028. Five substantive author turns are frozen. Recommended disposition: **original unsolved5/5**, with the stated scoped results. Please bind the final review to the final manifest and subsequently verified WIP head; preserve frozen author files and keep review artifacts separate. No additional author search is requested.\n+\n+## Packet and source paths\n+\n+Public packet: `/workspace/shared/math-30005116-final`.\n+Source inputs: `/workspace/shared/math-30005116/sources`.\n+Read `SOURCE_GATE.md`, `FINAL_RESULT.md`, all five proofs, checkers, receipts, states and manifests. Source hashes are in `SOURCE_HASHES.json` and the turn2/turn4 additive source records. The historical gate and states remain unchanged.\n+\n+- `owr2022-22.pdf/.txt`, `printed1227.png`: exact Mubayi Problem10, Conjecture11, Theorem12 on1227, reference1228. The nearby “no longer open” sentence belongs to the preceding problem. Report2022 versus publication14April2023.\n+- `lmr-feasible.pdf/.txt`, `lmr-page10.png`: Liu–Mubayi–Reiher definitions, Construction1.9, Theorems1.16/1.18, Proposition6.1, Section3 symmetrization and Section6 proof. The source's density is induced vertex-set density, not labeled embedding or ordinary cycle density. Source conjecture1.17 remains open in the paper.\n+- `semi2026.pdf/.txt`: Balogh–Lidický–Mubayi–Pfender–Volec, dated8January2026. Its AC4 leaves two pairs unspecified and is not inducedC4 or induced2K2. Its stronger related conjecture is credited, not substituted for our target. No numerical flag bound is used as an exact result.\n+- `pikhurko-razborov2017.pdf/.txt`, `pr-page140.png`: construction H_{a,n} on139; visually checked Theorem1.1 on140. The theorem assumes triangle density at most g3(a)+δ at the graph's actual edge density a and grants an ε binom(n,2) edit into H_{a,n}. This published theorem is a credited external input, not reproved. Print2017 and online4May2016 differ.\n+- `cograph-terminology2024.pdf/.txt`: Coudert–Coulomb–Ducoffe, Section6.2 on18 supplies the standard recursive definition and P4-free terminology with earlier credit. Our theorem is proved from the recursion and does not require a general graphon characterization or removal lemma.\n+\n+## Highest-risk points\n+\n+1. **Moment optimization:** compact fixed-dimensional constraint set; deleting zero coordinates; independent constraint gradients; at most two positive cubic roots; the constrained Hessian rules out two small coordinates. Check the reciprocal-integer exception, endpoint choices, finite-size factor24 and the unbounded-part-count limit. Merely locating stationary points is insufficient.\n+2. **Graphon normalization:** c(W) is the probability the sampled unlabeled four-vertex graph is C4, equal to three times one fixed induced edge-pattern integral. Perfect matching counting gives c≤3p²/2. All six edge/nonedge factors matter. Complements turn C4 into2K2, not C4.\n+3. **Join and triangle-stability step:** formula(4) of turn2 includes only occupancy4 and2+2; replacement preserves density exactly for block densities≤1/2. For finite graphs the adjacency kernel has edge density2e/n², whereas the source uses e/binom(n,2). Collision error is≤6/n. Published triangle stability is applied only to sequences whose triangle excess tends to0; no inference that arbitrary C4 extrema minimize triangles is made. The induced-C4 edit constant is6.\n+4. **Ties and locality:** the paw family attains the candidate value, not a verified unrestricted maximum. Check the one-edge-triple count, edit-distance bound, fixed-space tying path and L∞ versus L1 distinction. The multilinear remainder is bounded by171||h||∞||h||1, not by a false O(||h||1²) bound for strip edits.\n+5. **Full cograph closure:** check the coupled density at a union node: x=∑w_i²p_i, largest mass w≥x, and its internal density p≥x when x>1/2. Use the monotonicity of F only in its correct interval. Verify the explicit union gap, low-density case, join endpoint p_i=1 approximation, and cotree induction for arbitrary masses and depth. The finite scan through6 is supplementary. No almost-P4-free theorem is presumed.\n+6. **Rank-one direction:** factorization3(m2²−m3²)², Cauchy bridge m3m1≥m2², z=m2²/p∈[p,1], nonnegative squaring, both equality branches and p=0,1/2,1. Check the vertical feasible interval, deterministic graph-sequence attainability and explicit strict gaps from F. The rank-one maximum is not the source-wide maximum.\n+\n+## Replay\n+\n+Run `python verify_turn1.py` through `python verify_turn5.py` in the author directory and compare stdout byte-for-byte with their corresponding `TURN_n_CHECKS.json`. All use the standard library. Counts are38,829;611;502;44,939;8,624, totaling93,505. The source theorem hypotheses and universal written proofs require independent audit in addition to these finite controls.\n+\n+Report any defect promptly. The full original remains unresolved unless the exact all-graph source target is actually addressed; none of the restricted theorems is a silent substitute."},{"sha":"6f56f5ac631c6a35d14eda86a99d99ce5a4754ec","filename":"problems/30005116_induced_four_cycle_profile/PRIOR_GATE.json","status":"added","additions":78,"deletions":0,"changes":78,"blob_url":"https://github.com/AlecKriebel/Math/blob/c683fc4b84266a6a153c087e182cf427ed502d6c/problems%2F30005116_induced_four_cycle_profile%2FPRIOR_GATE.json","raw_url":"https://github.com/AlecKriebel/Math/raw/c683fc4b84266a6a153c087e182cf427ed502d6c/problems%2F30005116_induced_four_cycle_profile%2FPRIOR_GATE.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F30005116_induced_four_cycle_profile%2FPRIOR_GATE.json?ref=c683fc4b84266a6a153c087e182cf427ed502d6c","patch":"@@ -0,0 +1,78 @@\n+{\n+  \"target\": 30005116,\n+  \"gate_utc\": \"2026-10-02T16:56:53Z\",\n+  \"live_pr_searches\": [\n+    {\n+      \"term\": \"30005116\",\n+      \"total_count\": 0,\n+      \"items\": [],\n+      \"error\": false\n+    },\n+    {\n+      \"term\": \"OWR-10252930-028\",\n+      \"total_count\": 0,\n+      \"items\": [],\n+      \"error\": false\n+    },\n+    {\n+      \"term\": \"\\\"induced C4\\\"\",\n+      \"total_count\": 0,\n+      \"items\": [],\n+      \"error\": false\n+    },\n+    {\n+      \"term\": \"\\\"four-cycle\\\"\",\n+      \"total_count\": 3,\n+      \"items\": [\n+        {\n+          \"number\": 212,\n+          \"title\": \"30005310: Reviewed counterexample to literal threshold scenarios\",\n+          \"state\": \"open\",\n+          \"url\": \"https://github.com/AlecKriebel/Math/pull/212\"\n+        },\n+        {\n+          \"number\": 314,\n+          \"title\": \"30005425: reviewed surface-model partials; original unsolved (5/5)\",\n+          \"state\": \"open\",\n+          \"url\": \"https://github.com/AlecKriebel/Math/pull/314\"\n+        },\n+        {\n+          \"number\": 319,\n+          \"title\": \"30004033: reviewed fractional-coloring partials, original unsolved 5/5\",\n+          \"state\": \"open\",\n+          \"url\": \"https://github.com/AlecKriebel/Math/pull/319\"\n+        }\n+      ],\n+      \"error\": false\n+    }\n+  ],\n+  \"broad_hits_reviewed\": [\n+    {\n+      \"number\": 212,\n+      \"title\": \"30005310: Reviewed counterexample to literal threshold scenarios\",\n+      \"head\": \"c697b4a5cc62f3b8836d8c37d82b71a1d1c53fb7\",\n+      \"distinct_target\": true\n+    },\n+    {\n+      \"number\": 314,\n+      \"title\": \"30005425: reviewed surface-model partials; original unsolved (5/5)\",\n+      \"head\": \"149c896804a45349a7177c613f9b17ddb2f62fa2\",\n+      \"distinct_target\": true\n+    },\n+    {\n+      \"number\": 319,\n+      \"title\": \"30004033: reviewed fractional-coloring partials, original unsolved 5/5\",\n+      \"head\": \"41046766ce60f3f706abc1f6ec91711734e48565\",\n+      \"distinct_target\": true\n+    }\n+  ],\n+  \"exact_attempt_recovered\": false,\n+  \"limitations\": \"No claim to exclude uncommitted or unindexed work; imported triage and prior literature are not campaign proof attempts.\",\n+  \"all_ref_scan\": {\n+    \"refs_scanned\": 411,\n+    \"branch_hits\": [],\n+    \"artifact_hits\": [],\n+    \"commit_hits\": []\n+  },\n+  \"related_target_group_hit\": false\n+}"},{"sha":"cd9dd6ebfb76f858d9b2a074e0e76497baab4ae2","filename":"problems/30005116_induced_four_cycle_profile/PUBLICATION_MANIFEST.json","status":"added","additions":275,"deletions":0,"changes":275,"blob_url":"https://github.com/AlecKriebel/Math/blob/c683fc4b84266a6a153c087e182cf427ed502d6c/problems%2F30005116_induced_four_cycle_profile%2FPUBLICATION_MANIFEST.json","raw_url":"https://github.com/AlecKriebel/Math/raw/c683fc4b84266a6a153c087e182cf427ed502d6c/problems%2F30005116_induced_four_cycle_profile%2FPUBLICATION_MANIFEST.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F30005116_induced_four_cycle_profile%2FPUBLICATION_MANIFEST.json?ref=c683fc4b84266a6a153c087e182cf427ed502d6c","patch":"@@ -0,0 +1,275 @@\n+{\n+  \"problem_id\": 30005116,\n+  \"disposition\": \"unsolved\",\n+  \"turns\": \"5/5\",\n+  \"author_parent\": \"e27668a5dd99e38705ec6a97d15710b7eb1b0f41\",\n+  \"integration_main\": \"efd29c05204703acca9a0860812f54b94fae54b1\",\n+  \"author_files\": 36,\n+  \"review_files\": 6,\n+  \"files\": [\n+    {\n+      \"path\": \"FINAL_AUTHOR_MANIFEST.json\",\n+      \"bytes\": 7873,\n+      \"sha256\": \"e594f4629756fbf1a8b372d677de4f174f01f3886d3fa8c58c9dcc87c86fb2fa\",\n+      \"git_blob_sha1\": \"ce04187e64871be825cd82e93f257e96b95a88d2\"\n+    },\n+    {\n+      \"path\": \"FINAL_PUBLIC_SCOPE.json\",\n+      \"bytes\": 1290,\n+      \"sha256\": \"c00d3abf2cf8016cb7ec4a4ac0cf7b4f206e8bfeed47492b7779315c8e715095\",\n+      \"git_blob_sha1\": \"474511bf7a086dd186007c85549c92e7cf6e7d60\"\n+    },\n+    {\n+      \"path\": \"FINAL_REPLAY_RECEIPT.json\",\n+      \"bytes\": 1175,\n+      \"sha256\": \"a7d3f2c77dacf6702df5ad36189fffd56b7a8900c5bc85135f4418e1897d1888\",\n+      \"git_blob_sha1\": \"e3e17fe5752c98ac97ceea6daad8de123178c0c2\"\n+    },\n+    {\n+      \"path\": \"FINAL_RESULT.md\",\n+      \"bytes\": 4378,\n+      \"sha256\": \"64398cbf4c0787f13bbd55f83d