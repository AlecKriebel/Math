{"created": "2026-10-03T16:52:00.285180+00:00", "modified": "2026-10-03T16:52:00.630397+00:00", "id": 23124601, "conceptrecid": "23124600", "doi": "10.5281/zenodo.23124601", "conceptdoi": "10.5281/zenodo.23124600", "doi_url": "https://doi.org/10.5281/zenodo.23124601", "metadata": {"title": "Fixed-generator positive factorizations in Wajnryb's Artin A5 quotient", "doi": "10.5281/zenodo.23124601", "publication_date": "2026-10-03", "description": "We classify positive words in the five fixed standard generators of B6 modulo c=h representing c^2. The possible lengths are 20, 30 and 40, with respectively one, one and two strict Hurwitz classes. Simultaneous conjugation identifies the two length-40 classes, giving the three proposed representatives of Wajnryb's quotient question. A pure-braid linking reduction and an exhaustive exact 810-word certificate settle length 20. The classical group presentation, previously known length spectrum and Casson's twice-per-pair crossing assertion reported by Elrifai-Morton are explicitly credited. A full reproducible six-strand crossing certificate and independent controls accompany the note. Novelty of the exact complete classification is not certified by a negative literature search. AI tools were used extensively in solving, verifying, literature research, writing and adversarial review. This is an unrefereed preprint and has not received external human peer review. The statement is restricted to fixed-generator input words, not arbitrary conjugate-factor or geometric factorizations.", "access_right": "open", "creators": [{"name": "Kriebel, Alec", "affiliation": "Independent researcher", "orcid": "0009-0001-9320-500X"}], "keywords": ["braid groups", "Hurwitz equivalence", "mapping class groups", "positive factorizations", "computer-assisted proof"], "version": "1.0", "resource_type": {"title": "Preprint", "type": "publication", "subtype": "preprint"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23124600"}}]}}, "title": "Fixed-generator positive factorizations in Wajnryb's Artin A5 quotient", "links": {"self": "https://zenodo.org/api/records/23124601", "self_html": "https://zenodo.org/records/23124601", "preview_html": "https://zenodo.org/records/23124601?preview=1", "doi": "https://doi.org/10.5281/zenodo.23124601", "self_doi": "https://doi.org/10.5281/zenodo.23124601", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23124601", "reserve_doi": "https://zenodo.org/api/records/23124601/draft/pids/doi", "parent": "https://zenodo.org/api/records/23124600", "parent_html": "https://zenodo.org/records/23124600", "parent_doi": "https://doi.org/10.5281/zenodo.23124600", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23124600", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23124601/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23124601/sequence/default", "files": "https://zenodo.org/api/records/23124601/files", "media_files": "https://zenodo.org/api/records/23124601/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:23124601:fixed_generator_classification.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:23124601:fixed_generator_classification.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:23124601:fixed_generator_classification.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:23124601:fixed_generator_classification.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:23124601:fixed_generator_classification.pdf/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record:23124601:fixed_generator_classification.pdf/full/%5E1200,/0/default.jpg"}, "archive": "https://zenodo.org/api/records/23124601/files-archive", "archive_media": "https://zenodo.org/api/records/23124601/media-files-archive", "latest": "https://zenodo.org/api/records/