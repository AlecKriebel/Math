+      \"path\": \"TURN_4_CHECKS.json\",\n+      \"bytes\": 574,\n+      \"sha256\": \"d541bfc16409de3b4c4e171e590c809aca6456a164a5a4a7dcb5680185c0820b\"\n+    },\n+    {\n+      \"path\": \"TURN_4_CPP_CHECKS.json\",\n+      \"bytes\": 514,\n+      \"sha256\": \"661ef52ff67574e217c270b60ddededdd76799c8904e49e31006d4b25918fd54\"\n+    },\n+    {\n+      \"path\": \"TURN_4_MANIFEST.json\",\n+      \"bytes\": 1242,\n+      \"sha256\": \"5ea770b400070f25af6206459e03eccfd58db95355a05968c0c0af96c43b7dae\"\n+    },\n+    {\n+      \"path\": \"check_turn_1.py\",\n+      \"bytes\": 2957,\n+      \"sha256\": \"68751e5a701247344c32517aea0752711175c3e72c50fda0a5e93445db78db5c\"\n+    },\n+    {\n+      \"path\": \"check_turn_2.py\",\n+      \"bytes\": 2121,\n+      \"sha256\": \"a0385e57064caf3353007b20f374361720544dd7067590dd81d7b3b3d092f2a5\"\n+    },\n+    {\n+      \"path\": \"check_turn_3.py\",\n+      \"bytes\": 2685,\n+      \"sha256\": \"c6de7525ee866f4e384e36983f4ba17281b6d463bf1a9bb32fdc85966ad7a2bf\"\n+    },\n+    {\n+      \"path\": \"check_turn_4.cpp\",\n+      \"bytes\": 5114,\n+      \"sha256\": \"7ca50a2a0804b592b741f2fc04e3a2178101eabcf8a23aa262cdabd95e110843\"\n+    },\n+    {\n+      \"path\": \"check_turn_4.py\",\n+      \"bytes\": 2665,\n+      \"sha256\": \"37adab4df9e3efa67ef934b5c0006957de7ded4001b3eb8bdcd555c26b55f17e\"\n+    },\n+    {\n+      \"path\": \"review/AUTHOR_REPLAY.json\",\n+      \"bytes\": 3187,\n+      \"sha256\": \"4e0c0e9b7ed5e7f260b0b6f0f32202ed4e4be3f5d3c95f362903b9a0f05e9503\"\n+    },\n+    {\n+      \"path\": \"review/INDEPENDENT_CHECKS.json\",\n+      \"bytes\": 365,\n+      \"sha256\": \"b4bb9743588b9019d4b6100ecdef31676cb6a6b369231881e717c6086d30d104\"\n+    },\n+    {\n+      \"path\": \"review/REVIEW.md\",\n+      \"bytes\": 4441,\n+      \"sha256\": \"bb8ca1b5bbb37be8393957faaf352c7d2402757cafd2e39a605700f523818ce4\"\n+    },\n+    {\n+      \"path\": \"review/REVIEW_MANIFEST.json\",\n+      \"bytes\": 884,\n+      \"sha256\": \"8a42b56b77cc4e9f803497af69a7278fdaa457838d3fde09d3aaa3d9e88f6f5f\"\n+    },\n+    {\n+      \"path\": \"review/independent_check.py\",\n+      \"bytes\": 2650,\n+      \"sha256\": \"5de33aa29199853914c93719046ae96a1ffe858d0e17e4b75246fefec5e32923\"\n+    },\n+    {\n+      \"path\": \"review/replay_author.py\",\n+      \"bytes\": 937,\n+      \"sha256\": \"bf8115ea4e7caab22bfccb98924ffa1f9ee837a9ebc4216c7fe3460a0e77914d\"\n+    },\n+    {\n+      \"path\": \"verify_publication.py\",\n+      \"bytes\": 876,\n+      \"sha256\": \"9488818bafe490a517104c82e7f73de5c28bc48c7632f4dc411ced09bf2adbef\"\n+    },\n+    {\n+      \"path\": \"verify_turn_4_cpp.py\",\n+      \"bytes\": 1213,\n+      \"sha256\": \"b8e1f2e6ca69699cccbfc353bd1361c15d9f0faf2fa56905ed3ea85f71cc7243\"\n+    }\n+  ]\n+}"},{"sha":"4b0994f7a1f75755834672d4ec9cc68cfdf737a4","filename":"problems/11000151_artin_a5_quotient/PUBLICATION_README.md","status":"added","additions":15,"deletions":0,"changes":15,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FPUBLICATION_README.md","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FPUBLICATION_README.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FPUBLICATION_README.md?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,15 @@\n+# Artin A5 quotient: complete fixed-generator classification\n+\n+**Disposition: claimed_solved, 4/5 substantive turns.** A separate full AI-assisted mathematical/source audit passed. Historical novelty is unverified; this is not external peer review.\n+\n+For Wajnryb's exact quotient of B6 by c=h, classify positive words in the five fixed standard generators representing c². The possible lengths are 20, 30 and 40. There are **four strict Hurwitz classes**, distributed 1,1,2 across those lengths. **Allowing simultaneous conjugation gives three classes**, because it identifies the two length-40 classes. Both conventions are resolved; this does not classify arbitrary conjugate factors or arbitrary geometric factorizations.\n+\n+The imported catalog relation is typographically corrupted. SOURCE_GATE.md and the turn files recover the typeset equation from the primary source. The upper bound and structural braid results are credited to Baykur–Monden–Van Horn-Morris, Perron–Vannier and classical Artin/Garside theory. No independent discovery of those ingredients is claimed.\n+\n+The complete finite reductions include 810 twenty-letter candidates with ten surviving rotations, and a thirty-letter crossing DAG with 234,368 reachable states, 90,921 coaccessible states and 261,810 exact free-group-action edge comparisons. Complete Python and C++ replays agree. The large action stream is regenerable, not stored here; hashes are integrity checks, not substitutes for literal equality tests or the completeness argument.\n+\n+Read FINAL_RESULT.md and TURN_1.md through TURN_4.md, followed by review/REVIEW.md. Historical pending-review snapshots are intentionally unchanged. All 34 frozen author files and all six frozen review files are preserved exactly. Fresh main is the first integration parent; author WIP a440a519393bf4c68433c6a8cdd49b384d3bfca6 is the second. Only this target and its own queue status/turn cells change.\n+\n+## Reproduction\n+\n+Run `python verify_publication.py` from any directory. It verifies public hashes, reruns the four Python author receipts, compiles/runs the independent C++ action stream (requires g++ with C++17), and replays the separate reviewer controls. No raw source PDFs, imported records, private notes or large generated state streams are distributed."},{"sha":"62e06528fac4d0e5a37e19f76b530131c70a5fbe","filename":"problems/11000151_artin_a5_quotient/SOURCE_ADDITION_T2.json","status":"added","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FSOURCE_ADDITION_T2.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FSOURCE_ADDITION_T2.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FSOURCE_ADDITION_T2.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,7 @@\n+{\n+  \"name\": \"basic-braids.pdf\",\n+  \"url\": \"https://www.numdam.org/item/AMBP_2011__18_1_15_0.pdf\",\n+  \"sha256\": \"d094faad7803b263e742e5b128f6c8aac5603c7ea94c8f9dd3b330820d6c7edc\",\n+  \"bytes\": 1037965,\n+  \"inspected\": \"sections1.6 and4; faithful Artin action, full twist centrality and positive monoid embedding\"\n+}"},{"sha":"30947fbc711606f212b9c28af932488673ca9430","filename":"problems/11000151_artin_a5_quotient/SOURCE_GATE.md","status":"added","additions":15,"deletions":0,"changes":15,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FSOURCE_GATE.md","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FSOURCE_GATE.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FSOURCE_GATE.md?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,15 @@\n+# Exact source and prior-attempt gate: 11000151\n+\n+Target AMR-109-0151, Wajnryb, *Relations in the mapping class group*, in Farb's *Problems on Mapping Class Groups and Related Topics*. Author-hosted complete volume: https://www.math.uchicago.edu/~farb/papers/mcgbook.pdf . The complete chapter, printed122–128, was read. The target on printed126 (physical133) was visually checked, including every exponent. The following page explicitly distinguishes closed-surface equivalence from the boundary-surface problem.\n+\n+Let B6 have Artin generators a1,...,a5. Put c=(a1a2a3a4)^5 and h=a5a4a3a2 a1² a2a3a4a5. The quotient is G=B6/normal-closure(c h^−1). The exact target element is c²=(a1a2a3a4)^10. The question has two parts: must every positive word representing it have length40,30 or20, and must the factorization be Hurwitz equivalent to c², z=(a1a2a3a4a5)^6, or h² respectively? The malformed catalog's a1 exponent is2, not an extra generator or a negative power.\n+\n+The cited Auroux chapter, printed131–132, defines Hurwitz moves on ordered tuples by (x,y)→(xyx^−1,x), and distinguishes global conjugation as an additional equivalence. The present target literally asks Hurwitz equivalence. We do not silently add global conjugation, arbitrary boundary capping or negative factors to that requested conclusion. Positive words are words in the five fixed Artin generators; intermediate Hurwitz factors can be conjugates.\n+\n+The surrounding geometric motivation involves nonseparating twists on genus2 with one boundary. The source's chain identities are sufficient to construct a homomorphism from G into that mapping class group; no assertion that this homomorphism is injective is needed for the first-turn length bound.\n+\n+Prior gate: pinned full record and imported research read. Imported research only says the statement was truncated and requests retrieval, with OPEN-TRIAGE; it is not a prior mathematical solution. Exact-ID11000151, AMR-109-0151, Wajnryb and Hurwitz all-state campaign PR searches found no match. Available all-ref commit subjects found only unrelated Hurwitz polytope work. Full-source/title searches did not identify a later exact boundary Hurwitz classification. The closed-surface Siebert–Tian result cited in the source does not by itself settle this quotient problem.\n+\n+A relevant later primary theorem is Baykur–Monden–Van Horn-Morris, *Positive factorizations of mapping classes*, AGT17(2017),1527–1555, TheoremA on1529: a genus2 boundary twist has maximal nonseparating positive factorization length40. Published primary PDF https://msp.org/agt/2017/17-3/agt-v17-n3-p06-s.pdf was retrieved and the theorem page visually checked; the corresponding proof and exact genus2/one-boundary hypotheses were checked in arXiv1412.0352v2. This gives a credited upper bound, not a Hurwitz classification. Limited literature searches do not certify current novelty or universal open status.\n+\n+Eligible for scoped work on the remaining exact question. First substantive turn proves the complete length subquestion by combining the cited upper bound with an elementary linking obstruction. Original full classification remains unresolved pending further turns and separate review."},{"sha":"8573be04e290fe1e3aea1b4a90dfe7fb1b2e3abd","filename":"problems/11000151_artin_a5_quotient/SOURCE_MANIFEST.json","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FSOURCE_MANIFEST.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FSOURCE_MANIFEST.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FSOURCE_MANIFEST.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,22 @@\n+{\n+  \"files\": [\n+    {\n+      \"name\": \"mcgbook.pdf\",\n+      \"url\": \"https://www.math.uchicago.edu/~farb/papers/mcgbook.pdf\",\n+      \"bytes\": 2724624,\n+      \"sha256\": \"f37c6a1dbc875105c2b294196de1a03a88595b75e8705e6077e9d48f066e402a\"\n+    },\n+    {\n+      \"name\": \"positive-factorizations.pdf\",\n+      \"url\": \"https://arxiv.org/pdf/1412.0352\",\n+      \"bytes\": 390564,\n+      \"sha256\": \"90fd9b5d03147e742074cb79f6c48dee809b97fd5fa6f3850e52964c4a67721d\"\n+    },\n+    {\n+      \"name\": \"positive-factorizations-published.pdf\",\n+      \"url\": \"https://msp.org/agt/2017/17-3/agt-v17-n3-p06-s.pdf\",\n+      \"bytes\": 420428,\n+      \"sha256\": \"479fb4d84d5fa40a90aa897a58d7fbf2c0559d879042f5173a01f91492199331\"\n+    }\n+  ]\n+}"},{"sha":"25e90685189af0bb56ff47cbf0f79f5047d706cb","filename":"problems/11000151_artin_a5_quotient/STATE.json","status":"added","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FSTATE.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FSTATE.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FSTATE.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,8 @@\n+{\n+  \"problem_id\": 11000151,\n+  \"author_turns_completed\": 1,\n+  \"status\": \"original_unresolved\",\n+  \"partial\": \"Exact length spectrum20,30,40; boundary Hurwitz classification remains unresolved\",\n+  \"source_gate\": \"complete\",\n+  \"public_scope\": \"No raw source/imports; prior maximal-length theorem credited\"\n+}"},{"sha":"698deba585d9d77c00a595fe66e846abbc49c73e","filename":"problems/11000151_artin_a5_quotient/STATE_T2.json","status":"added","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FSTATE_T2.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FSTATE_T2.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FSTATE_T2.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,7 @@\n+{\n+  \"problem_id\": 11000151,\n+  \"author_turns_completed\": 2,\n+  \"status\": \"original_unresolved\",\n+  \"completed\": \"Strict Hurwitz obstruction; linking patterns; exactly two strict40-letter classes, one modulo simultaneous conjugation\",\n+  \"remaining\": \"20/30-letter classification modulo simultaneous conjugation; source intended convention ambiguous\"\n+}"},{"sha":"82f86aa71deaf0cb404e72bc419a42493cff9cf5","filename":"problems/11000151_artin_a5_quotient/STATE_T3.json","status":"added","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FSTATE_T3.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FSTATE_T3.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FSTATE_T3.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,7 @@\n+{\n+  \"problem_id\": 11000151,\n+  \"author_turns_completed\": 3,\n+  \"status\": \"original_unresolved\",\n+  \"completed\": \"Complete20-letter strict Hurwitz class;40-letter class modulo simultaneous conjugation; exactlengths\",\n+  \"remaining\": \"30-letter classification modulo simultaneous conjugation\"\n+}"},{"sha":"5800981fd222c2755bc3b89474f360a43aef2edd","filename":"problems/11000151_artin_a5_quotient/STATE_T4.json","status":"added","additions":10,"deletions":0,"changes":10,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FSTATE_T4.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FSTATE_T4.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FSTATE_T4.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,10 @@\n+{\n+  \"problem_id\": 11000151,\n+  \"author_turns_completed\": 4,\n+  \"status\": \"complete_candidate_pending_independent_review\",\n+  \"strict_Hurwitz_classes\": 4,\n+  \"modulo_global_conjugation_classes\": 3,\n+  \"scope\": \"positive words in the fixed standard five generators\",\n+  \"fifth_turn_not_used\": true,\n+  \"novelty_certified\": false\n+}"},{"sha":"07c7379cf2103824140aef6fc5dc85f6fadd1448","filename":"problems/11000151_artin_a5_quotient/TURN_1.md","status":"added","additions":92,"deletions":0,"changes":92,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_1.md","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_1.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FTURN_1.md?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,92 @@\n+# Turn 1: exact length spectrum, with the Hurwitz part left open\n+\n+One substantive author turn. Original question remains unresolved1/5. The maximal-length input is a credited published theorem; no novelty claim is made for this corollary or its elementary ingredients.\n+\n+## Theorem\n+\n+In the exact group\n+\n+    G = B6 / << c h^−1 >>,\n+    c = (a1 a2 a3 a4)^5,\n+    h = a5 a4 a3 a2 a1² a2 a3 a4 a5,\n+\n+the set of lengths of positive words representing c² is exactly {20,30,40}.\n+\n+This proves the first clause of Wajnryb's question. It does not classify the corresponding ordered factorizations up to Hurwitz moves in G.\n+\n+## 1. Realization and the geometric upper bound\n+\n+Let z=(a1a2a3a4a5)^6. The classical full-twist decomposition in B6 is\n+\n+    z = c h.                                                   (1)\n+\n+Here c is the full twist of the first five strands and h is the pure braid that takes the sixth strand once positively around all five. The decomposition follows by separating that strand from the full twist; it also follows by the Artin braid relations. The supplied exact free-group-action check verifies this particular identity independently, using the faithful classical Artin action.\n+\n+In G, c=h, so c²=z=h². These positive representatives have lengths40,30,20 respectively.\n+\n+For the upper bound, take the usual five-curve chain on a genus2 surface with two boundary components and cap one of those boundary components with a disk. Denote the surviving boundary by delta. Each chain curve remains nonseparating, adjacent twists satisfy the braid relation, and distant twists commute. The chain identities give\n+\n+    image(z)=t_delta,\n+    image(c²)=t_delta.                                        (2)\n+\n+The four-curve chain has a genus2 one-boundary neighborhood; its boundary is parallel to the surviving boundary after the other disk is capped. The five-chain identity before capping is the product of the two boundary twists. These are precisely the familiar chain relations described in Wajnryb's source, printed125, cases(2) and(3).\n+\n+By (1) and (2), image(c) image(h)=image(c)², so image(h)=image(c). Thus the geometric homomorphism B6→Mod(Sigma_2^1) factors through G. Every positive word of length m representing c² maps to a factorization of t_delta into exactly m positive twists along nonseparating curves. No injectivity assertion is required.\n+\n+Baykur–Monden–Van Horn-Morris, *Positive factorizations of mapping classes*, AGT17(2017), TheoremA, gives L(t_delta)=40 for genus2 and one boundary component. All its hypotheses hold here. Consequently\n+\n+    m ≤ 40.                                                   (3)\n+\n+This upper bound, including its geometric input, is credited. It does not follow just from abelianizing G.\n+\n+## 2. The quotient's exponent sum\n+\n+In the abelianization of B6 all five generators have the same class. The new relation has exponent sums20 and10, so it imposes10 times that class equal to zero. Conversely sending every a_i to1 modulo10 respects all relations. Therefore\n+\n+    G_ab = Z/10Z.\n+\n+Since c² has exponent sum40, every representing positive word has length divisible by10. Together with (3), only0,10,20,30,40 need be considered.\n+\n+## 3. Pure-braid linking obstruction to lengths0 and10\n+\n+Let P6 be the kernel of the standard permutation map B6→S6. Both c and h are pure, so the added relation is pure and the permutation map descends to G. A word w equal to c² in G is therefore a pure braid when regarded as a word in B6.\n+\n+For a pure braid define ell_ij to be half the algebraic crossing count of the two labelled strands i,j, for1≤i<j≤6. These are integer homomorphisms P6→Z. On a positive word all ell_ij are nonnegative, and the exponent sum is2 sum ell_ij. Conjugation by a braid permutes these coordinates according to its strand permutation. These elementary facts can be seen directly by following labelled strands; no faithful linear representation is assumed.\n+\n+The linking vector beta of c² has entries\n+\n+    beta_ij=2 if i,j≤5, and beta_i6=0.\n+\n+The relator r=c h^−1 has linking vector r_6 with entry+1 on edges among the first five vertices and−1 on edges incident to6. Its braid conjugates have vectors r_k, k=1,...,6, where\n+\n+    (r_k)_ij = 1−2*indicator(k in {i,j}).\n+\n+If w=c² in G, then w(c²)^−1 is a finite product of conjugates of r and r^−1 in B6. All factors are pure. Applying the linking homomorphism yields integers t1,...,t6 such that\n+\n+    ell_ij(w) = beta_ij + T − 2(t_i+t_j),\n+    T = t1+...+t6.                                            (4)\n+\n+No bound or sign is placed on the integers t_i; they record a necessary normal-closure condition only. Summing (4) over the fifteen pairs gives\n+\n+    m/2 = 20 + 5T,\n+    T = m/10 − 4.                                            (5)\n+\n+Suppose m=0 or10. Then T is−4 or−3. For i,j≤5, positivity in (4) and integrality give t_i+t_j≤−1 in either case. Writing s=t1+...+t5 and summing the ten inequalities gives4s≤−10, hence\n+\n+    s ≤ −3.                                                  (6)\n+\n+For the five pairs i,6, positivity gives t_i+t6≤−2. Summing yields\n+\n+    s+5t6≤−10,\n+    5T−4s≤−10,\n+    s≥ceil((5T+10)/4).                                       (7)\n+\n+When T=−4 the last lower bound is−2, and when T=−3 it is−1. Both contradict (6). Thus lengths0 and10 are impossible. This argument also directly shows that the target element is nontrivial; it does not rely on declaring a nonempty word nontrivial by positivity alone.\n+\n+Together with the upper bound, congruence and three realizations, this proves the length theorem.\n+\n+## 4. Exact verification and remaining problem\n+\n+The standard-library checker verifies the full-twist identity via freely reduced Artin automorphisms, all pure linking vectors, the six conjugation patterns, summed inequalities, three representative lengths and bounded stress instances. The finite controls are supplementary: equations(6)–(7) are a proof for all integers t_i, not an extrapolation from the bounded test. The cited topological upper bound remains an external theorem, not a finite computation.\n+\n+What remains is the original second clause: for each of the three lengths, must every positive word representing c² in G be Hurwitz equivalent to the corresponding standard word? Equality in G is weaker than equality in B6; closed-surface equivalence is also weaker than the requested boundary setting. Neither the linking obstruction nor the maximal-length theorem supplies these equivalences. The next turn will study the normal-closure/linking data at the allowed lengths and what it can and cannot detect under Hurwitz moves."},{"sha":"7f18c347a9c34398b923ab0dbeab01c48f84e231","filename":"problems/11000151_artin_a5_quotient/TURN_1_CHECKS.json","status":"added","additions":13,"deletions":0,"changes":13,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_1_CHECKS.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_1_CHECKS.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FTURN_1_CHECKS.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,13 @@\n+{\n+  \"bounded_integer_stress_cases\": 1466,\n+  \"exact_assertions\": 2309,\n+  \"linking_coordinates\": 15,\n+  \"realized_lengths\": [\n+    20,\n+    30,\n+    40\n+  ],\n+  \"relation_conjugate_patterns\": 6,\n+  \"scope\": \"Exact braid identities/linking and integer obstruction controls. The universal upper bound40 is the credited Baykur\\u2013Monden\\u2013Van Horn-Morris theorem; Hurwitz classification remains open here.\",\n+  \"status\": \"PASS\"\n+}"},{"sha":"dbfd1f55091a25c1984c5da93ecc67bf3da9cbbd","filename":"problems/11000151_artin_a5_quotient/TURN_1_MANIFEST.json","status":"added","additions":36,"deletions":0,"changes":36,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_1_MANIFEST.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_1_MANIFEST.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FTURN_1_MANIFEST.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,36 @@\n+{\n+  \"problem_id\": 11000151,\n+  \"turn\": 1,\n+  \"files\": [\n+    {\n+      \"path\": \"SOURCE_GATE.md\",\n+      \"sha256\": \"44a3a2401d2e27c9744be7444bec47c7bac7e506b860f53f6a59854c2128e4b2\",\n+      \"bytes\": 3215\n+    },\n+    {\n+      \"path\": \"SOURCE_MANIFEST.json\",\n+      \"sha256\": \"54fd80f205a6c1c1d8a86088d93596e5dfc2ad8a1793e5518932eb06ee6c494a\",\n+      \"bytes\": 693\n+    },\n+    {\n+      \"path\": \"STATE.json\",\n+      \"sha256\": \"e036cc95665157242e6d1704da78ea226e55528bccee54423539969602abc46b\",\n+      \"bytes\": 304\n+    },\n+    {\n+      \"path\": \"TURN_1.md\",\n+      \"sha256\": \"bfa2a98a5fee81f2088d6962678e31ebdd0ed4d6335d1ca8ea033bb29e515ade\",\n+      \"bytes\": 6650\n+    },\n+    {\n+      \"path\": \"check_turn_1.py\",\n+      \"sha256\": \"68751e5a701247344c32517aea0752711175c3e72c50fda0a5e93445db78db5c\",\n+      \"bytes\": 2957\n+    },\n+    {\n+      \"path\": \"TURN_1_CHECKS.json\",\n+      \"sha256\": \"724fdaab0d0007047ea4005426b9bc75b755117797a6e07f3f1e05a3a450ff85\",\n+      \"bytes\": 422\n+    }\n+  ]\n+}"},{"sha":"1f73f38968b3b154314c8bd48103d47e1fe4aae9","filename":"problems/11000151_artin_a5_quotient/TURN_1_REMOTE_RECEIPT.json","status":"added","additions":43,"deletions":0,"changes":43,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_1_REMOTE_RECEIPT.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_1_REMOTE_RECEIPT.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FTURN_1_REMOTE_RECEIPT.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,43 @@\n+{\n+  \"commit\": \"4a0d60738ffc0fe06668c5a85156717501196aa5\",\n+  \"branch\": \"math/11000151-artin-a5-quotient-wip\",\n+  \"files\": [\n+    {\n+      \"name\": \"SOURCE_GATE.md\",\n+      \"sha\": \"30947fbc711606f212b9c28af932488673ca9430\",\n+      \"size\": 3215\n+    },\n+    {\n+      \"name\": \"SOURCE_MANIFEST.json\",\n+      \"sha\": \"8573be04e290fe1e3aea1b4a90dfe7fb1b2e3abd\",\n+      \"size\": 693\n+    },\n+    {\n+      \"name\": \"STATE.json\",\n+      \"sha\": \"25e90685189af0bb56ff47cbf0f79f5047d706cb\",\n+      \"size\": 304\n+    },\n+    {\n+      \"name\": \"TURN_1.md\",\n+      \"sha\": \"07c7379cf2103824140aef6fc5dc85f6fadd1448\",\n+      \"size\": 6650\n+    },\n+    {\n+      \"name\": \"TURN_1_CHECKS.json\",\n+      \"sha\": \"7f18c347a9c34398b923ab0dbeab01c48f84e231\",\n+      \"size\": 422\n+    },\n+    {\n+      \"name\": \"TURN_1_MANIFEST.json\",\n+      \"sha\": \"dbfd1f55091a25c1984c5da93ecc67bf3da9cbbd\",\n+      \"size\": 952\n+    },\n+    {\n+      \"name\": \"check_turn_1.py\",\n+      \"sha\": \"65d05c64a88b74317a506275611ae88167a18f84\",\n+      \"size\": 2957\n+    }\n+  ],\n+  \"raw_bytes_exact\": true,\n+  \"queue_changed\": false\n+}"},{"sha":"1966f6c122c2349e8319818e15ee2fb4dc27cdca","filename":"problems/11000151_artin_a5_quotient/TURN_2.md","status":"added","additions":81,"deletions":0,"changes":81,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_2.md","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_2.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FTURN_2.md?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,81 @@\n+# Turn 2: the framing obstruction and the complete forty-letter slice\n+\n+Status: original classification unresolved2/5. This turn proves a literal Hurwitz-only obstruction, classifies all possible linking vectors at the three allowed lengths, and completely resolves the forty-letter slice modulo simultaneous conjugation. It does not use the convention issue to claim an unframed geometric classification.\n+\n+## 1. Source convention must remain qualified\n+\n+Wajnryb's own chapter does not define Hurwitz equivalence. Its question on printed126 says Hurwitz equivalent and points to Auroux's chapter. Auroux, printed131, explicitly defines adjacent Hurwitz moves and then separately introduces global conjugation. Nevertheless the geometric motivation and the following closed-surface comparison concern monodromy classifications that conventionally include simultaneous conjugation. We cannot infer from the abbreviated wording that Wajnryb intended to forbid it.\n+\n+Accordingly the following is a theorem for the strict equivalence generated by adjacent Hurwitz moves alone. It is not promoted to a negative answer under the natural weaker equivalence including global conjugation. The first-turn statements about the literal wording should be read with this qualification; frozen earlier bytes remain unchanged.\n+\n+## 2. A strict Hurwitz obstruction\n+\n+Continue with c=(a1a2a3a4)^5, h=a5a4a3a2 a1² a2a3a4a5, z=(a1a2a3a4a5)^6 and G=B6/<<c h^−1>>. Turn1 gives c²=z in G. The full twist z is central already in B6.\n+\n+Set d=a1a2a3a4a5. The standard braid identities give d a_i d^−1=a_(i+1) for i=1,...,4. Thus\n+\n+    w=(a2a3a4a5)^10 = d c² d^−1 = z = c² in G.             (1)\n+\n+The relation is pure, so the standard permutation map pi:G→S6 is well-defined. For the forty-term tuple underlying c², the subgroup generated by its images is the S5 fixing6. For the tuple underlying w it is the S5 fixing1. These are different subgroups of S6, although they are conjugate.\n+\n+Every Hurwitz move (x,y)→(xyx^−1,x), or its inverse, preserves the subgroup generated by the complete tuple: each old pair can be recovered as words in the new pair and conversely. Therefore its image under pi is also invariant. The two forty-term tuples in (1) are not strictly Hurwitz equivalent. Neither can the second tuple be equivalent to the thirty-term or twenty-term standard tuple, because the number of factors is invariant.\n+\n+This proves the negative assertion under the strict convention. Under simultaneous conjugation, the two tuples are explicitly equivalent by d, so it provides no obstruction at all to the modulo-conjugation question.\n+\n+## 3. All possible pairwise linking vectors\n+\n+The first-turn normal-closure argument gives, for any positive representative w of c² of length m,\n+\n+    L_ij = beta_ij+T−2(t_i+t_j) ≥ 0,\n+    T=sum t_i=m/10−4,\n+\n+where beta is twice the complete graph on vertices1,...,5 and zero on pairs incident to6. The integers t_i can have either sign. We now solve these inequalities at m20,30,40 completely.\n+\n+Write s=sum_(i≤5)t_i and t6=T−s. The ten internal inequalities are t_i+t_j≤floor((T+2)/2); the five other inequalities are t_i+t6≤floor(T/2).\n+\n+### Length20: twice a star\n+\n+T=−2. Summing the internal inequalities gives s≤0, and summing the cross inequalities gives s≥−1. Thus s is−1 or0.\n+\n+If s=−1, t6=−1 and every t_i≤0. Exactly one of the first five coordinates is−1 and the other four are0. If s=0, t6=−2 and each t_i≤1. The pair-sum bound is0. A positive coordinate M≥1 would force the other four to be at most−M and their total sum to be at most−3M<0. Hence all five are0.\n+\n+Substituting, L is exactly twice a star, centered at one of the six vertices: L_ij=2 precisely when the chosen center is in {i,j}, and0 otherwise.\n+\n+### Length30: the full complete graph\n+\n+T=−1. The internal inequalities give s≤0. The cross inequalities give s≥0, so s=0 and t6=−1. Each first coordinate is≤0, hence all are0. Substituting gives L_ij=1 for every pair.\n+\n+### Length40: twice a five-vertex clique\n+\n+T=0. The internal pair bound is1. If the maximum first coordinate M is≤0 then s≤0. If M≥1, the other four are≤1−M, giving s≤M+4(1−M)≤1. Thus s≤1. The cross inequalities imply t6≤0, hence s=−t6≥0.\n+\n+If s=0, t6=0 and all first coordinates are≤0, hence all0. If s=1, t6=−1 and all first coordinates are≤1. Pair sums≤1 allow at most one coordinate1, and the sum1 then forces precisely one1 and four0. Substituting, L is twice the complete graph on five vertices, with the remaining vertex isolated.\n+\n+These are necessary conditions, not a claim that every positive braid with the prescribed linking vector has the required image in G. The distinctions matter in lengths20 and30.\n+\n+## 4. Complete classification of the forty-letter slice\n+\n+Let m=40 and let k be the isolated vertex in its linking vector. Since the word is positive, zero linking of strand k with every other strand means that strand k has no crossings at all. It therefore stays in its original position, and the word uses neither adjacent generator a_(k−1) nor a_k whenever defined.\n+\n+If 2≤k≤5, the untouched strand separates strands to its left from strands to its right. No crossings between these two sets can occur in such a word. But the required linking vector is2 on every pair of vertices other than k, including a pair lying on opposite sides. This contradiction shows that k=1 or6.\n+\n+If k=6, the word uses only a1,...,a4. The four-chain geometric homomorphism B5→Mod(Sigma_2^1) is injective: it is the A4 instance of the Perron–Vannier theorem stated as Theorem2.1 in Wajnryb's chapter, where the surface is a regular neighborhood of the chain. Under the map from G constructed in turn1, w and c² have the same image. Therefore they are equal already in this B5 subgroup.\n+\n+The positive braid monoid embeds in B5 (classical Garside theory). Thus two positive words representing the same B5 element can be related by positive commutations and adjacent braid relations. Each such word relation induces strict Hurwitz equivalence of the factor tuples. A commutation xy=yx is one Hurwitz swap. For xyx=yxy, two inverse Hurwitz moves give\n+\n+    (x,y,x) → (y,y^−1 x y,x) → (y,x,x^−1 y^−1 x y x)\n+            = (y,x,y).\n+\n+Consequently every forty-letter representative with k=6 is strictly Hurwitz equivalent to c².\n+\n+If k=1, the same argument on the other four-curve chain shows strict Hurwitz equivalence to w0=(a2a3a4a5)^10. That chain's neighborhood is again genus2 with one boundary, and its boundary is parallel to the surviving boundary of the capped five-chain surface. Alternatively conjugate the entire argument by d.\n+\n+It follows that there are **exactly two strict Hurwitz classes** of positive forty-letter representatives of c², represented by c² and w0. They are distinct by §2. They form exactly one class after allowing simultaneous conjugation.\n+\n+## 5. Credit, certificates and next gap\n+\n+Classical inputs are the Artin action/full-twist identities, the Perron–Vannier geometric injection and the positive braid monoid embedding. The latter and the faithful free-group action are verified in González-Meneses, *Basic results on braid groups*, AMBP18(2011),15–59, §§1.6 and4 (especially printed43–44). The first-turn bound40 is still credited to Baykur–Monden–Van Horn-Morris. No historical novelty is certified.\n+\n+The exact checker verifies the conjugation identities, centrality, permutation subgroups of order120, their different fixed vertices, and bounded stress cases of the linking classifications. The inequalities above prove the classifications without any bounded-integer assumption.\n+\n+The remaining substantive question modulo simultaneous conjugation is now confined to lengths20 and30. Their linking patterns are completely determined as above, but linking data is only a necessary invariant. Further work must establish actual equality in G and equivalence of factorizations, not infer either from those vectors or from a closed-surface theorem."},{"sha":"4f76ade522c279e75d57c7b9e24fc830ba4d4092","filename":"problems/11000151_artin_a5_quotient/TURN_2_CHECKS.json","status":"added","additions":23,"deletions":0,"changes":23,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_2_CHECKS.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_2_CHECKS.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FTURN_2_CHECKS.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,23 @@\n+{\n+  \"bounded_stress_solutions\": {\n+    \"20\": 6,\n+    \"30\": 1,\n+    \"40\": 6\n+  },\n+  \"different_fixed_vertices\": [\n+    6,\n+    1\n+  ],\n+  \"exact_assertions\": 53,\n+  \"necessary_linking_patterns\": {\n+    \"20\": 6,\n+    \"30\": 1,\n+    \"40\": 6\n+  },\n+  \"scope\": \"Exact conjugation, centrality and subgroup checks; linking classifications and all-length forty-letter slice are proved analytically. Simultaneous-conjugation classification at lengths20 and30 remains unresolved.\",\n+  \"status\": \"PASS\",\n+  \"subgroup_orders\": [\n+    120,\n+    120\n+  ]\n+}"},{"sha":"bf87ed708360ab17bd9f95bdfccaeaa28d821c8c","filename":"problems/11000151_artin_a5_quotient/TURN_2_MANIFEST.json","status":"added","additions":35,"deletions":0,"changes":35,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_2_MANIFEST.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_2_MANIFEST.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FTURN_2_MANIFEST.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,35 @@\n+{\n+  \"turn\": 2,\n+  \"files\": [\n+    {\n+      \"path\": \"TURN_2.md\",\n+      \"bytes\": 8051,\n+      \"sha256\": \"2a6cd830d78b45a99966c7dc422adc5ccab1450680a7eae1122846fc105b5707\"\n+    },\n+    {\n+      \"path\": \"check_turn_2.py\",\n+      \"bytes\": 2121,\n+      \"sha256\": \"a0385e57064caf3353007b20f374361720544dd7067590dd81d7b3b3d092f2a5\"\n+    },\n+    {\n+      \"path\": \"TURN_2_CHECKS.json\",\n+      \"bytes\": 523,\n+      \"sha256\": \"c9d13fdad802eeb0b370f247a9716472a9ce7ed81716bbb0116d8acfe0d141cd\"\n+    },\n+    {\n+      \"path\": \"STATE_T2.json\",\n+      \"bytes\": 348,\n+      \"sha256\": \"ef1df9c576c149cf773384fe447fa1c0d1ce4540834665d259d489a8d4929765\"\n+    },\n+    {\n+      \"path\": \"SOURCE_ADDITION_T2.json\",\n+      \"bytes\": 309,\n+      \"sha256\": \"113d7edceb9355709cb78214ea5c563888c6f5c9576dc15b7889ffdfc5f95745\"\n+    },\n+    {\n+      \"path\": \"TURN_1_MANIFEST.json\",\n+      \"bytes\": 952,\n+      \"sha256\": \"ff2b04d0bdedfa465641d6d59c0a1ea9147f7c76c9abaffee99ca65e46e24ce4\"\n+    }\n+  ]\n+}"},{"sha":"6181c5ca31b62f2d6730eb6b4f0ab8b482c471fa","filename":"problems/11000151_artin_a5_quotient/TURN_2_REMOTE_RECEIPT.json","status":"added","additions":78,"deletions":0,"changes":78,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_2_REMOTE_RECEIPT.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_2_REMOTE_RECEIPT.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FTURN_2_REMOTE_RECEIPT.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,78 @@\n+{\n+  \"commit\": \"87962a85c66ca2b3448f2fe54c526443b25e72f4\",\n+  \"branch\": \"math/11000151-artin-a5-quotient-wip\",\n+  \"files\": [\n+    {\n+      \"name\": \"SOURCE_ADDITION_T2.json\",\n+      \"sha\": \"62e06528fac4d0e5a37e19f76b530131c70a5fbe\",\n+      \"size\": 309\n+    },\n+    {\n+      \"name\": \"SOURCE_GATE.md\",\n+      \"sha\": \"30947fbc711606f212b9c28af932488673ca9430\",\n+      \"size\": 3215\n+    },\n+    {\n+      \"name\": \"SOURCE_MANIFEST.json\",\n+      \"sha\": \"8573be04e290fe1e3aea1b4a90dfe7fb1b2e3abd\",\n+      \"size\": 693\n+    },\n+    {\n+      \"name\": \"STATE.json\",\n+      \"sha\": \"25e90685189af0bb56ff47cbf0f79f5047d706cb\",\n+      \"size\": 304\n+    },\n+    {\n+      \"name\": \"STATE_T2.json\",\n+      \"sha\": \"698deba585d9d77c00a595fe66e846abbc49c73e\",\n+      \"size\": 348\n+    },\n+    {\n+      \"name\": \"TURN_1.md\",\n+      \"sha\": \"07c7379cf2103824140aef6fc5dc85f6fadd1448\",\n+      \"size\": 6650\n+    },\n+    {\n+      \"name\": \"TURN_1_CHECKS.json\",\n+      \"sha\": \"7f18c347a9c34398b923ab0dbeab01c48f84e231\",\n+      \"size\": 422\n+    },\n+    {\n+      \"name\": \"TURN_1_MANIFEST.json\",\n+      \"sha\": \"dbfd1f55091a25c1984c5da93ecc67bf3da9cbbd\",\n+      \"size\": 952\n+    },\n+    {\n+      \"name\": \"TURN_1_REMOTE_RECEIPT.json\",\n+      \"sha\": \"1f73f38968b3b154314c8bd48103d47e1fe4aae9\",\n+      \"size\": 1031\n+    },\n+    {\n+      \"name\": \"TURN_2.md\",\n+      \"sha\": \"1966f6c122c2349e8319818e15ee2fb4dc27cdca\",\n+      \"size\": 8051\n+    },\n+    {\n+      \"name\": \"TURN_2_CHECKS.json\",\n+      \"sha\": \"4f76ade522c279e75d57c7b9e24fc830ba4d4092\",\n+      \"size\": 523\n+    },\n+    {\n+      \"name\": \"TURN_2_MANIFEST.json\",\n+      \"sha\": \"bf87ed708360ab17bd9f95bdfccaeaa28d821c8c\",\n+      \"size\": 937\n+    },\n+    {\n+      \"name\": \"check_turn_1.py\",\n+      \"sha\": \"65d05c64a88b74317a506275611ae88167a18f84\",\n+      \"size\": 2957\n+    },\n+    {\n+      \"name\": \"check_turn_2.py\",\n+      \"sha\": \"05cce4b8113d97bcd765c4836f72b205f15a33c2\",\n+      \"size\": 2121\n+    }\n+  ],\n+  \"raw_bytes_exact\": true,\n+  \"queue_changed\": false\n+}"},{"sha":"5e414f40a7d3a9cd55bf1ebe8efd8c42f193a811","filename":"problems/11000151_artin_a5_quotient/TURN_3.md","status":"added","additions":65,"deletions":0,"changes":65,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_3.md","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_3.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FTURN_3.md?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,65 @@\n+# Turn 3: complete twenty-letter classification\n+\n+Original classification unresolved3/5. The twenty-letter case is now proved even under strict Hurwitz equivalence. No faithfulness of a representation of G is assumed, and no finite sample is extrapolated to longer words.\n+\n+## Theorem\n+\n+Every positive word of length20 that equals c² in G is one of the ten distinct cyclic rotations of h², as a literal word in the five Artin generators. All these factorizations are strictly Hurwitz equivalent to h². Here G,c,h have their exact source definitions from turns1–2.\n+\n+## 1. A complete finite reduction\n+\n+Turn2 proves that its pure-braid linking vector is twice a star centered at some labelled strand k. A positive word has no negative crossing cancellations. Thus no two strands other than k can cross; each other strand crosses k exactly four times. Those five noncentral strands keep their relative order throughout the braid diagram.\n+\n+It follows that the entire word is determined by the position of strand k. Starting at position k, it performs a nearest-neighbor walk on the six positions, returns to k, and crosses each of the five edges of that path exactly four times. Crossing edge i is precisely the generator a_i. Conversely every such walk gives a positive pure braid with the required star-linking vector. At a given edge the noncentral strand encountered is fixed by the order of the five other strands, so edge counts exactly record the five individual crossing counts.\n+\n+All walks have length20. A depth-first enumeration that tries each of the at most two adjacent positions, rejects an edge only once it has already been used four times, and retains a walk at length20 precisely when it returns to the start, is exhaustive. At length20 every edge count is automatically four because all five counts are at most four. There is no additional cap or pruning assumption.\n+\n+The counts are81,162,162,162,162,81 for the six starting positions, totaling810 distinct words. These are all the possible positive words of length20 that could represent the target. Necessary linking conditions alone do not declare them equal in G.\n+\n+## 2. An explicit quotient representation supplies a safe rejection test\n+\n+Let F4 be freely generated by x1,x2,x3,x4. We use right actions of automorphisms: x acted on by a word uv means first apply u, then v. Define A_i on the ordered generators by the following tuples, with integer j denoting x_j and−j denoting its inverse:\n+\n+    A1 = (1, 12, 13, 14)\n+    A2 = (1(-2)1, 1, 3, 4)\n+    A3 = (1, 2(-3)2, 2, 4)\n+    A4 = (1, 2, 3(-4)3, 3)\n+    A5 = (1, 2, 3, 3(-2)14).\n+\n+For clarity these are words, not numbers or matrix entries. The inverse tuples are\n+\n+    A1^-1 = (1, (-1)2, (-1)3, (-1)4)\n+    A2^-1 = (2, 2(-1)2, 3, 4)\n+    A3^-1 = (1, 3, 3(-2)3, 4)\n+    A4^-1 = (1, 2, 4, 4(-3)4)\n+    A5^-1 = (1, 2, 3, (-1)2(-3)4).\n+\n+Substitution followed by free reduction verifies both inverse compositions. It also verifies all adjacent braid relations, all distant commutations, and A_c A_h^−1=identity, in the right-action convention. These finitely many equalities of finite reduced words prove that a_i↦A_i defines an action of the presented group G. The complete tuples and every relation check appear in the standalone checker. The construction is motivated by the classical lifted braid action on a genus2 surface, but no geometric or injectivity assertion is required: the explicit presentation check is sufficient.\n+\n+Therefore any word equal to c² in G must have exactly the same four reduced images as c². Failure of this test conclusively rejects a word. Passing it alone would not prove equality, because the action is not asserted faithful.\n+\n+## 3. Exhaustive test and positive certificates for all survivors\n+\n+The checker constructs all810 words from §1 and applies the exact F4 test of §2 using only free reduction of integer-letter words. Precisely ten words pass. The retained set is checked for literal equality with\n+\n+    { cyclic rotations of h² }.\n+\n+All ten are stored in TURN_3_SURVIVORS.txt, and the full set hash is bound in the receipt. The candidate counts per center and retained counts(1,2,2,2,2,1) are also recorded. This computation is a finite proof obligation, not a probabilistic or bounded-prefix search. The reduction already covers every word in this source length class.\n+\n+Each survivor has an independent positive group certificate: h²=c²=z in G, where z is central. Moving an initial segment to the end conjugates a word's product, and conjugation fixes z. Consequently every cyclic rotation really does equal c² in G. The necessary representation test has therefore been supplemented by a sufficient certificate for every accepted case.\n+\n+## 4. Strict Hurwitz equivalence\n+\n+For a tuple(g1,...,gm) with central product z, successively applying inverse Hurwitz moves that move g1 to the right gives\n+\n+    (g2,...,gm,(g2...gm)^−1 g1(g2...gm)).\n+\n+Since g2...gm=g1^−1 z, the last factor equals z^−1 g1 z=g1. This realizes an ordinary cyclic rotation of the tuple by strict Hurwitz moves. Repeating connects all ten rotations of h².\n+\n+Together with §3, this proves the theorem. In particular, the twenty-letter slice consists of exactly one strict Hurwitz class, and hence one class after adding simultaneous conjugation.\n+\n+## 5. Verification limits and remaining work\n+\n+The standard-library checker includes the complete automorphism tables, inverse/relator checks, exhaustive walk recursion, all810 exact image comparisons and the survivor/rotation equality. It is short enough to inspect and independently reimplement. It does not rely on a group solver reporting an undecidable or timed-out word equality as false, and it does not assume the automorphism action faithful.\n+\n+The first two turns remain unchanged. The original intended modulo-global-conjugation question is reduced to the thirty-letter case. Its linking vector has every entry1, but unlike the star case it does not force a single moving strand. That finite-but-larger positive-braid class needs a new argument or a genuinely exhaustive certificate. The literal strict-only40-letter obstruction remains a separately qualified formulation observation."},{"sha":"8eb5757f6bdd89a97ab4b14ebae87204787885e9","filename":"problems/11000151_artin_a5_quotient/TURN_3_CHECKS.json","status":"added","additions":25,"deletions":0,"changes":25,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_3_CHECKS.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_3_CHECKS.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FTURN_3_CHECKS.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,25 @@\n+{\n+  \"all_survivors_cyclic_rotations_of_h_squared\": true,\n+  \"candidate_words\": 810,\n+  \"center_candidate_counts\": [\n+    81,\n+    162,\n+    162,\n+    162,\n+    162,\n+    81\n+  ],\n+  \"center_survivor_counts\": [\n+    1,\n+    2,\n+    2,\n+    2,\n+    2,\n+    1\n+  ],\n+  \"exact_assertions\": 852,\n+  \"scope\": \"Exhaustive under the proved star-linking reduction. Automorphism representation is used only as a necessary test; accepted words have direct central cyclic-rotation certificates in G. Thirty-letter classification remains unresolved.\",\n+  \"status\": \"PASS\",\n+  \"survivor_sha256\": \"4288f41ee220ebeb902514b301d701156d57ed6f7bfcbc2380be85af41325f52\",\n+  \"survivors\": 10\n+}"},{"sha":"40c7302168733ece2faa0a83e22b40906c43405e","filename":"problems/11000151_artin_a5_quotient/TURN_3_MANIFEST.json","status":"added","additions":35,"deletions":0,"changes":35,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_3_MANIFEST.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_3_MANIFEST.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FTURN_3_MANIFEST.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,35 @@\n+{\n+  \"turn\": 3,\n+  \"files\": [\n+    {\n+      \"path\": \"TURN_3.md\",\n+      \"bytes\": 6177,\n+      \"sha256\": \"98b7cf1fcfeb738af6b4d5faca0e990b6ed9f4cb58bc7492806879591e248a45\"\n+    },\n+    {\n+      \"path\": \"check_turn_3.py\",\n+      \"bytes\": 2685,\n+      \"sha256\": \"c6de7525ee866f4e384e36983f4ba17281b6d463bf1a9bb32fdc85966ad7a2bf\"\n+    },\n+    {\n+      \"path\": \"TURN_3_CHECKS.json\",\n+      \"bytes\": 649,\n+      \"sha256\": \"2eff1658244fda3eb2f16d64e42919e6b2e9f0cf6e53589377b7c600c2325cc6\"\n+    },\n+    {\n+      \"path\": \"TURN_3_SURVIVORS.txt\",\n+      \"bytes\": 210,\n+      \"sha256\": \"4288f41ee220ebeb902514b301d701156d57ed6f7bfcbc2380be85af41325f52\"\n+    },\n+    {\n+      \"path\": \"STATE_T3.json\",\n+      \"bytes\": 289,\n+      \"sha256\": \"e3706338ad0502b0d936a3ef060bd92c059f4c5c667409c6be8681195309fcc8\"\n+    },\n+    {\n+      \"path\": \"TURN_2_MANIFEST.json\",\n+      \"bytes\": 937,\n+      \"sha256\": \"62958ee7dc098774b049eab2e55a61c28208c7919bd2a0363ac4f0472ec204c6\"\n+    }\n+  ]\n+}"},{"sha":"42e78eabf6f1c68ddff8811bbcaa8c44a24bde6c","filename":"problems/11000151_artin_a5_quotient/TURN_3_REMOTE_RECEIPT.json","status":"added","additions":113,"deletions":0,"changes":113,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_3_REMOTE_RECEIPT.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_3_REMOTE_RECEIPT.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FTURN_3_REMOTE_RECEIPT.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,113 @@\n+{\n+  \"commit\": \"52d0f255942d882f60e1fc1a23256cff7f886431\",\n+  \"branch\": \"math/11000151-artin-a5-quotient-wip\",\n+  \"files\": [\n+    {\n+      \"name\": \"SOURCE_ADDITION_T2.json\",\n+      \"sha\": \"62e06528fac4d0e5a37e19f76b530131c70a5fbe\",\n+      \"size\": 309\n+    },\n+    {\n+      \"name\": \"SOURCE_GATE.md\",\n+      \"sha\": \"30947fbc711606f212b9c28af932488673ca9430\",\n+      \"size\": 3215\n+    },\n+    {\n+      \"name\": \"SOURCE_MANIFEST.json\",\n+      \"sha\": \"8573be04e290fe1e3aea1b4a90dfe7fb1b2e3abd\",\n+      \"size\": 693\n+    },\n+    {\n+      \"name\": \"STATE.json\",\n+      \"sha\": \"25e90685189af0bb56ff47cbf0f79f5047d706cb\",\n+      \"size\": 304\n+    },\n+    {\n+      \"name\": \"STATE_T2.json\",\n+      \"sha\": \"698deba585d9d77c00a595fe66e846abbc49c73e\",\n+      \"size\": 348\n+    },\n+    {\n+      \"name\": \"STATE_T3.json\",\n+      \"sha\": \"82f86aa71deaf0cb404e72bc419a42493cff9cf5\",\n+      \"size\": 289\n+    },\n+    {\n+      \"name\": \"TURN_1.md\",\n+      \"sha\": \"07c7379cf2103824140aef6fc5dc85f6fadd1448\",\n+      \"size\": 6650\n+    },\n+    {\n+      \"name\": \"TURN_1_CHECKS.json\",\n+      \"sha\": \"7f18c347a9c34398b923ab0dbeab01c48f84e231\",\n+      \"size\": 422\n+    },\n+    {\n+      \"name\": \"TURN_1_MANIFEST.json\",\n+      \"sha\": \"dbfd1f55091a25c1984c5da93ecc67bf3da9cbbd\",\n+      \"size\": 952\n+    },\n+    {\n+      \"name\": \"TURN_1_REMOTE_RECEIPT.json\",\n+      \"sha\": \"1f73f38968b3b154314c8bd48103d47e1fe4aae9\",\n+      \"size\": 1031\n+    },\n+    {\n+      \"name\": \"TURN_2.md\",\n+      \"sha\": \"1966f6c122c2349e8319818e15ee2fb4dc27cdca\",\n+      \"size\": 8051\n+    },\n+    {\n+      \"name\": \"TURN_2_CHECKS.json\",\n+      \"sha\": \"4f76ade522c279e75d57c7b9e24fc830ba4d4092\",\n+      \"size\": 523\n+    },\n+    {\n+      \"name\": \"TURN_2_MANIFEST.json\",\n+      \"sha\": \"bf87ed708360ab17bd9f95bdfccaeaa28d821c8c\",\n+      \"size\": 937\n+    },\n+    {\n+      \"name\": \"TURN_2_REMOTE_RECEIPT.json\",\n+      \"sha\": \"6181c5ca31b62f2d6730eb6b4f0ab8b482c471fa\",\n+      \"size\": 1900\n+    },\n+    {\n+      \"name\": \"TURN_3.md\",\n+      \"sha\": \"5e414f40a7d3a9cd55bf1ebe8efd8c42f193a811\",\n+      \"size\": 6177\n+    },\n+    {\n+      \"name\": \"TURN_3_CHECKS.json\",\n+      \"sha\": \"8eb5757f6bdd89a97ab4b14ebae87204787885e9\",\n+      \"size\": 649\n+    },\n+    {\n+      \"name\": \"TURN_3_MANIFEST.json\",\n+      \"sha\": \"40c7302168733ece2faa0a83e22b40906c43405e\",\n+      \"size\": 934\n+    },\n+    {\n+      \"name\": \"TURN_3_SURVIVORS.txt\",\n+      \"sha\": \"c553e8c7cae3f1eb89db12359fcbebe17ba9213d\",\n+      \"size\": 210\n+    },\n+    {\n+      \"name\": \"check_turn_1.py\",\n+      \"sha\": \"65d05c64a88b74317a506275611ae88167a18f84\",\n+      \"size\": 2957\n+    },\n+    {\n+      \"name\": \"check_turn_2.py\",\n+      \"sha\": \"05cce4b8113d97bcd765c4836f72b205f15a33c2\",\n+      \"size\": 2121\n+    },\n+    {\n+      \"name\": \"check_turn_3.py\",\n+      \"sha\": \"423c9be3095db25c5abaf9070c83e0956a24f464\",\n+      \"size\": 2685\n+    }\n+  ],\n+  \"raw_bytes_exact\": true,\n+  \"queue_changed\": false\n+}"},{"sha":"c553e8c7cae3f1eb89db12359fcbebe17ba9213d","filename":"problems/11000151_artin_a5_quotient/TURN_3_SURVIVORS.txt","status":"added","additions":10,"deletions":0,"changes":10,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_3_SURVIVORS.txt","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_3_SURVIVORS.txt","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FTURN_3_SURVIVORS.txt?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,10 @@\n+11234554321123455432\n+12345543211234554321\n+21123455432112345543\n+23455432112345543211\n+32112345543211234554\n+34554321123455432112\n+43211234554321123455\n+45543211234554321123\n+54321123455432112345\n+55432112345543211234"},{"sha":"1373307c999207ee932fb66fc09c7233951f0a6a","filename":"problems/11000151_artin_a5_quotient/TURN_4.md","status":"added","additions":87,"deletions":0,"changes":87,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_4.md","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_4.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FTURN_4.md?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,87 @@\n+# Turn 4: the thirty-letter case and the complete convention-qualified classification\n+\n+Four substantive author turns. Complete candidate for the original fixed-generator positive-word problem, pending full independent source/proof/computational review. Author search stops here; a fifth turn is not spent merely to reach a quota. No novelty certification.\n+\n+## 1. The remaining finite braid theorem\n+\n+**Six-strand theorem.** Every positive braid word on six strands in which every pair of labelled strands crosses exactly twice represents the full twist z=(a1a2a3a4a5)^6 in B6.\n+\n+This theorem is established by the exhaustive exact certificate below. We do not claim it for an arbitrary number of strands or infer it from experiments with fewer strands.\n+\n+Turn2 proves that a positive thirty-letter word representing c² in G has every pairwise pure linking number1. Positivity means every labelled pair therefore crosses exactly twice, so the six-strand theorem applies. Thus every such word equals z already in B6. The classical positive braid monoid embedding and the Hurwitz implementation of braid relations from turn2 imply that its factor tuple is strictly Hurwitz equivalent to the standard thirty-term tuple z. No faithfulness of G→Mod or G→Aut(F4) is needed for this step.\n+\n+## 2. A finite directed acyclic graph covers every candidate word\n+\n+Index the fifteen unordered pairs of labels{0,...,5} in lexicographic order. A crossing state has counts c_ij in{0,1,2}, encoded as\n+\n+    code(c)=sum_(i<j) c_ij*3^index(i,j).\n+\n+Retain also the ordered list p of strand labels at the six horizontal positions. Initially all counts are0 and p=(0,1,2,3,4,5). At position i, a positive generator interchanges the two currently adjacent labels a=p_i and b=p_(i+1). It increases c_ab by1 and leaves the other counts unchanged. The transition is allowed if and only if c_ab<2.\n+\n+This is a finite graph with at most3^15 count vectors. Along every edge the sum of the counts increases by1, so it is acyclic and has depth at most30. There is no imposed search-depth or state cap beyond these exact defining bounds.\n+\n+The permutation is determined by the parities of the pair counts: the relative order of two labels reverses precisely when their mutual crossing count is odd. Whenever a count vector is reachable, those relative comparisons determine its actual ordering uniquely. The implementation checks that any second path to a count vector gives the same permutation. Merging by the count vector therefore loses no available continuation.\n+\n+Let R be the set of all states reachable from the empty state. Breadth-first expansion explores every allowed edge from every discovered state until the queue is exhausted. It obtains234368 states and711342 outgoing edges. In particular the full vector f, whose fifteen counts are2, is reachable; its permutation is the identity. Every word in the six-strand theorem is a path from0 to f, and conversely every such path is a word of the required kind.\n+\n+## 3. Which reachable states can lead to the full state?\n+\n+A state c in R can continue to f if and only if f−c belongs to R.\n+\n+To prove necessity, take a suffix from the permutation at c to the final identity. Reverse its sequence of adjacent transpositions, keeping all generators positive. This starts at the identity and ends at the permutation at c; its labelled pair counts are2−c_ij. Thus f−c is reachable.\n+\n+Conversely, a path from the identity to the count vector f−c ends at the same permutation as c, because2−c has the same pair parities. Reverse its sequence of generators. Starting at that common permutation, it ends at the identity, crossing each labelled pair2−c_ij times. It is a permissible continuation after c, and no intermediate count exceeds2 because all added counts are nonnegative and their final values are exactly2−c_ij.\n+\n+Reversal here is reversal of the positive word, not its group inverse; it reverses the combinatorial trajectory of the adjacent swaps. The positive crossing counts and label pairs remain the required ones. This argument only identifies possible suffixes, not equalities of braid elements.\n+\n+Let S={c in R:f−c in R}. Every complete path lies in S, and every state in S is on some complete path. The exact computation obtains90921 states in S and261810 edges with both endpoints in S.\n+\n+## 4. An exact certificate of path-independent Artin action\n+\n+Let F6 have free generators x1,...,x6. Use the classical faithful Artin action, in the inverse-generator right-action convention\n+\n+    A_i(x_i)=x_i x_(i+1) x_i^−1,\n+    A_i(x_(i+1))=x_i,\n+    A_i(x_j)=x_j otherwise.\n+\n+For a word, substitute these automorphisms successively and freely reduce after each step. González-Meneses, *Basic results on braid groups*, §1.6, printed22–24, records the opposite generator convention and faithfulness. Inverting all braid generators and reversing the composition convention are bijections (an automorphism and an anti-automorphism of the braid group), so this convention still detects equality faithfully. The programs implement exactly the tuple action displayed above, including inverse letters inside free words. They do not use numerical matrices or hashes to decide equality.\n+\n+The breadth-first search records one canonical parent edge for each nonempty reachable state. For every state c in S its canonical parent is also in S: a prefix of a path reaching c can be followed by a completion from c. Define A(c) to be the exact six-tuple of reduced free words obtained along this canonical path.\n+\n+The certificate checks, for **every** edge c --i--> c' with endpoints in S,\n+\n+    apply_generator(A(c),i)=A(c')                              (1)\n+\n+as literal equality of all six freely reduced integer words. All261810 equalities hold. Starting with the identity at0, induction on path length now proves that every path in S from0 to c has action A(c), not just its canonical path. In particular all complete paths have action A(f).\n+\n+A separate direct computation of the standard positive word z=(a1a2a3a4a5)^6 gives exactly A(f). Faithfulness of the Artin action proves that every complete-path word equals z in B6. This proves the six-strand theorem and the thirty-letter classification.\n+\n+The argument does not assert that all reachable prefixes have the same braid for a given crossing vector. Only the coaccessible subgraph is used, and every edge in that subgraph is checked. No multiplicity of paths or unknown word equality is collapsed without the explicit comparisons(1).\n+\n+## 5. Reproduction and certificate identity\n+\n+Two separately implemented exact programs are supplied:\n+\n+- check_turn_4.py uses Python's standard library, explicit permutation tuples, dictionaries, free-word reduction and a complete reachable-state queue\n+- check_turn_4.cpp uses packed permutations, dense parent arrays, a vector queue and exact C++ integer-word reduction\n+\n+Both construct all reachable states and all coaccessible edges; neither has a cap. Both perform the exact action comparisons before any hashing. The C++ wrapper compiles with an installed C++17 compiler, streams all90921 coaccessible action records sorted by count code, and compares their SHA256 with the Python result:\n+\n+    af2b8ec569d613e4f3d8ba3b72d18e85e8c612f4265057b7f4c485d544d159bf.\n+\n+A record contains the count code, packed permutation and all six full reduced words. The full stream is regenerable with the C++ --stream option but is not retained as a large artifact. The digest is an integrity cross-check, not a replacement for exact free-word comparisons. The Python and C++ receipts record the same census and final result.\n+\n+## 6. Assemble all four turns and state both conventions\n+\n+The quantified objects are **positive words in the five fixed standard Artin generators a1,...,a5 of the source's quotient**. This is not a classification of arbitrary quasipositive factorizations into conjugates, arbitrary positive Dehn twists, or unframed Lefschetz fibrations without that restriction. Hurwitz moves may introduce conjugate factors as intermediate tuples; the initial word restriction is exactly what permits the crossing arguments.\n+\n+Turn1 proves the exact possible lengths20,30,40, using the credited topological maximum40 plus the linking obstruction to0/10. Turn3 gives one strict Hurwitz class at length20, represented by h². The present turn gives one strict class at length30, represented by z. Turn2 gives exactly two strict classes at length40, represented by c² and (a2a3a4a5)^10. Their different generated S5 subgroups in the permutation quotient prove they cannot be strictly Hurwitz equivalent. Simultaneous conjugation by a1a2a3a4a5 identifies the two forty-term classes.\n+\n+Therefore the complete classification is:\n+\n+- under strict Hurwitz moves alone: **four classes**, one at20, one at30 and two at40; the source's single40-class clause is false under this convention\n+- under Hurwitz moves plus simultaneous conjugation: **exactly three classes**, represented by h²,z,c²; the proposed list is affirmative under this convention\n+\n+The source's own brief use of Hurwitz equivalence is not treated as an unequivocal choice between those conventions. Instead both are resolved, avoiding a purely terminological promotion. The remaining unrestricted geometric classifications are outside the stated fixed-generator result.\n+\n+All classical ingredients are credited. The finite certificate and the full source interpretation require separate independent review before publication or a complete-result announcement. No fifth author search is undertaken after this freeze."},{"sha":"a3f47c23d4276f5d92c31c6fa31b6771cc3e9828","filename":"problems/11000151_artin_a5_quotient/TURN_4_CHECKS.json","status":"added","additions":12,"deletions":0,"changes":12,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_4_CHECKS.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_4_CHECKS.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FTURN_4_CHECKS.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,12 @@\n+{\n+  \"canonical_action_stream_sha256\": \"af2b8ec569d613e4f3d8ba3b72d18e85e8c612f4265057b7f4c485d544d159bf\",\n+  \"coaccessible_edges\": 261810,\n+  \"coaccessible_states\": 90921,\n+  \"exact_Artin_action_edge_equalities\": 261810,\n+  \"outgoing_edges\": 711342,\n+  \"reachable_states\": 234368,\n+  \"scope\": \"Exhaustive all positive six-strand words with every labelled pair crossing exactly twice. Faithful Artin action gives equality to the full twist; no quotient faithfulness or finite-prefix extrapolation.\",\n+  \"status\": \"PASS\",\n+  \"strands\": 6,\n+  \"terminal_full_twist_action_equal\": true\n+}"},{"sha":"82714d17d0bd0a5b091e3f85883030651fcd7f8d","filename":"problems/11000151_artin_a5_quotient/TURN_4_CPP_CHECKS.json","status":"added","additions":14,"deletions":0,"changes":14,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_4_CPP_CHECKS.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_4_CPP_CHECKS.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FTURN_4_CPP_CHECKS.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,14 @@\n+{\n+  \"Cplusplus_counts\": {\n+    \"coaccessible_edges\": 261810,\n+    \"coaccessible_states\": 90921,\n+    \"outgoing_edges\": 711342,\n+    \"reachable_states\": 234368,\n+    \"status\": \"PASS\"\n+  },\n+  \"all_actions_compared_exactly_before_hashing\": true,\n+  \"canonical_action_stream_sha256\": \"af2b8ec569d613e4f3d8ba3b72d18e85e8c612f4265057b7f4c485d544d159bf\",\n+  \"scope\": \"A second exact implementation, not a replacement for the completeness proof or independent mathematical review.\",\n+  \"status\": \"PASS\",\n+  \"stream_states\": 90921\n+}"},{"sha":"ffa0c5a375cb7d384ccfb117a550aa80407ae781","filename":"problems/11000151_artin_a5_quotient/TURN_4_MANIFEST.json","status":"added","additions":45,"deletions":0,"changes":45,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_4_MANIFEST.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2FTURN_4_MANIFEST.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2FTURN_4_MANIFEST.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,45 @@\n+{\n+  \"turn\": 4,\n+  \"files\": [\n+    {\n+      \"path\": \"TURN_4.md\",\n+      \"bytes\": 9579,\n+      \"sha256\": \"90a46e0ba1aee642bd5faedfbb89c94c316d128b46b24e297e355050fabb0cf5\"\n+    },\n+    {\n+      \"path\": \"check_turn_4.py\",\n+      \"bytes\": 2665,\n+      \"sha256\": \"37adab4df9e3efa67ef934b5c0006957de7ded4001b3eb8bdcd555c26b55f17e\"\n+    },\n+    {\n+      \"path\": \"check_turn_4.cpp\",\n+      \"bytes\": 5114,\n+      \"sha256\": \"7ca50a2a0804b592b741f2fc04e3a2178101eabcf8a23aa262cdabd95e110843\"\n+    },\n+    {\n+      \"path\": \"verify_turn_4_cpp.py\",\n+      \"bytes\": 1213,\n+      \"sha256\": \"b8e1f2e6ca69699cccbfc353bd1361c15d9f0faf2fa56905ed3ea85f71cc7243\"\n+    },\n+    {\n+      \"path\": \"TURN_4_CHECKS.json\",\n+      \"bytes\": 574,\n+      \"sha256\": \"d541bfc16409de3b4c4e171e590c809aca6456a164a5a4a7dcb5680185c0820b\"\n+    },\n+    {\n+      \"path\": \"TURN_4_CPP_CHECKS.json\",\n+      \"bytes\": 514,\n+      \"sha256\": \"661ef52ff67574e217c270b60ddededdd76799c8904e49e31006d4b25918fd54\"\n+    },\n+    {\n+      \"path\": \"STATE_T4.json\",\n+      \"bytes\": 322,\n+      \"sha256\": \"ff01c15861739c4df8fe00c43c440905f0ad33944904e1c31345bc66b2846654\"\n+    },\n+    {\n+      \"path\": \"TURN_3_MANIFEST.json\",\n+      \"bytes\": 934,\n+      \"sha256\": \"3c51a31e336be139fa8087a44392b567a48dd101eb601fe76ab9c46b0c1f8162\"\n+    }\n+  ]\n+}"},{"sha":"65d05c64a88b74317a506275611ae88167a18f84","filename":"problems/11000151_artin_a5_quotient/check_turn_1.py","status":"added","additions":66,"deletions":0,"changes":66,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Fcheck_turn_1.py","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Fcheck_turn_1.py","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2Fcheck_turn_1.py?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,66 @@\n+#!/usr/bin/env python3\n+\"\"\"Exact finite controls for the length theorem; topological upper bound is cited.\"\"\"\n+from itertools import combinations,product\n+from fractions import Fraction as F\n+import json\n+n=0\n+def ck(x):\n+ global n\n+ assert x;n+=1\n+pairs=list(combinations(range(6),2));pairidx={p:i for i,p in enumerate(pairs)}\n+def inverse(w):return tuple(-a for a in w[::-1])\n+def trace(w):\n+ pos=list(range(6));counts=[0]*15\n+ for a in w:\n+  i=abs(a)-1;p=tuple(sorted((pos[i],pos[i+1])));counts[pairidx[p]]+=1 if a>0 else -1;pos[i],pos[i+1]=pos[i+1],pos[i]\n+ return tuple(pos),tuple(counts)\n+def linking(w):\n+ p,c=trace(w);ck(p==tuple(range(6)));ck(all(x%2==0 for x in c));return tuple(x//2 for x in c)\n+c=(1,2,3,4)*5;h=(5,4,3,2,1,1,2,3,4,5);z=(1,2,3,4,5)*6;r=c+inverse(h);target=c+c\n+lc=linking(c);lh=linking(h);lr=linking(r);lb=linking(target)\n+for k,(i,j)in enumerate(pairs):\n+ ck(lc[k]==int(j<5));ck(lh[k]==int(j==5));ck(lr[k]==(1 if j<5 else -1));ck(lb[k]==2*int(j<5))\n+# Faithful Artin action on F6, exact freely reduced words.\n+def reduce(w):\n+ out=[]\n+ for a in w:\n+  if out and out[-1]==-a:out.pop()\n+  else:out.append(a)\n+ return tuple(out)\n+def substitute(w,images):\n+ return reduce(a for x in w for a in (images[x-1]if x>0 else inverse(images[-x-1])))\n+def action(w):\n+ im=[(j,)for j in range(1,7)]\n+ for a in w:\n+  i=abs(a);g=[(j,)for j in range(1,7)]\n+  if a>0:g[i-1]=(i,i+1,-i);g[i]=(i,)\n+  else:g[i-1]=(i+1,);g[i]=(-(i+1),i,i+1)\n+  im=[substitute(x,g)for x in im]\n+ return im\n+ck(action(c+h)==action(z))\n+for i in range(1,6):\n+ ck(action((i,-i))==action(()))\n+ if i<5:ck(action((i,i+1,i))==action((i+1,i,i+1)))\n+ for j in range(i+2,6):ck(action((i,j))==action((j,i)))\n+# The conjugation orbit of r's linking vector consists of the six vertex patterns.\n+patterns={tuple(1 if k not in pair else -1 for pair in pairs) for k in range(6)}\n+conjugators=[(),(5,),(4,5),(3,4,5),(2,3,4,5),(1,2,3,4,5)]\n+observed={linking(b+r+inverse(b))for b in conjugators};ck(observed==patterns)\n+for v in patterns:ck(sum(v)==5)\n+ck(len(c+c)==40 and len(z)==30 and len(h+h)==20)\n+# Exact summed inequalities, valid without a bound on t_i.\n+for m in [0,10]:\n+ T=F(m,10)-4;ck(T.denominator==1);T=int(T)\n+ ck((T+2)//2==-1 and T//2==-2)\n+ lower=-((-5*T-10)//4) # ceil((5T+10)/4)\n+ ck(lower>-3)\n+# Bounded stress controls of the necessary inequalities, not the infinite proof.\n+stress=0\n+for first in product(range(-3,4),repeat=5):\n+ s=sum(first)\n+ if not all(first[i]+first[j]<=-1 for i,j in combinations(range(5),2)):continue\n+ ck(s<=-3)\n+ for T in [-4,-3]:\n+  t6=T-s\n+  ck(not all(x+t6<=-2 for x in first));stress+=1\n+print(json.dumps({'status':'PASS','exact_assertions':n,'linking_coordinates':15,'relation_conjugate_patterns':6,'bounded_integer_stress_cases':stress,'realized_lengths':[20,30,40],'scope':'Exact braid identities/linking and integer obstruction controls. The universal upper bound40 is the credited Baykur–Monden–Van Horn-Morris theorem; Hurwitz classification remains open here.'},indent=2,sort_keys=True))"},{"sha":"05cce4b8113d97bcd765c4836f72b205f15a33c2","filename":"problems/11000151_artin_a5_quotient/check_turn_2.py","status":"added","additions":36,"deletions":0,"changes":36,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Fcheck_turn_2.py","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Fcheck_turn_2.py","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2Fcheck_turn_2.py?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,36 @@\n+#!/usr/bin/env python3\n+from pathlib import Path\n+import runpy,io,contextlib,itertools,json\n+with contextlib.redirect_stdout(io.StringIO()):D=runpy.run_path(str(Path(__file__).with_name('check_turn_1.py')))\n+action=D['action'];inverse=D['inverse'];pairs=D['pairs'];n=0\n+def ck(x):\n+ global n\n+ assert x;n+=1\n+c=(1,2,3,4)*5;z=(1,2,3,4,5)*6;d=(1,2,3,4,5);w=(2,3,4,5)*10\n+for i in range(1,5):ck(action(d+(i,)+inverse(d))==action((i+1,)))\n+for i in range(1,6):ck(action(z+(i,))==action((i,)+z))\n+ck(action(d+c+c+inverse(d))==action(w))\n+def perm(i):\n+ p=list(range(6));p[i-1],p[i]=p[i],p[i-1];return tuple(p)\n+def compose(p,q):return tuple(p[q[i]]for i in range(6))\n+def closure(gs):\n+ e=tuple(range(6));out={e};queue=[e]\n+ for p in queue:\n+  for g in gs:\n+   q=compose(p,g)\n+   if q not in out:out.add(q);queue.append(q)\n+ return out\n+A=closure([perm(i)for i in range(1,5)]);B=closure([perm(i)for i in range(2,6)])\n+ck(len(A)==len(B)==120);ck(A!=B);ck(all(p[5]==5 for p in A));ck(all(p[0]==0 for p in B));ck(perm(1)in A and perm(1)not in B);ck(perm(5)in B and perm(5)not in A)\n+expected={20:{tuple(2*int(k in ij)for ij in pairs)for k in range(6)},30:{(1,)*15},40:{tuple(2*int(k not in ij)for ij in pairs)for k in range(6)}}\n+found={m:set()for m in expected};solutions={m:0 for m in expected}\n+for t in itertools.product(range(-3,4),repeat=6):\n+ T=sum(t);m=10*(T+4)\n+ if m not in expected:continue\n+ L=tuple(2*int(j<5)+T-2*(t[i]+t[j])for i,j in pairs)\n+ if min(L)<0:continue\n+ ck(L in expected[m]);ck(sum(L)*2==m);found[m].add(L);solutions[m]+=1\n+for m in expected:ck(found[m]==expected[m])\n+for k in range(1,5):\n+ left=0;right=5;ck(left<k<right);ck(2*int(k not in (left,right))==2)\n+print(json.dumps({'status':'PASS','exact_assertions':n,'subgroup_orders':[len(A),len(B)],'different_fixed_vertices':[6,1],'necessary_linking_patterns':{m:len(v)for m,v in expected.items()},'bounded_stress_solutions':solutions,'scope':'Exact conjugation, centrality and subgroup checks; linking classifications and all-length forty-letter slice are proved analytically. Simultaneous-conjugation classification at lengths20 and30 remains unresolved.'},indent=2,sort_keys=True))"},{"sha":"423c9be3095db25c5abaf9070c83e0956a24f464","filename":"problems/11000151_artin_a5_quotient/check_turn_3.py","status":"added","additions":57,"deletions":0,"changes":57,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Fcheck_turn_3.py","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Fcheck_turn_3.py","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2Fcheck_turn_3.py?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,57 @@\n+#!/usr/bin/env python3\n+\"\"\"Exhaustive20-letter certificate; no search cap, no faithfulness assumption.\"\"\"\n+import json,hashlib\n+from pathlib import Path\n+n=0\n+def ck(x):\n+ global n\n+ assert x;n+=1\n+def inv(w):return tuple(-a for a in w[::-1])\n+def red(w):\n+ out=[]\n+ for a in w:\n+  if out and out[-1]==-a:out.pop()\n+  else:out.append(a)\n+ return tuple(out)\n+def subst(w,im):return red(a for x in w for a in(im[x-1]if x>0 else inv(im[-x-1])))\n+I=((1,),(2,),(3,),(4,))\n+A={1:((1,),(1,2),(1,3),(1,4)),2:((1,-2,1),(1,),(3,),(4,)),3:((1,),(2,-3,2),(2,),(4,)),4:((1,),(2,),(3,-4,3),(3,)),5:((1,),(2,),(3,),(3,-2,1,4)),-1:((1,),(-1,2),(-1,3),(-1,4)),-2:((2,),(2,-1,2),(3,),(4,)),-3:((1,),(3,),(3,-2,3),(4,)),-4:((1,),(2,),(4,),(4,-3,4)),-5:((1,),(2,),(3,),(-1,2,-3,4))}\n+def act(w):\n+ im=I\n+ for a in w:im=tuple(subst(x,A[a])for x in im)\n+ return im\n+for i in range(1,6):\n+ ck(act((i,-i))==I);ck(act((-i,i))==I)\n+ if i<5:ck(act((i,i+1,i))==act((i+1,i,i+1)))\n+ for j in range(i+2,6):ck(act((i,j))==act((j,i)))\n+c=(1,2,3,4)*5;h=(5,4,3,2,1,1,2,3,4,5);ck(act(c+inv(h))==I)\n+target=act(c+c);ck(target==act(h+h))\n+# The positive central-strand word is exactly its nearest-neighbour position walk.\n+def words(k):\n+ def visit(pos,counts,w):\n+  if len(w)==20:\n+   if pos==k:yield w\n+   return\n+  for q in(pos-1,pos+1):\n+   if 0<=q<6:\n+    e=min(pos,q)\n+    if counts[e]<4:\n+     new=list(counts);new[e]+=1;yield from visit(q,tuple(new),w+(e+1,))\n+ yield from visit(k,(0,)*5,())\n+allwords=set();accepted=set();counts=[];kept=[]\n+for k in range(6):\n+ ws=list(words(k));ck(len(ws)==(81 if k in(0,5)else 162));counts.append(len(ws));matches=[]\n+ for w in ws:\n+  ck(len(w)==20 and all(w.count(i)==4 for i in range(1,6)))\n+  allwords.add(w)\n+  if act(w)==target:accepted.add(w);matches.append(w)\n+ kept.append(len(matches))\n+ck(len(allwords)==810);ck(len(accepted)==10)\n+rotations={(h+h)[i:]+(h+h)[:i]for i in range(20)}\n+ck(accepted==rotations)\n+for w in rotations:ck(act(w)==target)\n+stream='\\n'.join(''.join(map(str,w))for w in sorted(accepted))+'\\n'\n+p=Path(__file__).with_name('TURN_3_SURVIVORS.txt')\n+if p.exists():ck(p.read_bytes()==stream.encode())\n+else:p.write_bytes(stream.encode());ck(True)\n+print(json.dumps({'status':'PASS','exact_assertions':n,'center_candidate_counts':counts,'center_survivor_counts':kept,'candidate_words':len(allwords),'survivors':len(accepted),'survivor_sha256':hashlib.sha256(stream.encode()).hexdigest(),'all_survivors_cyclic_rotations_of_h_squared':True,'scope':'Exhaustive under the proved star-linking reduction. Automorphism representation is used only as a necessary test; accepted words have direct central cyclic-rotation certificates in G. Thirty-letter classification remains unresolved.'},indent=2,sort_keys=True))"},{"sha":"37d737d0dc2fef60dca68f8da3d1062d6f1c9029","filename":"problems/11000151_artin_a5_quotient/check_turn_4.cpp","status":"added","additions":123,"deletions":0,"changes":123,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Fcheck_turn_4.cpp","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Fcheck_turn_4.cpp","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2Fcheck_turn_4.cpp?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,123 @@\n+// Exact finite Artin-action certificate. C++17; no state/depth cap.\n+#include <array>\n+#include <iostream>\n+#include <string>\n+#include <unordered_map>\n+#include <vector>\n+#include <stdexcept>\n+using Word = std::vector<int>;\n+using Aut = std::array<Word, 6>;\n+static void append_reduced(Word& w, int x) {\n+    if (!w.empty() && w.back() == -x) w.pop_back();\n+    else w.push_back(x);\n+}\n+static Aut act_generator(const Aut& input, int g) {\n+    Aut output;\n+    for (int k = 0; k < 6; ++k) {\n+        for (int x : input[k]) {\n+            const int v = x > 0 ? x : -x;\n+            if (v == g) {\n+                append_reduced(output[k], g);\n+                append_reduced(output[k], x > 0 ? g + 1 : -g - 1);\n+                append_reduced(output[k], -g);\n+            } else if (v == g + 1) {\n+                append_reduced(output[k], x > 0 ? g : -g);\n+            } else append_reduced(output[k], x);\n+        }\n+    }\n+    return output;\n+}\n+static void require(bool condition, const char* message) {\n+    if (!condition) throw std::runtime_error(message);\n+}\n+int main(int argc, char** argv) {\n+    const bool stream = argc == 2 && std::string(argv[1]) == \"--stream\";\n+    require(argc == 1 || stream, \"Only --stream is supported\");\n+    int pair_index[6][6], pair_count = 0;\n+    for (int i = 0; i < 6; ++i)\n+        for (int j = i + 1; j < 6; ++j)\n+            pair_index[i][j] = pair_index[j][i] = pair_count++;\n+    std::vector<int> power(16, 1);\n+    for (int i = 1; i <= 15; ++i) power[i] = 3 * power[i - 1];\n+    const int count = power[15], full = count - 1;\n+    // -2 means unreached; the empty-state parent is -1.\n+    std::vector<int> parent(count, -2), permutation(count);\n+    std::vector<unsigned char> last_generator(count);\n+    std::vector<int> queue;\n+    parent[0] = -1;\n+    for (int i = 0; i < 6; ++i) permutation[0] |= i << (3 * i);\n+    queue.push_back(0);\n+    long long edges = 0;\n+    for (std::size_t head = 0; head < queue.size(); ++head) {\n+        const int code = queue[head], perm = permutation[code];\n+        for (int i = 0; i < 5; ++i) {\n+            const int a = (perm >> (3 * i)) & 7;\n+            const int b = (perm >> (3 * (i + 1))) & 7;\n+            const int step = power[pair_index[a][b]];\n+            if (code / step % 3 == 2) continue;\n+            ++edges;\n+            const int next = code + step;\n+            const int np = perm ^ ((a ^ b) << (3 * i)) ^ ((a ^ b) << (3 * (i + 1)));\n+            if (parent[next] == -2) {\n+                parent[next] = code;\n+                permutation[next] = np;\n+                last_generator[next] = i + 1;\n+                queue.push_back(next);\n+            } else require(permutation[next] == np, \"Parity/permutation inconsistency\");\n+        }\n+    }\n+    auto good = [&](int code) { return parent[code] != -2 && parent[full - code] != -2; };\n+    Aut identity;\n+    for (int i = 0; i < 6; ++i) identity[i] = {i + 1};\n+    std::unordered_map<int, Aut> images;\n+    images.reserve(100000);\n+    images.emplace(0, identity);\n+    for (int code : queue) {\n+        if (!code || !good(code)) continue;\n+        auto it = images.find(parent[code]);\n+        require(it != images.end(), \"Canonical parent is not coaccessible\");\n+        images.emplace(code, act_generator(it->second, last_generator[code]));\n+    }\n+    long long comparisons = 0;\n+    for (int code : queue) {\n+        if (!good(code)) continue;\n+        const int perm = permutation[code];\n+        for (int i = 0; i < 5; ++i) {\n+            const int a = (perm >> (3 * i)) & 7;\n+            const int b = (perm >> (3 * (i + 1))) & 7;\n+            const int step = power[pair_index[a][b]];\n+            if (code / step % 3 == 2) continue;\n+            const int next = code + step;\n+            if (!good(next)) continue;\n+            require(act_generator(images.at(code), i + 1) == images.at(next),\n+                    \"Different free-group actions on paths to one state\");\n+            ++comparisons;\n+        }\n+    }\n+    Aut standard = identity;\n+    for (int repetition = 0; repetition < 6; ++repetition)\n+        for (int g = 1; g <= 5; ++g) standard = act_generator(standard, g);\n+    require(images.at(full) == standard, \"Terminal action is not full twist\");\n+    require(queue.size() == 234368 && edges == 711342, \"Reachable census mismatch\");\n+    require(images.size() == 90921 && comparisons == 261810, \"Coaccessible census mismatch\");\n+    if (stream) {\n+        for (int code = 0; code < count; ++code) {\n+            if (!good(code)) continue;\n+            std::cout << \"S|\" << code << '|' << permutation[code];\n+            for (const auto& word : images.at(code)) {\n+                std::cout << '|';\n+                bool first = true;\n+                for (int x : word) {\n+                    if (!first) std::cout << ',';\n+                    first = false;\n+                    std::cout << x;\n+                }\n+            }\n+            std::cout << '\\n';\n+        }\n+    }\n+    std::cout << \"{\\\"status\\\":\\\"PASS\\\",\\\"reachable_states\\\":\" << queue.size()\n+              << \",\\\"outgoing_edges\\\":\" << edges\n+              << \",\\\"coaccessible_states\\\":\" << images.size()\n+              << \",\\\"coaccessible_edges\\\":\" << comparisons << \"}\\n\";\n+}"},{"sha":"dc341ad7f0a3392db874a51e8e652c885675b676","filename":"problems/11000151_artin_a5_quotient/check_turn_4.py","status":"added","additions":59,"deletions":0,"changes":59,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Fcheck_turn_4.py","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Fcheck_turn_4.py","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2Fcheck_turn_4.py?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,59 @@\n+#!/usr/bin/env python3\n+\"\"\"Complete finite B6 certificate, using only exact integers and free words.\n+No cap. The generated state stream is hashed incrementally, not retained.\n+\"\"\"\n+from itertools import combinations\n+from collections import deque\n+import hashlib,json\n+N=6\n+pairs=list(combinations(range(N),2));index={p:i for i,p in enumerate(pairs)}\n+power=[3**i for i in range(len(pairs))];full=3**len(pairs)-1\n+identity_perm=tuple(range(N));records={0:(identity_perm,-1,0)};queue=[0];edges=0\n+for code in queue:\n+ perm,_,_=records[code]\n+ for i in range(N-1):\n+  j=index[tuple(sorted((perm[i],perm[i+1])))];step=power[j]\n+  if code//step%3==2:continue\n+  edges+=1;nc=code+step;np=list(perm);np[i],np[i+1]=np[i+1],np[i];np=tuple(np)\n+  if nc not in records:records[nc]=(np,code,i+1);queue.append(nc)\n+  else:assert records[nc][0]==np\n+co={code for code in records if full-code in records}\n+identity=tuple((i,)for i in range(1,N+1))\n+def actgen(images,g):\n+ out=[]\n+ for word in images:\n+  w=[]\n+  for x in word:\n+   if abs(x)==g:part=(g,g+1,-g)if x>0 else(g,-g-1,-g)\n+   elif abs(x)==g+1:part=(g,)if x>0 else(-g,)\n+   else:part=(x,)\n+   for y in part:\n+    if w and w[-1]==-y:w.pop()\n+    else:w.append(y)\n+  out.append(tuple(w))\n+ return tuple(out)\n+images={0:identity}\n+for code in queue:\n+ if code and code in co:\n+  perm,parent,g=records[code];assert parent in images;images[code]=actgen(images[parent],g)\n+comparisons=0\n+for code in queue:\n+ if code not in co:continue\n+ perm,_,_=records[code]\n+ for i in range(N-1):\n+  j=index[tuple(sorted((perm[i],perm[i+1])))];step=power[j]\n+  if code//step%3==2:continue\n+  nc=code+step\n+  if nc not in co:continue\n+  assert actgen(images[code],i+1)==images[nc];comparisons+=1\n+standard=identity\n+for _ in range(N):\n+ for i in range(1,N):standard=actgen(standard,i)\n+assert images[full]==standard\n+assert len(records)==234368 and edges==711342 and len(co)==90921 and comparisons==261810\n+sha=hashlib.sha256()\n+for code in sorted(co):\n+ perm=records[code][0];packed=sum(a<<(3*i)for i,a in enumerate(perm))\n+ line='S|'+str(code)+'|'+str(packed)+'|'+('|'.join(','.join(map(str,w))for w in images[code]))+'\\n'\n+ sha.update(line.encode())\n+print(json.dumps({'status':'PASS','strands':N,'reachable_states':len(records),'outgoing_edges':edges,'coaccessible_states':len(co),'coaccessible_edges':comparisons,'exact_Artin_action_edge_equalities':comparisons,'terminal_full_twist_action_equal':True,'canonical_action_stream_sha256':sha.hexdigest(),'scope':'Exhaustive all positive six-strand words with every labelled pair crossing exactly twice. Faithful Artin action gives equality to the full twist; no quotient faithfulness or finite-prefix extrapolation.'},indent=2,sort_keys=True))"},{"sha":"0dfccd6035d4814e7f73cee9f47d18d8a2bbb87c","filename":"problems/11000151_artin_a5_quotient/review/AUTHOR_REPLAY.json","status":"added","additions":94,"deletions":0,"changes":94,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Freview%2FAUTHOR_REPLAY.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Freview%2FAUTHOR_REPLAY.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2Freview%2FAUTHOR_REPLAY.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,94 @@\n+{\n+  \"status\": \"PASS\",\n+  \"author_manifest_sha256\": \"dc4840da287b2d44fab7fa0eea0a66a2f617b98e6f953a76dd917dd7adcbafac\",\n+  \"bound_files\": 33,\n+  \"python_replays\": [\n+    {\n+      \"bounded_integer_stress_cases\": 1466,\n+      \"exact_assertions\": 2309,\n+      \"linking_coordinates\": 15,\n+      \"realized_lengths\": [\n+        20,\n+        30,\n+        40\n+      ],\n+      \"relation_conjugate_patterns\": 6,\n+      \"scope\": \"Exact braid identities/linking and integer obstruction controls. The universal upper bound40 is the credited Baykur\\u2013Monden\\u2013Van Horn-Morris theorem; Hurwitz classification remains open here.\",\n+      \"status\": \"PASS\"\n+    },\n+    {\n+      \"bounded_stress_solutions\": {\n+        \"20\": 6,\n+        \"30\": 1,\n+        \"40\": 6\n+      },\n+      \"different_fixed_vertices\": [\n+        6,\n+        1\n+      ],\n+      \"exact_assertions\": 53,\n+      \"necessary_linking_patterns\": {\n+        \"20\": 6,\n+        \"30\": 1,\n+        \"40\": 6\n+      },\n+      \"scope\": \"Exact conjugation, centrality and subgroup checks; linking classifications and all-length forty-letter slice are proved analytically. Simultaneous-conjugation classification at lengths20 and30 remains unresolved.\",\n+      \"status\": \"PASS\",\n+      \"subgroup_orders\": [\n+        120,\n+        120\n+      ]\n+    },\n+    {\n+      \"all_survivors_cyclic_rotations_of_h_squared\": true,\n+      \"candidate_words\": 810,\n+      \"center_candidate_counts\": [\n+        81,\n+        162,\n+        162,\n+        162,\n+        162,\n+        81\n+      ],\n+      \"center_survivor_counts\": [\n+        1,\n+        2,\n+        2,\n+        2,\n+        2,\n+        1\n+      ],\n+      \"exact_assertions\": 852,\n+      \"scope\": \"Exhaustive under the proved star-linking reduction. Automorphism representation is used only as a necessary test; accepted words have direct central cyclic-rotation certificates in G. Thirty-letter classification remains unresolved.\",\n+      \"status\": \"PASS\",\n+      \"survivor_sha256\": \"4288f41ee220ebeb902514b301d701156d57ed6f7bfcbc2380be85af41325f52\",\n+      \"survivors\": 10\n+    },\n+    {\n+      \"canonical_action_stream_sha256\": \"af2b8ec569d613e4f3d8ba3b72d18e85e8c612f4265057b7f4c485d544d159bf\",\n+      \"coaccessible_edges\": 261810,\n+      \"coaccessible_states\": 90921,\n+      \"exact_Artin_action_edge_equalities\": 261810,\n+      \"outgoing_edges\": 711342,\n+      \"reachable_states\": 234368,\n+      \"scope\": \"Exhaustive all positive six-strand words with every labelled pair crossing exactly twice. Faithful Artin action gives equality to the full twist; no quotient faithfulness or finite-prefix extrapolation.\",\n+      \"status\": \"PASS\",\n+      \"strands\": 6,\n+      \"terminal_full_twist_action_equal\": true\n+    }\n+  ],\n+  \"cpp_replay\": {\n+    \"Cplusplus_counts\": {\n+      \"coaccessible_edges\": 261810,\n+      \"coaccessible_states\": 90921,\n+      \"outgoing_edges\": 711342,\n+      \"reachable_states\": 234368,\n+      \"status\": \"PASS\"\n+    },\n+    \"all_actions_compared_exactly_before_hashing\": true,\n+    \"canonical_action_stream_sha256\": \"af2b8ec569d613e4f3d8ba3b72d18e85e8c612f4265057b7f4c485d544d159bf\",\n+    \"scope\": \"A second exact implementation, not a replacement for the completeness proof or independent mathematical review.\",\n+    \"status\": \"PASS\",\n+    \"stream_states\": 90921\n+  }\n+}"},{"sha":"50cc72522d4c194b129de48fc141d45efb6ac81e","filename":"problems/11000151_artin_a5_quotient/review/INDEPENDENT_CHECKS.json","status":"added","additions":15,"deletions":0,"changes":15,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Freview%2FINDEPENDENT_CHECKS.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Freview%2FINDEPENDENT_CHECKS.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2Freview%2FINDEPENDENT_CHECKS.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,15 @@\n+{\n+  \"status\": \"PASS\",\n+  \"assertions\": 851,\n+  \"twenty_letter_candidates\": 810,\n+  \"twenty_letter_survivors\": 10,\n+  \"candidate_counts\": [\n+    81,\n+    162,\n+    162,\n+    162,\n+    162,\n+    81\n+  ],\n+  \"scope\": \"Independent iterative exhaustive twenty-letter action test and supplementary linking controls; full thirty-letter Python/C++ certificates separately replayed.\"\n+}"},{"sha":"76697bcf8a62e1884b6316a73be5db167e312300","filename":"problems/11000151_artin_a5_quotient/review/REVIEW.md","status":"added","additions":27,"deletions":0,"changes":27,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Freview%2FREVIEW.md","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Freview%2FREVIEW.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2Freview%2FREVIEW.md?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,27 @@\n+# Independent full review: 11000151\n+\n+Verdict: PASS, complete convention-qualified fixed-generator classification after four substantive author turns. This is a mathematical review, not historical novelty certification.\n+\n+## Source and scope\n+\n+The original Wajnryb question on printed126 was checked in the primary volume, including its exact quotient and positive-word restriction. Its [1] is Auroux, whose chapter distinguishes Hurwitz moves and simultaneous conjugation. The packet appropriately resolves both conventions. The objects being classified are positive words in the five fixed generators; arbitrary conjugate-factor or unrestricted geometric classifications are not claimed.\n+\n+## Full proof audit\n+\n+Turn1: c h=z is independently certified by the faithful Artin action. Capping one boundary of the five-chain neighborhood gives the required genus-two one-boundary map, with z and c² both the boundary twist; hence the quotient relation holds. All generators remain nonseparating. The published Baykur–Monden–Van Horn-Morris TheoremA gives maximum40 for this precise surface. This theorem and classical chain relations are credited external inputs. The Z/10 abelianization, linking-vector normal-closure inclusion and inequalities excluding0 and10 are valid for arbitrary integer coefficients, not merely the bounded controls.\n+\n+Turn2: integer inequalities at20,30,40 give exactly the stated linking patterns. A positive untouched interior strand prevents the required cross-side linking, so the isolated40-letter strand is an endpoint. The four-chain surface is its regular neighborhood; Perron–Vannier's injection therefore applies to B5. Positive-monoid embedding and explicit Hurwitz realizations of Artin relations prove the classes. The generated permutation subgroup is invariant under strict moves, distinguishing the two endpoint classes, and the displayed conjugation joins them under the wider convention.\n+\n+Turn3: the star reduction covers all candidates by a single labelled strand's nearest-neighbor walk. The explicit free-group maps and their inverses satisfy the quotient presentation. Their use is rejection-only, with separate central cyclic-rotation certificates for every survivor. An independently written iterative frontier implementation, carrying the free-group images during enumeration, confirms all810 candidates and exactly the ten rotations, rather than importing the author's enumeration. The central-product Hurwitz cyclic-rotation argument is correct.\n+\n+Turn4: the finite crossing DAG is exhaustive because every pair count is bounded by2 and every step increments its sum. Count parity determines the strand permutation. The positive-word reversal proof establishes complement coaccessibility without confusing reversal with group inversion. Every canonical prefix of a coaccessible state remains coaccessible. Literal action comparisons on every coaccessible edge, followed by induction, establish action path-independence; faithful Artin action then gives actual braid equality to z. This is not reliance on equal linking numbers alone. Both complete Python and C++ implementations were inspected/replayed, with identical full action-stream digest and all261810 exact edge comparisons. Hashes are integrity receipts, not equality tests.\n+\n+## Reproduction and limits\n+\n+AUTHOR_REPLAY.json records exact replay of all four Python receipts and the C++ receipt and verification of all34 manifest-bound files. INDEPENDENT_CHECKS.json records851 independent assertions, including the exhaustive20-letter check and supplementary linking controls. The full30-letter census is234368 reachable states,90921 coaccessible states and261810 coaccessible edges, with action-stream digest af2b8ec569d613e4f3d8ba3b72d18e85e8c612f4265057b7f4c485d544d159bf.\n+\n+The classical upper-bound, chain-injection, Artin-faithfulness and monoid-embedding theorems are checked for exact hypotheses and credited, rather than re-proved foundationally. No stochastic tests or arbitrary computational cutoff replace an infinite implication.\n+\n+## Disposition\n+\n+claimed_solved,4/5, with the exact outcome prominent: lengths20,30,40; four strict Hurwitz classes (one,one,two), or three classes when simultaneous conjugation is allowed. No remaining gap was found within the original fixed-generator scope. Do not state an unqualified three-class strict-Hurwitz result or a classification of arbitrary positive Dehn-twist factorizations."},{"sha":"a0626c2d2991c4e25bac9a0f4791560f94c1cc18","filename":"problems/11000151_artin_a5_quotient/review/REVIEW_MANIFEST.json","status":"added","additions":31,"deletions":0,"changes":31,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Freview%2FREVIEW_MANIFEST.json","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Freview%2FREVIEW_MANIFEST.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2Freview%2FREVIEW_MANIFEST.json?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,31 @@\n+{\n+  \"problem_id\": 11000151,\n+  \"verdict\": \"PASS complete fixed-generator classification, both conventions\",\n+  \"files\": [\n+    {\n+      \"path\": \"AUTHOR_REPLAY.json\",\n+      \"bytes\": 3187,\n+      \"sha256\": \"4e0c0e9b7ed5e7f260b0b6f0f32202ed4e4be3f5d3c95f362903b9a0f05e9503\"\n+    },\n+    {\n+      \"path\": \"INDEPENDENT_CHECKS.json\",\n+      \"bytes\": 365,\n+      \"sha256\": \"b4bb9743588b9019d4b6100ecdef31676cb6a6b369231881e717c6086d30d104\"\n+    },\n+    {\n+      \"path\": \"REVIEW.md\",\n+      \"bytes\": 4441,\n+      \"sha256\": \"bb8ca1b5bbb37be8393957faaf352c7d2402757cafd2e39a605700f523818ce4\"\n+    },\n+    {\n+      \"path\": \"independent_check.py\",\n+      \"bytes\": 2650,\n+      \"sha256\": \"5de33aa29199853914c93719046ae96a1ffe858d0e17e4b75246fefec5e32923\"\n+    },\n+    {\n+      \"path\": \"replay_author.py\",\n+      \"bytes\": 937,\n+      \"sha256\": \"bf8115ea4e7caab22bfccb98924ffa1f9ee837a9ebc4216c7fe3460a0e77914d\"\n+    }\n+  ]\n+}"},{"sha":"fa7f910aef7a7424a00d86a151e60023123b35ea","filename":"problems/11000151_artin_a5_quotient/review/independent_check.py","status":"added","additions":61,"deletions":0,"changes":61,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Freview%2Findependent_check.py","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Freview%2Findependent_check.py","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2Freview%2Findependent_check.py?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,61 @@\n+import itertools,json,hashlib\n+from pathlib import Path\n+N=0\n+def check(v):\n+ global N\n+ assert v;N+=1\n+def reduce(w):\n+ s=[]\n+ for a in w:\n+  if s and s[-1]+a==0:s.pop()\n+  else:s.append(a)\n+ return tuple(s)\n+def inverse(w):return tuple(-a for a in reversed(w))\n+def substitute(w,A):return reduce(itertools.chain.from_iterable(A[a-1] if a>0 else inverse(A[-a-1]) for a in w))\n+A=[((1,),(1,2),(1,3),(1,4)),((1,-2,1),(1,),(3,),(4,)),((1,),(2,-3,2),(2,),(4,)),((1,),(2,),(3,-4,3),(3,)),((1,),(2,),(3,),(3,-2,1,4))]\n+I=tuple((i,) for i in range(1,5))\n+def action(w):\n+ r=I\n+ for i in w:r=tuple(substitute(x,A[i-1]) for x in r)\n+ return r\n+h=(5,4,3,2,1,1,2,3,4,5);c=(1,2,3,4)*5\n+check(action(h)==action(c));target=action(h*2)\n+for i in range(1,6):\n+ for j in range(i+1,6):check(action((i,j,i))==action((j,i,j)) if j==i+1 else action((i,j))==action((j,i)))\n+# Iterative frontier with images carried along, independently of author's recursive word/action routine.\n+counts=[];survivors=set();total=0\n+for start in range(6):\n+ frontier=[(start,(0,)*5,(),I)]\n+ for depth in range(20):\n+  nxt=[]\n+  for pos,used,w,im in frontier:\n+   for delta in [-1,1]:\n+    q=pos+delta\n+    if not 0<=q<6:continue\n+    edge=min(pos,q)\n+    if used[edge]==4:continue\n+    v=list(used);v[edge]+=1\n+    nxt.append((q,tuple(v),w+(edge+1,),tuple(substitute(x,A[edge]) for x in im)))\n+  frontier=nxt\n+ retained=[r for r in frontier if r[0]==start]\n+ counts.append(len(retained));total+=len(retained)\n+ for pos,used,w,im in retained:\n+  check(used==(4,)*5)\n+  if im==target:survivors.add(w)\n+check(counts==[81,162,162,162,162,81]);check(total==810)\n+check(survivors=={(h*2)[i:]+(h*2)[:i] for i in range(20)})\n+# Stress all linking integer solutions in a box; analytic inequalities, not this box, prove exhaustiveness.\n+patterns={20:set(),30:set(),40:set()};pairs=list(itertools.combinations(range(6),2))\n+for m in [0,10,20,30,40]:\n+ T=m//10-4\n+ for t0 in itertools.product(range(-3,3),repeat=5):\n+  t=t0+(T-sum(t0),)\n+  L=tuple((2 if j<5 else 0)+T-2*(t[i]+t[j]) for i,j in pairs)\n+  if min(L)<0:continue\n+  check(m>=20)\n+  if m==20:check(L in {tuple(2 if k in (i,j) else 0 for i,j in pairs) for k in range(6)})\n+  if m==30:check(L==(1,)*15)\n+  if m==40:check(L in {tuple(0 if k in (i,j) else 2 for i,j in pairs) for k in range(6)})\n+  patterns[m].add(L)\n+check([len(patterns[m]) for m in [20,30,40]]==[6,1,6])\n+print(json.dumps({'status':'PASS','assertions':N,'twenty_letter_candidates':total,'twenty_letter_survivors':len(survivors),'candidate_counts':counts,'scope':'Independent iterative exhaustive twenty-letter action test and supplementary linking controls; full thirty-letter Python/C++ certificates separately replayed.'},indent=2))"},{"sha":"5ccc13a1bf393029a8623d57ad36e0874a659cc0","filename":"problems/11000151_artin_a5_quotient/review/replay_author.py","status":"added","additions":12,"deletions":0,"changes":12,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Freview%2Freplay_author.py","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Freview%2Freplay_author.py","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2Freview%2Freplay_author.py?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,12 @@\n+from pathlib import Path\n+import subprocess,json,hashlib,sys\n+root=Path(sys.argv[1]) if len(sys.argv)>1 else Path('/workspace/shared/math-11000151')\n+out=Path(__file__).parent\n+m=json.loads((root/'FINAL_AUTHOR_MANIFEST.json').read_text())\n+for f in m['files']:\n+ p=root/f['path'];assert hashlib.sha256(p.read_bytes()).hexdigest()==f['sha256']\n+reports=[]\n+for n in range(1,5):\n+ b=subprocess.check_output([sys.executable,str(root/f'check_turn_{n}.py')]);assert json.loads(b)==json.loads((root/f'TURN_{n}_CHECKS.json').read_text());reports.append(json.loads(b))\n+b=subprocess.check_output([sys.executable,str(root/'verify_turn_4_cpp.py')]);assert json.loads(b)==json.loads((root/'TURN_4_CPP_CHECKS.json').read_text())\n+print(json.dumps({'status':'PASS','author_manifest_sha256':hashlib.sha256((root/'FINAL_AUTHOR_MANIFEST.json').read_bytes()).hexdigest(),'bound_files':len(m['files']),'python_replays':reports,'cpp_replay':json.loads(b)},indent=2))"},{"sha":"f8e66b27eed0b704057ec72808db51564bc2ae99","filename":"problems/11000151_artin_a5_quotient/verify_publication.py","status":"added","additions":14,"deletions":0,"changes":14,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Fverify_publication.py","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Fverify_publication.py","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2Fverify_publication.py?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,14 @@\n+#!/usr/bin/env python3\n+from pathlib import Path\n+import hashlib,json,subprocess,sys\n+D=Path(__file__).resolve().parent\n+for r in json.loads((D/'PUBLICATION_MANIFEST.json').read_text())['files']:\n+ b=(D/r['path']).read_bytes();assert len(b)==r['bytes'];assert hashlib.sha256(b).hexdigest()==r['sha256']\n+for i in range(1,5):\n+ out=subprocess.check_output([sys.executable,str(D/f'check_turn_{i}.py')],cwd=D)\n+ assert out==(D/f'TURN_{i}_CHECKS.json').read_bytes()\n+out=subprocess.check_output([sys.executable,str(D/'verify_turn_4_cpp.py')],cwd=D)\n+assert out==(D/'TURN_4_CPP_CHECKS.json').read_bytes()\n+out=subprocess.check_output([sys.executable,str(D/'review/independent_check.py')],cwd=D)\n+assert json.loads(out)==json.loads((D/'review/INDEPENDENT_CHECKS.json').read_bytes())\n+print('PASS: all frozen public bytes, four Python receipts, C++ full stream, and independent review controls')"},{"sha":"fb6978e89830c5d7f27db99d24051cba78f5248c","filename":"problems/11000151_artin_a5_quotient/verify_turn_4_cpp.py","status":"added","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Fverify_turn_4_cpp.py","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/problems%2F11000151_artin_a5_quotient%2Fverify_turn_4_cpp.py","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/problems%2F11000151_artin_a5_quotient%2Fverify_turn_4_cpp.py?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -0,0 +1,19 @@\n+#!/usr/bin/env python3\n+\"\"\"Compile the independent C++ implementation and hash its complete action stream.\"\"\"\n+from pathlib import Path\n+import subprocess,tempfile,hashlib,json\n+p=Path(__file__).resolve().parent\n+with tempfile.TemporaryDirectory() as d:\n+ exe=Path(d)/'check'\n+ subprocess.run(['g++','-O3','-std=c++17',str(p/'check_turn_4.cpp'),'-o',str(exe)],check=True)\n+ process=subprocess.Popen([str(exe),'--stream'],stdout=subprocess.PIPE)\n+ sha=hashlib.sha256();states=0;result=None\n+ for line in process.stdout:\n+  if line.startswith(b'S|'):sha.update(line);states+=1\n+  else:result=json.loads(line)\n+ assert process.wait()==0 and result is not None\n+ expected=json.loads((p/'TURN_4_CHECKS.json').read_text())\n+ assert states==expected['coaccessible_states']\n+ for key,value in result.items():assert expected[key]==value\n+ assert sha.hexdigest()==expected['canonical_action_stream_sha256']\n+ print(json.dumps({'status':'PASS','stream_states':states,'canonical_action_stream_sha256':sha.hexdigest(),'Cplusplus_counts':result,'all_actions_compared_exactly_before_hashing':True,'scope':'A second exact implementation, not a replacement for the completeness proof or independent mathematical review.'},indent=2,sort_keys=True))"},{"sha":"37984b312512124f3025e82bfaf8f73c5a6e4459","filename":"unsolved_math_prioritization/QUEUE.md","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/AlecKriebel/Math/blob/d977c9564f079cde975a7b4261776eb9061c5f5f/unsolved_math_prioritization%2FQUEUE.md","raw_url":"https://github.com/AlecKriebel/Math/raw/d977c9564f079cde975a7b4261776eb9061c5f5f/unsolved_math_prioritization%2FQUEUE.md","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2FQUEUE.md?ref=d977c9564f079cde975a7b4261776eb9061c5f5f","patch":"@@ -397,7 +397,7 @@ Budget per problem: Five substantive proof-attempt turns with ChatGPT6 Astra at\n | 386 | 30001563 / OWR-4425-020 | PVHH-Cube Avoidance in a Morphic Fixed Point | 0.1442 | 5.0 | 3 | 2010 | queued | 0/5 |  |  |  |\n | 387 | 30004048 / OWR-16763-022 | Symmetry of Bidirectional Two-Step Path Density | 0.1441 | 6.0 | 3 | 2019 | queued | 0/5 |  |  |  |\n | 388 | 30004320 / OWR-17295-004 | Descent of Rational Points from Laurent Series Fields | 0.1441 | 7.0 | 3 | 2019 | queued | 0/5 |  |  |  |\n-| 389 | 11000151 / AMR-109-0151 | Question — Consider the Artin group A5 (the braid group on six strings) divided by the relation (a1a2a3a4)5 = a5a4a3a2a2 1a2a3a4a5. | 0.1440 | 5.0 | 3 | unknown | queued | 0/5 |  |  |  |\n+| 389 | 11000151 / AMR-109-0151 | Question — Consider the Artin group A5 (the braid group on six strings) divided by the relation (a1a2a3a4)5 = a5a4a3a2a2 1a2a3a4a5. | 0.1440 | 5.0 | 3 | unknown | claimed_solved | 4/5 |  |  |  |\n | 390 | 11000228 / AMR-109-0228 | Problem 21 — (Exceptional Strata). | 0.1440 | 5.5 | 3 | unknown | queued | 0/5 |  |  |  |\n | 391 | 20000728 / AIM-ANALYTIC_NUMBER_THEORY-0092 | Weight-only modularity recognition has a finite-data obstruction | 0.1440 | 5.0 | 3 | unknown | queued | 0/5 |  |  |  |\n | 392 | 20001666 / AIM-GEOMETRY-0004 | Fixed-volume degeneration of Maxwell cavity eigenvalues | 0.1440 | 5.0 | 3 | unknown | queued | 0/5 |  |  |  |"}]]