(version 1)

;; Deny by default. Package code may execute local processes, read only the
;; copied review workspace and operating-system/runtime files, and write only
;; inside the copied review workspace. No user home, browser profile, SSH,
;; cloud configuration, keychain database, or network endpoint is readable.
(deny default)

(allow process*)
(allow signal (target self))
(allow sysctl-read)
(allow mach-lookup)
(allow ipc-posix-shm)

;; Keep credential/keychain brokers unavailable even though ordinary runtime
;; services may be looked up.
(deny mach-lookup
  (global-name "com.apple.securityd")
  (global-name "com.apple.securityd.xpc")
  (global-name "com.apple.security.agent")
  (global-name "com.apple.trustd")
  (global-name "com.apple.trustd.agent"))

;; Runtime libraries on macOS are scattered across system and developer
;; roots, so permit ordinary reads and then carve out the complete user home
;; except for this copied workspace, plus system credential stores.
(allow file-read*)

(deny file-read*
  (require-all
    (subpath "/Users/alec")
    (require-not
      (literal "/Users/alec"))
    (require-not
      (literal "/Users/alec/Documents"))
    (require-not
      (literal "/Users/alec/Documents/Math"))
    (require-not
      (literal "/Users/alec/Documents/Math/k3p_level2_revision_independent_referee_2026-08-27"))
    (require-not
      (subpath "/Users/alec/Documents/Math/k3p_level2_revision_independent_referee_2026-08-27"))))

(deny file-read*
  (subpath "/Library/Keychains")
  (subpath "/private/var/root")
  (subpath "/private/var/db/SystemKey")
  (subpath "/private/var/db/dslocal"))

(allow file-write*
  (subpath "/Users/alec/Documents/Math/k3p_level2_revision_independent_referee_2026-08-27/package_copy")
  (literal "/dev/null"))

(deny network*)

;; Defense in depth if a future runtime rule becomes broader.
(deny file-read*
  (subpath "/Users/alec/.ssh")
  (subpath "/Users/alec/.aws")
  (subpath "/Users/alec/.config")
  (subpath "/Users/alec/Library/Keychains")
  (subpath "/Users/alec/Library/Application Support/Google/Chrome")
  (subpath "/Users/alec/Library/Application Support/com.apple.sharedfilelist")
  (subpath "/Users/alec/Library/CloudStorage"))
