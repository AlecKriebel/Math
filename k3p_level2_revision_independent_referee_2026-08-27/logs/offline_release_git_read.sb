(version 1)

;; Release-engineering variant of the mathematical-review sandbox.  It keeps
;; the no-network/no-credentials boundary and the same copied-workspace-only
;; write rule, but permits read-only access to the monorepo Git object store so
;; an exact detached checkout can run the explicitly Git-bound packaging
;; mutation suite.
(deny default)

(allow process*)
(allow signal (target self))
(allow signal (target children))
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow mach-lookup)
(allow ipc-posix-shm)

(deny mach-lookup
  (global-name "com.apple.securityd")
  (global-name "com.apple.securityd.xpc")
  (global-name "com.apple.security.agent")
  (global-name "com.apple.trustd")
  (global-name "com.apple.trustd.agent"))

(allow file-read*)

(deny file-read*
  (require-all
    (subpath "/Users/alec")
    (require-not
      (literal "/Users/alec"))
    (require-not
      (literal "/Users/alec/Documents"))
    (require-not
      (literal "/Users/alec/Documents/Math"))
    (require-not
      (literal "/Users/alec/Documents/Math/.git"))
    (require-not
      (literal "/Users/alec/Documents/Math/.git/objects"))
    (require-not
      (subpath "/Users/alec/Documents/Math/.git/objects"))
    (require-not
      (literal "/Users/alec/Documents/Math/k3p_level2_identifiability_final/release/dist/k3p_level2_compact_verifier.zip"))
    (require-not
      (literal "/Users/alec/Documents/Math/k3p_level2_identifiability_final/release/dist/k3p_level2_reproducibility.tar.gz"))
    (require-not
      (literal "/Users/alec/Documents/Math/k3p_level2_revision_independent_referee_2026-08-27"))
    (require-not
      (subpath "/Users/alec/Documents/Math/k3p_level2_revision_independent_referee_2026-08-27"))))

(deny file-read*
  (subpath "/Library/Keychains")
  (subpath "/private/var/root")
  (subpath "/private/var/db/SystemKey")
  (subpath "/private/var/db/dslocal"))

(allow file-write*
  (subpath "/Users/alec/Documents/Math/k3p_level2_revision_independent_referee_2026-08-27/package_copy")
  (literal "/dev/null"))

(deny network*)

(deny file-read*
  (subpath "/Users/alec/.ssh")
  (subpath "/Users/alec/.aws")
  (subpath "/Users/alec/.config")
  (subpath "/Users/alec/Library/Keychains")
  (subpath "/Users/alec/Library/Application Support/Google/Chrome")
  (subpath "/Users/alec/Library/Application Support/com.apple.sharedfilelist")
  (subpath "/Users/alec/Library/CloudStorage"))
