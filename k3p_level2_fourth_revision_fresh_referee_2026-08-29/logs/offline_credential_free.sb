(version 1)

;; Referee-owned boundary for reviewed package code. Permit runtime reads only
;; from system locations, the copied sealed payload, and the dependency venv;
;; permit writes only beneath the copied package's unsealed review_runs root.
(deny default)

(allow process*)
(allow signal (target self))
(allow signal (target children))
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow ipc-posix-shm)

(allow file-read-metadata
  (literal "/")
  (literal "/Users")
  (literal "/Users/alec")
  (literal "/Users/alec/Documents")
  (literal "/Users/alec/Documents/Math")
  (literal "/Users/alec/Documents/Math/k3p_level2_identifiability_final")
  (literal "/Users/alec/Documents/Math/k3p_level2_fourth_revision_fresh_referee_2026-08-29")
  (literal "/opt")
  (literal "/opt/homebrew")
  (literal "/opt/homebrew/opt")
  (literal "/opt/homebrew/opt/python@3.14")
  (literal "/opt/homebrew/opt/python@3.14/bin")
  (literal "/opt/homebrew/Cellar")
  (literal "/opt/homebrew/Cellar/python@3.14"))

(allow file-read*
  (literal "/")
  (literal "/dev")
  (subpath "/dev")
  (literal "/System")
  (subpath "/System")
  (literal "/usr")
  (subpath "/usr")
  (literal "/bin")
  (subpath "/bin")
  (literal "/sbin")
  (subpath "/sbin")
  (literal "/Library")
  (subpath "/Library/Apple")
  (subpath "/Library/Frameworks")
  (literal "/private")
  (literal "/private/var")
  (literal "/private/var/db")
  (subpath "/private/var/db/dyld")
  (subpath "/private/var/db/timezone")
  (literal "/opt")
  (subpath "/opt/homebrew")
  (literal "/Users")
  (literal "/Users/alec")
  (literal "/Users/alec/Documents")
  (literal "/Users/alec/Documents/Math")
  (literal "/Users/alec/Documents/Math/k3p_level2_identifiability_final")
  (subpath "/Users/alec/Documents/Math/k3p_level2_identifiability_final/.venv")
  (literal "/Users/alec/Documents/Math/k3p_level2_fourth_revision_fresh_referee_2026-08-29")
  (subpath "/Users/alec/Documents/Math/k3p_level2_fourth_revision_fresh_referee_2026-08-29/package_copy"))

(allow file-write*
  (subpath "/Users/alec/Documents/Math/k3p_level2_fourth_revision_fresh_referee_2026-08-29/package_copy/review_runs")
  (literal "/dev/null"))

(deny network*)
