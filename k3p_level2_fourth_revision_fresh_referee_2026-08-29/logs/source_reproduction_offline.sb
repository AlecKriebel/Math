(version 1)
(deny default)

(allow process*)
(allow signal (target self))
(allow signal (target children))
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow ipc-posix-shm)
(allow mach-lookup
  (global-name "com.apple.SystemConfiguration.configd"))

(allow file-read-metadata
  (literal "/")
  (literal "/Users")
  (literal "/Users/alec")
  (literal "/Users/alec/Documents")
  (literal "/Users/alec/Documents/Math")
  (literal "/Users/alec/Documents/Math/.git")
  (literal "/Users/alec/Documents/Math/k3p_level2_fourth_revision_fresh_referee_2026-08-29")
  (literal "/Users/alec/Documents/Math/k3p_level2_fourth_revision_fresh_referee_2026-08-29/execution")
  (literal "/Users/alec/Documents/Math/k3p_level2_fourth_revision_fresh_referee_2026-08-29/execution/source_literature_reaudit")
  (literal "/opt")
  (literal "/opt/homebrew"))

(allow file-read*
  (literal "/")
  (literal "/dev") (subpath "/dev")
  (literal "/System") (subpath "/System")
  (literal "/usr") (subpath "/usr")
  (literal "/bin") (subpath "/bin")
  (literal "/sbin") (subpath "/sbin")
  (literal "/Library")
  (literal "/Library/Apple") (subpath "/Library/Apple")
  (literal "/Library/Fonts") (subpath "/Library/Fonts")
  (literal "/Library/Frameworks") (subpath "/Library/Frameworks")
  (literal "/private")
  (literal "/private/etc") (subpath "/private/etc")
  (literal "/private/var")
  (literal "/private/var/db")
  (literal "/private/var/db/dyld") (subpath "/private/var/db/dyld")
  (literal "/private/var/db/timezone") (subpath "/private/var/db/timezone")
  (literal "/opt") (literal "/opt/homebrew") (subpath "/opt/homebrew")
  (literal "/Users") (literal "/Users/alec")
  (literal "/Users/alec/Documents")
  (literal "/Users/alec/Documents/Math")
  (literal "/Users/alec/Documents/Math/.git")
  (subpath "/Users/alec/Documents/Math/.git")
  (literal "/Users/alec/Documents/Math/k3p_level2_fourth_revision_fresh_referee_2026-08-29")
  (literal "/Users/alec/Documents/Math/k3p_level2_fourth_revision_fresh_referee_2026-08-29/execution")
  (literal "/Users/alec/Documents/Math/k3p_level2_fourth_revision_fresh_referee_2026-08-29/execution/source_literature_reaudit")
  (subpath "/Users/alec/Documents/Math/k3p_level2_fourth_revision_fresh_referee_2026-08-29/execution/source_literature_reaudit"))

(allow file-write*
  (subpath "/Users/alec/Documents/Math/k3p_level2_fourth_revision_fresh_referee_2026-08-29/execution/source_literature_reaudit")
  (literal "/dev/null"))

(deny network*)
