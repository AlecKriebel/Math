{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "k2p-four-port-record-v3",
  "title": "Hash-bound resumable K2P four-port relation record",
  "type": "object",
  "required": [
    "schema", "canonicalizer_sha256", "compiler_sha256",
    "descriptor_pickle_sha256", "rank_pickle_sha256", "output_schema_sha256", "hard_certificate_sha256",
    "input_lock_sha256", "source_index", "canonical_class_id",
    "descriptor_sha256", "source_graph_sha256", "target_graph_sha256",
    "direction", "incoming_roles", "port_match", "port_matches",
    "omitted_roles", "source_rank", "target_rank", "stratum", "status",
    "certificate", "certificate_payload_sha256", "restoration_parent_id", "child_requests", "members",
    "runtime_seconds", "peak_rss_bytes", "runtime_platform",
    "generated_at_utc", "semantic_record_sha256", "record_payload_sha256"
  ],
  "properties": {
    "schema": {"const": "k2p-four-port-record-v3"},
    "canonicalizer_sha256": {"$ref": "#/$defs/sha256"},
    "compiler_sha256": {"$ref": "#/$defs/sha256"},
    "descriptor_pickle_sha256": {"$ref": "#/$defs/sha256"},
    "rank_pickle_sha256": {"$ref": "#/$defs/sha256"},
    "output_schema_sha256": {"$ref": "#/$defs/sha256"},
    "input_lock_sha256": {"$ref": "#/$defs/sha256"},
    "hard_certificate_sha256": {"$ref": "#/$defs/sha256"},
    "source_index": {"type": "integer", "minimum": 0},
    "canonical_class_id": {"type": "integer", "minimum": 0},
    "descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "source_graph_sha256": {"$ref": "#/$defs/sha256"},
    "target_graph_sha256": {"$ref": "#/$defs/sha256"},
    "direction": {"const": "source_to_target"},
    "incoming_roles": {"type": "object"},
    "port_match": {"type": "array", "items": {"type": "integer"}},
    "port_matches": {"type": "array", "items": {"type": "array", "items": {"type": "integer"}}},
    "omitted_roles": {"type": "array", "items": {"type": "string"}},
    "source_rank": {"type": "integer", "minimum": 0},
    "target_rank": {"type": "integer", "minimum": 0},
    "stratum": {"enum": ["direct_no_dummy", "restoration_candidate"]},
    "status": {"enum": ["separated", "isomorphic", "triangle", "restoration_parent", "unresolved", "error"]},
    "certificate": {"type": ["object", "null"]},
    "certificate_payload_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "restoration_parent_id": {"type": ["string", "null"]},
    "child_requests": {"type": "array"},
    "members": {"type": "array"},
    "runtime_seconds": {"type": "number", "minimum": 0},
    "peak_rss_bytes": {"type": "integer", "minimum": 0},
    "runtime_platform": {"type": "object"},
    "generated_at_utc": {"type": "string"},
    "semantic_record_sha256": {"$ref": "#/$defs/sha256"},
    "record_payload_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
