,"filename":"unsolved_math_prioritization/attempts/30002061/source_provenance.json","status":"added","additions":27,"deletions":0,"changes":27,"blob_url":"https://github.com/AlecKriebel/Math/blob/28c6ce952d6027fb995bbd2d79a8c9647cc8b844/unsolved_math_prioritization%2Fattempts%2F30002061%2Fsource_provenance.json","raw_url":"https://github.com/AlecKriebel/Math/raw/28c6ce952d6027fb995bbd2d79a8c9647cc8b844/unsolved_math_prioritization%2Fattempts%2F30002061%2Fsource_provenance.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30002061%2Fsource_provenance.json?ref=28c6ce952d6027fb995bbd2d79a8c9647cc8b844","patch":"@@ -0,0 +1,27 @@\n+{\n+  \"date\": \"2026-09-30\",\n+  \"dataset_revision\": \"37e53eabe540fb458758e198be61634bd02ee008\",\n+  \"sources\": [\n+    {\n+      \"file\": \"owr2012.pdf\",\n+      \"url\": \"https://ems.press/content/serial-article-files/46393?nt=1\",\n+      \"sha256\": \"54ae757af04584062a30548693a2b861fe0e41503992f9703d602f5917028b74\"\n+    },\n+    {\n+      \"file\": \"adiprasito-benedetti.pdf\",\n+      \"url\": \"https://arxiv.org/pdf/1709.07930v1\",\n+      \"sha256\": \"d9c3a69487dae19aeb3cfc38dfd285bbc171b6ece05bce609c4ffefa3a41f0d8\"\n+    },\n+    {\n+      \"file\": \"published-ab.pdf\",\n+      \"url\": \"https://par.nsf.gov/servlets/purl/10169029\",\n+      \"sha256\": \"584b7cb14c50fc7394b77813ece511a29696c771fa319c25241910feaa4ab7e5\"\n+    },\n+    {\n+      \"file\": \"tight2015.pdf\",\n+      \"url\": \"https://arxiv.org/pdf/1202.3390v2\",\n+      \"sha256\": \"2fe6eba829d4052bc7c5c56305e8748021c07f0a2e59779f551fe3e426c95f95\"\n+    }\n+  ],\n+  \"pdf_redistribution\": false\n+}"},{"sha":"b4ed17132441bdd8f61659a06d852b5080249395","filename":"unsolved_math_prioritization/attempts/30002061/source_record.json","status":"added","additions":68,"deletions":0,"changes":68,"blob_url":"https://github.com/AlecKriebel/Math/blob/28c6ce952d6027fb995bbd2d79a8c9647cc8b844/unsolved_math_prioritization%2Fattempts%2F30002061%2Fsource_record.json","raw_url":"https://github.com/AlecKriebel/Math/raw/28c6ce952d6027fb995bbd2d79a8c9647cc8b844/unsolved_math_prioritization%2Fattempts%2F30002061%2Fsource_record.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30002061%2Fsource_record.json?ref=28c6ce952d6027fb995bbd2d79a8c9647cc8b844","patch":"@@ -0,0 +1,68 @@\n+{\n+  \"id\": 30002061,\n+  \"problem_number\": \"OWR-11786-016\",\n+  \"title\": \"Collapse Preservation under Subdivision\",\n+  \"statement\": \"If a simplicial complex $C$ collapses to a subcomplex $C'$, and $D$ is a subdivision of $C$ restricting to a subdivision $D'$ of $C'$, must $D$ collapse to $D'$?\",\n+  \"background\": \"Collected from Oberwolfach Reports, which document mathematical workshops and their open-problem discussions.\\n\\n**Source report:** [Triangulations (2013), Oberwolfach Reports, DOI 10.4171/owr/2012/24, pp. 1405--1486](https://doi.org/10.4171/owr/2012/24)\\n\\n## Literature review (checked 2026-08-21)\\n\\n**Status:** partially solved\\n\\n**Assessment.** The subdivision question is open in its stated form, but a barycentric subdivision of D is proved to collapse to the corresponding barycentric subdivision of D-prime, with further low-dimensional positive cases.\\n\\n**Sources checked.**\\n\\n- [Adiprasito--Benedetti](https://arxiv.org/abs/1709.07930)\\n- [original OWR report](https://doi.org/10.4171/owr/2012/24)\\n\\nThis is a dated literature triage derived from the supplied OWR curation; verify time-sensitive status and cited claims independently.\",\n+  \"difficulty_level_id\": 3,\n+  \"status\": \"partially_solved\",\n+  \"proposed_by\": null,\n+  \"proposed_year\": 2012,\n+  \"category_id\": 7,\n+  \"set_id\": 15,\n+  \"source_url\": \"https://doi.org/10.4171/owr/2012/24\",\n+  \"source_citation\": \"Triangulations (2013), Oberwolfach Reports, DOI 10.4171/owr/2012/24, pp. 1405--1486\",\n+  \"literature_assessment\": \"The subdivision question is open in its stated form, but a barycentric subdivision of D is proved to collapse to the corresponding barycentric subdivision of D-prime, with further low-dimensional positive cases.\",\n+  \"literature_sources\": [\n+    {\n+      \"url\": \"https://arxiv.org/abs/1709.07930\",\n+      \"label\": \"Adiprasito--Benedetti\"\n+    },\n+    {\n+      \"url\": \"https://doi.org/10.4171/owr/2012/24\",\n+      \"label\": \"original OWR report\"\n+    }\n+  ],\n+  \"literature_checked_at\": \"2026-08-21\",\n+  \"tags\": [\n+    \"owr\",\n+    \"oberwolfach-reports\",\n+    \"OWR-11786-016\",\n+    \"literature-status:partially-solved\",\n+    \"owr-year:2012\"\n+  ],\n+  \"view_count\": 0,\n+  \"favorite_count\": 0,\n+  \"created_at\": \"2026-08-25T00:00:00Z\",\n+  \"updated_at\": \"2026-09-16T12:06:53Z\",\n+  \"published\": true,\n+  \"category\": {\n+    \"id\": 7,\n+    \"name\": \"topology\",\n+    \"display_name\": \"Topology\",\n+    \"description\": \"Properties preserved under continuous deformations.\",\n+    \"slug\": \"topology\",\n+    \"order_index\": 7,\n+    \"created_at\": \"2026-07-31T15:26:25.671Z\"\n+  },\n+  \"difficulty\": {\n+    \"id\": 3,\n+    \"level\": 3,\n+    \"name\": \"L3: Advanced\",\n+    \"description\": \"Difficult problems requiring specialized knowledge and sophisticated techniques.\",\n+    \"color_class\": \"text-yellow-600 bg-yellow-50 border-yellow-200\"\n+  },\n+  \"set\": {\n+    \"id\": 15,\n+    \"name\": \"oberwolfach_reports_open_problems\",\n+    \"display_name\": \"Oberwolfach Reports Open Problems\",\n+    \"description\": \"Open and partially solved problems extracted from Oberwolfach Reports workshop discussions, with report provenance and dated literature assessments.\",\n+    \"slug\": \"oberwolfach-reports-open-problems\",\n+    \"order_index\": 15,\n+    \"created_at\": \"2026-08-25T00:00:00Z\"\n+  },\n+  \"original_statement\": \"If a simplicial complex C collapses to a subcomplex C-prime, and D is a subdivision of C restricting to a subdivision D-prime of C-prime, does D collapse to D-prime?\",\n+  \"clean_statement\": \"If a simplicial complex $C$ collapses to a subcomplex $C'$, and $D$ is a subdivision of $C$ restricting to a subdivision $D'$ of $C'$, must $D$ collapse to $D'$?\",\n+  \"statement_status\": \"corrected_verified\",\n+  \"statement_verification\": \"Manual semantic, typographic, and LaTeX review confirmed that this meaning-preserving cleanup is self-contained and adds no unsupported source-dependent content.\"\n+}"},{"sha":"30b8ff7770c62d9665a360c71afeffc348862ab8","filename":"unsolved_math_prioritization/attempts/30002061/turns.json","status":"added","additions":12,"deletions":0,"changes":12,"blob_url":"https://github.com/AlecKriebel/Math/blob/28c6ce952d6027fb995bbd2d79a8c9647cc8b844/unsolved_math_prioritization%2Fattempts%2F30002061%2Fturns.json","raw_url":"https://github.com/AlecKriebel/Math/raw/28c6ce952d6027fb995bbd2d79a8c9647cc8b844/unsolved_math_prioritization%2Fattempts%2F30002061%2Fturns.json","contents_url":"https://api.github.com/repos/AlecKriebel/Math/contents/unsolved_math_prioritization%2Fattempts%2F30002061%2Fturns.json?ref=28c6ce952d6027fb995bbd2d79a8c9647cc8b844","patch":"@@ -0,0 +1,12 @@\n+[\n+  {\n+    \"turn\": 1,\n+    \"started_at\": \"2026-09-30T06:29:00Z\",\n+    \"completed_at\": \"2026-09-30T06:37:00Z\",\n+    \"interruption\": \"Separate source audit06:30-06:34\",\n+    \"mechanism\": \"Relative-simplex reduction and parent-first dual-tree certificate\",\n+    \"outcome\": \"scoped_partial_stalled\",\n+    \"novelty\": false,\n+    \"gap\": \"No relative collapse of the higher-dimensional residual complex onto the prescribed protected boundary; the extra-barycentric theorem does not remove its own subdivision.\"\n+  }\n+]"},{"sha":"b9218e7eb6a5c4192539e8afc54ff552c225c808","filename":"unsolved_math_prioritization/attempts/30002061/verification.json","status":"added","additio