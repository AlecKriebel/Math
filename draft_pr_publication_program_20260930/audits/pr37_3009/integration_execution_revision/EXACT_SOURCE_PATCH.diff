+def whole_foreign_members(base, scope, authored):
+    """Imported PDFs/text are individually bound, never first-party evidence."""
+    provenance_names = {'SOURCE_AND_READ_COVERAGE.json', 'INITIAL_SOURCE_ACQUISITION_TOOL_BODY.txt', 'fetch_primary_supplement.py'}
+    provenance = [row for row in authored if row['path'] in provenance_names or row['path'].startswith('receipts/')]
+    require(provenance_names <= {row['path'] for row in provenance}, 'Whole acquisition/read provenance absent')
+    require(strict_equal(scope['foreign_inventory_sources'], provenance), 'Complete authored acquisition/read receipt bindings differ')
+    check_rows(base, provenance)
+    coverage = load(base / 'SOURCE_AND_READ_COVERAGE.json')
+    sources = coverage['sources']
+    require(type(sources) is list and sources, 'Actual source/read PDF inventory required')
+    pdfs = []
+    for source in sources:
+        required_values(source, {'foreign_import': True}, 'Imported PDF source qualification')
+        pin = {key: source[key] for key in ['path', 'bytes', 'sha256']}
+        rows([pin], foreign=True)
+        require(strict_equal(source, {**pin, 'foreign_import': True}), 'Actual read coverage PDF entry shape differs')
+        require(PurePosixPath(pin['path']).suffix == '.pdf', 'Coverage source must be exact PDF')
+        pdfs.append(pin)
+    require({row['path'] for row in pdfs} == {'primary/' + name + '.pdf' for name in ['boronski_v1', 'hamilton1954', 'k3', 'kolev_v3', 'pardon_v3']} and len(pdfs) == 5, 'Only actual five imported primary PDFs qualified')
+    foreign = rows(scope['foreign_members'], foreign=True)
+    require([row['path'] for row in foreign] == sorted({row['path'] for row in pdfs} | {str(PurePosixPath(row['path']).with_suffix('.txt')) for row in pdfs}), 'Full exact root primary PDF/text inventory required')
+    foreign_by_path = {row['path']: row for row in foreign}
+    for pdf in pdfs:
+        require(strict_equal(foreign_by_path[pdf['path']], pdf), 'Foreign PDF differs from actual read coverage')
+        receipt_name = 'receipts/' + PurePosixPath(pdf['path']).stem + '.fetch.json'
+        require(receipt_name in {row['path'] for row in provenance}, 'Actual fetch receipt omitted from provenance')
+        required_values(load(base / receipt_name), {'bytes': pdf['bytes'], 'sha256': pdf['sha256'], 'http_status': 200, 'extract_exit': 0}, 'Actual imported PDF fetch/extraction')
