===== verify_leading_algebra.py =====
     1  #!/usr/bin/env python3
     2  """Exact algebra certificate for the dilute pair--leaf hybrid threshold."""
     3  
     4  from __future__ import annotations
     5  
     6  import sympy as sp
     7  
     8  
     9  r, sigma = sp.symbols("r sigma", positive=True)
    10  p = r**6 - 8*r**5 + 22*r**4 - 30*r**3 + 21*r**2 - 6*r + 1
    11  
    12  
    13  def main() -> None:
    14      polynomial = sp.Poly(p, r, domain=sp.QQ)
    15      assert polynomial.count_roots(sp.Rational(1), sp.Rational(3, 2)) == 0
    16      assert polynomial.count_roots(sp.Rational(3, 2), sp.Rational(151, 100)) == 1
    17      assert p.subs(r, sp.Rational(3, 2)) == sp.Rational(1, 64)
    18      assert p.subs(r, sp.Rational(151, 100)) == -sp.Rational(
    19          39866792399, 10**12
    20      )
    21      root = sp.CRootOf(polynomial, 0)
    22      assert sp.Rational(3, 2) < root < sp.Rational(151, 100)
    23  
    24      lower = 2 * (1 - sigma) * (r - 1) / (1 + sigma * (r**2 - 1))
    25      upper = 2 * (r * (2 - r) - sigma) / (sigma + 2 * r * (r - 1))
    26      gap_numerator = sp.factor(sp.together(upper - lower).as_numer_denom()[0])
    27      expected = -2 * r * (
    28          (r - 1) * sigma**2
    29          + (r**3 - 4 * r**2 + 3 * r + 1) * sigma
    30          + r * (2 * r - 3)
    31      )
    32      assert sp.expand(gap_numerator - expected) == 0
    33  
    34      minimizing_sigma = sp.factor(
    35          -(r**3 - 4 * r**2 + 3 * r + 1) / (2 * (r - 1))
    36      )
    37      quadratic = -gap_numerator / (2 * r)
    38      minimum = sp.factor(quadratic.subs(sigma, minimizing_sigma))
    39      assert sp.simplify(minimum + p / (4 * (r - 1))) == 0
    40  
    41      sigma_star = sp.cancel(minimizing_sigma.subs(r, root))
    42      lambda_star = sp.cancel(lower.subs({r: root, sigma: sigma_star}))
    43      # The exact minimum identity above and p(root)=0 prove L=U at this
    44      # algebraic pair.  Positivity follows throughout the isolating interval:
    45      # neither the numerator of sigma_* nor that of 1-sigma_* has a root
    46      # there, and both are positive at 3/2.
    47      sigma_numerator = -r**3 + 4 * r**2 - 3 * r - 1
    48      one_minus_numerator = 2 * (r - 1) - sigma_numerator
    49      interval_left, interval_right = sp.Rational(3, 2), sp.Rational(151, 100)
    50      for numerator in (sigma_numerator, one_minus_numerator):
    51          assert sp.Poly(numerator, r).count_roots(interval_left, interval_right) == 0
    52          assert numerator.subs(r, interval_left) > 0
    53  
    54      # For fixed sigma_star, L is increasing and U decreasing throughout the
    55      # relevant interval.  The factored derivatives make both signs exact.
    56      derivative_lower = sp.factor(sp.diff(lower, r))
    57      derivative_upper = sp.factor(sp.diff(upper, r))
    58      expected_lower_derivative = (
    59          2
    60          * (sigma - 1)
    61          * (r**2 * sigma - 2 * r * sigma + sigma - 1)
    62          / (r**2 * sigma - sigma + 1) ** 2
    63      )
    64      expected_upper_derivative = 4 * r * (-r + sigma) / (2 * r**2 - 2 * r + sigma) ** 2
    65      assert sp.simplify(derivative_lower - expected_lower_derivative) == 0
    66      assert sp.simplify(derivative_upper - expected_upper_derivative) == 0
    67  
    68      print(f"R_hyb~{sp.N(root, 18)}")
    69      print(f"sigma_*~{sp.N(sigma_star, 18)}")
    70      print(f"lambda_*~{sp.N(lambda_star, 18)}")
    71      print("PASS exact sextic threshold, tangency, and monotonicity algebra")
    72  
    73  
    74  if __name__ == "__main__":
    75      main()
===== verify_hybrid_lumping.py =====
     1  #!/usr/bin/env python3
     2  """Exact labelled audit of the five-coordinate hybrid lumping.
     3  
     4  This implementation does not import the discovery solver.  It constructs a
     5  small labelled graph, enumerates every Bd source--target and dB death--parent
     6  event over ``Fraction``, aggregates by the orbit label, and compares with an
     7  independently written formula for ``(h,i,u,v,l)`` transitions.
     8  """
     9  
    10  from __future__ import annotations
    11  
    12  from fractions import Fraction as F
    13  from itertools import combinations
    14  
    15  
    16  R = F(3, 2)
    17  CORE, PAIRS, PENDANTS = 3, 2, 2
    18  SIGMA, EPSILON = F(19, 137), F(1, 100)
    19  PAIR_WEIGHT = F(CORE, 1) / SIGMA
    20  
    21  
    22  def graph():
    23      n = CORE + 2 * PAIRS + PENDANTS
    24      weights = [[F(0) for _ in range(n)] for _ in range(n)]
    25      for a, b in combinations(range(CORE), 2):
    26          weights[a][b] = weights[b][a] = F(1)
    27      offset = CORE
    28      for pair in range(PAIRS):
    29          left, right = offset + 2 * pair, offset + 2 * pair + 1
    30          weights[left][right] = weights[right][left] = PAIR_WEIGHT
    31          for vertex in (left, right):
    32              for core in range(CORE):
    33                  weights[vertex][core] = weights[core][vertex] = EPSILON
    34      offset += 2 * PAIRS
    35      for pendant in range(PENDANTS):
    36          vertex = offset + pendant
    37          weights[0][vertex] = weights[vertex][0] = F(1)
    38      return weights
    39  
    40  
    41  def label(mask: int):
    42      h = (mask >> 0) & 1
    43      i = sum((mask >> vertex) & 1 for vertex in range(1, CORE))
    44      u = v = 0
    45      offset = CORE
    46      for pair in range(PAIRS):
    47          count = ((mask >> (offset + 2 * pair)) & 1) + ((mask >> (offset + 2 * pair + 1)) & 1)
    48          u += count == 1
    49          v += count == 2
    50      offset += 2 * PAIRS
    51      l = sum((mask >> (offset + pendant)) & 1 for pendant in range(PENDANTS))
    52      return h, i, u, v, l
    53  
    54  
    55  def add(row, target, value):
    56      if value:
    57          row[target] = row.get(target, F(0)) + value
    58  
    59  
    60  def labelled(mask: int, rule: str):
    61      weights = graph()
    62      n = len(weights)
    63      mutant = [bool(mask & (1 << vertex)) for vertex in range(n)]
    64      fitness = [R if kind else F(1) for kind in mutant]
    65      row = {}
    66      if rule == "Bd":
    67          total = sum(fitness, F(0))
    68          degree = [sum(values, F(0)) for values in weights]
    69          for parent in range(n):
    70              for target in range(n):
    71                  if weights[parent][target] and mutant[parent] != mutant[target]:
    72                      probability = fitness[parent] / total * weights[parent][target] / degree[parent]
    73                      add(row, label(mask ^ (1 << target)), probability)
    74      elif rule == "dB":
    75          for target in range(n):
    76              denominator = sum(
    77                  (fitness[parent] * weights[parent][target] for parent in range(n)), F(0)
    78              )
    79              for parent in range(n):
    80                  if weights[parent][target] and mutant[parent] != mutant[target]:
    81                      probability = F(1, n) * fitness[parent] * weights[parent][target] / denominator
    82                      add(row, label(mask ^ (1 << target)), probability)
    83      else:
    84          raise ValueError(rule)
    85      return row
    86  
    87  
    88  def declared(state, rule: str):
    89      h, i, u, v, l = state
    90      c, q, k = CORE - 1, PAIRS, PENDANTS
    91      n0 = q - u - v
    92      mp = u + 2 * v
    93      rp = 2 * q - mp
    94      W, e = PAIR_WEIGHT, EPSILON
    95      dh, do, dp = F(c) + 2 * q * e + k, F(c) + 2 * q * e, W + CORE * e
    96      row = {}
    97      if rule == "Bd":
    98          scale = 1 / (F(CORE + 2 * q + k) + (R - 1) * (h + i + mp + l))
    99          if h == 0:
   100              add(row, (1, i, u, v, l), scale * R * (F(i, 1) / do + mp * e / dp + l))
   101          else:
   102              add(row, (0, i, u, v, l), scale * (F(c - i, 1) / do + rp * e / dp + k - l))
   103          if i < c:
   104              add(row, (h, i + 1, u, v, l), scale * R * (c - i) * (F(h, 1) / dh + F(i, 1) / do + mp * e / dp))
   105          if i:
   106              add(row, (h, i - 1, u, v, l), scale * i * (F(1 - h, 1) / dh + F(c - i, 1) / do + rp * e / dp))
   107          mb = e * (F(h, 1) / dh + F(i, 1) / do)
   108          rb = e * (F(1 - h, 1) / dh + F(c - i, 1) / do)
   109          if n0:
   110              add(row, (h, i, u + 1, v, l), scale * R * 2 * n0 * mb)
   111          if u:
   112              add(row, (h, i, u - 1, v + 1, l), scale * R * u * (mb + W / dp))
   113              add(row, (h, i, u - 1, v, l), scale * u * (rb + W / dp))
   114          if v:
   115              add(row, (h, i, u + 1, v - 1, l), scale * 2 * v * rb)
   116          if h and l < k:
   117              add(row, (h, i, u, v, l + 1), scale * R * (k - l) / dh)
   118          if not h and l:
   119              add(row, (h, i, u, v, l - 1), scale * l / dh)
   120      elif rule == "dB":
   121          scale = F(1, CORE + 2 * q + k)
   122          mm, rm = i + mp * e + l, c - i + rp * e + k - l
   123          if h == 0 and mm:
   124              add(row, (1, i, u, v, l), scale * R * mm / (R * mm + rm))
   125          if h == 1 and rm:
   126              add(row, (0, i, u, v, l), scale * rm / (R * mm + rm))
   127          if i < c:
   128              mm = h + i + mp * e; rm = do - mm
   129              add(row, (h, i + 1, u, v, l), scale * (c - i) * R * mm / (R * mm + rm))
   130          if i:
   131              mm = h + i - 1 + mp * e; rm = do - mm
   132              add(row, (h, i - 1, u, v, l), scale * i * rm / (R * mm + rm))
   133          mb, rb = e * (h + i), e * (CORE - h - i)
   134          if n0 and mb:
   135              add(row, (h, i, u + 1, v, l), scale * 2 * n0 * R * mb / (R * mb + W + rb))
   136          if u:
   137              add(row, (h, i, u - 1, v + 1, l), scale * u * R * (W + mb) / (R * (W + mb) + rb))
   138              add(row, (h, i, u - 1, v, l), scale * u * (W + rb) / (R * mb + W + rb))
   139          if v and rb:
   140              add(row, (h, i, u + 1, v - 1, l), scale * 2 * v * rb / (R * (W + mb) + rb))
   141          if h and l < k:
   142              add(row, (h, i, u, v, l + 1), scale * (k - l))
   143          if not h and l:
   144              add(row, (h, i, u, v, l - 1), scale * l)
   145      else:
   146          raise ValueError(rule)
   147      return row
   148  
   149  
   150  def main():
   151      n = CORE + 2 * PAIRS + PENDANTS
   152      fibres = {}
   153      for mask in range(1 << n):
   154          fibres.setdefault(label(mask), []).append(mask)
   155      for rule in ("Bd", "dB"):
   156          for state, masks in fibres.items():
   157              expected = declared(state, rule)
   158              for mask in masks:
   159                  assert labelled(mask, rule) == expected, (rule, state, mask)
   160      print(f"PASS exact labelled hybrid lumping: n={n}, masks={1<<n}, fibres={len(fibres)}")
   161  
   162  
   163  if __name__ == "__main__":
   164      main()
===== verify_hybrid_coefficients.py =====
     1  #!/usr/bin/env python3
     2  """Exact symbolic audit of the dilute hybrid correction coefficients."""
     3  
     4  from __future__ import annotations
     5  
     6  import sympy as sp
     7  
     8  
     9  def sturm_count(poly, variable, left, right):
    10      sequence = sp.sturm(poly, variable)
    11  
    12      def variations(point):
    13          signs = []
    14          for entry in sequence:
    15              value = sp.sign(entry.subs(variable, point))
    16              assert value in (-1, 0, 1)
    17              if value:
    18                  signs.append(int(value))
    19          return sum(a != b for a, b in zip(signs, signs[1:]))
    20  
    21      return variations(left) - variations(right)
    22  
    23  
    24  def main():
    25      r, sigma, lam = sp.symbols("r sigma lam", positive=True)
    26      p = (r - 1) / r
    27  
    28      # Direct rare-invasion rates after the common positive factors are
    29      # removed.  The K2-local establishment probabilities are r/(r+1) for Bd
    30      # and 1/2 for dB.
    31      A_b, D_b = 2 * sigma * (r - 1), 2 / (r + 1)
    32      pi_b = sp.factor(A_b / (A_b + D_b))
    33      A_d, D_d = 2 * (r - 1), sigma / r
    34      pi_d = sp.factor(A_d / (A_d + D_d))
    35  
    36      F_b = sp.factor(-2 + 2 * (r / (r + 1)) * pi_b / p)
    37      F_d = sp.factor(-2 + pi_d / p)
    38      expected_b = 2 * (sigma - 1) / (1 + sigma * (r**2 - 1))
    39      expected_d = 2 * (r * (2 - r) - sigma) / (
    40          sigma + 2 * r * (r - 1)
    41      )
    42      assert sp.factor(F_b - expected_b) == 0
    43      assert sp.factor(F_d - expected_d) == 0
    44  
    45      G_b = sp.factor(F_b + lam / (r - 1))
    46      G_d = sp.factor(F_d - lam)
    47      lower = sp.factor(-(r - 1) * F_b)
    48      upper = sp.factor(F_d)
    49      assert sp.factor(G_b - (lam - lower) / (r - 1)) == 0
    50      assert sp.factor(G_d - (upper - lam)) == 0
    51  
    52      # A family with entirely rational edge weights already crosses 3/2.
    53      rational_sigma, rational_lam = sp.Rational(19, 137), sp.Rational(20, 27)
    54      endpoint_b = sp.factor(G_b.subs({r: sp.Rational(3, 2), sigma: rational_sigma, lam: rational_lam}))
    55      endpoint_d = sp.factor(G_d.subs({r: sp.Rational(3, 2), sigma: rational_sigma, lam: rational_lam}))
    56      assert endpoint_b == sp.Rational(232, 17361)
    57      assert endpoint_d == sp.Rational(65, 12123)
    58      rational_b = sp.factor(G_b.subs({sigma: rational_sigma, lam: rational_lam}))
    59      rational_d = sp.factor(G_d.subs({sigma: rational_sigma, lam: rational_lam}))
    60      assert sp.factor(rational_b - 4 * (95 * r**2 - 1593 * r + 2183) / (
    61          27 * (r - 1) * (19 * r**2 + 118)
    62      )) == 0
    63      assert sp.factor(rational_d + 2 * (6439 * r**2 - 10138 * r + 703) / (
    64          27 * (274 * r**2 - 274 * r + 19)
    65      )) == 0
    66      rational_threshold = (sp.Integer(5069) + 12 * sp.sqrt(147001)) / 6439
    67      assert sp.factor(6439 * rational_threshold**2 - 10138 * rational_threshold + 703) == 0
    68      assert sp.Rational(3, 2) < rational_threshold < sp.Rational(151, 100)
    69      assert rational_b.subs(r, rational_threshold) > 0
    70  
    71      # Optimize the two-parameter leading family.  Equality of the lower and
    72      # upper admissible lambda bounds is quadratic in sigma.  Its discriminant
    73      # is the displayed degree-six phase polynomial.
    74      phase = r**6 - 8 * r**5 + 22 * r**4 - 30 * r**3 + 21 * r**2 - 6 * r + 1
    75      equality_numerator = sp.factor(sp.together(lower - upper).as_numer_denom()[0])
    76      assert sp.factor(sp.discriminant(equality_numerator, sigma) - 4 * r**2 * phase) == 0
    77      assert sturm_count(phase, r, sp.Rational(3, 2), sp.Rational(151, 100)) == 1
    78      # There are only two real roots; the smaller is the desired one.
    79      assert sturm_count(phase, r, -100, 100) == 2
    80  
    81      real_roots = [root for root in sp.nroots(phase, n=50) if abs(sp.im(root)) < sp.Rational(1, 10) ** 40]
    82      small = min(real_roots, key=lambda value: abs(sp.re(value) - sp.Rational(3, 2)))
    83      assert sp.Rational(3, 2) < sp.re(small) < sp.Rational(151, 100)
    84      R_decimal = sp.re(small)
    85      sigma_decimal = (-R_decimal**3 + 4 * R_decimal**2 - 3 * R_decimal - 1) / (2 * (R_decimal - 1))
    86      lambda_decimal = lower.subs({r: R_decimal, sigma: sigma_decimal})
    87      assert abs(float(R_decimal) - 1.5028569127905696) < 1e-15
    88      assert abs(float(sigma_decimal) - 0.13067728228704838) < 1e-15
    89      assert abs(float(lambda_decimal) - 0.7508064830318805) < 1e-15
    90  
    91      # The exact algebraic definitions use the unique root in the rational
    92      # isolating interval.  Substitution modulo the phase polynomial verifies
    93      # the double-root sigma identity without relying on decimals.
    94      sigma_star = (-r**3 + 4 * r**2 - 3 * r - 1) / (2 * (r - 1))
    95      remainder = sp.rem(
    96          sp.together(equality_numerator.subs(sigma, sigma_star)).as_numer_denom()[0],
    97          phase,
    98          domain=sp.QQ,
    99      )
   100      assert remainder == 0
   101      derivative_remainder = sp.rem(
   102          sp.together(sp.diff(equality_numerator, sigma).subs(sigma, sigma_star)).as_numer_denom()[0],
   103          phase,
   104          domain=sp.QQ,
   105      )
   106      assert derivative_remainder == 0
   107  
   108      print(f"rational endpoint margins: Bd={endpoint_b}, dB={endpoint_d}")
   109      print(f"rational-edge-family threshold ~{float(rational_threshold):.15g}")
   110      print(f"optimized phase root ~{float(R_decimal):.15g}")
   111      print(f"optimized sigma ~{float(sigma_decimal):.15g}, lambda ~{float(lambda_decimal):.15g}")
   112      print("PASS exact hybrid coefficient and phase-polynomial audit")
   113  
   114  
   115  if __name__ == "__main__":
   116      main()
