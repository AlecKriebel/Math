   11 
   12 \hypersetup{
   13   pdftitle={A fitness-independent family of simultaneous amplifiers beyond relative fitness 3/2},
   14   pdfauthor={Alec Kriebel},
   15   pdfsubject={Simultaneous amplification under Birth--death and death--Birth Moran updating},
   16   pdfkeywords={evolutionary graph theory, Moran process, fixation probability, simultaneous amplification, Birth--death updating, death--Birth updating}
   17 }
