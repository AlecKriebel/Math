cwd: /Users/alec/Documents/Math-universal-amplification/referee_packages/paper_ii_simultaneous_amplification_referee_package_2026-08-22/source_and_certificates/universal_simultaneous_amplification/phase4_landmark_closure/paper_hybrid_threshold
