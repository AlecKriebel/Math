     1	#!/usr/bin/env python3
     2	"""Build and internally verify Paper II's deterministic public archive."""
     3	
     4	from __future__ import annotations
     5	
     6	import argparse
     7	import gzip
     8	import hashlib
     9	import io
    10	import os
    11	from pathlib import Path, PurePosixPath
    12	import tarfile
    13	import tempfile
    14	
    15	
    16	PROJECT = "universal_simultaneous_amplification"
    17	PAPER = f"{PROJECT}/phase4_landmark_closure/paper_hybrid_threshold"
    18	EPOCH = 1_787_356_800
    19	
    20	# This is an exact file whitelist.  No paper directory is included
    21	# recursively, so a future private handoff file or research artifact cannot
    22	# enter the public archive merely by being created under PAPER.
    23	INCLUDE = (
    24	    f"{PROJECT}/LICENSE",
    25	    f"{PAPER}/README.md",
    26	    f"{PAPER}/RELEASE_NOTES.md",
    27	    f"{PAPER}/RESEARCH_LOG.md",
    28	    f"{PAPER}/all.sh",
    29	    f"{PAPER}/bootstrap_replay.sh",
    30	    f"{PAPER}/build.sh",
    31	    f"{PAPER}/bundle_manifest.py",
    32	    f"{PAPER}/certificates/verify_hybrid_coefficients.py",
    33	    f"{PAPER}/certificates/verify_hybrid_lumping.py",
    34	    f"{PAPER}/certificates/verify_leading_algebra.py",
    35	    f"{PAPER}/main.tex",
    36	    f"{PAPER}/output/pdf/simultaneous_amplification_beyond_three_halves.pdf",
    37	    f"{PAPER}/release_bundle.sh",
    38	    f"{PAPER}/replay.sh",
    39	    f"{PAPER}/requirements.txt",
    40	    f"{PAPER}/verify_paper_claims.py",
    41	)
    42	
    43	EXCLUDED_PARTS = frozenset(
    44	    {
    45	        ".git",
    46	        ".venv",
    47	        ".venv-paper2",
    48	        "__pycache__",
    49	        ".pytest_cache",
    50	        ".mypy_cache",
    51	        ".ruff_cache",
    52	        "tmp",
    53	        "rendered",
    54	        "release",
    55	    }
    56	)
    57	EXCLUDED_NAMES = frozenset({".DS_Store"})
    58	EXCLUDED_SUFFIXES = frozenset(
    59	    {".aux", ".log", ".out", ".pyc", ".synctex.gz", ".toc"}
    60	)
    61	
    62	
    63	def sha256(data: bytes) -> str:
    64	    return hashlib.sha256(data).hexdigest()
    65	
    66	
    67	def excluded(relative: PurePosixPath) -> bool:
    68	    if any(part in EXCLUDED_PARTS for part in relative.parts):
    69	        return True
    70	    if relative.name in EXCLUDED_NAMES:
    71	        return True
    72	    return any(relative.name.endswith(suffix) for suffix in EXCLUDED_SUFFIXES)
    73	
    74	
    75	def collect(repo_root: Path) -> list[tuple[PurePosixPath, Path]]:
    76	    found: dict[PurePosixPath, Path] = {}
    77	    for listed in INCLUDE:
    78	        source = repo_root / listed
    79	        if not source.exists():
    80	            raise FileNotFoundError(f"required bundle input is missing: {listed}")
    81	        candidates = [source] if source.is_file() else source.rglob("*")
    82	        for candidate in candidates:
    83	            if candidate.is_symlink():
    84	                raise ValueError(f"symlinks are not permitted in bundle: {candidate}")
    85	            if not candidate.is_file():
    86	                continue
    87	            relative = PurePosixPath(candidate.relative_to(repo_root).as_posix())
    88	            if excluded(relative):
    89	                continue
    90	            found[relative] = candidate
    91	    if not found:
    92	        raise RuntimeError("bundle inclusion set is empty")
    93	    return sorted(found.items(), key=lambda item: item[0].as_posix())
    94	
    95	
    96	def tar_info(name: str, size: int, executable: bool = False) -> tarfile.TarInfo:
    97	    info = tarfile.TarInfo(name)
    98	    info.size = size
    99	    info.mtime = EPOCH
   100	    info.uid = 0
   101	    info.gid = 0
   102	    info.uname = "root"
   103	    info.gname = "root"
   104	    info.mode = 0o755 if executable else 0o644
   105	    return info
   106	
   107	
   108	def synthetic_metadata() -> bytes:
   109	    return (
   110	        "Package: A fitness-independent family of simultaneous amplifiers beyond relative fitness 3/2\n"
   111	        "Author: Alec Kriebel\n"
   112	        "ORCID: 0009-0001-9320-500X\n"
   113	        "Status: superseding manuscript submission candidate; no new persistent identifier\n"
   114	        "License: MIT\n"
   115	        "Prior source/software DOI: 10.5281/zenodo.21852072\n"
   116	        "Contents: manuscript source, PDF, exact certificates, and replay tooling\n"
   117	        "Archive format: deterministic POSIX tar compressed with deterministic gzip\n"
   118	        f"SOURCE_DATE_EPOCH: {EPOCH}\n"
   119	        "Python: 3.14.6\n"
   120	        "SymPy: 1.14.0\n"
   121	        "mpmath: 1.3.0\n"
   122	        "PDF toolchain: Tectonic 0.16.9; Poppler 26.08.0\n"
   123	        "Replay entry point: universal_simultaneous_amplification/"
   124	        "phase4_landmark_closure/paper_hybrid_threshold/replay.sh\n"
   125	    ).encode("utf-8")
   126	
   127	
   128	def write_archive(repo_root: Path, output: Path) -> tuple[int, str]:
   129	    files = collect(repo_root)
   130	    metadata = synthetic_metadata()
   131	    hashes = [(sha256(metadata), "BUNDLE_METADATA.txt")]
   132	    payloads: list[tuple[str, bytes, bool]] = [
   133	        ("BUNDLE_METADATA.txt", metadata, False)
   134	    ]
   135	
   136	    for relative, source in files:
   137	        data = source.read_bytes()
   138	        name = relative.as_posix()
   139	        hashes.append((sha256(data), name))
   140	        executable = bool(source.stat().st_mode & 0o111)
   141	        payloads.append((name, data, executable))
   142	
   143	    manifest = "".join(f"{digest}  {name}\n" for digest, name in hashes).encode(
   144	        "utf-8"
   145	    )
   146	    payloads.append(("MANIFEST.sha256", manifest, False))
   147	    payloads.sort(key=lambda item: item[0])
   148	
   149	    output.parent.mkdir(parents=True, exist_ok=True)
   150	    with tempfile.NamedTemporaryFile(
   151	        prefix=f".{output.name}.", dir=output.parent, delete=False
   152	    ) as temporary:
   153	        temporary_path = Path(temporary.name)
   154	
   155	    try:
   156	        with temporary_path.open("wb") as raw:
   157	            with gzip.GzipFile(
   158	                filename="", mode="wb", fileobj=raw, mtime=EPOCH, compresslevel=9
   159	            ) as compressed:
   160	                with tarfile.open(
   161	                    fileobj=compressed, mode="w", format=tarfile.PAX_FORMAT
   162	                ) as archive:
   163	                    for name, data, executable in payloads:
   164	                        archive.addfile(tar_info(name, len(data), executable), io.BytesIO(data))
   165	        os.replace(temporary_path, output)
   166	        os.chmod(output, 0o644)
   167	    finally:
   168	        temporary_path.unlink(missing_ok=True)
   169	
   170	    verify_archive(output)
   171	    return len(files), sha256(output.read_bytes())
   172	
   173	
   174	def verify_archive(output: Path) -> None:
   175	    with tarfile.open(output, mode="r:gz") as archive:
   176	        members = archive.getmembers()
   177	        names = [member.name for member in members]
   178	        if names != sorted(names) or len(names) != len(set(names)):
   179	            raise RuntimeError("archive members are not unique and sorted")
   180	        if any(not member.isfile() for member in members):
   181	            raise RuntimeError("archive contains a non-regular member")
   182	        expected_names = sorted({"BUNDLE_METADATA.txt", "MANIFEST.sha256", *INCLUDE})
   183	        if names != expected_names:
   184	            raise RuntimeError("archive differs from the exact public-file whitelist")
   185	        extracted = {
   186	            member.name: archive.extractfile(member).read()  # type: ignore[union-attr]
   187	            for member in members
   188	        }
   189	
   190	    manifest = extracted.pop("MANIFEST.sha256").decode("utf-8")
   191	    expected: dict[str, str] = {}
   192	    for line in manifest.splitlines():
   193	        digest, name = line.split("  ", 1)
   194	        expected[name] = digest
   195	    if set(expected) != set(extracted):
   196	        raise RuntimeError("manifest and archive file sets differ")
   197	    for name, data in extracted.items():
   198	        if sha256(data) != expected[name]:
   199	            raise RuntimeError(f"archive hash verification failed: {name}")
   200	
   201	    forbidden_paths = (
   202	        "/submission/",
   203	        "endpoint_affine",
   204	        "audit_core_uniformity.py",
   205	        "/search_",
   206	        "/explore_",
   207	    )
   208	    for name in extracted:
   209	        if any(token in name for token in forbidden_paths):
   210	            raise RuntimeError(f"forbidden non-proof dependency in archive: {name}")
   211	
   212	
   213	def main() -> None:
   214	    parser = argparse.ArgumentParser(description=__doc__)
   215	    parser.add_argument("--repo-root", type=Path, required=True)
   216	    parser.add_argument("--output", type=Path, required=True)
   217	    args = parser.parse_args()
   218	
   219	    repo_root = args.repo_root.resolve()
   220	    output = args.output.resolve()
   221	    if not (repo_root / PROJECT / "LICENSE").is_file():
   222	        raise SystemExit(f"not the expected repository root: {repo_root}")
   223	
   224	    count, digest = write_archive(repo_root, output)
   225	    print(f"WROTE: {output}")
   226	    print(f"FILES: {count + 2} (including metadata and manifest)")
   227	    print(f"SHA256: {digest}")
   228	
   229	
   230	if __name__ == "__main__":
   231	    main()
