     1  #!/usr/bin/env python3
     2  """Exact integration audit for the Paper II response theorem.
     3  
     4  This audit deliberately checks only finite symbolic and rational identities.
     5  The weak-cut, establishment, cleanup, reciprocal-invasion, and global-sweep
     6  estimates are analytic proofs in the manuscript and certificate notes.
     7  """
     8  
     9  from __future__ import annotations
    10  
    11  from fractions import Fraction as F
    12  from pathlib import Path
    13  
    14  import sympy as sp
    15  
    16  
    17  HERE = Path(__file__).resolve().parent
    18  
    19  
    20  def check_module_responses() -> None:
    21      r, sigma, lam = sp.symbols("r sigma lam", positive=True)
    22      p = (r - 1) / r
    23  
    24      z_bd = sigma * (r**2 - 1)
    25      z_db = 2 * r * (r - 1) / sigma
    26      pair_bd = sp.factor(2 * ((r / (r + 1)) * z_bd / (1 + z_bd) / p - 1))
    27      pair_db = sp.factor(2 * (sp.Rational(1, 2) * z_db / (1 + z_db) / p - 1))
    28      expected_pair_bd = 2 * (sigma - 1) / (1 + sigma * (r**2 - 1))
    29      expected_pair_db = 2 * (r * (2 - r) - sigma) / (
    30          sigma + 2 * r * (r - 1)
    31      )
    32      assert sp.factor(pair_bd - expected_pair_bd) == 0
    33      assert sp.factor(pair_db - expected_pair_db) == 0
    34  
    35      # A dilute pendant replaces one baseline core start: 1/p-1 for Bd and
    36      # 0/p-1 for dB.
    37      leaf_bd = sp.factor(1 / p - 1)
    38      leaf_db = sp.Integer(-1)
    39      assert leaf_bd == 1 / (r - 1)
    40  
    41      response_bd = sp.factor(pair_bd + lam * leaf_bd)
    42      response_db = sp.factor(pair_db + lam * leaf_db)
    43      expected_bd = expected_pair_bd + lam / (r - 1)
    44      expected_db = expected_pair_db - lam
    45      assert sp.factor(response_bd - expected_bd) == 0
    46      assert sp.factor(response_db - expected_db) == 0
    47      print("PASS: pair and pendant modules reconstruct both response functions")
    48  
    49  
    50  def check_feasibility_and_tangency() -> None:
    51      r, sigma = sp.symbols("r sigma", positive=True)
    52      phase = r**6 - 8 * r**5 + 22 * r**4 - 30 * r**3 + 21 * r**2 - 6 * r + 1
    53      lower = 2 * (1 - sigma) * (r - 1) / (1 + sigma * (r**2 - 1))
    54      upper = 2 * (r * (2 - r) - sigma) / (sigma + 2 * r * (r - 1))
    55      quadratic = (
    56          (r - 1) * sigma**2
    57          + (r**3 - 4 * r**2 + 3 * r + 1) * sigma
    58          + r * (2 * r - 3)
    59      )
    60      gap_numerator = sp.factor(sp.together(upper - lower).as_numer_denom()[0])
    61      assert sp.expand(gap_numerator + 2 * r * quadratic) == 0
    62  
    63      minimizing_sigma = (-r**3 + 4 * r**2 - 3 * r - 1) / (2 * (r - 1))
    64      minimum = sp.factor(quadratic.subs(sigma, minimizing_sigma))
    65      assert sp.factor(minimum + phase / (4 * (r - 1))) == 0
    66  
    67      polynomial = sp.Poly(phase, r, domain=sp.QQ)
    68      assert polynomial.count_roots(sp.Rational(1), sp.Rational(3, 2)) == 0
    69      assert polynomial.count_roots(sp.Rational(3, 2), sp.Rational(151, 100)) == 1
    70      assert phase.subs(r, sp.Rational(3, 2)) == sp.Rational(1, 64)
    71      assert phase.subs(r, sp.Rational(151, 100)) == -sp.Rational(
    72          39866792399, 10**12
    73      )
    74      print("PASS: feasibility gap, quadratic minimum, and isolated sextic root")
    75  
    76  
    77  def check_rational_specialization() -> None:
    78      r = sp.symbols("r", positive=True)
    79      sigma = sp.Rational(19, 137)
    80      lam = sp.Rational(20, 27)
    81      response_bd = 2 * (sigma - 1) / (1 + sigma * (r**2 - 1)) + lam / (r - 1)
    82      response_db = (
    83          2 * (r * (2 - r) - sigma) / (sigma + 2 * r * (r - 1)) - lam
    84      )
    85      endpoint = sp.Rational(3, 2)
    86      assert sp.factor(response_bd.subs(r, endpoint)) == sp.Rational(232, 17361)
    87      assert sp.factor(response_db.subs(r, endpoint)) == sp.Rational(65, 12123)
    88  
    89      rational_threshold = (sp.Integer(5069) + 12 * sp.sqrt(147001)) / 6439
    90      assert sp.factor(6439 * rational_threshold**2 - 10138 * rational_threshold + 703) == 0
    91      assert sp.Rational(3, 2) < rational_threshold < sp.Rational(151, 100)
    92      assert sp.factor(response_bd.subs(r, rational_threshold)) > 0
    93  
    94      # The explicit weak cut is a positive rational for every integer exponent.
    95      for exponent in range(1, 9):
    96          cut = F(1, 2**exponent)
    97          assert cut > 0 and cut.denominator == 2**exponent
    98      print("PASS: rational margins, algebraic response threshold, and dyadic-cut schedule")
    99  
