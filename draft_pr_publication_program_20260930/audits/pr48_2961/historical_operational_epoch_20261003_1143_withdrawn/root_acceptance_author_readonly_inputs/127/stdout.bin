  1142  \section{Pair gates and the complete post-establishment path}
  1143  
  1144  For the center, let
  1145  \[
  1146   I_H=\sum_{x\ {\rm in\ clique}}\frac1{d_x}
  1147   =1+\frac1{C-1+m},
  1148  \qquad
  1149   J_H(r)=\sum_{x\ {\rm in\ clique}}
  1150   \frac{h_H^{\dB}(\{x\};r)}{d_x},
  1151  \]
  1152  where $h_H^{\dB}$ is the isolated-center dB fixation committor.
  1153  For a pair with internal weight $W=C/\sigma$, put
  1154  \[
  1155   I_P=\frac2W=\frac{2\sigma}{C},\qquad
  1156   J_P(r)=\frac1W=\frac{\sigma}{C}.
  1157  \]
  1158  The second identity uses the exact dB singleton value $1/2$ on $K_2$.
  1159  The center estimates imply
  1160  \[
  1161   I_H=1+o(1),\qquad J_H(r)=p+o(1),
  1162  \]
  1163  while $J_H(1/r)$ and the reciprocal core fixation probability are
  1164  $o(C^{-1})$.
  1165  
  1166  \begin{proposition}[Gate odds and global sweep]
  1167  \label{prop:gate}
  1168  For every fixed $r>1$, the separated macro-fixation probabilities satisfy
  1169  \[
  1170   P_U^H=1-o(q/C),
  1171   \qquad
  1172   P_{\Bd}^P\longrightarrow\frac{Z_B}{1+Z_B},
  1173   \qquad
  1174   P_{\dB}^P\longrightarrow\frac{Z_D}{1+Z_D},
  1175  \]
  1176  where
  1177  \[
  1178   Z_B=\sigma(r^2-1),\qquad
  1179   Z_D=\frac{2r(r-1)}{\sigma}.
  1180  \]
  1181  The convergence is uniform when $r$ ranges over a compact subinterval of
  1182  $(1,\infty)$.
  1183  \end{proposition}
  1184  
  1185  \begin{proof}
  1186  For one specified pair, let $A,D,B,C'$ denote, respectively, mutant-pair
  1187  invasion of a resident center, resident-center recovery of that pair,
  1188  mutant-center invasion of a resident pair, and resident-pair recovery of
  1189  the center.  In each row below $a_P$ means the isolated pair fixation
  1190  $a_P^U$ for that update rule.  Summing the parent--target or death--parent events gives,
  1191  after a common time change,
  1192  \[
  1193  \begin{array}{c|cccc}
  1194   &A&D&B&C'\\ \hline
  1195   \Bd&
  1196   CrI_Pu_{\rm core}^{\Bd}(r)&
  1197   2I_Ha_P(1/r)&
  1198   2rI_Ha_P(r)&
  1199   CI_Pu_{\rm core}^{\Bd}(1/r)\\[1mm]
  1200   \dB&
  1201   2rJ_H(r)&
  1202   (C/r)J_P(1/r)&
  1203   CrJ_P(r)&
  1204   (2/r)J_H(1/r).
  1205  \end{array}
  1206  \]
  1207  The isolated pair values are
  1208  \[
  1209   a_P^{\Bd}(r)=\frac r{r+1},\quad
  1210   a_P^{\Bd}(1/r)=\frac1{r+1},\quad
  1211   a_P^{\dB}(r)=a_P^{\dB}(1/r)=\frac12.
  1212  \]
  1213  
  1214  On macro states the only nonzero rates are
  1215  \[
  1216  \begin{array}{ll}
  1217   (0,k)\to(1,k):kA,&(0,k)\to(0,k-1):kD,\\
  1218   (1,k)\to(1,k+1):(q-k)B,&(1,k)\to(0,k):(q-k)C'.
  1219  \end{array}
  1220  \]
  1221  From $(1,k)$, the chance that the center reverses before the next pair
  1222  conversion is $C'/(B+C')$.  A union bound over at most $q$ conversions gives
  1223  \[
  1224   1-P_U^H\le q\frac{C'}{B+C'}.
  1225  \]
  1226  Proposition~\ref{prop:center} and the portal estimates give
  1227  $qC'/B=o(q/C)$, uniformly on each fitness compact.  Thus a mutant center
  1228  converts all resident pairs with probability $1-o(q/C)$.
  1229  
  1230  From $(0,1)$, the first successful macro event is either center invasion at
  1231  rate $A$ or loss of the sole mutant pair at rate $D$.  Hence
  1232  \[
  1233   P_U^P=\frac{A}{A+D}\,p_{1,1},
  1234  \]
  1235  where $p_{1,1}$ is the macro-fixation probability from $(1,1)$.  The same
  1236  sweep bound, now with at most $q-1$ remaining conversions, gives
  1237  $p_{1,1}\to1$.  (Equivalently,
  1238  $P_U^P=[A/(A+D)][(B+C')/B]P_U^H$.)
  1239  The rate table and the isolated $K_2$ values give
  1240  \[
  1241   Z_B=\sigma(r^2-1),\qquad
  1242   Z_D=\frac{2r(r-1)}{\sigma}.
  1243  \]
  1244  More precisely, $A/D\to Z_U$, which yields the stated limits.  The argument
  1245  uses the exact absorbing macro chain, including adverse reversals; no
  1246  branching survival probability is substituted for global fixation.
  1247  \end{proof}
  1248  
  1249  \section{The simultaneous correction and its optimization}
  1250  
  1251  Put $\eta=q/C$.  Substitution of
  1252  \eqref{eq:center-Bd}--\eqref{eq:center-dB} and
  1253  Proposition~\ref{prop:gate} into the finite trace gives the key asymptotic
  1254  statement.
  1255  
  1256  \begin{proposition}[Two response functions]
  1257  \label{prop:responses}
  1258  For $C=t^4$, $q=t$, $m/q\to\lambda$, and fixed $\sigma>0$, the separated
  1259  trace satisfies
  1260  \begin{align}
  1261   \frac{\rho^0_{\Bd,t}(r)}{\rho_{\Bd}(K_{n_t},r)}
  1262   &=1+\eta\left[
  1263   \frac{2(\sigma-1)}{1+\sigma(r^2-1)}
  1264   +\frac{\lambda}{r-1}\right]+o_r(\eta),\label{eq:B}\\
  1265   \frac{\rho^0_{\dB,t}(r)}{\rho_{\dB}(K_{n_t},r)}
  1266   &=1+\eta\left[
  1267   \frac{2\{r(2-r)-\sigma\}}{\sigma+2r(r-1)}
  1268   -\lambda\right]+o_r(\eta).\label{eq:D}
  1269  \end{align}
  1270  The remainders are uniform on every compact subinterval of $(1,\infty)$.
  1271  \end{proposition}
  1272  
  1273  \begin{proof}
  1274  The complete-graph Bd baseline differs from $p$ exponentially in $C$, while
  1275  the dB baseline differs from $p$ by $O(C^{-1})$; both errors are
  1276  $o(\eta)$.  The center terms follow from
  1277  \eqref{eq:center-Bd}--\eqref{eq:center-dB}.  The pair terms follow by the
  1278  exact simplifications
  1279  \begin{align}
  1280   2\left\{\frac{[r/(r+1)]Z_B/(1+Z_B)}p-1\right\}
  1281   &=\frac{2(\sigma-1)}{1+\sigma(r^2-1)},\\
  1282   2\left\{\frac{[1/2]Z_D/(1+Z_D)}p-1\right\}
  1283   &=\frac{2\{r(2-r)-\sigma\}}{\sigma+2r(r-1)}.
  1284  \end{align}
  1285  One leaf replaces one core vertex and contributes
  1286  $1/p-1=1/(r-1)$ under Bd and $-1$ under dB.
  1287  All inputs are compact-uniform by Propositions~\ref{prop:weak-trace},
  1288  \ref{prop:center}, and~\ref{prop:gate}, so the combined remainders are as
  1289  stated.
  1290  \end{proof}
  1291  
  1292  \begin{lemma}[Exact tangency]
  1293  \label{lem:tangency}
  1294  At $(\sigma_*,\lambda_*)$, both response functions in
  1295  \eqref{eq:B}--\eqref{eq:D} are strictly positive for every
  1296  $1<r<\Rhyb$ and vanish simultaneously at $r=\Rhyb$.
  1297  \end{lemma}
  1298  
  1299  \begin{proof}
  1300  Both bracketed corrections are positive precisely when
  1301  \[
  1302   L(r,\sigma)<\lambda<U(r,\sigma),
  1303  \]
  1304  where
  1305  \[
  1306   L=\frac{2(1-\sigma)(r-1)}{1+\sigma(r^2-1)},\qquad
  1307   U=\frac{2\{r(2-r)-\sigma\}}{\sigma+2r(r-1)}.
  1308  \]
  1309  After multiplication by positive denominators, $L<U$ is equivalent to
  1310  \[
  1311   F_r(\sigma)<0,
  1312  \]
  1313  where
  1314  \[
  1315   F_r(\sigma)
  1316   =(r-1)\sigma^2+(r^3-4r^2+3r+1)\sigma+r(2r-3).
  1317  \]
  1318  Its minimizing value and minimum are
  1319  \[
  1320   \sigma(r)=\frac{-r^3+4r^2-3r-1}{2(r-1)},\qquad
  1321   \min_\sigma F_r(\sigma)=-\frac{P(r)}{4(r-1)}.
  1322  \]
  1323  Exact Sturm counting gives no root of $P$ in $(1,3/2)$ and exactly one in
  1324  $(3/2,151/100)$.  At that root, $\sigma_*$ is the double tangency and
  1325  \[
  1326   L(\Rhyb,\sigma_*)=U(\Rhyb,\sigma_*)=\lambda_*.
  1327  \]
  1328  For fixed $\sigma_*$, $L$ is increasing and $U$ decreasing on
  1329  $(1,\Rhyb)$ because
  1330  \[
  1331   \partial_rL=
  1332   \frac{2(\sigma-1)\{\sigma(r-1)^2-1\}}
  1333        {\{1+\sigma(r^2-1)\}^2}>0,\qquad
  1334   \partial_rU=
  1335   \frac{4r(\sigma-r)}{\{2r(r-1)+\sigma\}^2}<0.
  1336  \]
  1337  Here $0<\sigma_*<1<r$ and
  1338  $\sigma_*(r-1)^2<1$ throughout the isolating interval, so the displayed
  1339  factorizations determine the signs without numerical approximation.
  1340  Thus
  1341  \[
  1342   L(r,\sigma_*)<\lambda_*<U(r,\sigma_*)
  1343   \quad(1<r<\Rhyb),
  1344  \]
  1345  which proves the claim.
  1346  \end{proof}
  1347  
  1348  \begin{proof}[Proof of Theorem~\ref{thm:main}]
  1349  Fix $r\in(1,\Rhyb)$.  Then $r\in I_t$ for every sufficiently large $t$.
  1350  By Proposition~\ref{prop:responses} and Lemma~\ref{lem:tangency}, the two
  1351  separated normalized gains, after multiplication by $n_t/q_t$, converge to
  1352  strictly positive numbers.  The defining inequality for $e_t$ changes each
  1353  scaled gain by at most $1/t$.  Thus both actual connected-graph gains are
  1354  strictly positive for all sufficiently large $t$.  The sequence, including
  1355  every weak-edge weight, was fixed before $r$ was chosen, which is exactly the
  1356  quantifier order in the definition of $\Rsim$.
  1357  \end{proof}
  1358  
  1359  \begin{proposition}[Fixed-parameter response optimality]
  1360  \label{prop:fixed-response-optimal}
  1361  Among fixed positive $(\sigma,\lambda)$ in the displayed first-order dilute
  1362  pair--pendant response model \eqref{eq:B}--\eqref{eq:D}, $\Rhyb$ is the exact
  1363  largest threshold of an interval beginning at one on which both corrections
  1364  can remain positive.
  1365  \end{proposition}
  1366  
  1367  \begin{proof}
  1368  For fixed positive $\sigma$, feasibility implies $F_r(\sigma)<0$, and hence
  1369  $\min_{s\in\mathbb R}F_r(s)<0$.  At $\Rhyb$ the unconstrained minimum is
  1370  zero at the admissible value $0<\sigma_*<1$.  Exact evaluation gives
  1371  \[
  1372   P(3/2)=\frac1{64}>0,\qquad
  1373   P(151/100)=-\frac{39866792399}{10^{12}}<0.
  1374  \]
  1375  The Sturm count in Lemma~\ref{lem:tangency} shows that $\Rhyb$ is the only
  1376  root between these endpoints.  Hence $P(r)<0$ on
  1377  $(\Rhyb,151/100]$ and
  1378  $\min_sF_r(s)=-P(r)/\{4(r-1)\}>0$ there.  No positive $\sigma$---indeed no
  1379  real $\sigma$---is feasible immediately beyond $\Rhyb$.  Since the fixed
  1380  pair $(\sigma_*,\lambda_*)$ works throughout $(1,\Rhyb)$, no interval
  1381  beginning at one can extend farther within this response model.
  1382  \end{proof}
  1383  
  1384  \begin{corollary}[A rational-edge family]
  1385  \label{cor:rational}
  1386  Taking $\sigma=19/137$ and $\lambda=20/27$ gives, exactly at $r=3/2$,
  1387  \[
  1388   B=\frac{232}{17361}>0,\qquad
  1389   D=\frac{65}{12123}>0.
  1390  \]
  1391  This choice gives a family with entirely rational edge weights and algebraic
  1392  response threshold
  1393  \[
  1394   R_{\mathbb Q}
  1395   =\frac{5069+12\sqrt{147001}}{6439}
  1396   =1.50176815223369\ldots>3/2.
  1397  \]
  1398  Thus a family with rational internal ratios and rational positive weak edges
  1399  already proves a strict interval beyond $3/2$.
  1400  \end{corollary}
  1401  
  1402  \begin{proof}
  1403  Substitution into \eqref{eq:B}--\eqref{eq:D} gives the two displayed
  1404  margins.  For these rational parameters the dB response first vanishes at
  1405  the unique root in $(1,2)$ of
  1406  \[
  1407   6439r^2-10138r+703=0,
  1408  \]
  1409  which is $R_{\mathbb Q}$; the Bd response is still strictly positive there.
  1410  Both responses are therefore positive on $(1,R_{\mathbb Q})$ by the same
  1411  monotonicity calculation used in Lemma~\ref{lem:tangency}.  The weak edges
  1412  remain rational as well: repeat the least-dyadic diagonal construction with
  1413  $I_t=[1+1/t,R_{\mathbb Q}-1/t]$, $\sigma=19/137$, and
  1414  $m_t=\lfloor(20/27)t\rfloor$.  Every edge-weight ratio in this specialized
  1415  family is therefore rational.
  1416  \end{proof}
  1417  
  1418  \section{Discussion}
  1419  
  1420  The central contribution is the quantifier in Theorem~\ref{thm:main}.  One
