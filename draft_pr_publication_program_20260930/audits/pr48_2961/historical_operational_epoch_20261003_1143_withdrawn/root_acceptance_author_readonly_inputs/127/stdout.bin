   141  \section{Model, baselines, and threshold}
   142  
   143  Let $G=(V,w)$ be finite, connected, loopless, undirected, and weighted:
   144  \[
   145   w_{uv}=w_{vu}\geq0,\qquad w_{uu}=0,\qquad
   146   d_u:=\sum_vw_{uv}>0.
   147  \]
   148  A state is a mutant set $S\subseteq V$.  Mutants have fitness $r>1$ and
   149  residents fitness one.  Under Bd, a parent is selected proportional to
   150  fitness and then a replacement target proportional to edge weight.  Under
   151  dB, a uniformly chosen target dies and then a parent is selected
   152  proportional to fitness times edge weight.  Thus, with
   153  $F(S)=|V|+(r-1)|S|$,
   154  \begin{align}
   155   P_{\Bd}(S,S\cup\{v\})
   156   &=\frac r{F(S)}\sum_{u\in S}\frac{w_{uv}}{d_u},
   157   &&v\notin S,\\
   158   P_{\Bd}(S,S\setminus\{v\})
   159   &=\frac1{F(S)}\sum_{u\notin S}\frac{w_{uv}}{d_u},
   160   &&v\in S,\\
   161   P_{\dB}(S,S\cup\{v\})
   162   &=\frac1{|V|}
   163   \frac{r\sum_{u\in S}w_{uv}}
   164   {r\sum_{u\in S}w_{uv}+\sum_{u\notin S}w_{uv}},
   165   &&v\notin S,\\
   166   P_{\dB}(S,S\setminus\{v\})
   167   &=\frac1{|V|}
   168   \frac{\sum_{u\notin S}w_{uv}}
   169   {r\sum_{u\in S}w_{uv}+\sum_{u\notin S}w_{uv}},
   170   &&v\in S.
   171  \end{align}
   172  The fixation function $h_U$ is the unique harmonic solution with boundary
   173  values zero at $\varnothing$ and one at $V$.  We use
   174  \[
   175   \rho_U(G,r)=\frac1{|V|}\sum_{v\in V}h_U(\{v\}),
   176   \qquad U\in\{\Bd,\dB\}.
   177  \]
   178  
   179  Direct solution of the one-dimensional complete-graph count chains gives
   180  \begin{align}
   181   \rho_{\Bd}(K_n,r)
   182   &=\frac{1-r^{-1}}{1-r^{-n}},\\
   183   \rho_{\dB}(K_n,r)
   184   &=\frac{n-1}{n}\frac{1-r^{-1}}{1-r^{-(n-1)}}.
   185  \end{align}
   186  Both converge, for fixed $r>1$, to
   187  \[
   188   p(r):=1-\frac1r.
   189  \]
   190  
   191  \begin{definition}
   192  $\Rsim$ is the supremum of all $R>1$ for which one
   193  fitness-independent family $\{G_t\}$, with $|V(G_t)|\to\infty$, satisfies
   194  \[
   195   \rho_{\Bd}(G_t,r)>\rho_{\Bd}(K_{|V(G_t)|},r),\qquad
   196   \rho_{\dB}(G_t,r)>\rho_{\dB}(K_{|V(G_t)|},r)
   197  \]
   198  for every fixed $r\in(1,R)$ and every sufficiently large $t$.
   199  \end{definition}
   200  
   201  \section{The pair--pendant construction and main theorem}
   202  
   203  Let
   204  \[
   205   P(R)=R^6-8R^5+22R^4-30R^3+21R^2-6R+1
   206  \]
   207  and let $\Rhyb$ be its unique root in $(3/2,151/100)$.  Define
   208  \begin{align}
   209   \sigma_*&=
   210   \frac{-\Rhyb^3+4\Rhyb^2-3\Rhyb-1}{2(\Rhyb-1)},\\
   211   \lambda_*&=
   212   \frac{2(\Rhyb-1)(1-\sigma_*)}
   213   {1+\sigma_*(\Rhyb^2-1)}.
   214  \end{align}
   215  Exact root isolation gives
   216  \[
   217   \Rhyb=1.5028569127905696\ldots,\quad
   218   \sigma_*=0.1306772822870484\ldots,\quad
   219   \lambda_*=0.7508064830318805\ldots .
   220  \]
   221  
   222  For $t\geq2$, put
   223  \[
   224   q_t=t,\qquad m_t=\lfloor\lambda_*t\rfloor,\qquad C_t=t^4,
   225  \qquad n_t=C_t+m_t+2q_t.
   226  \]
   227  The graph contains:
   228  \begin{enumerate}
   229  \item a unit-weight clique on $C_t$ vertices, one designated as the hub;
   230  \item $m_t$ unit-weight leaves adjacent only to the hub;
   231  \item $q_t$ disjoint two-vertex satellites, each with internal edge weight
   232        $W_t=C_t/\sigma_*$;
   233  \item an edge of common weight $\eps_t>0$ from every satellite vertex to
   234        every clique vertex.
   235  \end{enumerate}
   236  There are no other edges.  In particular, there are no edges between
   237  distinct satellites.
   238  
   239  \begin{figure}[ht]
   240  \centering
   241  \begin{tikzpicture}[scale=0.95,
   242   core/.style={circle,draw,fill=blue!12,minimum size=5mm},
   243   pair/.style={circle,draw,fill=orange!18,minimum size=5mm},
   244   leaf/.style={circle,draw,fill=green!15,minimum size=4mm}]
   245  \node[core,thick] (h) at (0,0) {$H$};
   246  \node[core] (c1) at (-1.5,0.8) {};
   247  \node[core] (c2) at (-1.5,-0.8) {};
   248  \node[core] (c3) at (0,1.5) {};
   249  \node[core] (c4) at (0,-1.5) {};
   250  \foreach \x/\y in {h/c1,h/c2,h/c3,h/c4,c1/c2,c1/c3,c2/c4,c3/c4}
   251   \draw[blue!55] (\x)--(\y);
   252  \node[leaf] (l1) at (1.2,1.8) {};
   253  \node[leaf] (l2) at (1.8,1.2) {};
   254  \node[leaf] (l3) at (2.0,0.4) {};
   255  \foreach \x in {l1,l2,l3}\draw[green!50!black] (h)--(\x);
   256  \node[pair] (a1) at (4.0,1.0) {};
   257  \node[pair] (a2) at (5.0,1.0) {};
   258  \node[pair] (b1) at (4.0,-1.0) {};
   259  \node[pair] (b2) at (5.0,-1.0) {};
   260  \draw[orange!80!black,very thick] (a1)--node[above] {$C_t/\sigma_*$}(a2);
   261  \draw[orange!80!black,very thick] (b1)--(b2);
   262  \foreach \x in {a1,a2,b1,b2}{
   263   \draw[gray!65!black,dashed] (\x)--(c3);
   264   \draw[gray!65!black,dashed] (\x)--(c4);
   265  }
   266  \node[align=center] at (-1.7,-2.0) {unit clique\\$C_t=t^4$};
   267  \node[align=center] at (1.9,2.25) {$m_t$ hub leaves};
   268  \node[align=center] at (4.5,-1.75) {$q_t$ heavy pairs};
   269  \node[gray!65!black] at (3.2,0) {all weak edges $\eps_t$};
   270  \end{tikzpicture}
   271  \caption{Schematic of the dilute hybrid.  Dashed lines represent all
   272  satellite--clique edges, not only those drawn.}
   273  \label{fig:hybrid}
   274  \end{figure}
   275  
   276  To define the positive coupling without reference to a subsequently chosen
   277  fitness, let
   278  \[
   279   I_t=[1+1/t,\Rhyb-1/t]
   280  \]
   281  when this interval is nonempty.  Let $\rho^0_{U,t}$ denote the finite
   282  separated trace defined in Section~\ref{sec:trace}.  Choose $e_t$ to be the
   283  least positive integer such that, for $\eps_t=2^{-e_t}$,
   284  \[
   285   \sup_{r\in I_t}\frac{n_t}{q_t}
   286   \left|
   287   \frac{\rho_U(G_t(\eps_t),r)}{\rho_U(K_{n_t},r)}
   288   -\frac{\rho^0_{U,t}(r)}{\rho_U(K_{n_t},r)}
   289   \right|\leq\frac1t
   290   \quad (U=\Bd,\dB).
   291  \]
   292  For the finitely many empty intervals, take $e_t=1$.
   293  
   294  \begin{lemma}[Effective dyadic diagonal]
   295  \label{lem:effective-diagonal}
   296  The integer $e_t$ exists and is computable by exact real-algebraic
   297  arithmetic.  In particular, the family $\{G_t\}$ is effectively defined and
   298  every one of its weights is fixed before fitness is quantified.
   299  \end{lemma}
   300  
   301  \begin{proof}
   302  Work over the algebraic number field $\mathbb K=\mathbb Q(\Rhyb)$.
   303  Both $\sigma_*$ and $\lambda_*$ lie in $\mathbb K$, and
   304  $m_t=\lfloor\lambda_*t\rfloor$ is obtained by an exact comparison of real
   305  algebraic numbers.  For fixed $t,e$ and either update rule, the transient
   306  first-step system of $G_t(2^{-e})$ has entries in $\mathbb K(r)$.  Cramer's
   307  rule therefore puts its fixation probability in $\mathbb K(r)$; the same is
   308  true of the finite separated trace and the complete-graph baseline.  For
   309  each $r\in I_t$, every transient block $Q(r)$ occurring in these absorbing
   310  systems is substochastic with spectral radius less than one.  Hence
   311  $I-Q(r)$ is a nonsingular $M$-matrix and
   312  $\det(I-Q(r))>0$; the event denominators are positive as well.
   313  
   314  After clearing those positive denominators, each of the two absolute-value
   315  conditions defining $e_t$ is a pair of polynomial inequalities over
   316  $\mathbb K$ quantified on the algebraic interval $I_t$.  Its truth is
   317  decidable by Sturm--subresultant arithmetic, equivalently by quantifier
   318  elimination in the real closure of $\mathbb K$.  Proposition
   319  \ref{prop:weak-trace} gives uniform convergence on $I_t$, so some exponent is
   320  admissible.  Testing $e=1,2,\ldots$ by the exact decision procedure therefore
   321  terminates at the least admissible $e_t$.
   322  \end{proof}
   323  
   324  \begin{theorem}[Main theorem]
   325  \label{thm:main}
   326  For every fixed $1<r<\Rhyb$, the family above satisfies, for every
   327  sufficiently large $t$,
   328  \[
   329   \rho_{\Bd}(G_t,r)>\rho_{\Bd}(K_{n_t},r),\qquad
   330   \rho_{\dB}(G_t,r)>\rho_{\dB}(K_{n_t},r).
   331  \]
   332  Consequently
   333  \[
   334   \boxed{\Rsim\geq\Rhyb=1.5028569127905696\ldots>3/2.}
   335  \]
   336  \end{theorem}
   337  
   338  \section{Exact lumping and the weak-cut limiting trace}
   339  \label{sec:trace}
   340  
   341  A configuration has orbit label
   342  \[
   343   (h,i,u,v,\ell),
   344  \]
   345  where $h$ is the hub type, $i$ the number of mutant ordinary clique
   346  vertices, $u$ the number of mixed pairs, $v$ the number of all-mutant pairs,
   347  and $\ell$ the mutant-leaf count.  The group
   348  \[
   349  S_{C_t-1}\times(S_2\wr S_{q_t})\times S_{m_t}
   350  \]
   351  is transitive on every fibre and commutes with both update kernels.  This
   352  immediately gives the following exact reduction.
   353  
   354  \begin{lemma}[Strong orbit lumping]
   355  \label{lem:lumping}
   356  For every positive value of the weak-edge weight and for both update rules,
   357  the total transition probability from a labelled configuration to a target
   358  fibre depends only on $(h,i,u,v,\ell)$.
   359  \end{lemma}
   360  
   361  \begin{proof}
   362  Every permutation in the displayed wreath-product action preserves vertex
   363  degrees, edge weights, types, and fitnesses.  It therefore commutes with each
   364  labelled parent--target event under Bd and each labelled death--parent event
   365  under dB.  Summing events into a target fibre proves strong lumpability.
   366  \end{proof}
   367  
   368  We next fix finite $C,m,q$ and send $\eps\downarrow0$.  At $\eps=0$ the
   369  closed fast classes are precisely the states in which the center module and
   370  every pair are internally homogeneous.  Write a macro state as
   371  \[
   372   (h,k)\in\{0,1\}\times\{0,\ldots,q\},
   373  \]
   374  where $h$ is the center type and $k$ the number of mutant pairs.  Partition
   375  the finite first-step matrix into mixed-module states $F$ and all
   376  monomorphic-module states $M$, explicitly including global extinction and
   377  fixation.  Their two harmonic values remain fixed at zero and one.
   378  
   379  \begin{proposition}[Finite-state weak-cut limiting trace]
   380  \label{prop:weak-trace}
   381  Let $a_H^U,a_P^U$ be the uniformly initialized isolated fixation
   382  probabilities of the center and one pair, and let $P_U^H,P_U^P$ be fixation
   383  probabilities of the limiting macro chain from $(1,0)$ and $(0,1)$.  For
   384  $U\in\{\Bd,\dB\}$,
   385  \begin{equation}
   386   \rho_U^0(C,m,q;r)
   387   =\frac{C+m}{N}a_H^U(r)P_U^H
   388   +\frac{2q}{N}a_P^U(r)P_U^P,
   389   \qquad N=C+m+2q.
   390  \label{eq:finite-trace}
   391  \end{equation}
   392  Moreover, $\rho_U(G(C,m,q,\eps),r)\to\rho_U^0(C,m,q;r)$ uniformly in $r$
   393  on every compact subinterval of $(0,\infty)$.
   394  \end{proposition}
   395  
   396  \begin{proof}
   397  Order the states as $M,F$.  At $\eps=0$, the first-step matrix
   398  has the block form
   399  \[
   400   P_U(0)=
   401   \begin{pmatrix}I&0\\ C_0&Q_0\end{pmatrix},
   402   \qquad \rho(Q_0)<1.
   403  \]
   404  Indeed, from a mixed state each finite connected module absorbs internally
   405  almost surely, so $I-Q_0$ is invertible with nonnegative inverse and
   406  $(I-Q_0)^{-1}C_0$ is the stochastic matrix of its first monomorphic return.
   407  Expanding the positive-cut chain gives
   408  \[
   409   P_{MM}(\eps)=I+\eps A+O(\eps^2),\qquad
   410   P_{MF}(\eps)=\eps B+O(\eps^2),
   411  \]
   412  and $P_{FM}(\eps)=C_0+O(\eps)$,
   413  $P_{FF}(\eps)=Q_0+O(\eps)$.  Eliminating $F$ from the finite harmonic
   414  system yields, after division by the common factor $\eps$, the macro
   415  generator
   416  \begin{equation}
   417   \mathcal L_U=A+B(I-Q_0)^{-1}C_0.
   418  \label{eq:schur-trace}
   419  \end{equation}
   420  The second term first makes one cross-module introduction and then resolves
   421  its entire zero-cut internal excursion.  Its absorption distribution is
   422  therefore exactly the affected module's local fixation probability.  On the
   423  two globally absorbing macro states we retain boundary values zero and one;
   424  on every other macro state, the leading harmonic equation is
   425  $\mathcal L_Uh=0$.  Positive introduction rates make every interior state
   426  of this finite macro ladder transient.  On a compact fitness interval its
   427  interior inverse is uniformly bounded, so the boundary-value problem has a
   428  unique solution.  This is the claimed
   429  introduction-rate-times-fixation trace, derived from the finite chain rather
   430  than from independent lineages.
   431  
   432  A uniformly chosen initial mutant first resolves inside its center or pair
   433  module with probability $1-O(\eps)$.  Conditioning on which module fixes
   434  locally gives \eqref{eq:finite-trace}.  All matrices are finite and their
   435  entries are continuous rational functions of $(\eps,r)$ with positive event
   436  denominators.  After fixing the two boundary coordinates, the scaled Schur
   437  complement converges to the invertible interior restriction of
   438  $\mathcal L_U$.  On a compact fitness interval that limiting inverse,
   439  $(I-Q_0)^{-1}$, and the nearby absorbing inverses are uniformly bounded.
   440  The block expansion and hence the convergence are uniform there.
   441  \end{proof}
   442  
   443  \section{Clique--pendant estimates at the gain scale}
