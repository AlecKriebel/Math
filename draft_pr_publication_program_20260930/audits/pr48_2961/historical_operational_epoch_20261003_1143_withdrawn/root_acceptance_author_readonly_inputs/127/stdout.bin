    11  assert sys.version_info[:3] == (3, 14, 6), sys.version
    12  '
    13  
    14  if [ ! -x "$venv/bin/python" ]; then
    15    "$bootstrap_python" -m venv "$venv"
    16  fi
    17  
    18  "$venv/bin/python" -m pip install \
    19    --disable-pip-version-check \
    20    --no-cache-dir \
    21    --requirement "$paper_dir/requirements.txt"
    22  
    23  "$venv/bin/python" -c '
    24  import importlib.metadata as metadata
    25  import sys
    26  assert sys.version_info[:3] == (3, 14, 6), sys.version
    27  assert metadata.version("sympy") == "1.14.0"
    28  assert metadata.version("mpmath") == "1.3.0"
    29  print("PASS: Python 3.14.6, SymPy 1.14.0, and mpmath 1.3.0")
    30  '
    31  
    32  PYTHON="$venv/bin/python" "$paper_dir/replay.sh"
