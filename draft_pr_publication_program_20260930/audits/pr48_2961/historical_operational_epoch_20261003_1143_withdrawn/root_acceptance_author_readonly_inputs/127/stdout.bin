    10	
    11	
    12	PACKAGE = Path(__file__).resolve().parent
    13	ARCHIVE_NAME = (
    14	    "simultaneous_amplifier_beyond_three_halves_"
    15	    "source_and_certificates.tar.gz"
    16	)
    17	PDF_NAME = "simultaneous_amplification_beyond_three_halves.pdf"
    18	SOURCE_PDF = PurePosixPath(
    19	    "universal_simultaneous_amplification/phase4_landmark_closure/"
    20	    "paper_hybrid_threshold/output/pdf/"
    21	    "simultaneous_amplification_beyond_three_halves.pdf"
    22	)
    23	COMMIT = "2302d7c6ae17fc061a985da322df6d0600b66672"
    24	TAG = "simultaneous-amplification-beyond-three-halves-v2.0.1"
    25	HEX64 = re.compile(r"[0-9a-f]{64}")
    26	
    27	
    28	def digest(path: Path) -> str:
    29	    value = hashlib.sha256()
    30	    with path.open("rb") as stream:
    31	        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
    32	            value.update(chunk)
    33	    return value.hexdigest()
    34	
    35	
    36	def parse_manifest(text: str, label: str) -> dict[PurePosixPath, str]:
    37	    expected: dict[PurePosixPath, str] = {}
    38	    for number, line in enumerate(text.splitlines(), 1):
    39	        try:
    40	            claimed, raw_name = line.split("  ", 1)
    41	        except ValueError as exc:
    42	            raise RuntimeError(f"{label}:{number}: malformed line") from exc
    43	        name = PurePosixPath(raw_name)
    44	        if not HEX64.fullmatch(claimed):
    45	            raise RuntimeError(f"{label}:{number}: malformed SHA-256")
    46	        if name.is_absolute() or ".." in name.parts or name.as_posix() != raw_name:
    47	            raise RuntimeError(f"{label}:{number}: unsafe or noncanonical path")
    48	        if name in expected:
    49	            raise RuntimeError(f"{label}:{number}: duplicate path")
    50	        expected[name] = claimed
    51	    if not expected:
    52	        raise RuntimeError(f"{label}: empty manifest")
    53	    return expected
    54	
    55	
    56	def verify_package_manifest() -> int:
    57	    manifest_path = PACKAGE / "PACKAGE_MANIFEST.sha256"
    58	    expected = parse_manifest(
    59	        manifest_path.read_text(encoding="ascii"), manifest_path.name
    60	    )
    61	    actual: set[PurePosixPath] = set()
    62	    for path in PACKAGE.rglob("*"):
    63	        if path.is_symlink():
    64	            raise RuntimeError(f"package contains a symlink: {path}")
    65	        if path.is_dir():
    66	            continue
    67	        if not path.is_file():
    68	            raise RuntimeError(f"package contains a non-regular node: {path}")
    69	        if path == manifest_path:
    70	            continue
    71	        actual.add(PurePosixPath(path.relative_to(PACKAGE).as_posix()))
    72	    if actual != set(expected):
    73	        missing = sorted(str(path) for path in set(expected) - actual)
    74	        unexpected = sorted(str(path) for path in actual - set(expected))
    75	        raise RuntimeError(
    76	            f"package file-set mismatch; missing={missing}, "
    77	            f"unexpected={unexpected}"
    78	        )
    79	    for name, claimed in expected.items():
    80	        if digest(PACKAGE / name) != claimed:
    81	            raise RuntimeError(f"package hash mismatch: {name}")
    82	    return len(expected)
    83	
    84	
    85	def verify_source_archive() -> tuple[int, str, str]:
    86	    archive_path = PACKAGE / ARCHIVE_NAME
    87	    archive_digest = digest(archive_path)
    88	    sidecar = (PACKAGE / f"{ARCHIVE_NAME}.sha256").read_text(encoding="ascii")
    89	    if sidecar != f"{archive_digest}  {ARCHIVE_NAME}\n":
    90	        raise RuntimeError("detached source-archive checksum mismatch")
    91	
    92	    with tarfile.open(archive_path, mode="r:gz") as archive:
    93	        members = archive.getmembers()
    94	        names = [member.name for member in members]
    95	        if names != sorted(names) or len(names) != len(set(names)):
    96	            raise RuntimeError("source archive members are not unique and sorted")
    97	        if any(not member.isfile() for member in members):
    98	            raise RuntimeError("source archive contains a non-regular member")
    99	        for member in members:
   100	            name = PurePosixPath(member.name)
   101	            if (
   102	                name.is_absolute()
   103	                or ".." in name.parts
   104	                or name.as_posix() != member.name
   105	            ):
   106	                raise RuntimeError(f"unsafe source archive member: {member.name}")
   107	        payloads = {
   108	            PurePosixPath(member.name): archive.extractfile(member).read()
   109	            for member in members
   110	        }
   111	
   112	    manifest_bytes = payloads.pop(PurePosixPath("MANIFEST.sha256"), None)
   113	    if manifest_bytes is None:
   114	        raise RuntimeError("source archive lacks MANIFEST.sha256")
   115	    internal = parse_manifest(
   116	        manifest_bytes.decode("ascii"), "source archive MANIFEST.sha256"
   117	    )
   118	    if set(internal) != set(payloads):
   119	        raise RuntimeError("source archive manifest and payload sets differ")
   120	
   121	    extracted_root = PACKAGE / "source_and_certificates"
   122	    extracted_files: set[PurePosixPath] = set()
   123	    for path in extracted_root.rglob("*"):
   124	        if path.is_symlink():
   125	            raise RuntimeError(f"extracted tree contains a symlink: {path}")
   126	        if path.is_dir():
   127	            continue
   128	        if not path.is_file():
   129	            raise RuntimeError(f"extracted tree contains a non-regular node: {path}")
   130	        extracted_files.add(
   131	            PurePosixPath(path.relative_to(extracted_root).as_posix())
   132	        )
   133	    expected_extracted = set(payloads) | {PurePosixPath("MANIFEST.sha256")}
   134	    if extracted_files != expected_extracted:
   135	        raise RuntimeError("extracted tree and source archive file sets differ")
   136	
   137	    for name, data in payloads.items():
   138	        if hashlib.sha256(data).hexdigest() != internal[name]:
   139	            raise RuntimeError(f"internal archive hash mismatch: {name}")
   140	        if (extracted_root / name).read_bytes() != data:
   141	            raise RuntimeError(f"extracted file differs from archive: {name}")
   142	    if (extracted_root / "MANIFEST.sha256").read_bytes() != manifest_bytes:
   143	        raise RuntimeError("extracted internal manifest differs from archive")
   144	
   145	    nested_pdf = extracted_root / SOURCE_PDF
   146	    if (PACKAGE / PDF_NAME).read_bytes() != nested_pdf.read_bytes():
   147	        raise RuntimeError("convenience PDF differs from source-tree PDF")
   148	
   149	    pdf_digest = digest(PACKAGE / PDF_NAME)
   150	    for document_name in ("VERSION.md", "README_FIRST.md"):
   151	        text = (PACKAGE / document_name).read_text(encoding="utf-8")
   152	        for value, label in (
   153	            (archive_digest, "source-archive digest"),
   154	            (pdf_digest, "PDF digest"),
   155	            (COMMIT, "scientific commit"),
   156	            (TAG, "immutable tag"),
   157	        ):
   158	            if value not in text:
   159	                raise RuntimeError(f"{document_name} has a stale {label}")
   160	        if f"Internal source-archive members: {len(members)}" not in text:
   161	            raise RuntimeError(f"{document_name} has a stale member count")
   162	    return len(members), archive_digest, pdf_digest
   163	
   164	
   165	def verify_neutral_prompt() -> None:
   166	    prompt = (PACKAGE / "REFEREE_PROMPT.md").read_text(encoding="utf-8")
   167	    normalized = " ".join(prompt.lower().split())
   168	    for verdict in (
   169	        "fully validated",
   170	        "valid after minor corrections",
   171	        "major correction required",
   172	        "invalid",
   173	        "inconclusive / review incomplete",
   174	    ):
   175	        if verdict not in normalized:
   176	            raise RuntimeError(f"referee prompt omits verdict option: {verdict}")
   177	    if "you have not been told whether the results are correct" not in normalized:
   178	        raise RuntimeError("referee prompt lacks explicit neutrality instruction")
   179	    if "do not infer a proof from a successful program run" not in normalized:
   180	        raise RuntimeError("referee prompt fails to separate replay from proof")
   181	
   182	
   183	def main() -> None:
   184	    package_count = verify_package_manifest()
   185	    source_count, archive_digest, pdf_digest = verify_source_archive()
   186	    verify_neutral_prompt()
   187	    print(
   188	        f"PASS: {package_count} package payload files match "
   189	        "PACKAGE_MANIFEST.sha256"
   190	    )
   191	    print(
   192	        f"PASS: {source_count} source-archive members match the internal manifest"
   193	    )
   194	    print(f"SOURCE_ARCHIVE_SHA256: {archive_digest}")
   195	    print(f"PDF_SHA256: {pdf_digest}")
   196	    print("PASS: extracted source tree, convenience PDF, and neutral prompt are bound")
   197	
   198	
   199	if __name__ == "__main__":
   200	    main()
