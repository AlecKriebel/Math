   934	\begin{lemma}[Reciprocal killed-Green bounds]
   935	\label{lem:killed-green}
   936	Put $s=1/r$ and suppress hub changes while $h=0,\ell=0$.  Stop the resulting
   937	ordinary-count chain $I$ on hitting $0$ or $\lceil\delta c\rceil$, and define
   938	\[
   939	 G_C^U(i,j)=\mathbb E_i\int_0^\tau
   940	             \mathbf1_{\{I_z=j\}}\,dz.
   941	\]
   942	For every fixed $L$ there are $a_L,\kappa,\theta>0$, uniform for
   943	$s\in[1/r_+,1/r_-]$ and $U\in\{\Bd,\dB\}$, such that
   944	\begin{align}
   945	 \sup_{i\leq L}\Prob_i(\tau_{\lceil\delta c\rceil}<\tau_0)
   946	 &\leq a_Le^{-\kappa C},\label{eq:green-macro}\\
   947	 \sup_{i\leq L}\sum_jjG_C^U(i,j)&\leq a_L,
   948	 \label{eq:green-mass}\\
   949	 \sup_{i\leq L}\sum_{j>L'}jG_C^U(i,j)
   950	 &\leq a_Le^{-\theta L'}.
   951	 \label{eq:green-tail}
   952	\end{align}
   953	Consequently the probability of a hub change before ordinary extinction is
   954	$O_L(C^{-1})$, and the ordinary count at that change has an exponentially
   955	decreasing tail after multiplication by $C$.
   956	\end{lemma}
   957	
   958	\begin{proof}
   959	For $i\leq\delta c$, the reciprocal-fitness versions of the two rate tables
   960	give
   961	\[
   962	 \frac{q_i^+}{q_i^-}\leq s_+\{1+O(\delta)+O(C^{-1})\}\leq\vartheta<1
   963	\]
   964	after decreasing $\delta$, where $s_+=1/r_-$.  They also give
   965	$q_i^--q_i^+\geq\kappa_0i$ in the displayed clock.  The product-odds formula
   966	for the dominated nearest-neighbor walk proves \eqref{eq:green-macro}.
   967	Dynkin's formula for $I_{z\wedge\tau}$ gives
   968	\[
   969	 \kappa_0\mathbb E_i\int_0^\tau I_z\,dz\leq i,
   970	\]
   971	which is \eqref{eq:green-mass}.  To obtain \eqref{eq:green-tail}, let $\nu$
   972	be the first hit of $L'+1$.  Conditional bias gives
   973	$\Prob_i(\nu<\tau_0)\leq K_L\vartheta^{L'-L}$.  After $\nu$, the same Dynkin
   974	estimate bounds the expected remaining particle-time by
   975	$(L'+1)/\kappa_0$.  Therefore
   976	\[
   977	 \mathbb E_i\int_0^\tau I_s\mathbf1_{\{I_s>L'\}}\,ds
   978	 \leq \frac{K_L(L'+1)}{\kappa_0}\vartheta^{L'-L}
   979	 \leq a_Le^{-\theta L'},
   980	\]
   981	after decreasing $\theta$.
   982	
   983	With resident hub and no mutant pendants, the hub-change intensity in either
   984	rule is at most $K_1I_z/C$.  If $\chi$ is that first change, the two precise
   985	consequences are
   986	\begin{align}
   987	 \Prob_i(\chi<\tau)&\leq \frac{K_1a_L}{C},\label{eq:green-hub-change}\\
   988	 \Prob_i(\chi<\tau,\ I_\chi>L')
   989	 &\leq\frac{K_1}{C}\mathbb E_i\int_0^\tau
   990	 I_s\mathbf1_{\{I_s>L'\}}\,ds
   991	 \leq\frac{K_1a_L}{C}e^{-\theta L'}.
   992	\label{eq:green-hub-tail}
   993	\end{align}
   994	This proves the asserted change-event bounds.
   995	\end{proof}
   996	
   997	\begin{lemma}[Reciprocal hub-excursion renewal]
   998	\label{lem:reciprocal-renewal}
   999	Uniformly for $r\in\mathcal R$,
  1000	\[
  1001	 u_{\mathrm{core}}^{\Bd}(1/r)=o(C^{-1}),\qquad
  1002	 J_H(1/r)=o(C^{-1}).
  1003	\]
  1004	\end{lemma}
  1005	
  1006	\begin{proof}
  1007	For fixed $L$, let $X_L$ be the states with resident hub, no mutant pendants,
  1008	and at most $L$ mutant ordinary vertices; let $Y_L$ be the analogous states
  1009	with mutant hub.  Write $x^U_{C,L}$ and $y^U_{C,L}$ for the largest fixation
  1010	probabilities on these two sets.  Lemma~\ref{lem:killed-green} first gives
  1011	the coarse bound
  1012	\begin{equation}
  1013	 x^U_{C,L}\leq a_Le^{-\kappa C}+a_L/C=O_L(C^{-1}).
  1014	\label{eq:renewal-coarse}
  1015	\end{equation}
  1016	
  1017	We now make the hub-excursion stopping decomposition explicit.  For Bd,
  1018	start from $Y_L$.  The hub-loss rate is at least $m$, while the total
  1019	ordinary-changing rate is $O_L(1)$ and the pendant-seeding rate is $O(m/C)$.
  1020	If hub loss is the first such event, the return state lies in $X_L$ exactly;
  1021	charging every other first event as successful fixation gives
  1022	\begin{equation}
  1023	 y^{\Bd}_{C,L}\leq x^{\Bd}_{C,L}+K_Lm^{-1}+K C^{-1}=o(1).
  1024	\label{eq:renewal-y-Bd}
  1025	\end{equation}
  1026	
  1027	For dB, let $\zeta$ be the first hub loss.  Until the ordinary count reaches
  1028	$\delta c$, the hub-loss intensity is bounded below explicitly:
  1029	\[
  1030	 q_{h:1\mapsto0}
  1031	 =\frac{d-i-\ell}{d+(s-1)(i+\ell)}
  1032	 \geq\frac{(1-\delta)c}{d}=:k_h>0.
  1033	\]
  1034	While the hub is mutant, the ordinary count is dominated by a
  1035	subcritical birth--death process with immigration:
  1036	\[
  1037	 q_i^+\leq b(i+1),\qquad q_i^-\geq d_0i,\qquad b<d_0,
  1038	\]
  1039	after decreasing $\delta$.  A common-clock monotone coupling gives
  1040	$I_s\leq\bar I_s$ for $s\leq\zeta$ until the macro boundary, where $\bar I$ has
  1041	birth rate $b(i+1)$ and death rate $d_0i$.  To make its maximum bound
  1042	explicit, choose $1<z<d_0/b$ and put $V(i)=z^i$.  Its generator satisfies
  1043	\[
  1044	 \overline{\mathcal G}V(i)
  1045	 =(z-1)z^i\left[b-\left(\frac{d_0}{z}-b\right)i\right]
  1046	 \leq K_z-\alpha_zV(i)
  1047	\]
  1048	for suitable compact-uniform $K_z,\alpha_z>0$.  If
  1049	$\bar\tau_M=\inf\{s:\bar I_s\geq M\}$, Dynkin's formula stopped at
  1050	$T\wedge\bar\tau_M$ gives
  1051	\begin{equation}
  1052	 \sup_{i\leq L}\Prob_i\!\left(\sup_{s\leq T}\bar I_s\geq M\right)
  1053	 \leq (z^L+K_zT)z^{-M}.
  1054	\label{eq:immigration-maximum}
  1055	\end{equation}
  1056	Consequently the ordinary cloud before $\zeta$ is uniformly tight.
  1057	Indeed, for fixed $T$ and $L\leq L_1<\delta c$,
  1058	\[
  1059	 \Prob\!\left(\sup_{s<\zeta}I_s>L_1\right)
  1060	 \leq e^{-k_hT}+(z^L+K_zT)z^{-L_1}
  1061	 =:\eta_L(L_1,T),
  1062	\]
  1063	because on the event that the cloud stays below $L_1$ through time $T$, the
  1064	hub-loss intensity remains at least $k_h$ throughout.  Thus the first term
  1065	is precisely the surviving-hub part of the finite-$T$ split; no
  1066	infinite-horizon maximum estimate is being used.
  1067	For fixed $T$, let $L_1\to\infty$ and then let $T\to\infty$; the bound
  1068	vanishes in that order,
  1069	uniformly in $C$ and reciprocal fitness.
  1070	
  1071	On the complementary event, suppress hub reactivation after $\zeta$.
  1072	The mutant pendants are then pure deaths, so
  1073	$\mathbb E\int_0^\infty\ell_s\,ds\leq m$; the killed-Green bound gives
  1074	$\mathbb E\int_0^\tau I_s\,ds\leq a_{L_1}$.  Since the hub-reactivation
  1075	intensity is at most $K(I_s+\ell_s)/C$, its probability before pendant
  1076	clearance and ordinary extinction is at most
  1077	$K(m+a_{L_1})/C$.  Conditional bias also gives
  1078	\[
  1079	 \Prob_{\{I\leq L_1\}}(\tau_{L_2}<\tau_0)
  1080	 \leq K_{L_1}\vartheta^{L_2-L_1}.
  1081	\]
  1082	If neither event occurs, the process enters $X_{L_2}$.  Restoring the
  1083	suppressed reactivation only adds its displayed probability, so the strong
  1084	Markov property yields
  1085	\begin{equation}
  1086	 y^{\dB}_{C,L}
  1087	 \leq \eta_L(L_1,T)+\frac{K(m+a_{L_1})}{C}
  1088	      +K_{L_1}\vartheta^{L_2-L_1}+x^{\dB}_{C,L_2}.
  1089	\label{eq:renewal-y-dB}
  1090	\end{equation}
  1091	For fixed $L_1,L_2,T$, let $C\to\infty$; then let $L_2\to\infty$,
  1092	$L_1\to\infty$, and $T\to\infty$ in that order.  Equations
  1093	\eqref{eq:renewal-y-Bd}--\eqref{eq:renewal-y-dB} prove
  1094	$y^U_{C,L}=o(1)$ for each fixed $L$.
  1095	
  1096	Return now to one ordinary mutant.  At its first hub change, the explicit
  1097	hazard-weighted estimates \eqref{eq:green-macro} and
  1098	\eqref{eq:green-hub-tail} give a constant $a$ such that
  1099	\begin{equation}
  1100	 x^U_{C,1}\leq a e^{-\kappa C}
  1101	 +\frac aC\bigl(y^U_{C,L}+e^{-\theta L}\bigr).
  1102	\label{eq:renewal-refined}
  1103	\end{equation}
  1104	Therefore
  1105	$\limsup_{C\to\infty}Cx^U_{C,1}\leq ae^{-\theta L}$; letting $L\to\infty$
  1106	proves $x^U_{C,1}=o(C^{-1})$, while
  1107	\eqref{eq:renewal-y-Bd}--\eqref{eq:renewal-y-dB} give
  1108	$y^U_{C,0}=o(1)$.  Hence
  1109	\begin{align*}
  1110	 u_{\mathrm{core}}^{\Bd}(1/r)
  1111	 &\leq\frac{C-1}{C}x^{\Bd}_{C,1}+\frac1Cy^{\Bd}_{C,0}
  1112	 =o(C^{-1}),\\
  1113	 J_H(1/r)
  1114	 &\leq x^{\dB}_{C,1}+\frac{y^{\dB}_{C,0}}{c+m}
  1115	 =o(C^{-1}),
  1116	\end{align*}
  1117	because every ordinary clique vertex has degree $c$ and the hub has degree
  1118	$c+m$.
  1119	\end{proof}
  1120	
  1121	\begin{proof}[Proof of Proposition~\ref{prop:center}]
  1122	Choose $A_0$ so that both $r^{-K}$ and $r_0^{-K}$ in
  1123	Lemmas~\ref{lem:early-establishment} and \ref{lem:core-confinement} are
  1124	$o(q/C)=o(C^{-3/4})$, and then choose $B_0>3/4$ in
  1125	Lemma~\ref{lem:pendant-cleanup}.  Since
  1126	\[
  1127	 K^2/C=o(C^{-3/4}),\qquad C^{-B_0}=o(C^{-3/4}),
  1128	\]
  1129	the early-establishment probability is $p+o(q/C)$ and every established
  1130	family completes fixation with failure $o(q/C)$.  The hub starting vertex
  1131	has normalized mass $C^{-1}=o(q/C)$.  This proves \eqref{eq:core};
  1132	Lemma~\ref{lem:pendant-cleanup} proves \eqref{eq:leaf-Bd} and
  1133	\eqref{eq:leaf-dB}; and Lemma~\ref{lem:reciprocal-renewal} proves the two
  1134	reciprocal estimates.
  1135	
  1136	Finally, average the $C-1$ ordinary starts, the hub start, and the $m$
  1137	pendant starts.  Their contributions give
  1138	\eqref{eq:center-Bd}--\eqref{eq:center-dB}; the exceptional hub mass is
  1139	$O(C^{-1})=o(q/C)$.
  1140	\end{proof}
  1141	
  1142	\section{Pair gates and the complete post-establishment path}
  1143	
  1144	For the center, let
  1145	\[
  1146	 I_H=\sum_{x\ {\rm in\ clique}}\frac1{d_x}
  1147	 =1+\frac1{C-1+m},
  1148	\qquad
  1149	 J_H(r)=\sum_{x\ {\rm in\ clique}}
  1150	 \frac{h_H^{\dB}(\{x\};r)}{d_x},
  1151	\]
  1152	where $h_H^{\dB}$ is the isolated-center dB fixation committor.
  1153	For a pair with internal weight $W=C/\sigma$, put
  1154	\[
  1155	 I_P=\frac2W=\frac{2\sigma}{C},\qquad
  1156	 J_P(r)=\frac1W=\frac{\sigma}{C}.
  1157	\]
  1158	The second identity uses the exact dB singleton value $1/2$ on $K_2$.
  1159	The center estimates imply
  1160	\[
  1161	 I_H=1+o(1),\qquad J_H(r)=p+o(1),
  1162	\]
  1163	while $J_H(1/r)$ and the reciprocal core fixation probability are
  1164	$o(C^{-1})$.
  1165	
  1166	\begin{proposition}[Gate odds and global sweep]
  1167	\label{prop:gate}
  1168	For every fixed $r>1$, the separated macro-fixation probabilities satisfy
  1169	\[
  1170	 P_U^H=1-o(q/C),
  1171	 \qquad
  1172	 P_{\Bd}^P\longrightarrow\frac{Z_B}{1+Z_B},
  1173	 \qquad
  1174	 P_{\dB}^P\longrightarrow\frac{Z_D}{1+Z_D},
  1175	\]
  1176	where
  1177	\[
  1178	 Z_B=\sigma(r^2-1),\qquad
  1179	 Z_D=\frac{2r(r-1)}{\sigma}.
  1180	\]
  1181	The convergence is uniform when $r$ ranges over a compact subinterval of
  1182	$(1,\infty)$.
  1183	\end{proposition}
  1184	
  1185	\begin{proof}
  1186	For one specified pair, let $A,D,B,C'$ denote, respectively, mutant-pair
  1187	invasion of a resident center, resident-center recovery of that pair,
  1188	mutant-center invasion of a resident pair, and resident-pair recovery of
  1189	the center.  In each row below $a_P$ means the isolated pair fixation
  1190	$a_P^U$ for that update rule.  Summing the parent--target or death--parent events gives,
  1191	after a common time change,
  1192	\[
  1193	\begin{array}{c|cccc}
  1194	 &A&D&B&C'\\ \hline
  1195	 \Bd&
  1196	 CrI_Pu_{\rm core}^{\Bd}(r)&
  1197	 2I_Ha_P(1/r)&
  1198	 2rI_Ha_P(r)&
  1199	 CI_Pu_{\rm core}^{\Bd}(1/r)\\[1mm]
  1200	 \dB&
  1201	 2rJ_H(r)&
  1202	 (C/r)J_P(1/r)&
  1203	 CrJ_P(r)&
  1204	 (2/r)J_H(1/r).
  1205	\end{array}
  1206	\]
  1207	The isolated pair values are
  1208	\[
  1209	 a_P^{\Bd}(r)=\frac r{r+1},\quad
  1210	 a_P^{\Bd}(1/r)=\frac1{r+1},\quad
  1211	 a_P^{\dB}(r)=a_P^{\dB}(1/r)=\frac12.
  1212	\]
  1213	
  1214	On macro states the only nonzero rates are
  1215	\[
  1216	\begin{array}{ll}
  1217	 (0,k)\to(1,k):kA,&(0,k)\to(0,k-1):kD,\\
  1218	 (1,k)\to(1,k+1):(q-k)B,&(1,k)\to(0,k):(q-k)C'.
  1219	\end{array}
  1220	\]
  1221	From $(1,k)$, the chance that the center reverses before the next pair
  1222	conversion is $C'/(B+C')$.  A union bound over at most $q$ conversions gives
  1223	\[
  1224	 1-P_U^H\le q\frac{C'}{B+C'}.
  1225	\]
  1226	Proposition~\ref{prop:center} and the portal estimates give
  1227	$qC'/B=o(q/C)$, uniformly on each fitness compact.  Thus a mutant center
  1228	converts all resident pairs with probability $1-o(q/C)$.
  1229	
  1230	From $(0,1)$, the first successful macro event is either center invasion at
  1231	rate $A$ or loss of the sole mutant pair at rate $D$.  Hence
  1232	\[
  1233	 P_U^P=\frac{A}{A+D}\,p_{1,1},
  1234	\]
  1235	where $p_{1,1}$ is the macro-fixation probability from $(1,1)$.  The same
  1236	sweep bound, now with at most $q-1$ remaining conversions, gives
  1237	$p_{1,1}\to1$.  (Equivalently,
  1238	$P_U^P=[A/(A+D)][(B+C')/B]P_U^H$.)
  1239	The rate table and the isolated $K_2$ values give
  1240	\[
  1241	 Z_B=\sigma(r^2-1),\qquad
  1242	 Z_D=\frac{2r(r-1)}{\sigma}.
  1243	\]
  1244	More precisely, $A/D\to Z_U$, which yields the stated limits.  The argument
  1245	uses the exact absorbing macro chain, including adverse reversals; no
  1246	branching survival probability is substituted for global fixation.
  1247	\end{proof}
  1248	
  1249	\section{The simultaneous correction and its optimization}
  1250	
