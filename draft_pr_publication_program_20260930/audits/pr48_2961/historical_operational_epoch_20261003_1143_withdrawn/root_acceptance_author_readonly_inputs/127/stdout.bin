   360	
   361	\begin{proof}
   362	Every permutation in the displayed wreath-product action preserves vertex
   363	degrees, edge weights, types, and fitnesses.  It therefore commutes with each
   364	labelled parent--target event under Bd and each labelled death--parent event
   365	under dB.  Summing events into a target fibre proves strong lumpability.
   366	\end{proof}
   367	
   368	We next fix finite $C,m,q$ and send $\eps\downarrow0$.  At $\eps=0$ the
   369	closed fast classes are precisely the states in which the center module and
   370	every pair are internally homogeneous.  Write a macro state as
   371	\[
   372	 (h,k)\in\{0,1\}\times\{0,\ldots,q\},
   373	\]
   374	where $h$ is the center type and $k$ the number of mutant pairs.  Partition
   375	the finite first-step matrix into mixed-module states $F$ and all
   376	monomorphic-module states $M$, explicitly including global extinction and
   377	fixation.  Their two harmonic values remain fixed at zero and one.
   378	
   379	\begin{proposition}[Finite-state weak-cut limiting trace]
   380	\label{prop:weak-trace}
   381	Let $a_H^U,a_P^U$ be the uniformly initialized isolated fixation
   382	probabilities of the center and one pair, and let $P_U^H,P_U^P$ be fixation
   383	probabilities of the limiting macro chain from $(1,0)$ and $(0,1)$.  For
   384	$U\in\{\Bd,\dB\}$,
   385	\begin{equation}
   386	 \rho_U^0(C,m,q;r)
   387	 =\frac{C+m}{N}a_H^U(r)P_U^H
   388	 +\frac{2q}{N}a_P^U(r)P_U^P,
   389	 \qquad N=C+m+2q.
   390	\label{eq:finite-trace}
   391	\end{equation}
   392	Moreover, $\rho_U(G(C,m,q,\eps),r)\to\rho_U^0(C,m,q;r)$ uniformly in $r$
   393	on every compact subinterval of $(0,\infty)$.
   394	\end{proposition}
   395	
   396	\begin{proof}
   397	Order the states as $M,F$.  At $\eps=0$, the first-step matrix
   398	has the block form
   399	\[
   400	 P_U(0)=
   401	 \begin{pmatrix}I&0\\ C_0&Q_0\end{pmatrix},
   402	 \qquad \rho(Q_0)<1.
   403	\]
   404	Indeed, from a mixed state each finite connected module absorbs internally
   405	almost surely, so $I-Q_0$ is invertible with nonnegative inverse and
   406	$(I-Q_0)^{-1}C_0$ is the stochastic matrix of its first monomorphic return.
   407	Expanding the positive-cut chain gives
   408	\[
   409	 P_{MM}(\eps)=I+\eps A+O(\eps^2),\qquad
   410	 P_{MF}(\eps)=\eps B+O(\eps^2),
   411	\]
   412	and $P_{FM}(\eps)=C_0+O(\eps)$,
   413	$P_{FF}(\eps)=Q_0+O(\eps)$.  Eliminating $F$ from the finite harmonic
   414	system yields, after division by the common factor $\eps$, the macro
   415	generator
   416	\begin{equation}
   417	 \mathcal L_U=A+B(I-Q_0)^{-1}C_0.
   418	\label{eq:schur-trace}
   419	\end{equation}
   420	The second term first makes one cross-module introduction and then resolves
   421	its entire zero-cut internal excursion.  Its absorption distribution is
   422	therefore exactly the affected module's local fixation probability.  On the
   423	two globally absorbing macro states we retain boundary values zero and one;
   424	on every other macro state, the leading harmonic equation is
   425	$\mathcal L_Uh=0$.  Positive introduction rates make every interior state
   426	of this finite macro ladder transient.  On a compact fitness interval its
   427	interior inverse is uniformly bounded, so the boundary-value problem has a
   428	unique solution.  This is the claimed
   429	introduction-rate-times-fixation trace, derived from the finite chain rather
   430	than from independent lineages.
   431	
   432	A uniformly chosen initial mutant first resolves inside its center or pair
   433	module with probability $1-O(\eps)$.  Conditioning on which module fixes
   434	locally gives \eqref{eq:finite-trace}.  All matrices are finite and their
   435	entries are continuous rational functions of $(\eps,r)$ with positive event
   436	denominators.  After fixing the two boundary coordinates, the scaled Schur
   437	complement converges to the invertible interior restriction of
   438	$\mathcal L_U$.  On a compact fitness interval that limiting inverse,
   439	$(I-Q_0)^{-1}$, and the nearby absorbing inverses are uniformly bounded.
   440	The block expansion and hence the convergence are uniform there.
   441	\end{proof}
   442	
   443	\section{Clique--pendant estimates at the gain scale}
   444	
   445	Let $H_{C,m}$ be a unit clique $K_C$ with $m$ unit hub pendants and put
   446	$p=1-1/r$.  Along $C=t^4$, $q=t$, and $m\asymp t$, the following estimates hold
   447	uniformly when $r$ ranges over a compact subset of $(1,\infty)$:
   448	\begin{proposition}[Center module]
   449	\label{prop:center}
   450	\begin{align}
   451	 u_{\rm core}^U(r)&=p+o(q/C),\qquad U=\Bd,\dB,\label{eq:core}\\
   452	 u_{\rm leaf}^{\Bd}(r)&=1-o(1),\label{eq:leaf-Bd}\\
   453	 u_{\rm leaf}^{\dB}(r)&=O(C^{-1}).\label{eq:leaf-dB}
   454	\end{align}
   455	Here $u_{\rm core}^U$ averages the $C$ clique starting vertices.
   456	Consequently
   457	\begin{align}
   458	 a_H^{\Bd}(r)&=\frac{Cp+m}{C+m}+o(q/C),\label{eq:center-Bd}\\
   459	 a_H^{\dB}(r)&=\frac{Cp}{C+m}+o(q/C).\label{eq:center-dB}
   460	\end{align}
   461	At reciprocal fitness $1/r$,
   462	\[
   463	 u_{\mathrm{core}}^{\Bd}(1/r)=o(C^{-1}),\qquad J_H(1/r)=o(C^{-1}),
   464	\]
   465	where $J_H$ is the dB portal functional defined below.
   466	\end{proposition}
   467	
   468	We prove the proposition through five stopped-process lemmas.  This detail is
   469	needed because an $o(1)$ establishment approximation would be too weak: the
   470	final gain is only of order $q/C$.  Fix throughout a compact interval
   471	$\mathcal R=[r_-,r_+]\Subset(1,\infty)$.  Write a center state as
   472	$(h,i,\ell)$, put $c=C-1$, $d=c+m$, and suppress a common positive statewise
   473	time factor.  The six Bd changing rates are
   474	\[
   475	\begin{array}{c|c}
   476	\text{change}&\text{rate}\\ \hline
   477	i\to i+1&r(c-i)\{h/d+i/c\}\\
   478	i\to i-1&i\{(1-h)/d+(c-i)/c\}\\
   479	0\to1\text{ at }h&r(i/c+\ell)\\
   480	1\to0\text{ at }h&(c-i)/c+m-\ell\\
   481	\ell\to\ell+1&rh(m-\ell)/d\\
   482	\ell\to\ell-1&(1-h)\ell/d .
   483	\end{array}
   484	\]
   485	After multiplication by $C+m$, the six dB rates are
   486	\[
   487	\begin{array}{c|c}
   488	i\to i+1&(c-i)\dfrac{r(h+i)}{c+(r-1)(h+i)}\\[1mm]
   489	i\to i-1&i\dfrac{c-i+1-h}{c+(r-1)(i-1+h)}\\[1mm]
   490	0\to1\text{ at }h&\dfrac{r(i+\ell)}{d+(r-1)(i+\ell)}\\[1mm]
   491	1\to0\text{ at }h&\dfrac{d-i-\ell}{d+(r-1)(i+\ell)}\\[1mm]
   492	\ell\to\ell+1&h(m-\ell)\\
   493	\ell\to\ell-1&(1-h)\ell .
   494	\end{array}
   495	\]
   496	These tables follow by summing the labelled parent--target and
   497	death--parent events and are the only estimates used below.
   498	
   499	\begin{lemma}[Early ordinary-core establishment]
   500	\label{lem:early-establishment}
   501	Start from one ordinary clique mutant, with resident hub and no mutant
   502	pendants.  Let $\chi$ be the first change of the hub or pendant coordinates,
   503	let $K=\lceil A_0\log C\rceil$, and let
   504	$\tau_j=\inf\{s:i_s=j\}$ and
   505	$\tau_{0,K}=\tau_0\wedge\tau_K$.  Uniformly for
   506	$r\in\mathcal R$ and $U\in\{\Bd,\dB\}$,
   507	\begin{align}
   508	 \Prob(\chi<\tau_{0,K})&=O(K^2/C),\label{eq:early-mark}\\
   509	 \Prob_1(\tau_K<\tau_0)
   510	 &=1-\frac1r+O(K^2/C)+O(r^{-K}).\label{eq:early-est}
   511	\end{align}
   512	The constants are uniform for every fixed $A_0$.
   513	\end{lemma}
   514	
   515	\begin{proof}
   516	Until $\chi$, the exact embedded ordinary-count up/down odds are
   517	\begin{align}
   518	 R_{\Bd}(i)
   519	 &=r\,\frac{c-i}{c-i+c/(c+m)},\\
   520	 R_{\dB}(i)
   521	 &=r\,\frac{c-i}{c-i+1}
   522	 \frac{c+(r-1)(i-1)}{c+(r-1)i}.
   523	\end{align}
   524	Thus $\lambda_i^U:=(R_U(i))^{-1}=r^{-1}\{1+O(K/C)\}$ uniformly for
   525	$1\leq i<K$.  For large $C$, the embedded ordinary walk has conditional
   526	upward probability at least $1/2+\eta$ for some $\eta>0$ depending only on
   527	$\mathcal R$.  If $N$ is its number of changes before $\{0,K\}$, optional
   528	stopping applied to the count minus its uniform positive drift gives
   529	$\mathbb E_1N\leq K/(2\eta)=O(K)$.  At every visited state the hub-change
   530	hazard divided by the ordinary-change hazard is $O(K/C)$; a union bound over
   531	the stopped changes gives \eqref{eq:early-mark}.  Pendant coordinates cannot
   532	change before the initially resident hub does.
   533	
   534	Suppressing that killing event, the product-odds formula is
   535	\[
   536	 \Prob_1(\tau_K<\tau_0)
   537	 =\left(1+\sum_{k=1}^{K-1}\prod_{j=1}^k\lambda_j^U\right)^{-1}.
   538	\]
   539	For $k<K$, the product is
   540	$r^{-k}\exp\{O(kK/C)\}$; summing the geometric tail and restoring the
   541	killing event changes the answer by
   542	$O(K^2/C)+O(r^{-K})$.  This proves \eqref{eq:early-est}.
   543	\end{proof}
   544	\begin{lemma}[Supercritical completion and core confinement]
   545	\label{lem:core-confinement}
   546	There are constants $\delta>0$, $r_0>1$, $a,b,\gamma>0$, and an integer
   547	$R_0$, depending only on $\mathcal R$, with the following properties.
   548	Uniformly in the hub and pendant coordinates, a core family starting at
   549	$i=K$ reaches $i\geq(1-\delta)c$ before extinction except with probability
   550	\[
   551	 O(r_0^{-K})+e^{-\gamma C}.
   552	\]
   553	If $R=c-i$ and $R(0)\leq\delta c$, then for every fixed $M$,
   554	\begin{equation}
   555	 \Prob\!\left(\sup_{s\leq C^M}R_s\geq2\delta c\right)
   556	 \leq C_M C^{M+1}e^{-\gamma C},
   557	\label{eq:core-confinement}
   558	\end{equation}
   559	where time is measured in the displayed continuous-time clock.  Before the
   560	exceptional exit, the bounded strip is reached with the uniform tail
   561	\begin{equation}
   562	 \Prob\bigl(\tau_{\{R\leq R_0\}}>a\log C+x,
   563	             \tau_{2\delta c}>\tau_{\{R\leq R_0\}}\bigr)
   564	 \leq a e^{-bx}.
   565	\label{eq:deficit-return}
   566	\end{equation}
   567	\end{lemma}
   568	
   569	\begin{proof}
   570	For every hub and pendant state, the ordinary-count odds remain bounded
   571	below by a constant $r_0>1$ from $K$ to a fixed positive core density.
   572	Indeed, the two tables give the uniform lower bounds
   573	\[
   574	 \frac{q^+_{\Bd}}{q^-_{\Bd}}
   575	 \geq\frac{r}{1+c/\{d(c-i)\}},\qquad
   576	 \frac{q^+_{\dB}}{q^-_{\dB}}
   577	 =r\,\frac{h+i}{i}\frac{c-i}{c-i+1-h}
   578	 \frac{c+(r-1)(i-1+h)}{c+(r-1)(i+h)}.
   579	\]
   580	For $K\to\infty$ and $i\leq(1-\delta)c$, their infimum is strictly larger
   581	than one.  This comparison remains valid although the hidden coordinates
   582	move.  At successive $i$-change epochs, condition on the complete past.  The
   583	pointwise intensity ratio implies that the conditional probability of an
   584	upward step is at least $r_0/(1+r_0)$: this follows equivalently by comparing
   585	the two compensator integrals up to the next $i$-change.  Thus
   586	$r_0^{-i_n}$ is a supermartingale for the embedded adapted process.  Stopping
   587	on $\{0,\lfloor(1-\delta)c\rfloor\}$ gives
   588	\[
   589	 \Prob_K\bigl(\tau_0<\tau_{\lfloor(1-\delta)c\rfloor}\bigr)
   590	 \leq r_0^{-K}.
   591	\]
   592	Applying the same conditional-bias comparison across any subsequent
   593	fixed-density interval gives an $e^{-\gamma C}$ failure bound.
   594	
   595	In the upper strip $1\leq R\leq2\delta c$, the same tables give, uniformly
   596	in the hub and pendant coordinates,
   597	\begin{equation}
   598	 \frac{q(R\mapsto R-1)}{q(R\mapsto R+1)}
   599	 \geq r(1-2\delta)\frac{R}{R+1}\{1-o(1)\}.
   600	\label{eq:deficit-odds}
   601	\end{equation}
   602	Writing $r_-$ for the lower end of the chosen fitness compact, choose
   603	\[
   604	 \delta<\min\left\{\frac18,\frac{r_--1}{8r_-},
   605	 \frac{r_-^2-1}{4(r_-^2+1)}\right\}.
   606	\]
   607	Then one may take $\alpha=(r_-+1)/2>1$ and, for all sufficiently large
   608	$C$, replace the right side of \eqref{eq:deficit-odds} by
   609	$\alpha R/(R+1)$.  It is larger than $1+\eta_0$ above the fixed integer
   610	$R_0=\lceil(\alpha+1)/(\alpha-1)\rceil$; no statewise drift assertion is
   611	made below $R_0$.  The hidden hub and pendant coordinates do not make the
   612	deficit marginal Markov, so we use a conditional-bias coupling rather than
   613	assuming that they do.  At successive $R$-change epochs, condition on the
   614	entire past.  Whenever $R>R_0$, the probability of an outward step divided
   615	by that of an inward step is at most $(1+\eta_0)^{-1}$.  Choose
   616	$0<\theta<\log(1+\eta_0)$.  Then
   617	\[
   618	 \exp\{\theta R_{n\wedge\tau}\},\qquad
   619	 \tau=\tau_{\{R\leq R_0\}}\wedge\tau_{\{R\geq2\delta c\}},
   620	\]
   621	is a supermartingale for the embedded adapted process.  Optional stopping
   622	therefore gives, uniformly in all hidden-coordinate histories,
   623	\begin{equation}
   624	 \sup_{k\leq\delta c}
   625	 \Prob_k(\tau_{\{R\geq2\delta c\}}<\tau_{\{R\leq R_0\}})
   626	 \leq e^{-\theta\delta c}=e^{-\gamma C}.
   627	\label{eq:deficit-initial-excursion}
   628	\end{equation}
   629	The same estimate, started at $R_0+1$, controls every later excursion.
   630	The total $R$-change intensity in the displayed clock is at most $\Lambda C$.
   631	Its compensator through time $C^M$ is therefore at most
   632	$\Lambda C^{M+1}$.  Applying the strong Markov property at successive
   633	entries into $R_0+1$ and multiplying the last excursion bound by the expected
   634	number of entries proves \eqref{eq:core-confinement}; Markov's inequality for
   635	the compensator already suffices.
   636	
   637	For completeness, the stopped generator calculation behind the return-time
   638	claim is also explicit.  Substituting $i=c-R$ in the two tables gives
   639	\begin{align*}
   640	 \mathcal G_{\Bd}R
   641	 &=(c-R)\left\{\frac{1-h}{d}+\frac Rc\right\}
   642	   -rR\left\{\frac hd+\frac{c-R}{c}\right\},\\
   643	 \mathcal G_{\dB}R
   644	 &=(c-R)\frac{R+1-h}{c+(r-1)(c-R-1+h)}
   645	   -R\frac{r(c-R+h)}{c+(r-1)(c-R+h)}.
   646	\end{align*}
   647	After increasing $R_0$ and decreasing $\delta$ if necessary, both are at
   648	most $-\kappa R$ for $R_0<R<2\delta c$, uniformly in $h,\ell$, and
   649	$r\in\mathcal R$.  Thus
   650	$e^{\kappa(s\wedge\tau)}R_{s\wedge\tau}$ is a supermartingale in the
   651	displayed clock.  On the event in \eqref{eq:deficit-return} it has not yet
   652	hit either boundary at time $a\log C+x$.  Hence
   653	\[
   654	 \Prob(\tau_{\{R\leq R_0\}}>a\log C+x,
   655	       \tau_{\{R\geq2\delta c\}}>\tau_{\{R\leq R_0\}})
   656	 \leq \frac{\delta C}{R_0}e^{-\kappa(a\log C+x)}.
   657	\]
   658	Taking $a>2/\kappa$ proves \eqref{eq:deficit-return}.  The states below
   659	$R_0$ form the announced boundary layer and require no statewise drift claim.
   660	\end{proof}
   661	
   662	\begin{lemma}[Pendant synchronization and pendant initialization]
   663	\label{lem:pendant-cleanup}
   664	For every fixed $B_0>0$ there is a fixed $D_{\rm cl}=D_{\rm cl}(B_0)$ such
   665	that, under either update
   666	rule and uniformly in $r\in\mathcal R$, a state with
   667	$i\geq(1-\delta)c$ reaches fixation within time $C^{D_{\rm cl}}$, except with
   668	probability
   669	\[
   670	 O(C^{-B_0})+O(C^{D_{\rm cl}+1}e^{-\gamma C}).
   671	\]
   672	Moreover, fixation from one mutant pendant satisfies
   673	\[
   674	 u_{\rm leaf}^{\Bd}(r)=1-o(1),\qquad
   675	 u_{\rm leaf}^{\dB}(r)=O(C^{-1}).
   676	\]
   677	\end{lemma}
