+{
+  "assertions": 142,
+  "checks": {
+    "char2_inverse": "PASS",
+    "char2_jacobian": "PASS",
+    "char3_inverse": "PASS",
+    "char3_jacobian": "PASS",
+    "char5_inverse": "PASS",
+    "char5_jacobian": "PASS",
+    "divergence_zero_0": "PASS",
+    "divergence_zero_1": "PASS",
+    "divergence_zero_2": "PASS",
+    "dual_numbers_correction_inverse_r1": "PASS",
+    "dual_numbers_correction_inverse_r2": "PASS",
+    "dual_numbers_correction_inverse_r3": "PASS",
