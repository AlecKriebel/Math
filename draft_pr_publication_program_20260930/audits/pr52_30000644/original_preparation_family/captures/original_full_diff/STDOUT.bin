+    "exact_inverse_1_7": "PASS",
+    "exact_inverse_1_8": "PASS",
+    "exact_inverse_2_0": "PASS",
+    "exact_inverse_2_1": "PASS",
+    "exact_inverse_2_10": "PASS",
+    "exact_inverse_2_11": "PASS",
+    "exact_inverse_2_2": "PASS",
+    "exact_inverse_2_3": "PASS",
+    "exact_inverse_2_4": "PASS",
+    "exact_inverse_2_5": "PASS",
+    "exact_inverse_2_6": "PASS",
+    "exact_inverse_2_7": "PASS",
+    "exact_inverse_2_8": "PASS",
+    "exact_inverse_2_9": "PASS",
+    "exact_jacobian_0_0": "PASS",
+    "exact_jacobian_0_1": "PASS",
+    "exact_jacobian_0_2": "PASS",
