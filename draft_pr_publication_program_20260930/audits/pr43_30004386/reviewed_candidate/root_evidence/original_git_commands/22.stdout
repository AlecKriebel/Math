+    "unit_sphere_normalization": 30,
+    "projection_variance": 30,
+    "sorted_coordinate_interval": 186,
+    "coordinate_error_bound": 186,
+    "exact_target_fourth_tail": 30,
+    "gaussian_filler_fourth_bound": 30,
+    "total_fourth_error_bound": 30,
+    "projection_fourth_moment_range": 30,
+    "characteristic_normalization": 5,
