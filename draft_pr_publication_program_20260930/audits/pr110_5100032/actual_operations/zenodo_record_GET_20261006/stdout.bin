_sum.pdf", "size": 65142, "checksum": "md5:2557525eabb46e57ddece9d49cd0b4b4", "links": {"self": "https://zenodo.org/api/records/23191247/files/focal_antipedal_sum.pdf/content"}}, {"id": "6003a1a0-9131-4071-b400-28d9224e1936", "key": "focal_antipedal_sum_support.zip", "size": 113446, "checksum": "md5:49694a21bd623ce1337ca4dafda9cf8f", "links": {"self": "https://zenodo.org/api/records/23191247/files/focal_antipedal_sum_support.zip/content"}}], "swh": {}, "owners": [{"id": "1789874"}], "status": "published", "stats": {"downloads": 0, "unique_downloads": 0, "views": 0, "unique_views": 0, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 0, "version_views": 0}, "state": "done", "submitted": true}