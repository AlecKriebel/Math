+      "url": "https://spiral.imperial.ac.uk/server/api/core/bitstreams/31fba2ba-24ed-45cb-9374-dad47877adcc/content",
+      "sha256": "ca374df2576d443ec8e6e057ee218ca250ae0e4156be2e9dcb990eabe5f052df",
