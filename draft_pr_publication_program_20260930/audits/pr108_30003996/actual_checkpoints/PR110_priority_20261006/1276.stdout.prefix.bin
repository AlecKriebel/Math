      "name": "AST_revisited",
      "title": "Billiards in ellipses revisited",
      "authors": "Akopyan, Schwartz, Tabachnikov",
      "doi": "10.1007/s40879-020-00426-9",
      "year": 2020,
      "version": "Published PDF; online 9 September 2020, journal volume 2022",
      "url": "https://par.nsf.gov/servlets/purl/10408491",
      "scope": "Complete 15-page body and references; Theorems1.1–1.3,2.1/2.3/2.4,3.1,4.1,5.1,6.1–6.6 and their arguments.",
      "entire": true,
      "comparison": "Angle sums/products, odd area ratios, Minkowski duality, and squared diagonals. No arbitrary ordinary focal antipedal radial-sum theorem is stated in this body."
    },
    {
      "name": "BT_identities",
      "title": "Dan Reznik's identities and more",
      "authors": "Bialy, Tabachnikov",
      "doi": "10.1007/s40879-020-00428-7",
      "year": 2020,
      "version": "Published PDF; online 11 September 2020, journal volume 2022",
      "url": "https://par.nsf.gov/servlets/purl/10408490",
      "scope": "Complete 14-page body and references; generating-function Proposition2.1, Theorem2.2, Cor3.2, Theorems3.3/4.1/4.3, Lemma4.2 with both proofs. Rendered actual PDF p9, journal p1349.",
      "entire": true,
      "comparison": "Lemma4.2 supplies h_plus*h_minus=b²−lambda, a required credited background fact. Theorem4.1 treats outer tangent pedal feet and squared norms, not consecutive antipedal intersections and ordinary norms."
    },
    {
      "name": "RGR_bicentric",
