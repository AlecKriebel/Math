  "sources": [
    {
      "id": "S1",
      "title": "Eighty New Invariants of N-Periodics in the Elliptic Billiard",
      "authors": [
        "Dan Reznik",
        "Ronaldo Garcia",
        "Jair Koiller"
      ],
      "url": "https://arxiv.org/abs/2004.12497",
      "latest_version": "v11",
      "main_locator": "Section3.4/Table4p6",
      "comparison": "Original conjectural target; all11 row history checked."
    },
    {
      "id": "S2",
      "title": "Fifty New Invariants of N-Periodics in the Elliptic Billiard",
      "doi": "10.1007/s40598-021-00174-y",
      "url": "https://armj.math.stonybrook.edu/pdf-Springer-final/021-0174.pdf",
      "main_locator": "Table4p346/Section3.4",
      "comparison": "Distinct journal edition same conjectural row; no explicit primitive convention."
    },
    {
      "id": "S3",
      "title": "Outer-Pedal Area Products in Elliptic Billiards",
      "author": "Alper Ferudun",
      "doi": "10.5281/zenodo.23087221",
      "version": "1.0",
      "url": "https://zenodo.org/records/23087221",
      "main_locator": "Theorem1p1/Sections1–7",
      "comparison": "Exact target theorem; complete manuscript read."
    },
    {
      "id": "S4",
      "title": "Outer-Pedal Area Products in Elliptic Billiards",
      "author": "Alper Ferudun",
      "doi": "10.5281/zenodo.23088516",
      "version": "1.1",
      "url": "https://eulersolve.org/papers/amr-050-0014/",
      "main_locator": "Theorem1p1/Sections2–5 unchanged; centered Theorem2 added",
      "comparison": "Exact target retained; current PDF/source equal v1.1 deposit hashes."
    },
    {
      "id": "S5",
      "title": "Invariants of Self-Intersected N-Periodics in the Elliptic Billiard",
      "url": "https://arxiv.org/abs/2011.06640v3",
      "main_locator": "Proposition2; full text pedal/area contexts",
      "comparison": "No exact target theorem located; not an absence proof outside text."
    },
    {
      "id": "S6",
      "title": "Exploring self-intersected N-periodics in the elliptic billiard",
      "doi": "10.33039/ami.2022.02.001",
      "url": "https://doi.org/10.33039/ami.2022.02.001",
      "main_locator": "Proposition3.4/Section4",
      "comparison": "Self-intersected signed-area and other original/outer invariants; no arbitrary-M pedal area theorem."
    },
    {
      "id": "S7",
      "title": "New Invariants of Poncelet–Jacobi Bicentric Polygons",
      "doi": "10.1007/s40598-021-00188-6",
      "url": "https://arxiv.org/abs/2103.11260v3",
      "main_locator": "Theorem1/Theorem2/Corollary1; journal Thm2p625",
      "comparison": "Closely related Liouville/pole method; angle cosines and limiting-point pedal perimeters, not exact product."
    },
    {
      "id": "S8",
      "title": "Estimating Elliptic Billiard Invariants with Spatial Integrals",
      "doi": "10.1007/s10883-022-09608-y",
      "url": "https://doi.org/10.1007/s10883-022-09608-y",
      "main_locator": "Section1.1/Table1/Sections3–6",
      "comparison": "Spatial averages of lengths/cosines/curvature; no pedal map."
    },
    {
      "id": "S9",
      "title": "Discovering Poncelet Invariants in the Plane",
      "authors": [
        "Ronaldo A. Garcia",
        "Dan S. Reznik"
      ],
      "isbn": "978-65-89124-43-6",
      "edition": "IMPA July2021",
      "url": null,
      "main_locator": "contents/all pedal-area contexts/Corollary6.1",
      "comparison": "Cached complete primary text; relevant triangular/homothetic results do not give exact all-N target."
    },
    {
      "id": "S10",
      "title": "Area-Invariant Pedal-Like Curves Derived from the Ellipse",
      "url": "https://arxiv.org/abs/2009.02581v3",
      "main_locator": "Section2/Theorem1/Corollaries1–3/Theorems2–3",
      "comparison": "Continuous curve and moving-M invariance; cannot replace discrete phase-invariant product."
    },
    {
      "id": "S11",
      "title": "Topics on Pedal Polygons",
      "url": "https://arxiv.org/abs/2108.08293v1",
      "main_locator": "Definition2.1/Theorem2.8",
      "comparison": "Different angle-prescribed rotating outer polygon and area sum; not exact construction/product."
    },
    {
      "id": "S12",
      "title": "New Properties and Invariants of Harmonic Polygons",
      "url": "https://arxiv.org/abs/2112.02545v3",
      "main_locator": "Theorem1/Proposition6",
      "comparison": "Cotangent symmetric invariants/associated harmonic areas; no pedal map."
    }
  ],
