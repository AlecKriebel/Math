+def sum_y_witness(n,p,q2,q1=None):
+    """Interrogate constructed degree-one coordinates and every raw product.
+
+    Return None on a defective linear layer/product, allowing a deliberate
+    zero-sum regression to test this diagnostic rather than a constant list.
+    """
+    if q1 is None: q1=quotient(n,degree=1)
+    linear,d,_=q1
+    z=[sum(linear[(j,)][r] for j in range(n,2*n))%p for r in range(d)]
+    if not any(z) or d!=2*n: return None
+    # In this relation-free degree-one presentation, the surviving monomials
+    # are the raw variables; multiply the derived coordinates in q2.
+    products=matrix(n,q2,z)
+    quadratic,_,_=q2
+    for i in range(n):
+        vi=quadratic[tuple(sorted((i,n+(i+1)%n)))]
+        actual=[row[i]%p for row in products]
+        if actual!=[((n-1)*v)%p for v in vi]: return None
+        if any(actual)!=((n-1)%p!=0): return None
+        if any(row[n+i]%p for row in products): return None
+    return {'n':n,'p':p,'p_divides_n':n%p==0,
+            'p_divides_n_minus_one':(n-1)%p==0,
+            'degree_one_coordinates':z,
+            'products_by_raw_generators':[[row[j]%p for row in products]
+                                          for j in range(2*n)]}
 
