+f = [s.Matrix([-y * (x - z) * (x - y - z), -y * (x - z) * (x - y - z)]), s.Matrix([y * (-2 * x * x + 3 * x * y + 3 * x * z - y * y - 3 * z * z), (x - z) * rF[0]]), s.Matrix([y * (y - z) * r, 0])]
