+x, y, z, w = s.symbols('x y z w')
+checks = {}
+rD = [x * (x - z), 3 * x - y - z, y - x]
+rF = [-3 * x * y + x * z + 3 * y * y + z * z, y * (x - y - z), -x - y + z]
+gD = s.groebner(rD, z, y, x)
+gF = s.groebner(rF, z, y, x)
+checks['D_Ext1_groebner'] = [str(p.as_expr()) for p in gD.polys]
+checks['F_Ext1_groebner'] = [str(p.as_expr()) for p in gF.polys]
+if not [p.as_expr() for p in gD.polys] == [-2 * x + z, -x + y, x * x]:
+    raise RuntimeError('Check failed at accepted-source line 13')
+if not [p.as_expr() for p in gF.polys] == [-x - y + z, y * y, x * x]:
+    raise RuntimeError('Check failed at accepted-source line 14')
+checks['D_reduced_relation'] = [str(s.expand(p.subs({y: x, z: 2 * x}, simultaneous=True))) for p in rD]
+checks['F_reduced_relation'] = [str(s.expand(p.subs(z, x + y))) for p in rF]
+if not s.expand(rD[0].subs(z, 2 * x)) == -x * x:
+    raise RuntimeError('Check failed at accepted-source line 18')
+if not s.expand(rF[0].subs(z, x + y)) == 2 * x * x + 4 * y * y:
+    raise RuntimeError('Check failed at accepted-source line 19')
+if not s.expand(rF[1].subs(z, x + y)) == -2 * y * y:
+    raise RuntimeError('Check failed at accepted-source line 20')
+checks['Ext1_lengths_over_K_w'] = {'D': 2, 'F': 4}
+a, b = s.symbols('a b')
+if not s.expand((3 * x - y).subs({x: (a + b) / 2, y: (a + 3 * b) / 2}, simultaneous=True)) == a:
+    raise RuntimeError('Check failed at accepted-source line 25')
+if not s.expand((y - x).subs({x: (a + b) / 2, y: (a + 3 * b) / 2}, simultaneous=True)) == b:
+    raise RuntimeError('Check failed at accepted-source line 26')
+checks['seven_reduction_extra_entry'] = str(s.expand(x * x).subs(x, (a + b) / 2))
+r4 = s.Matrix([x + y, -y, x])
+U4 = s.Matrix([[1, 1, -1], [0, 0, 1], [0, -1, 0]])
+if not (U4.det() == 1 and U4 * r4 == s.Matrix([0, x, y])):
+    raise RuntimeError('Check failed at accepted-source line 31')
+checks['four_reduction_unimodular'] = {'matrix': str(U4), 'det': str(U4.det()), 'image': str(U4 * r4)}
+A = s.diag(1 - x, 1)
+v = s.Matrix([x, 0])
+aug = A.row_join(v)
+right_inverse = s.Matrix([[1, 0], [0, 1], [1, 0]])
+if not aug * right_inverse == s.eye(2):
+    raise RuntimeError('Check failed at accepted-source line 37')
+checks['ordinary_nonunit_A_epimorphism'] = {'A': str(A), 'v': str(v), 'det_A': str(A.det()), 'right_inverse': str(right_inverse)}
+Q = x * x * y * y * (x + y) ** 2
+Az = s.Matrix([[1, Q], [0, 1]])
+inv = s.Matrix([[1, -Q], [0, 1]])
+if not Az * inv == s.eye(2):
+    raise RuntimeError('Check failed at accepted-source line 43')
+for beta, cov in [(x, s.Matrix([[1, 0]])), (y, s.Matrix([[0, 1]])), (x + y, s.Matrix([[1, 1]]))]:
+    tangent = s.Matrix([cov[0, 1], -cov[0, 0]])
+    for B in [Az, inv]:
+        if not s.rem(s.expand((cov * B * tangent)[0]), beta ** 2, x if beta != y else y) == 0:
+            raise RuntimeError('Check failed at accepted-source line 47')
+checks['multiplicity_two_inverse_preservation'] = True
+p = x * (x - z)
+q = y * (y - z)
