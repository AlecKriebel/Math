+def check_boundary_quotient(tetrahedra, left, right, image):
+    """Permit only the prescribed paired boundary simplex identifications."""
+    for size in range(1, 5):
+        old_faces={f for t in tetrahedra for f in it.combinations(t,size)}
+        fibers=collections.defaultdict(list)
+        for face in old_faces:
+            target=tuple(sorted(image[v] if v in right else v for v in face))
+            need(len(set(target))==size, 'collapsed quotient simplex')
+            fibers[target].append(face)
+        for preimages in fibers.values():
+            if len(preimages)==1:
+                continue
+            need(len(preimages)==2, 'quotient simplex has too many preimages')
+            first,second=preimages
+            need((set(first)<=left and set(second)<=right) or
+                 (set(first)<=right and set(second)<=left),
+                 'unintended quotient identification outside boundary')
+            if set(first)<=right:
+                first,second=second,first
+            need(tuple(sorted(image[v] for v in second))==first,
+                 'quotient boundary pair differs from prescribed map')
+
