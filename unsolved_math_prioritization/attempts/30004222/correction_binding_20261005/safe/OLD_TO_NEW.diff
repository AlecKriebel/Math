+    for i in range(s-1):
+        for k in range(i+1,s):
+            c=t[i]-t[k]+k-i
+            z.update(qbinomial_factors(c-1,N[i]))
+            if k<s-1:z.subtract(qbinomial_factors(c+N[k],N[i]))
+    return {k:v for k,v in sorted(z.items()) if v and k!=1}
