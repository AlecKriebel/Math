  "metadata_object": {
    "title": "Cyclic self-sumset recognition: a credited corollary of the integer hardness theorem",
    "upload_type": "publication",
    "publication_type": "preprint",
    "publication_date": "2026-10-14",
    "creators": [
      {
        "name": "Kriebel, Alec",
        "affiliation": "Independent researcher",
        "orcid": "0009-0001-9320-500X"
      }
    ],
    "description": "Credited exposition of the cyclic consequence of the integer hardness theorem of Abboud, Fischer, Safier, and Wallheimer. Ordinary all-pair self-sumset recognition in the same Z/nZ, with unbounded positive input n, is NP-complete separately for binary n with an explicit binary residue list and for an n-bit characteristic vector. Hardness holds already for odd n and nonempty B containing 0 with every canonical 2b<n. The universal proof gives integer normalization and an odd zero-anchor/no-wrap transfer; dense hardness uses the AFWS uniform 3SAT numerical bound 2^57(v+c)^4. A deterministic polynomial-time exact decision algorithm in either model exists iff P=NP. No new hardness gadget, novelty, first-publication, independent-discovery, or worldwide-openness claim is made. Extensive AI assistance was used in reasoning, source work, adversarial checking, coding, computational verification and writing. Unrefereed; no external human peer review or formal certification. Support includes byte-preserved original records and authored verification code, not third-party source bodies. Inspected AFWS proof: arXiv2410.18661v2 (26 October 2024); SODA2025 publication metadata separately verified.",
    "access_right": "open",
    "license": "cc-by-4.0",
    "version": "1.0",
    "language": "eng",
    "keywords": [
      "sumsets",
      "cyclic groups",
      "NP-completeness",
      "credited exposition",
      "AI-assisted research"
    ],
    "related_identifiers": [
      {
        "identifier": "10.1137/1.9781611978322.153",
        "relation": "references",
        "scheme": "doi"
      },
      {
        "identifier": "10.4171/owr/2022/22",
        "relation": "references",
        "scheme": "doi"
      },
      {
        "identifier": "https://arxiv.org/abs/2410.18661v2",
        "relation": "references",
        "scheme": "url"
      }
    ],
    "notes": "Alec Kriebel is the sole named author. OpenAI Codex AI systems were used extensively. Exact historical priority of the cyclic formulation is unknown. Prepared locally on 2026-10-14 before deposit or publication."
  },
